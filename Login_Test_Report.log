    }
}

@media (max-width: 380px) {
    #er-expense-modal .er-expense-title {
        -webkit-line-clamp: 2;
        font-size: 13px;
    }

    #er-expense-modal .er-inline-btn,
    #er-expense-modal .er-item-actions .cr-view-btn {
        font-size: 10px !important;
        padding: 7px 8px !important;
    }
}

/* Event Request — modal footers, budget grid, compact action buttons */
.er-modal-footer {
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: nowrap;
}

.er-modal-footer-end {
    justify-content: flex-end !important;
}

.er-modal-footer .er-footer-left,
.er-modal-footer .er-footer-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;
}

.er-modal-footer .er-footer-btn,
.er-modal-footer .btn-sec,
.er-modal-footer .btn-pri {
    flex: 0 0 auto !important;
    width: auto !important;
    min-width: 88px;
    max-width: none;
    padding: 8px 18px !important;
}

#er-expense-modal .er-modal-footer-end .er-footer-btn {
    min-width: 96px;
}

.er-budget-hint {
    font-size: 12px;
    color: #64748b;
    margin: 0 0 14px;
}

.er-budget-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 16px;
    margin-bottom: 12px;
}

.er-budget-field {
    min-width: 0;
}

.er-budget-input-wrap {
    display: flex;
    align-items: stretch;
}

.er-budget-currency {
    display: inline-flex;
    align-items: center;
    padding: 0 10px;
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-right: 0;
    border-radius: 8px 0 0 8px;
    color: #64748b;
    font-size: 13px;
    font-weight: 700;
}

.er-budget-input-wrap .er-budget-input {
    border-radius: 0 8px 8px 0 !important;
}

.cr-request-page .cr-view-btn-sm {
    padding: 4px 8px !important;
    font-size: 10px !important;
    gap: 4px;
    display: inline-flex;
    align-items: center;
}

.cr-request-page .cr-act-group .cr-view-btn-sm .cr-btn-label {
    display: inline;
}

@media (max-width: 767.98px) {
    .er-budget-grid {
        grid-template-columns: 1fr;
    }

    .cr-request-page .cr-act-group .cr-view-btn-sm .cr-btn-label {
        display: none;
    }

    .cr-request-page .cr-view-btn-sm {
        padding: 5px 7px !important;
        min-width: 32px;
        justify-content: center;
    }

    .er-modal-footer {
        flex-wrap: wrap;
    }

    .er-modal-footer .er-footer-left,
    .er-modal-footer .er-footer-right {
        width: 100%;
        justify-content: flex-end;
    }

    .er-modal-footer .er-footer-left:only-child,
    .er-modal-footer .er-footer-left:empty {
        display: none;
    }
}

/* ── Approvals hub: table mode scrolls in #main; Event/Claim use nested pane scroll ─ */
#page-approvals:not(.appr-split-mode).page.active {
    display: block;
    height: auto;
    overflow: visible;
}

#page-approvals:not(.appr-split-mode) .appr-main-card {
    display: block;
    overflow: visible;
    min-height: 0;
}

#page-approvals:not(.appr-split-mode) #appr-table-shell {
    display: flex;
    flex-direction: column;
    min-height: 0;
}

#page-approvals:not(.appr-split-mode) #appr-table-shell > div:last-child {
    overflow-x: auto;
    overflow-y: auto;
    max-height: calc(100dvh - 320px);
    -webkit-overflow-scrolling: touch;
}

#page-approvals .ea-horiz-tabs {
    flex-shrink: 0;
    border-bottom: 1px solid #e2e8f0;
    padding: 8px 12px 0;
    margin: 0;
    gap: 4px;
    background: #ffffff;
}

#page-approvals .ea-horiz-tabs .nav-link {
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
    border: none;
    border-radius: 8px 8px 0 0;
    padding: 8px 16px;
    background: transparent;
}

#page-approvals .ea-horiz-tabs .nav-link.active {
    color: #d97706;
    background: #fff7ed;
    box-shadow: inset 0 -2px 0 #d97706;
}

#page-approvals .cr-empty-state {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 24px;
    background: #ffffff;
    color: #64748b;
    border-radius: 0 0 12px 12px;
}

#page-approvals .cr-empty-state i {
    color: #cbd5e1;
}

#page-approvals .cr-empty-state h5 {
    color: #334155;
    font-weight: 700;
    margin-bottom: 6px;
}

#page-approvals .cr-empty-state p {
    color: #94a3b8;
    margin: 0;
    font-size: 13px;
}

#page-approvals #appr-event-panel.appr-split-panel {
    background: #ffffff;
    border-radius: 0 0 12px 12px;
}

#page-approvals #appr-event-panel .cr-approvals-wrap {
    background: #ffffff;
}

#page-approvals > .card.mb-3,
#page-approvals > .appr-cat-scroll {
    flex-shrink: 0;
}

#page-approvals .appr-card-hdr {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 12px;
    padding: 10px 14px;
    background: linear-gradient(180deg, #f8f9fb, #eef2f7);
    border-bottom: 1px solid #e2e8f0;
    flex-shrink: 0;
    min-height: 48px;
}

/* Desktop: fill #main and scroll only inside left list + right details */
@media (min-width: 992px) {
    body:has(#page-approvals.appr-split-mode.page.active) #main {
        overflow: hidden !important;
        display: flex !important;
        flex-direction: column !important;
    }

    #page-approvals.appr-split-mode.page.active {
        flex: 1 1 auto !important;
        align-self: stretch;
        width: 100%;
        min-height: 0 !important;
        height: 100% !important;
        max-height: 100% !important;
        display: flex !important;
        flex-direction: column !important;
        overflow: hidden !important;
        box-sizing: border-box !important;
        padding-bottom: 10px !important;
    }

    #page-approvals.appr-split-mode .appr-main-card {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    #page-approvals.appr-split-mode .appr-split-panel,
    #page-approvals.appr-split-mode #ea-request-pane,
    #page-approvals.appr-split-mode #ea-bill-pane,
    #page-approvals.appr-split-mode #ea-fund-pane,
    #page-approvals.appr-split-mode #appr-claim-panel {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    #page-approvals .cr-approvals-wrap.is-empty,
    #page-approvals .cr-approvals-wrap[hidden] {
        display: none !important;
    }

    #page-approvals.appr-split-mode .cr-approvals-wrap {
        flex: 1 1 auto;
        min-height: 0;
        height: 100%;
        max-height: 100%;
        display: grid !important;
        grid-template-columns: minmax(160px, 200px) minmax(0, 1fr) minmax(260px, 300px);
        grid-template-rows: minmax(0, 1fr);
        align-items: stretch;
        padding: 10px;
        gap: 10px;
        overflow: hidden;
    }

    #page-approvals.appr-split-mode .cr-approvals-wrap > * {
        min-width: 0;
        min-height: 0;
        height: 100%;
        max-height: 100%;
        overflow: hidden;
    }

    #page-approvals.appr-split-mode .cr-pending-sidebar,
    #page-approvals.appr-split-mode .cr-file-pane,
    #page-approvals.appr-split-mode .cr-approval-panel {
        display: flex !important;
        flex-direction: column !important;
        min-height: 0 !important;
        height: 100% !important;
        max-height: 100% !important;
        overflow: hidden !important;
    }

    #page-approvals.appr-split-mode .cr-pending-list {
        flex: 1 1 auto !important;
        min-height: 0 !important;
        overflow-x: hidden !important;
        overflow-y: auto !important;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior: contain;
        touch-action: pan-y;
    }

    #page-approvals.appr-split-mode .cr-file-viewport {
        flex: 1 1 auto;
        min-height: 0;
        height: 100%;
        overflow: hidden;
        -webkit-overflow-scrolling: touch;
        background: #0f172a;
    }

    #page-approvals.appr-split-mode .cr-file-viewport-inner,
    #page-approvals.appr-split-mode .cr-file-viewer-inner {
        min-height: 100%;
        height: 100%;
        width: 100%;
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
    }

    #page-approvals.appr-split-mode .cr-pdf-frame {
        flex: 1 1 auto;
        min-height: 0;
        width: 100%;
        height: 100%;
        border: 0;
        background: #0f172a;
    }

    #page-approvals.appr-split-mode .cr-doc-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        background: #0f172a;
    }

    #page-approvals.appr-split-mode .cr-approval-body {
        flex: 1 1 auto !important;
        min-height: 0 !important;
        overflow-x: hidden !important;
        overflow-y: auto !important;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior: contain;
        touch-action: pan-y;
    }

    #page-approvals.appr-split-mode .cr-approval-actions {
        flex-shrink: 0;
        display: flex;
        gap: 8px;
        padding: 10px 14px;
        border-top: 1px solid #e8edf3;
        background: #fff;
    }

    #page-approvals.appr-split-mode .cr-approval-nav {
        flex-shrink: 0;
    }

    #page-approvals.appr-split-mode .cr-file-pager {
        flex-shrink: 0;
        margin-top: 8px !important;
    }

    /* Visible scroll affordance for approval panes (layout hides scrollbars globally) */
    #page-approvals.appr-split-mode .cr-pending-list,
    #page-approvals.appr-split-mode .cr-approval-body {
        scrollbar-width: thin !important;
        scrollbar-color: rgba(100, 116, 139, 0.55) transparent;
    }

    #page-approvals.appr-split-mode .cr-pending-list::-webkit-scrollbar,
    #page-approvals.appr-split-mode .cr-approval-body::-webkit-scrollbar {
        width: 8px !important;
        height: 8px !important;
        display: block !important;
    }

    #page-approvals.appr-split-mode .cr-pending-list::-webkit-scrollbar-thumb,
    #page-approvals.appr-split-mode .cr-approval-body::-webkit-scrollbar-thumb {
        background: rgba(100, 116, 139, 0.45);
        border-radius: 999px;
    }
}

#page-approvals .appr-card-title,
#page-approvals #appr-title {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    color: #1a202c;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

#page-approvals .appr-card-hdr-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex: 0 0 auto;
    margin-left: auto;
    gap: 8px;
    min-width: 0;
}

#page-approvals #appr-tab-toggle {
    flex: 0 0 auto;
}

#page-approvals #appr-op-subtabs.appr-op-subtabs {
    display: none;
    flex: 0 0 auto;
    align-items: center;
    gap: 0;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
}

#page-approvals #appr-op-subtabs.appr-op-subtabs.is-visible {
    display: flex;
}

#page-approvals #appr-op-subtabs .appr-op-subtab {
    padding: 5px 12px;
    margin: 0;
    border: none;
    border-bottom: none;
    border-radius: 6px;
    font-size: 11.5px;
    font-weight: 700;
    color: #64748b;
    background: transparent;
    white-space: nowrap;
}

#page-approvals #appr-op-subtabs .appr-op-subtab:hover {
    color: #334155;
    background: rgba(79, 70, 229, 0.08);
}

#page-approvals #appr-op-subtabs .appr-op-subtab.active {
    color: #4f46e5;
    background: rgba(79, 70, 229, 0.12);
    box-shadow: inset 0 0 0 1px rgba(79, 70, 229, 0.2);
}

@media (max-width: 640px) {
    #page-approvals .appr-card-hdr {
        padding: 8px 10px;
        gap: 8px;
    }

    #page-approvals .appr-card-title,
    #page-approvals #appr-title {
        font-size: 13px;
    }

    #page-approvals #appr-tab-toggle .tab-btn {
        padding: 5px 10px;
        font-size: 11px;
    }

    #page-approvals #appr-op-subtabs .appr-op-subtab {
        padding: 5px 8px;
        font-size: 10.5px;
    }

    #page-approvals #appr-op-subtabs .appr-op-subtab i {
