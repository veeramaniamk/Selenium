                var fileBlock = '';
                if (row.file_url) {
                    fileBlock = '<div class="pa-section" style="margin-top:12px">'
                        + '<div class="pa-section-hdr"><i class="fa fa-paperclip me-1"></i>Attachment</div>'
                        + '<div class="pa-section-body"><a href="' + esc(row.file_url) + '" target="_blank" rel="noopener" class="pa-view-btn">'
                        + '<i class="fa fa-external-link me-1"></i>Open ' + esc(row.file_type || 'file')
                        + '</a></div></div>';
                }

                body.innerHTML = ''
                    + '<div class="row g-3">'
                    + '<div class="col-12 col-lg-5">'
                    + '<div class="pa-section"><div class="pa-section-hdr"><i class="fa fa-circle-info me-1"></i>Overview</div>'
                    + '<div class="pa-section-body" style="display:grid;gap:8px">'
                    + '<div><span class="pa-cell">Requester</span><div style="font-weight:700">' + esc(row.requester_name || '—') + ' (' + esc(row.requester_bio_id || '') + ')</div></div>'
                    + '<div><span class="pa-cell">Company</span><div style="font-weight:700">' + esc(row.company_name || '—') + '</div></div>'
                    + '<div><span class="pa-cell">Requested</span><div style="font-weight:700">' + esc(row.requested_at_display || '—') + '</div></div>'
                    + '<div><span class="pa-cell">Status</span><div>' + statusPill(row.status) + '</div></div>'
                    + (row.payload_summary ? ('<div><span class="pa-cell">Summary</span><div>' + esc(row.payload_summary) + '</div></div>') : '')
