        }

        .pa-toolbar {
            display: none;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
            padding: 12px 16px;
            background: linear-gradient(180deg, #f8f9fb, #eef2f7);
            border-bottom: 1px solid #e2e8f0;
        }

        .pa-toolbar.is-visible {
