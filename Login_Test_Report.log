                var pending = [];

                function finishBadges() {
                    Promise.all(pending).catch(function() {}).then(function() {
                        if (typeof window.refreshApprovalCategoryBadges === 'function') {
                            window.refreshApprovalCategoryBadges();
                        }
                    });
                }

                function runNext() {
                    var item = queue.shift();
                    if (!item) {
                        finishBadges();
