                'Sent': 'sp-sent',
                'Received': 'sp-received',
                'Scheduled': 'sp-leave'
            };
            const lbl = {
                'Scheduled': 'Scheduled'
            };
            return `<span class="sp ${m[s]||''}">${lbl[s]||s}</span>`;
        }

        // ═══════════════════════════════════════
        // NAVIGATION
        // ═══════════════════════════════════════
        async function goPage(pg, title = '') {
            if (typeof window.closeAsset360 === 'function') {
                window.closeAsset360();
            }
            if (pg === 'equipment-entry') {
                const approvalAccess = (window.ED_CONFIG && window.ED_CONFIG.approvalAccess) ||
                    window.__ED_APPROVAL_ACCESS || {};
                if (!approvalAccess.equipmentEntry) {
                    if (approvalAccess.equipmentEntryPrivilege) {
                        const privNav = document.querySelector('.subitem[data-slug="equipment-entry"]');
                        if (privNav) {
                            await goPrivilege(privNav);
                            return;
                        }
                    }
                    return;
                }
            }
            if (pg !== 'approvals' && window.EDEquipmentApproval && typeof window.EDEquipmentApproval.leaveEquipmentTab === 'function') {
                window.EDEquipmentApproval.leaveEquipmentTab();
            }
            if (pg !== 'approvals' && window.EDEquipmentEditApproval && typeof window.EDEquipmentEditApproval.leaveEquipmentEditTab === 'function') {
                window.EDEquipmentEditApproval.leaveEquipmentEditTab();
            }
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.sitem, .subitem').forEach(n => n.classList.remove('active'));

            const pid = pg === 'ph' ? 'page-ph' : 'page-' + pg;
            const el = document.getElementById(pid);
            if (el) el.classList.add('active');

            if (pg === 'ph') {
                document.getElementById('ph-title').textContent = title;
                const nav = document.querySelector(`.sitem[data-page="ph"][data-title="${title}"], .subitem[data-page="ph"][data-title="${title}"]`);
                if (nav) nav.classList.add('active');
            } else {
                const nav = document.querySelector(`.sitem[data-page="${pg}"], .subitem[data-page="${pg}"]`);
                if (nav) nav.classList.add('active');
            }

            if (pg !== 'home' && window.EDPageLoader) {
                try {
                    await window.EDPageLoader.ensurePage(pg);
                } catch (err) {
                    console.error('[goPage] Failed to load page fragment:', err);
                }
            }

            var activePage = document.getElementById(pid);

            if (pg === 'equipment-entry') {
                var eePage = document.getElementById('page-equipment-entry');
                if (!eePage) {
                    var mainEl = document.getElementById('main');
                    var errEl = document.getElementById('ee-page-missing-error');
                    if (!errEl && mainEl) {
                        errEl = document.createElement('div');
                        errEl.id = 'ee-page-missing-error';
                        errEl.className = 'page';
                        errEl.innerHTML =
                            '<div class="card p-4 text-center" style="max-width:420px;margin:40px auto">' +
                            '<p style="font-size:13px;color:#b91c1c;margin:0 0 12px">Equipment Entry is unavailable. Please refresh the page.</p>' +
                            '<button type="button" class="btn btn-sm btn-outline-primary" onclick="location.reload()">Refresh</button>' +
                            '</div>';
                        mainEl.appendChild(errEl);
                    }
                    activePage = errEl || activePage;
                } else {
                    if (!eePage.querySelector('.cr-card-shell') &&
                        window.EDPageLoader &&
                        typeof window.EDPageLoader.invalidatePage === 'function') {
                        window.EDPageLoader.invalidatePage('equipment-entry');
                        try {
                            await window.EDPageLoader.ensurePage('equipment-entry');
                        } catch (remountErr) {
                            console.error('[goPage] equipment-entry remount failed:', remountErr);
                        }
                    }
                    var eeShell = eePage.querySelector('.cr-card-shell');
                    if (eeShell) eeShell.style.removeProperty('display');
                    eePage.classList.remove('ee-asset360-open');
                    if (window.EDEquipmentEntry && typeof window.EDEquipmentEntry.restoreShell === 'function') {
                        window.EDEquipmentEntry.restoreShell();
                    }
                    activePage = eePage;
                    var errHide = document.getElementById('ee-page-missing-error');
                    if (errHide) errHide.classList.remove('active');
                }
            }

            if (activePage) activePage.classList.add('active');

            if (pg === 'notifications') drawNotifs();
            if (pg === 'approvals') {
                initAppr();
            }
            if (pg === 'proReview' && window.EDProReview) {
                window.EDProReview.onPage();
            }
            if (pg === 'project-request' && window.EDProjectRequest) {
                window.EDProjectRequest.onPage();
            }
            if (pg === 'scrape-items' && window.EDScrapeItems) {
                window.EDScrapeItems.onPage();
            }
            if (pg === 'claim-request' && window.EDClaimRequest) {
                window.EDClaimRequest.onPage();
            }
            if (pg === 'event-request' && window.EDEventRequest) {
                window.EDEventRequest.onPage();
            }
            if (pg === 'software-grievance' && window.EDSoftwareGrievance) {
                window.EDSoftwareGrievance.onPage();
            }
            if (pg === 'pending-tickets' && window.EDPendingTickets) {
                window.EDPendingTickets.onPage();
            }
            if (pg === 'consumable-request' && window.EDConsumableRequest) {
                window.EDConsumableRequest.onPage();
            }
            if (pg === 'equipment-entry' && window.EDEquipmentEntry) {
                window.EDEquipmentEntry.onPage();
            }
            if (pg === 'overtime' && window.EDAttendanceClaims) {
                window.EDAttendanceClaims.onPage();
            }
            if (pg === 'grievance' && window.EDGrievance) {
                window.EDGrievance.onPage();
            }
            if (pg === 'duty-wall' && window.EDDutyWall) {
                window.EDDutyWall.onPage();
            }
            if (pg === 'hierarchy' && window.EDHierarchy) {
                window.EDHierarchy.onPage();
            }
            if (pg === 'salary' && window.EDReports) {
                window.EDReports.onSalaryPage();
            }
            if (pg === 'reports-360' && window.EDReports360) {
                window.EDReports360.onPage();
            }
            if (pg === 'settings') {
                hydrateSettingsUi();
                if (window.EDProfile && typeof window.EDProfile.bindPasswordForm === 'function') {
                    window.EDProfile.bindPasswordForm();
                }
                setOpt(title === 'password' ? 'password' : 'profile');
            }
            document.getElementById('main').scrollTop = 0;

            if (window.innerWidth < 992) {
                closeSidebar();
            }
        }

        async function goPrivilege(navEl) {
            if (!navEl || !navEl.dataset) return;

            const slug = navEl.dataset.slug || '';
            const campusBioId = navEl.dataset.campusBioId || '';
            if (!slug) return;

            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.sitem, .subitem').forEach(n => n.classList.remove('active'));

            if (window.EDPageLoader) {
                await window.EDPageLoader.ensurePage('privilege');
            }

            const page = document.getElementById('page-privilege');
            if (page) page.classList.add('active');
            navEl.classList.add('active');

            const iframe = document.getElementById('priv-iframe');
            const loader = document.getElementById('priv-loader');
            if (iframe) {
                const params = new URLSearchParams();
                params.set('embed', '1');
                if (campusBioId) params.set('campus_bio_id', campusBioId);
                const doaSlugs = new Set([
                    'purchase-approval',
                    'project-payment',
                    'cons-payment',
                    'batch-edit',
                    'item-codes',
                    'conference-approval',
                    'bill-approval',
                    'inventory-approval',
                    'stock-approval',
                    'location-approval',
                    'cancel-transfer-project',
                    'account-location-transfer',
                ]);
                const empSlugScreens = {
                    'promotion-approval': 'promotion.php',
                    'new-employee-approval': 'new-employee.php',
                    'onduty-approval': 'on-duty.php',
                    'allowance-approval': 'allowance.php',
                    'doj-approval': 'doj.php',
                    'experience-approval': 'experience.php',
                    'leave-addition-approval': 'leave-addition.php',
                    'shift-roster-approval': 'shift-roster.php',
                };
                let nextSrc;
                if (doaSlugs.has(slug)) {
                    nextSrc = '/privileges/doa/' + encodeURIComponent(slug) + '.php?' + params.toString();
                } else if (empSlugScreens[slug]) {
                    nextSrc = '/privileges/emp/' + empSlugScreens[slug] + '?' + params.toString();
                } else {
                    nextSrc = '/privileges/' + encodeURIComponent(slug) + '.php?' + params.toString();
                }

                if (loader) loader.classList.add('visible');
                iframe.onload = () => {
                    if (loader) loader.classList.remove('visible');
                };

                if (iframe.getAttribute('src') !== nextSrc) {
                    iframe.setAttribute('src', nextSrc);
                } else if (loader) {
                    loader.classList.remove('visible');
                }
            }

            document.getElementById('main').scrollTop = 0;

            if (window.innerWidth < 992) {
                closeSidebar();
            }
        }

        function togSidebar() {
            if (window.innerWidth < 992) {
                const s = document.getElementById('sidebar');
                const o = document.getElementById('soverlay');
                if (s) s.classList.toggle('open');
                if (o) o.classList.toggle('open');
            } else {
                document.body.classList.toggle('collapsed');
            }
        }

        function closeSidebar() {
            const s = document.getElementById('sidebar');
            const o = document.getElementById('soverlay');
            if (s) s.classList.remove('open');
            if (o) o.classList.remove('open');
        }

        function togPriv() {
            const s = document.getElementById('priv-sub'),
                a = document.getElementById('priv-arr'),
                t = document.getElementById('priv-tog'),
                sidebar = document.getElementById('sidebar');
            if (!s || !a) return;

            const isOpen = s.classList.contains('open');

            if (!isOpen) {
                s.classList.add('open');
                if (t) t.classList.add('open');
                if (sidebar) sidebar.classList.add('priv-menu-open');
                a.style.transform = 'rotate(180deg)';
                if (document.body.classList.contains('collapsed') && t) {
                    const rect = t.getBoundingClientRect();
                    const maxTop = Math.max(12, window.innerHeight - 420);
                    s.style.top = Math.min(Math.max(12, rect.top - 6), maxTop) + 'px';
                } else {
                    s.style.top = '';
                }
            } else {
                s.classList.remove('open');
                if (t) t.classList.remove('open');
                if (sidebar) sidebar.classList.remove('priv-menu-open');
                a.style.transform = '';
                s.style.top = '';
            }
        }

        async function loadPrivilegeBadges() {
            try {
                const res = await fetch('/privileges/api/doa/pending_counts.php', {
                    credentials: 'same-origin'
                });
                const json = await res.json();
                if (!json || !json.success || !json.data) return;
                const bySlug = json.data.by_slug || {};
                let total = 0;
                document.querySelectorAll('.priv-slug-badge').forEach((el) => {
                    const slug = el.getAttribute('data-priv-slug') || '';
                    const n = Number(bySlug[slug] || 0);
                    total += n;
                    if (n > 0) {
                        el.textContent = String(n);
                        el.style.display = '';
                    } else {
                        el.style.display = 'none';
                    }
                });
                // Prefer API total for granted DOA privileges only (matches sum of shown badges)
                const apiTotal = Number(json.data.total || total);
                const main = document.getElementById('sidebar-privileges-badge');
                if (main) {
                    if (apiTotal > 0) {
                        main.textContent = String(apiTotal);
                        main.style.display = '';
                    } else {
                        main.style.display = 'none';
                    }
                }
            } catch (e) {
                console.warn('Privilege badge load failed', e);
            }
        }

        // ═══════════════════════════════════════
        // SEGMENTED — PIXEL PERFECT
        // ═══════════════════════════════════════
        function initSeg() {
            // Position the pill on first segment
            posSeg(0);
        }

        function posSeg(idx) {
            const ctrl = document.querySelector('.seg-outer');
            if (!ctrl) return;
            const pill = document.getElementById('sp');
            const btns = ctrl.querySelectorAll('.seg-btn');
            const activeBtn = btns[idx];
            if (activeBtn && pill) {
                // Add active class early for style stability
                btns.forEach((b, i) => b.classList.toggle('active', i === idx));

                // Robust offset calculation
                const rect = activeBtn.getBoundingClientRect();
                const parentRect = ctrl.getBoundingClientRect();
                const offset = rect.left - parentRect.left;
                const width = rect.width;

                pill.style.left = offset + 'px';
                pill.style.width = width + 'px';
            }
        }

        let _attDomBuilt = false;
        let _attLastCycle = null;
        const _segPending = [false, false, false];
        const _segWarmState = {
            duty: false,
            leave: false
        };

        function ensureHomeSegTab(idx) {
            if (!window.EDPageLoader || typeof window.EDPageLoader.ensureTab !== 'function') {
                return Promise.resolve();
            }
            if (idx === 1) {
                return window.EDPageLoader.ensureTab('home-tab-duty').catch(() => null);
            }
            if (idx === 2) {
                return window.EDPageLoader.ensureTab('home-tab-leave').catch(() => null);
            }
            return Promise.resolve();
        }

        function warmHomeSegTabs() {
            if (_segWarmState.duty && _segWarmState.leave) return;
            _segWarmState.duty = true;
            _segWarmState.leave = true;

            // Cache HTML only — do not mount hidden tabs during idle warm-up.
            if (window.EDPageLoader && typeof window.EDPageLoader.warmTab === 'function') {
                window.EDPageLoader.warmTab('home-tab-duty').catch(() => null);
                window.EDPageLoader.warmTab('home-tab-leave').catch(() => null);
            }

            if (window.EDDutyExchange && typeof window.EDDutyExchange.prefetch === 'function') {
                try {
                    window.EDDutyExchange.prefetch();
                } catch (e) {
                    /* ignore */
                }
            }
            if (window.EDLeave && typeof window.EDLeave.prefetch === 'function') {
                try {
                    window.EDLeave.prefetch();
                } catch (e) {
                    /* ignore */
                }
            }
        }

        function waitFor(checker, timeoutMs, pollMs) {
            const timeout = Number(timeoutMs || 2400);
            const poll = Number(pollMs || 40);
            const start = Date.now();
            return new Promise(function(resolve) {
                const tick = function() {
                    let ok = false;
                    try {
                        ok = !!checker();
                    } catch (e) {
                        ok = false;
                    }
                    if (ok) return resolve(true);
                    if ((Date.now() - start) >= timeout) return resolve(false);
                    setTimeout(tick, poll);
                };
                tick();
            });
        }

        function ensureDutySegReady() {
            const runDutyViews = function() {
                drawDuties();
                drawXchg();
                drawHist();
            };

            return waitFor(function() {
                return window.EDDutyExchange && typeof window.EDDutyExchange.ensureLoaded === 'function';
            }, 2400, 40).then(function(ready) {
                if (!ready) {
                    runDutyViews();
                    return null;
                }
                return window.EDDutyExchange.ensureLoaded()
                    .then(runDutyViews)
                    .catch(function() {
                        runDutyViews();
                    });
            });
        }

        function ensureLeaveSegReady() {
            return waitFor(function() {
                return window.EDLeave && typeof window.EDLeave.ensureLoaded === 'function';
            }, 2400, 40).then(function(ready) {
                if (!ready) return null;
                return window.EDLeave.ensureLoaded().catch(() => null);
            });
        }

        async function switchSeg(idx) {
            if (activeSeg === idx || _segPending[idx]) return;
            _segPending[idx] = true;
            try {
                // Flip UI state first so switching feels immediate.
                activeSeg = idx;
                requestAnimationFrame(() => posSeg(idx));
                document.querySelectorAll('.tm-tab').forEach((t, i) => t.classList.toggle('active', i === idx));

                const monthCard = document.getElementById('att-month-card');
                if (monthCard) monthCard.style.display = idx === 0 ? 'flex' : 'none';

                // Ensure the selected tab shell is mounted before rendering data into it.
                if (idx === 1 || idx === 2) {
                    await ensureHomeSegTab(idx);
                }

                if (idx === 0) {
                    const cycle = document.getElementById('att-m')?.value;
                    if (!_attDomBuilt || _attLastCycle !== cycle) updAtt();
                } else if (idx === 1) {
                    await ensureDutySegReady();
                } else if (idx === 2) {
                    await ensureLeaveSegReady();
                }
            } finally {
                _segPending[idx] = false;
            }
        }
        // Re-position pill on resize
        window.addEventListener('resize', () => {
            if (activeSeg !== undefined) posSeg(activeSeg)
        });

        // ═══════════════════════════════════════
        // ATTENDANCE
        // ═══════════════════════════════════════
        function animCount(id, start, end, dur, suff = '') {
            const el = document.getElementById(id);
            if (!el) return;
            let st = null;
            const step = (ts) => {
                if (!st) st = ts;
                const prog = Math.min((ts - st) / dur, 1);
                const ease = 1 - Math.pow(1 - prog, 3);
                el.textContent = Math.floor(start + (end - start) * ease) + suff;
                if (prog < 1) requestAnimationFrame(step);
                else el.textContent = end + suff;
            };
            requestAnimationFrame(step);
        }

        function updAtt() {
            const store = window.ATT || {};
            const mEl = document.getElementById('att-m');
            if (!mEl) return;
            const m = String(mEl.value || '').trim() || 'cycle-current';
            const d = store[m];
            if (!d) return;
            const body = document.getElementById('att-body');
            if (!body) return;
            if (mEl.value !== m) mEl.value = m;
            const rem = d.totBuf - d.usedBuf;
            // Update stats (Desktop and potential mobile instances)
            document.querySelectorAll('[id^="v-lop"]').forEach(el => {
                el.innerHTML = d.lop + ' <span style="font-size:14px;color:#94a3b8;font-weight:600">day' + (d.lop !== 1 ? 's' : '') + '</span>';
            });

            document.querySelectorAll('[id^="v-buf"]').forEach(el => animCount(el.id, 0, rem, 900));
            document.querySelectorAll('[id^="v-att"]').forEach(el => animCount(el.id, 0, d.att, 900, '%'));
            document.querySelectorAll('[id^="v-used"]').forEach(el => el.textContent = d.usedBuf + 'm used');

            document.querySelectorAll('[id^="v-bar"]').forEach(bar => {
                bar.style.width = '0%';
                setTimeout(() => {
                    bar.style.width = Math.round(d.usedBuf / d.totBuf * 100) + '%';
                }, 50);
            });

            if (!d.rows || !d.rows.length) {
                body.innerHTML = '<tr><td colspan="8" class="ed-att-reveal" style="text-align:center;padding:32px 16px;color:#64748b;font-size:13px">No attendance records for this cycle.</td></tr>';
            } else {
                body.innerHTML = d.rows.map(r => `<tr><td class="dc"><strong>${escHtml(r.d)}</strong><span>${escHtml(r.dy)}</span></td><td>${escHtml(r.ss)}</td><td>${escHtml(r.se)}</td><td><strong>${escHtml(r.it)}</strong></td><td><strong>${escHtml(r.ot)}</strong></td><td>${escHtml(r.h)}</td><td>${escHtml(r.b)}</td><td>${pill(r.s)}</td></tr>`).join('');
            }
            if (window.EDAttendance && typeof window.EDAttendance.renderLegend === 'function') {
                window.EDAttendance.renderLegend(d.summary || null);
            }
            drawCal(m);
            _attDomBuilt = true;
            _attLastCycle = m;
        }
        window.updAtt = updAtt;

        function drawCal(m) {
            const store = window.ATT || {};
            const d = store[m];
            if (!d) return;
            const hd = document.getElementById('cal-hd');
            const grid = document.getElementById('cal-grid');
            if (!grid) return;
            if (hd) {
                hd.classList.remove('ed-skel', 'ed-skel-title');
                if (d.cycleLabel && d.title && d.cycleLabel !== d.title) {
                    // hd.innerHTML = '<div style="font-weight:700">' + d.title + '</div>' +
                    //     '<div style="font-size:11px;color:#94a3b8;font-weight:500;margin-top:2px">' + d.cycleLabel + '</div>';
                    hd.innerHTML =
                        '<div style="font-size:11px;color:rgba(45, 56, 79, 0.88);font-weight:bold;margin-top:2px">' + d.cycleLabel + '</div>';
                } else {
                    hd.textContent = d.cycleLabel || d.title;
                }
            }
            grid.innerHTML = '';
            for (let i = 0; i < d.offset; i++) {
                const el = document.createElement('div');
                el.className = 'cal-cell cal-e';
                grid.appendChild(el);
            }
            const cells = (d.cal && d.cal.cells) ? d.cal.cells : [];
            const totalDays = d.totalDays || d.days || cells.length;
            for (let i = 0; i < totalDays; i++) {
                const day = cells[i];
                const el = document.createElement('div');
                const displayNum = day ? day.display_day : (i + 1);
                if (!day || day.is_future || !day.s) {
                    el.className = 'cal-cell cal-f';
                    el.textContent = displayNum;
                } else {
                    const sc = 'c-' + day.s.toLowerCase().replace(/\s+/g, '-');
                    el.className = 'cal-cell ' + sc;
                    el.textContent = displayNum;
                    el.onclick = () => showDayPop(day, d.cycleLabel || d.title, el);
                }
                grid.appendChild(el);
            }
            const pop = document.getElementById('cal-popup');
            if (pop) pop.innerHTML = '';
        }

        function showDayPop(day, title, el) {
            document.querySelectorAll('.cal-cell.selected').forEach(c => c.classList.remove('selected'));
            el.classList.add('selected');
            let buf = '—';
            if (day.i && day.s !== 'Weekend' && day.s !== 'Holiday' && day.s !== 'Leave' && day.s !== 'Absent') {
                const p = day.i.split(' ');
                const hm = p[0].split(':').map(Number);
                let m = hm[0] * 60 + hm[1];
                if (p[1] === 'PM' && hm[0] !== 12) m += 720;
                if (p[1] === 'AM' && hm[0] === 12) m -= 720;
                buf = Math.max(0, 60 - Math.max(0, m - 540)) + 'm';
            }
            const year = day.date ? day.date.split('-')[0] : '';
            const dateDisplay = day.month_label ?
                day.month_label + ' ' + day.display_day + (year ? ', ' + year : '') :
                (day.date || title);

            // Find nearest popup container
            const popCont = el.closest('.cal-wrap').querySelector('[id^="cal-popup"]') || document.getElementById('cal-popup');

            popCont.innerHTML = `
    <div class="day-popup">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
        <div style="display:flex;align-items:center;gap:8px"><span style="font-size:13px;font-weight:700;color:#1a202c">${escHtml(dateDisplay)}</span>${pill(day.s || '—')}</div>
        <button onclick="closePop()" style="background:none;border:none;cursor:pointer;color:#9ca3af;font-size:12px"><i class="fa fa-times"></i></button>
      </div>
      <div class="det-grid">
        <div class="det-box"><i class="fa fa-right-to-bracket" style="color:#22c55e;font-size:13px"></i><div style="font-size:9px;font-weight:700;text-transform:uppercase;color:#9ca3af;letter-spacing:.06em;margin-top:4px">IN TIME</div><div style="font-size:13px;font-weight:700;color:#1a202c;margin-top:2px">${escHtml(day.i||'—')}</div></div>
        <div class="det-box"><i class="fa fa-right-from-bracket" style="color:#f97316;font-size:13px"></i><div style="font-size:9px;font-weight:700;text-transform:uppercase;color:#9ca3af;letter-spacing:.06em;margin-top:4px">OUT TIME</div><div style="font-size:13px;font-weight:700;color:#1a202c;margin-top:2px">${escHtml(day.o||'—')}</div></div>
        <div class="det-box"><i class="fa fa-hourglass-half" style="color:#3b82f6;font-size:13px"></i><div style="font-size:9px;font-weight:700;text-transform:uppercase;color:#9ca3af;letter-spacing:.06em;margin-top:4px">BUFFER</div><div style="font-size:13px;font-weight:700;color:#1a202c;margin-top:2px">${escHtml(buf)}</div></div>
      </div>
    </div>`;
        }

        function closePop() {
            document.querySelectorAll('.cal-cell.selected').forEach(c => c.classList.remove('selected'));
            document.querySelectorAll('[id^="cal-popup"]').forEach(p => p.innerHTML = '');
        }

        // ═══════════════════════════════════════
        // TIMELINE
        // ═══════════════════════════════════════
        function drawTimeline() {
            const el = document.getElementById('tl-wrap');
            if (!el) return;
            el.innerHTML = '<div class="tl-vline"></div>' + TL.map(t => `
    <div class="tl-node">
      <div class="tl-dot" style="background:${t.c};border-color:${t.c};box-shadow:0 0 0 3px ${t.c}22"></div>
      <div style="width:22px;height:22px;border-radius:5px;background:#f8fafc;border:1px solid #e5e7eb;display:flex;align-items:center;justify-content:center;flex-shrink:0"><i class="fa ${t.icon}" style="font-size:10px;color:#6b7280"></i></div>
      <div style="flex:1;min-width:0">
        <div style="display:flex;align-items:center;gap:6px"><span style="font-size:12px;font-weight:700;color:#1a202c">${escHtml(t.title)}</span>${t.now?'<span style="font-size:8px;font-weight:700;text-transform:uppercase;padding:1px 5px;border-radius:99px;background:#eff6ff;color:#2563eb;letter-spacing:.04em">Now</span>':''}</div>
        <div style="font-size:10px;color:#9ca3af;margin-top:1px">${escHtml(t.date)} · ${escHtml(t.desc)}</div>
      </div>
    </div>`).join('');
        }

        function formatDutyShift(row) {
            if (window.EDDutyExchange && typeof window.EDDutyExchange.formatDutyShift === 'function') {
                return window.EDDutyExchange.formatDutyShift(row);
            }
            const name = row.shift_name || '—';
            const campus = row.campus ? ' · ' + row.campus : '';
            if (row.duty_type === 'special' && row.total_hours) {
                return name + ' (' + row.total_hours + ' hrs)' + campus;
            }
            if (row.duty_start && row.duty_end) {
                return name + ' (' + row.duty_start + '–' + row.duty_end + ')' + campus;
            }
            return name + campus;
        }

        function dutyTypeLabel(row) {
            return row.duty_type_label || (row.duty_type === 'special' ? 'Special duty' : 'Regular duty');
        }

        function dutyStatusPill(row) {
            if (row.button_state === 'pending') return pill('Exchange Pending');
            if (row.duty_type === 'special') {
                const ds = String(row.duty_status || '').trim();
                if (ds) {
                    return pill(ds.charAt(0).toUpperCase() + ds.slice(1));
                }
            }
            return pill('Scheduled');
        }

        function escHtml(value) {
            return String(value == null ? '' : value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        function escAttr(value) {
            return escHtml(value).replace(/'/g, '&#39;');
        }

        // ═══════════════════════════════════════
        // DUTY EXCHANGE
        // ═══════════════════════════════════════
        function dChip(tab, el) {
            document.querySelectorAll('#t-duty .chip').forEach(c => c.classList.remove('active'));
            el.classList.add('active');
            ['my-duties', 'exchange-requests', 'history'].forEach(t => document.getElementById('dp-' + t).style.display = t === tab ? 'block' : 'none');
            if (tab === 'history' && window.EDDutyExchange) {
                window.EDDutyExchange.onHistoryTab();
            }
        }

        function formatExchangeWith(row) {
            const name = row.exchange_to_name || '';
            const bioId = row.exchange_to || '';
            if (name && bioId) {
                return `<div style="font-weight:600;color:#1a202c">${name}</div><div style="font-size:11px;color:#9ca3af;font-weight:600">${bioId}</div>`;
            }
            if (name) return `<div style="font-weight:600;color:#1a202c">${name}</div>`;
            if (bioId) return `<div style="font-weight:600;color:#1a202c">${bioId}</div>`;
            return '—';
        }

        function formatExchangeFrom(row) {
            const name = row.exchange_from_name || '';
            const bioId = row.exchange_from || '';
            if (name && bioId) {
                return `<div style="font-weight:600;color:#1a202c">${name}</div><div style="font-size:11px;color:#9ca3af;font-weight:600">${bioId}</div>`;
            }
            if (name) return `<div style="font-weight:600;color:#1a202c">${name}</div>`;
            if (bioId) return `<div style="font-weight:600;color:#1a202c">${bioId}</div>`;
            return '—';
        }

        function drawDuties() {
            const store = window.ED_DUTY || {};
            const rows = store.upcoming || [];
            const outgoing = store.outgoing_pending || [];
            const body = document.getElementById('duty-body');
            if (!body) return;

            if (!store.loaded) {
                body.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:28px 16px;color:#94a3b8;font-size:13px">Loading duties...</td></tr>';
            } else if (!rows.length) {
                body.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:32px 16px;color:#9ca3af;font-size:13px">No duties in current cycle.</td></tr>';
            } else {
                body.innerHTML = rows.map(r => {
                    const isExchangePending = r.button_state === 'pending';
                    const canEx = !!r.can_exchange && !isExchangePending;
                    const shiftLabel = formatDutyShift(r);
                    const date = escAttr(r.shift_date);
                    const shift = escAttr(r.shift_name);
                    const campus = escAttr(r.campus || '');
                    const dutyType = escAttr(r.duty_type || 'regular');
                    const typeLabel = dutyTypeLabel(r);
                    return `<tr><td><strong style="color:#1a202c">${r.shift_date}</strong></td><td style="color:#9ca3af">${r.day_label || '—'}</td><td>${pill(typeLabel)}</td><td style="color:#4a5568">${shiftLabel}</td><td>${dutyStatusPill(r)}</td><td><button onclick="openEx('${date}','${shift}','${campus}','${dutyType}')" ${canEx ? '' : 'disabled'} style="padding:4px 14px;border-radius:99px;font-size:11.5px;font-weight:700;cursor:${canEx ? 'pointer' : 'not-allowed'};background:${canEx ? 'linear-gradient(180deg,#5082b8,#2d5f96)' : '#f1f5f9'};color:${canEx ? '#fff' : '#9ca3af'};border:1.5px solid ${canEx ? '#1e4e82' : '#d1d5db'};opacity:${canEx ? 1 : 0.5};transition:all .18s">Exchange</button></td></tr>`;
                }).join('');
            }

            const w = document.getElementById('pend-wrap');
            if (!w) return;
            if (!outgoing.length) {
                w.innerHTML = '<p style="font-size:12px;color:#9ca3af;text-align:center;padding:12px 0">No pending requests</p>';
                return;
            }
            w.innerHTML = outgoing.map(p => `<div class="preq"><div style="display:flex;justify-content:space-between;align-items:flex-start;gap:6px;margin-bottom:3px"><div><div style="font-size:11px;font-weight:700;text-transform:uppercase;color:#9ca3af;letter-spacing:.04em;margin-bottom:2px">Exchange with</div>${formatExchangeWith(p)}</div>${pill('Pending')}</div><div style="font-size:11px;color:#6b7280">${pill(dutyTypeLabel(p))} · ${p.shift_date} · ${formatDutyShift(p)}</div></div>`).join('');
        }
        window.drawDuties = drawDuties;

        function renderRequestAvatar(row) {
            const name = row.exchange_from_name || '';
            const bioId = row.exchange_from || '';
            const initial = (name || bioId || '?').charAt(0).toUpperCase();
            const imgUrl = row.exchange_from_profile_img_url || '';
            if (imgUrl) {
                const safeUrl = escAttr(imgUrl);
                const safeName = escAttr(name || bioId);
                return `<img src="${safeUrl}" alt="${safeName}" style="width:100%;height:100%;object-fit:cover" onerror="this.style.display='none';this.parentElement.innerHTML='<span style=\\'font-size:16px;font-weight:700;color:#4f46e5\\'>${initial}</span>'">`;
            }
            return `<span style="font-size:16px;font-weight:700;color:#4f46e5">${initial}</span>`;
        }

        function drawXchg() {
            const store = window.ED_DUTY || {};
            const incoming = store.incoming || [];
            const row = document.getElementById('xchg-row');
            if (!row) return;

            if (!store.loaded) {
                row.innerHTML = '<div class="col-12"><div class="card p-5 text-center"><p style="font-size:13px;color:#94a3b8">Loading requests...</p></div></div>';
                return;
            }
            if (!incoming.length) {
                row.innerHTML = '<div class="col-12"><div class="card p-5 text-center"><i class="fa fa-check-circle fa-2x" style="color:#22c55e;margin-bottom:12px;display:block"></i><p style="font-size:15px;font-weight:700;color:#374151">All caught up!</p><p style="font-size:13px;color:#9ca3af">No pending exchange requests</p></div></div>';
                return;
            }
            row.innerHTML = incoming.map(r => {
                const empName = r.exchange_from_name || '—';
                const bioId = r.exchange_from || '—';
                const exFrom = escAttr(r.exchange_from);
                const exDate = escAttr(r.shift_date);
                const exCampus = escAttr(r.campus || '');
                const exDutyType = escAttr(r.duty_type || 'regular');
                const typeLabel = dutyTypeLabel(r);
                const cardId = 'xcard-' + exFrom + '-' + exDate.replace(/[^a-zA-Z0-9]/g, '');
                return `
    <div class="col-12 col-md-6 col-xl-4" id="${cardId}">
      <div class="xcard">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px">
          <div style="width:46px;height:46px;border-radius:50%;overflow:hidden;border:2px solid #e5e7eb;flex-shrink:0;background:linear-gradient(135deg,#e0e7ff,#c7d2fe);display:flex;align-items:center;justify-content:center">${renderRequestAvatar(r)}</div>
          <div>
            <div style="font-size:14px;font-weight:700;color:#1a202c">${empName}</div>
            <div style="font-size:11px;color:#9ca3af;font-weight:600">${bioId}</div>
            <div style="font-size:10px;color:#cbd5e1;margin-top:2px">Duty exchange request · ${typeLabel}</div>
          </div>
        </div>
        <div class="row g-2 mb-3">
          <div class="col-12"><div style="background:#f8fafc;border:1px solid #e8edf4;border-radius:8px;padding:10px"><div style="font-size:9px;font-weight:700;text-transform:uppercase;color:#9ca3af;letter-spacing:.04em;margin-bottom:4px">Duty Date</div><div style="font-size:12px;font-weight:700;color:#1a202c">${r.shift_date}</div><div style="font-size:11px;color:#6b7280">${formatDutyShift(r)}</div></div></div>
        </div>
        <div style="display:flex;gap:8px;padding-top:12px;border-top:1px solid #f0f4f8">
          <button class="xchg-act-btn" data-action="reject" onclick="rejXchg('${exFrom}','${exDate}','${exCampus}','${exDutyType}')" style="flex:1;padding:8px;border-radius:8px;font-size:12px;font-weight:700;background:#fff;border:1.5px solid #fca5a5;color:#ef4444;cursor:pointer">Reject</button>
          <button class="xchg-act-btn" data-action="approve" onclick="appXchg('${exFrom}','${exDate}','${exCampus}','${exDutyType}')" style="flex:1;padding:8px;border-radius:8px;font-size:12px;font-weight:700;background:linear-gradient(180deg,#4ade80,#22c55e);border:1.5px solid #16a34a;color:#fff;cursor:pointer">Approve</button>
        </div>
      </div>
    </div>`;
            }).join('');
        }
        window.drawXchg = drawXchg;

        function drawHist() {
            const store = window.ED_DUTY || {};
            const entries = store.history || [];
            const body = document.getElementById('hist-body');
            if (!body) return;

            if (!store.historyLoaded) {
                body.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:28px 16px;color:#94a3b8;font-size:13px">Loading history...</td></tr>';
                return;
            }
            if (!entries.length) {
                body.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:32px 16px;color:#9ca3af;font-size:13px">No exchange history found.</td></tr>';
                return;
            }
            body.innerHTML = entries.map(e => `<tr><td style="color:#4a5568">${e.shift_date}</td><td>${formatExchangeWith(e)}</td><td>${pill(dutyTypeLabel(e))}</td><td>${pill(e.status || '—')}</td><td style="color:#9ca3af">${e.shift_date}</td></tr>`).join('');
        }
        window.drawHist = drawHist;

        function openEx(shiftDate, shiftName, campus, dutyType) {
            const type = dutyType || 'regular';
            const typeLabel = type === 'special' ? 'Special duty' : 'Regular duty';
            window.selDutyDuty = {
                shift_date: shiftDate,
                shift_name: shiftName,
                campus: campus || '',
                duty_type: type
            };
            document.getElementById('ex-date').textContent = shiftDate;
            document.getElementById('ex-type').textContent = typeLabel;
            document.getElementById('ex-shift').textContent = shiftName;
            document.getElementById('ex-with').value = '';
            document.getElementById('ex-reason').value = '';
            document.getElementById('ex-bg').classList.add('open');
            if (window.EDDutyExchange) {
                window.EDDutyExchange.loadContext();
            }
        }

        function closeEx() {
            document.getElementById('ex-bg').classList.remove('open')
        }

        function setXchgBusy(busy) {
            document.querySelectorAll('.xchg-act-btn').forEach(function(btn) {
                btn.disabled = !!busy;
                btn.style.opacity = busy ? '0.55' : '1';
                btn.style.pointerEvents = busy ? 'none' : 'auto';
            });
        }

        function subEx() {
            const wv = document.getElementById('ex-with').value;
            const submitBtn = document.querySelector('#ex-bg .btn-pri');
            if (!wv || !window.selDutyDuty || !window.EDDutyExchange) return;
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.textContent = 'Sending...';
            }
            window.EDDutyExchange.submit(
                    window.selDutyDuty.shift_date,
                    window.selDutyDuty.shift_name,
                    wv,
                    window.selDutyDuty.campus,
                    window.selDutyDuty.duty_type || 'regular'
                )
                .then(function() {
                    closeEx();
                })
                .catch(function(err) {
                    if (window.EDToast) window.EDToast.error(err.message || 'Failed to submit exchange request.');
                })
                .finally(function() {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.textContent = 'Submit';
                    }
                });
        }

        function appXchg(exchangeFrom, shiftDate, campus, dutyType) {
            if (!window.EDDutyExchange) return;
            setXchgBusy(true);
            window.EDDutyExchange.respond(exchangeFrom, shiftDate, 'approve', campus, dutyType || 'regular')
                .catch(function(err) {
                    if (window.EDToast) window.EDToast.error(err.message || 'Failed to approve request.');
                })
                .finally(function() {
                    setXchgBusy(false);
                });
        }

        function rejXchg(exchangeFrom, shiftDate, campus, dutyType) {
            if (!window.EDDutyExchange) return;
            setXchgBusy(true);
            window.EDDutyExchange.respond(exchangeFrom, shiftDate, 'reject', campus, dutyType || 'regular')
                .catch(function(err) {
                    if (window.EDToast) window.EDToast.error(err.message || 'Failed to reject request.');
                })
                .finally(function() {
                    setXchgBusy(false);
                });
        }

        // ═══════════════════════════════════════
        // LEAVE
        // ═══════════════════════════════════════
        function setDt(t) {
            if (window.EDLeave && typeof window.EDLeave.setDayType === 'function') {
                window.EDLeave.setDayType(t);
                return;
            }
            document.getElementById('dtf').classList.toggle('active', t === 'full');
            document.getElementById('dth').classList.toggle('active', t === 'half');
            document.getElementById('dt-ind').style.left = t === 'full' ? '3px' : 'calc(50%)';
            document.getElementById('sess-row').style.display = t === 'half' ? 'block' : 'none';
        }

        function lvTab(tab, btn) {
            document.querySelectorAll('.lv-tab').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            var histPane = document.getElementById('lv-hist-pane');
            var logsPane = document.getElementById('lv-logs-pane');
            if (histPane) histPane.style.display = tab === 'hist' ? 'flex' : 'none';
            if (logsPane) logsPane.style.display = tab === 'logs' ? 'flex' : 'none';
            if (tab === 'logs' && window.EDLeave) {
                window.EDLeave.onLogsTab();
            }
        }

        function subLeave() {
            if (window.EDLeave) {
                window.EDLeave.submitApplication();
            }
        }

        // ═══════════════════════════════════════
        // APPROVALS
        // ═══════════════════════════════════════
        function apprCategoryCount(catId, pendingCounts) {
            const pending = pendingCounts || getApprovalAccess().pendingCounts || {};
            const map = {
                purchase: 'purchase',
                'project-handover': 'projectHandover',
                payment: 'payment',
                consumable: 'consumable',
                scrape: 'scrape',
                scrapDispatch: 'scrapDispatch',
                equipment: 'equipment',
                'equipment-edit': 'equipmentEdit',
                service: 'service',
                leave: 'leave',
                substitute: 'substitute',
                'overall-project': 'project',
                event: 'event',
                claim: 'claim',
                privilege: 'privilege'
            };

            if (catId === 'overall-project') {
                return 0;
            }

            const key = map[catId];
            const serverCount = (key && typeof pending[key] === 'number') ? pending[key] : 0;

            // Prefer live module counts only after that module has loaded data.
            if (catId === 'purchase' && window.EDPurchaseApproval && window.ED_PURCHASE && window.ED_PURCHASE.loaded) {
                return window.EDPurchaseApproval.getPendingCount();
            }
            if (catId === 'payment' && window.EDPaymentApproval && window.ED_PAYMENT && window.ED_PAYMENT.loaded) {
                return window.EDPaymentApproval.getPendingCount();
            }
            if (catId === 'consumable' && window.EDConsumableApproval && window.EDConsumableApproval.isLoaded && window.EDConsumableApproval.isLoaded()) {
                return window.EDConsumableApproval.getPendingCount();
            }
            if (catId === 'leave' && window.EDLeaveApproval && window.ED_LEAVE_APPROVAL && window.ED_LEAVE_APPROVAL.loaded) {
                return window.EDLeaveApproval.getPendingCount();
            }
            if (catId === 'substitute' && window.EDSubstituteApproval && window.ED_SUBSTITUTE_APPROVAL && window.ED_SUBSTITUTE_APPROVAL.loaded) {
                return window.EDSubstituteApproval.getPendingCount();
            }
            if (catId === 'event' && window.EDEventApproval && window.EDEventApproval.isLoaded && window.EDEventApproval.isLoaded()) {
                return window.EDEventApproval.getPendingCount();
            }
            if (catId === 'claim' && window.EDClaimApproval && window.EDClaimApproval.isLoaded && window.EDClaimApproval.isLoaded()) {
                return window.EDClaimApproval.getPendingCount();
            }
            if (catId === 'privilege' && window.EDPrivilegeApproval && window.ED_PRIVILEGE_APPROVAL && window.ED_PRIVILEGE_APPROVAL.loaded) {
                return window.EDPrivilegeApproval.getPendingCount();
            }
            if (catId === 'equipment' && window.EDEquipmentApproval) {
                return window.EDEquipmentApproval.getPendingCount();
            }
            if (catId === 'equipment-edit' && window.EDEquipmentEditApproval) {
                return window.EDEquipmentEditApproval.getPendingCount();
            }
            if (catId === 'scrape' && window.EDScrapeApproval && window.ED_SCRAPE && window.ED_SCRAPE.loaded) {
                return (window.ED_SCRAPE.counts && window.ED_SCRAPE.counts.pending) || 0;
            }

            return serverCount;
        }

        function onApprFilterChange() {
            syncApprSearchToState(selCat);
            if (selCat === 'purchase' && window.EDPurchaseApproval) {
                window.EDPurchaseApproval.onFilterChange();
                return;
            }
            if (selCat === 'payment' && window.EDPaymentApproval) {
                window.EDPaymentApproval.onFilterChange();
                return;
            }
            if (selCat === 'consumable' && window.EDConsumableApproval) {
                window.EDConsumableApproval.onFilterChange();
                return;
            }
            if (selCat === 'leave' && window.EDLeaveApproval) {
                window.EDLeaveApproval.onFilterChange();
                return;
            }
            if (selCat === 'substitute' && window.EDSubstituteApproval) {
                window.EDSubstituteApproval.onFilterChange();
                return;
            }
            if (selCat === 'overall-project' && window.EDOverallProjectApproval) {
                window.EDOverallProjectApproval.onFilterChange();
                return;
            }
            if (selCat === 'event' && window.EDEventApproval) {
                window.EDEventApproval.onFilterChange();
                return;
            }
            if (selCat === 'claim' && window.EDClaimApproval) {
                return;
            }
            if (selCat === 'privilege' && window.EDPrivilegeApproval) {
                window.EDPrivilegeApproval.onFilterChange();
                return;
            }
            if (selCat === 'equipment' && window.EDEquipmentApproval) {
                window.EDEquipmentApproval.onFilterChange();
                return;
            }
            if (selCat === 'equipment-edit' && window.EDEquipmentEditApproval) {
                window.EDEquipmentEditApproval.onFilterChange();
                return;
            }
            if (selCat === 'scrape' && window.EDScrapeApproval) {
                window.EDScrapeApproval.onFilterChange();
                return;
            }
        }

        function refreshSidebarApprovalsBadge() {
            const acc = getApprovalAccess();
            const pending = acc.pendingCounts || {};
            let total = 0;
            getVisibleCats().forEach(function(c) {
                if (c.showPendingBadge === false) return;
                total += apprCategoryCount(c.id, pending);
            });
            let badge = document.getElementById('sidebar-approvals-badge');
            const sidebarItem = document.querySelector('.sitem[data-page="approvals"]');
            if (total > 0) {
                if (!badge && sidebarItem) {
                    badge = document.createElement('div');
                    badge.className = 'snbadge';
                    badge.id = 'sidebar-approvals-badge';
                    sidebarItem.appendChild(badge);
                }
                if (badge) badge.textContent = String(total);
            } else if (badge) {
                badge.remove();
            }
        }

        function refreshApprovalCategoryBadges() {
            const pending = getApprovalAccess().pendingCounts || {};
            const row = document.getElementById('cat-row');
            const sorted = sortCatsByPending(getVisibleCats());
            if (row && sorted.length) {
                CATS = sorted;
                sorted.forEach(function(c) {
                    const tab = row.querySelector('[data-cid="' + c.id + '"]');
                    if (tab) row.appendChild(tab);
                });
            }
            sorted.forEach(function(c) {
                if (c.showPendingBadge === false) return;
                const badge = document.querySelector('[data-cid="' + c.id + '"] .cat-tab-count');
                if (badge) badge.textContent = String(apprCategoryCount(c.id, pending));
            });
            refreshSidebarApprovalsBadge();
        }
        window.refreshSidebarApprovalsBadge = refreshSidebarApprovalsBadge;
        window.refreshApprovalCategoryBadges = refreshApprovalCategoryBadges;

        function refreshSidebarProReviewBadge(count) {
            const sidebarItem = document.querySelector('.sitem[data-page="proReview"]');
            if (!sidebarItem) return;
            let badge = document.getElementById('sidebar-proreview-badge');
            if (typeof count === 'undefined') {
                const acc = getApprovalAccess();
                const pending = acc.pendingCounts || {};
                count = pending.proReview || 0;
            }
            if (count > 0) {
                if (!badge) {
                    badge = document.createElement('div');
                    badge.className = 'snbadge';
                    badge.id = 'sidebar-proreview-badge';
                    sidebarItem.appendChild(badge);
                }
                badge.textContent = String(count);
                badge.style.display = '';
            } else if (badge) {
                badge.style.display = 'none';
            }
        }
        window.refreshSidebarProReviewBadge = refreshSidebarProReviewBadge;

        function toggleApprSplitPanels(cat) {
            const page = document.getElementById('page-approvals');
            const tableShell = document.getElementById('appr-table-shell');
            const eventPanel = document.getElementById('appr-event-panel');
            const claimPanel = document.getElementById('appr-claim-panel');
            const tabToggle = document.getElementById('appr-tab-toggle');
            const opSubtabs = document.getElementById('appr-op-subtabs');
            const ytbPanel = document.getElementById('appr-ytb-panel');
            const isEvent = cat === 'event';
            const isClaim = cat === 'claim';
            const isOverallProject = cat === 'overall-project';
            const isSplit = isEvent || isClaim;
            if (page) page.classList.toggle('appr-split-mode', isSplit);
            if (!isOverallProject) {
                if (opSubtabs) {
                    opSubtabs.classList.remove('is-visible');
                    opSubtabs.style.display = 'none';
                    opSubtabs.setAttribute('aria-hidden', 'true');
                }
                if (ytbPanel) ytbPanel.style.display = 'none';
            }
            if (isOverallProject) {
                if (tabToggle) tabToggle.style.display = 'none';
            } else if (!isSplit) {
                if (tableShell) tableShell.style.display = '';
                if (tabToggle) tabToggle.style.display = '';
            } else {
                if (tableShell) tableShell.style.display = 'none';
                if (tabToggle) tabToggle.style.display = 'none';
            }
            if (eventPanel) {
                eventPanel.style.display = isEvent ? 'flex' : 'none';
            }
            if (claimPanel) {
                claimPanel.style.display = isClaim ? 'flex' : 'none';
            }
        }

        function initAppr() {
            window.__edApprBooting = true;
            const acc = getApprovalAccess();
            const pending = acc.pendingCounts || {};
            CATS = sortCatsByPending(getVisibleCats());
            const row = document.getElementById('cat-row');
            const catWrap = document.getElementById('appr-cat-wrap');
            const mainCard = document.getElementById('appr-main-card');
            const emptyState = document.getElementById('appr-empty-state');
            if (!CATS.length) {
                if (row) row.innerHTML = '';
                if (catWrap) catWrap.style.display = 'none';
                if (mainCard) mainCard.style.display = 'none';
                if (emptyState) emptyState.style.display = '';
                window.__edApprBooting = false;
                return;
            }
            if (catWrap) catWrap.style.display = '';
            if (mainCard) mainCard.style.display = '';
            if (emptyState) emptyState.style.display = 'none';

            // Prefer highest-pending category as the active tab (pending tabs are sorted first).
            const firstPending = CATS.find(function(c) {
                return c.showPendingBadge !== false && apprCategoryCount(c.id, pending) > 0;
            });
            var nextCat = selCat;
            if (firstPending) {
                nextCat = firstPending.id;
            } else if (!CATS.some(function(c) {
                    return c.id === selCat;
                })) {
                nextCat = CATS[0].id;
            }

            if (!row) {
                window.__edApprBooting = false;
                return;
            }
            const apprPage = document.getElementById('page-approvals');
            if (apprPage) {
                apprPage.classList.toggle('ed-service-active', nextCat === 'service');
                apprPage.classList.toggle('ed-equipment-edit-active', nextCat === 'equipment-edit');
            }

            row.innerHTML = CATS.map(c => `
    <div class="cat-tab ${c.id===nextCat?'active':''}" onclick="selCatFn('${c.id}')" data-cid="${c.id}">
      <div class="cat-icon" style="background:linear-gradient(135deg,${c.ic}cc,${c.ic}88)"><i class="fa ${c.icon || 'fa-circle'}" aria-hidden="true"></i></div>
      <span class="cat-tab-label" style="font-size:13.5px;font-weight:${c.id===nextCat?'700':'600'};color:${c.id===nextCat?'#fff':'#334155'}">${c.label}</span>
      ${c.showPendingBadge === false ? '' : `<span class="cat-tab-count">${apprCategoryCount(c.id, pending)}</span>`}
    </div>`).join('');
            refreshApprovalCategoryBadges();
            // Activate via normal tab path so module on*Tab / split panels stay correct.
            selCatFn(nextCat);
            window.__edApprBooting = false;
        }

        function selCatFn(cat) {
            if (!window.__edApprBooting) {
                window.__edApprUserChose = true;
            }
            if (selCat === 'equipment' && cat !== 'equipment' && window.EDEquipmentApproval && typeof window.EDEquipmentApproval.leaveEquipmentTab === 'function') {
                window.EDEquipmentApproval.leaveEquipmentTab();
            }
            if (selCat === 'equipment-edit' && cat !== 'equipment-edit' && window.EDEquipmentEditApproval && typeof window.EDEquipmentEditApproval.leaveEquipmentEditTab === 'function') {
                window.EDEquipmentEditApproval.leaveEquipmentEditTab();
            }
            syncApprSearchToState(selCat);
            selCat = cat;
            window.selCat = cat;
            const apprPage = document.getElementById('page-approvals');
            if (apprPage) {
                apprPage.classList.toggle('ed-service-active', cat === 'service');
                apprPage.classList.toggle('ed-equipment-edit-active', cat === 'equipment-edit');
            }
            if (cat !== 'event' && cat !== 'claim') restorePaToolbarSearch();
            restoreApprSearchFromState(cat);
            apprTabSt = 'pending';
            window.apprTabSt = apprTabSt;
            const apprPb = document.getElementById('appr-pb');
            const apprHb = document.getElementById('appr-hb');
            if (apprPb) apprPb.classList.add('active');
            if (apprHb) apprHb.classList.remove('active');
            document.querySelectorAll('[data-cid]').forEach(t => {
                const a = t.dataset.cid === cat;
                t.classList.toggle('active', a);
                const label = t.querySelector('.cat-tab-label');
                if (label) {
                    label.style.fontWeight = a ? '700' : '600';
                    label.style.color = a ? '#fff' : '#334155';
                }
            });
            const apprTitle = document.getElementById('appr-title');
            if (apprTitle) apprTitle.textContent = (CATS.find(c => c.id === cat)?.label || cat) + ' Requests';
            if (cat === 'purchase' && window.EDPurchaseApproval) {
                window.EDPurchaseApproval.onPurchaseTab();
            }
            if (cat === 'project-handover' && window.EDCalloffHandover) {
                window.EDCalloffHandover.onHandoverTab();
            }
            if (cat === 'payment' && window.EDPaymentApproval) {
                window.EDPaymentApproval.onPaymentTab();
            }
            if (cat === 'consumable' && window.EDConsumableApproval) {
                window.EDConsumableApproval.onConsumableTab();
            }
            if (cat === 'scrape' && window.EDScrapeApproval) {
                window.EDScrapeApproval.onScrapeTab();
            }
            if (cat === 'scrapDispatch' && window.EDScrapDispatchApproval) {
                window.EDScrapDispatchApproval.renderScrapDispatchTable();
            }
            if (cat === 'leave' && window.EDLeaveApproval) {
                window.EDLeaveApproval.onLeaveTab();
            }
            if (cat === 'substitute' && window.EDSubstituteApproval) {
                window.EDSubstituteApproval.onSubstituteTab();
            }
            if (cat === 'overall-project' && window.EDOverallProjectApproval) {
                window.EDOverallProjectApproval.onOverallProjectTab();
            }
            if (cat === 'event' && window.EDEventApproval) {
                window.EDEventApproval.onEventTab();
            }
            if (cat === 'claim' && window.EDClaimApproval) {
                window.EDClaimApproval.onClaimTab();
            }
            if (cat === 'privilege' && window.EDPrivilegeApproval) {
                window.EDPrivilegeApproval.onPrivilegeTab();
            }
            if (cat === 'equipment' && window.EDEquipmentApproval) {
                window.EDEquipmentApproval.onEquipmentTab();
            }
            if (cat === 'equipment-edit' && window.EDEquipmentEditApproval) {
                window.EDEquipmentEditApproval.onEquipmentEditTab();
            }
            if (cat === 'service' && window.EDServiceApproval) {
                window.EDServiceApproval.onServiceTab();
            }
            toggleApprSplitPanels(cat);
            drawAppr();
        }

        function apprTab(tab) {
            apprTabSt = tab;
            window.apprTabSt = tab;
            const apprPb = document.getElementById('appr-pb');
            const apprHb = document.getElementById('appr-hb');
            if (apprPb) apprPb.classList.toggle('active', tab === 'pending');
            if (apprHb) apprHb.classList.toggle('active', tab === 'history');
            if (selCat === 'purchase' && window.EDPurchaseApproval) {
                window.EDPurchaseApproval.onPurchaseTab();
            }
            if (selCat === 'project-handover' && window.EDCalloffHandover) {
                window.EDCalloffHandover.onHandoverTab();
            }
            if (selCat === 'payment' && window.EDPaymentApproval) {
                window.EDPaymentApproval.onPaymentTab();
            }
            if (selCat === 'consumable' && window.EDConsumableApproval) {
                window.EDConsumableApproval.onConsumableTab();
            }
            if (selCat === 'scrape' && window.EDScrapeApproval) {
                window.EDScrapeApproval.onScrapeTab();
            }
            if (selCat === 'scrapDispatch' && window.EDScrapDispatchApproval) {
                window.EDScrapDispatchApproval.renderScrapDispatchTable();
            }
            if (selCat === 'leave' && window.EDLeaveApproval) {
                window.EDLeaveApproval.onLeaveTab();
            }
            if (selCat === 'substitute' && window.EDSubstituteApproval) {
                window.EDSubstituteApproval.onSubstituteTab();
            }
            if (selCat === 'overall-project' && window.EDOverallProjectApproval) {
                window.EDOverallProjectApproval.onOverallProjectTab();
            }
            if (selCat === 'event' && window.EDEventApproval) {
                window.EDEventApproval.onEventTab();
            }
            if (selCat === 'privilege' && window.EDPrivilegeApproval) {
                window.EDPrivilegeApproval.onPrivilegeTab();
            }
            if (selCat === 'equipment' && window.EDEquipmentApproval) {
                window.EDEquipmentApproval.onEquipmentTab();
            }
            if (selCat === 'equipment-edit' && window.EDEquipmentEditApproval) {
                window.EDEquipmentEditApproval.onEquipmentEditTab();
            }
            if (selCat === 'service' && window.EDServiceApproval) {
                window.EDServiceApproval.onServiceTab();
            }
            drawAppr();
        }

        function drawAppr() {
            toggleApprSplitPanels(selCat);
            if (selCat === 'purchase' && window.EDPurchaseApproval && window.EDPurchaseApproval.renderPurchaseTable()) {
                return;
            }
            if (selCat === 'project-handover' && window.EDCalloffHandover && window.EDCalloffHandover.renderTable()) {
                return;
            }
            if (selCat === 'payment' && window.EDPaymentApproval && window.EDPaymentApproval.renderPaymentTable()) {
                return;
            }
            if (selCat === 'consumable' && window.EDConsumableApproval && window.EDConsumableApproval.renderConsumableTable()) {
                return;
            }
            if (selCat === 'scrape' && window.EDScrapeApproval && window.EDScrapeApproval.renderScrapeTable()) {
                return;
            }
            if (selCat === 'scrapDispatch' && window.EDScrapDispatchApproval && window.EDScrapDispatchApproval.renderScrapDispatchTable()) {
                return;
            }
            if (selCat === 'leave' && window.EDLeaveApproval && window.EDLeaveApproval.renderLeaveTable()) {
                return;
            }
            if (selCat === 'substitute' && window.EDSubstituteApproval && window.EDSubstituteApproval.renderSubstituteTable()) {
                return;
            }
            if (selCat === 'overall-project' && window.EDOverallProjectApproval && window.EDOverallProjectApproval.renderOverallProjectTable()) {
                return;
            }
            if (selCat === 'event' && window.EDEventApproval && window.EDEventApproval.renderEventTable()) {
                return;
            }
            if (selCat === 'claim' && window.EDClaimApproval && window.EDClaimApproval.renderClaimTable()) {
                return;
            }
            if (selCat === 'privilege' && window.EDPrivilegeApproval && window.EDPrivilegeApproval.renderPrivilegeTable()) {
                return;
            }
            if (selCat === 'equipment' && window.EDEquipmentApproval && window.EDEquipmentApproval.renderEquipmentTable()) {
                return;
            }
            if (selCat === 'equipment-edit' && window.EDEquipmentEditApproval && window.EDEquipmentEditApproval.renderEquipmentEditTable()) {
                return;
            }
            if (selCat === 'service' && window.EDServiceApproval && window.EDServiceApproval.renderServiceTable()) {
                return;
            }
            if (selCat === 'purchase' || selCat === 'project-handover' || selCat === 'payment' || selCat === 'consumable' || selCat === 'scrape' || selCat === 'scrapDispatch' || selCat === 'leave' || selCat === 'substitute' || selCat === 'overall-project' || selCat === 'event' || selCat === 'claim' || selCat === 'equipment' || selCat === 'equipment-edit' || selCat === 'service' || selCat === 'privilege') {
                const paToolbar = document.getElementById('pa-toolbar');
                if (paToolbar) paToolbar.classList.remove('is-visible');
                const body = document.getElementById('appr-body');
                if (body) {
                    body.innerHTML = '<tr class="pa-skel-row"><td><span class="ed-skel ed-skel-cell w-sm"></span></td><td><span class="ed-skel ed-skel-cell w-md"></span></td><td><span class="ed-skel ed-skel-cell w-lg"></span></td><td><span class="ed-skel ed-skel-cell w-md"></span></td><td><span class="ed-skel ed-skel-cell w-md"></span></td><td><span class="ed-skel ed-skel-cell w-sm"></span></td><td><span class="ed-skel ed-skel-cell w-sm"></span></td><td><span class="ed-skel ed-skel-cell w-sm"></span></td></tr>' +
                        '<tr class="pa-skel-row"><td><span class="ed-skel ed-skel-cell w-sm"></span></td><td><span class="ed-skel ed-skel-cell w-md"></span></td><td><span class="ed-skel ed-skel-cell w-lg"></span></td><td><span class="ed-skel ed-skel-cell w-md"></span></td><td><span class="ed-skel ed-skel-cell w-md"></span></td><td><span class="ed-skel ed-skel-cell w-sm"></span></td><td><span class="ed-skel ed-skel-cell w-sm"></span></td><td><span class="ed-skel ed-skel-cell w-sm"></span></td></tr>' +
                        '<tr class="pa-skel-row"><td><span class="ed-skel ed-skel-cell w-sm"></span></td><td><span class="ed-skel ed-skel-cell w-md"></span></td><td><span class="ed-skel ed-skel-cell w-lg"></span></td><td><span class="ed-skel ed-skel-cell w-md"></span></td><td><span class="ed-skel ed-skel-cell w-md"></span></td><td><span class="ed-skel ed-skel-cell w-sm"></span></td><td><span class="ed-skel ed-skel-cell w-sm"></span></td><td><span class="ed-skel ed-skel-cell w-sm"></span></td></tr>';
                }
                return;
            }
            const paToolbar = document.getElementById('pa-toolbar');
            if (paToolbar) paToolbar.classList.remove('is-visible');
            const apprHead = document.getElementById('appr-head');
            const apprBody = document.getElementById('appr-body');
            if (!apprHead || !apprBody) return;
            const data = apprTabSt === 'pending' ? APPR_D[selCat] || [] : apprHist.filter(a => a._cat === selCat);
            const hasA = data.length > 0 && data[0].amt;
            apprHead.innerHTML = `<tr><th>REQUESTER</th><th>DETAILS</th>${hasA?'<th>AMOUNT</th>':''}<th>DATE</th><th>${apprTabSt==='history'?'STATUS':'ACTIONS'}</th></tr>`;
            if (!data.length) {
                apprBody.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:32px;color:#9ca3af;font-size:13px">${apprTabSt==='history'?'No history found':'No pending requests'}</td></tr>`;
                return;
            }
            apprBody.innerHTML = data.map(a => `<tr>
    <td><div style="display:flex;align-items:center;gap:9px"><div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#e0e7ff,#c7d2fe);display:flex;align-items:center;justify-content:center;flex-shrink:0"><span style="font-size:11px;font-weight:700;color:#4f46e5">${escHtml((a.req || '').charAt(0))}</span></div><div><div style="font-size:13px;font-weight:700;color:#1a202c">${escHtml(a.req)}</div><div style="font-size:11px;color:#9ca3af">${escHtml(a.dept||'')}</div></div></div></td>
    <td><div style="font-size:13px;color:#374151">${escHtml(a.det)}</div>${a.reason?`<div style="font-size:11px;font-style:italic;color:#9ca3af;margin-top:2px">"${escHtml(a.reason)}"</div>`:''}</td>
    ${hasA?`<td><strong style="color:#2563eb">${escHtml(a.amt||'—')}</strong></td>`:''}
    <td style="font-size:12px;color:#9ca3af;white-space:nowrap"><i class="fa fa-clock fa-xs me-1"></i>${escHtml(a.date)}</td>
    <td>${apprTabSt==='history'?'<span class="sp sp-approved"><i class="fa fa-check-circle" style="font-size:9px;margin-right:3px"></i>Completed</span>':`<div style="display:flex;gap:6px;align-items:center">${selCat==='purchase'?`<button onclick="openBoq('${escAttr(a.id)}')" style="padding:4px 10px;border-radius:6px;font-size:11px;font-weight:700;background:linear-gradient(180deg,#5082b8,#2d5f96);color:#fff;border:1px solid #1e4e82;cursor:pointer">BOQ</button>`:''}<button onclick="openWf('${escAttr(a.id)}')" style="padding:4px 10px;border-radius:6px;font-size:11px;font-weight:700;background:#fff;color:#374151;border:1.5px solid #dde3ef;cursor:pointer"><i class="fa fa-eye fa-xs"></i></button></div>`}</td>
  </tr>`).join('');
        }
        // BOQ
        function openBoq(id) {
            selApprId = id;
            const a = (APPR_D.purchase || []).find(x => x.id === id);
            document.getElementById('boq-sub').textContent = a ? `For: ${a.det} (${a.req})` : '';
            boqRows = [{
                id: 'r1',
                desc: '',
                qty: 1,
                price: 0
            }];
            drawBoqRows();
            new bootstrap.Modal(document.getElementById('boq-modal')).show();
        }

        function addBoqRow() {
            boqRows.push({
                id: 'r' + Date.now(),
                desc: '',
                qty: 1,
                price: 0
            });
            drawBoqRows();
        }

        function rmBoqRow(id) {
            if (boqRows.length > 1) {
                boqRows = boqRows.filter(r => r.id !== id);
                drawBoqRows();
            }
        }

        function boqUpd(id, f, v) {
            const r = boqRows.find(x => x.id === id);
            if (r) {
                r[f] = v;
                boqTot();
            }
        }

        function drawBoqRows() {
            document.getElementById('boq-rows').innerHTML = boqRows.map(r => `
    <div style="display:grid;grid-template-columns:1fr 80px 100px 88px 34px;gap:8px;align-items:center;margin-bottom:8px;background:#fff;padding:8px;border-radius:8px;border:1px solid #e8edf4">
      <input class="boq-inp" type="text" placeholder="Item description..." value="${r.desc}" oninput="boqUpd('${r.id}','desc',this.value)">
      <input class="boq-inp" type="number" min="1" value="${r.qty}" oninput="boqUpd('${r.id}','qty',+this.value)">
      <input class="boq-inp" type="number" min="0" step="0.01" value="${r.price}" oninput="boqUpd('${r.id}','price',+this.value)">
      <span style="font-size:14px;font-weight:700;color:#2563eb">$${(r.qty*r.price).toFixed(2)}</span>
      <button onclick="rmBoqRow('${r.id}')" ${boqRows.length===1?'disabled':''} style="width:32px;height:32px;border-radius:6px;background:${boqRows.length===1?'#f8fafc':'#fef2f2'};color:${boqRows.length===1?'#9ca3af':'#ef4444'};border:1px solid ${boqRows.length===1?'#e2e8f0':'#fca5a5'};cursor:${boqRows.length===1?'not-allowed':'pointer'}"><i class="fa fa-trash fa-xs"></i></button>
    </div>`).join('');
            boqTot();
        }

        function boqTot() {
            document.getElementById('boq-total').textContent = '$' + boqRows.reduce((s, r) => s + r.qty * r.price, 0).toFixed(2);
        }

        function subBoq() {
            const l = document.getElementById('boq-loc').value,
                p = document.getElementById('boq-pay').value;
            if (!l || !p) {
                if (window.EDToast) window.EDToast.warning('Please select location and payment terms.');
                return;
            }
            const a = (APPR_D.purchase || []).find(x => x.id === selApprId);
            if (a) {
                APPR_D.purchase = APPR_D.purchase.filter(x => x.id !== selApprId);
                apprHist.push({
                    ...a,
                    _cat: 'purchase',
                    status: 'BOQ Submitted'
                });
            }
            bootstrap.Modal.getInstance(document.getElementById('boq-modal')).hide();
            drawAppr();
            initAppr();
        }
        // Workflow
        function openWf(id) {
            let a = null;
            for (const k of Object.keys(APPR_D)) {
                const f = APPR_D[k].find(x => x.id === id);
                if (f) {
                    a = f;
                    break;
                }
            }
            if (!a) return;
            document.getElementById('wf-sub').textContent = a.det;
            document.getElementById('wf-req').textContent = a.req;
            document.getElementById('wf-dept').textContent = a.dept || '';
            document.getElementById('wf-amt').textContent = a.amt || '';
            const steps = [{
                    title: 'BOQ Submitted',
                    app: 'System',
                    role: 'Auto',
                    date: 'Mar 22',
                    st: 'done',
                    rem: 'BOQ created and submitted.'
                },
                {
                    title: 'Dept. Head Review',
                    app: 'Sarah Johnson',
                    role: 'Dept. Head',
                    date: 'Mar 23',
                    st: 'done',
                    rem: 'Approved. Budget confirmed.'
                },
                {
                    title: 'Procurement Review',
                    app: 'Richard Lee',
                    role: 'Procurement Mgr',
                    date: null,
                    st: 'pending',
                    rem: 'Awaiting vendor comparison.'
                },
                {
                    title: 'Finance Approval',
                    app: 'Angela Martinez',
                    role: 'Finance Director',
                    date: null,
                    st: 'up'
                },
                {
                    title: 'Final Sign-off & PO',
                    app: 'VP Operations',
                    role: 'VP Ops',
                    date: null,
                    st: 'up'
                },
            ];
            const done = steps.filter(s => s.st === 'done').length;
            document.getElementById('wf-prog').style.width = Math.round(done / steps.length * 100) + '%';
            document.getElementById('wf-cnt').textContent = `${done}/${steps.length}`;
            const pend = steps.find(s => s.st === 'pending');
            document.getElementById('wf-pend').textContent = pend ? `${pend.app} — ${pend.role}` : '';
            const dc = {
                done: {
                    bg: 'linear-gradient(180deg,#4ade80,#22c55e)',
                    border: '#16a34a',
                    icon: 'fa-check'
                },
                pending: {
                    bg: 'linear-gradient(180deg,#fbbf24,#f59e0b)',
                    border: '#d97706',
                    icon: 'fa-clock'
                },
                up: {
                    bg: '#e5e7eb',
                    border: '#d1d5db',
                    icon: 'fa-circle'
                }
            };
            document.getElementById('wf-steps').innerHTML = steps.map((s, i) => {
                const c = dc[s.st];
                return `<div class="wf-step d-flex ${s.st==='up'?'opacity-50':''}"><div class="wf-date">${s.date||'—'}</div><div class="wf-mid"><div class="wf-dot" style="background:${c.bg};border:1.5px solid ${c.border}"><i class="fa ${c.icon}" style="font-size:8px"></i></div>${i<steps.length-1?`<div class="wf-vline ${s.st==='done'?'done':''}"></div>`:''}</div><div class="wf-body"><div style="display:flex;align-items:center;gap:6px"><span style="font-size:12px;font-weight:700;color:#1a202c">${s.title}</span>${s.st==='pending'?'<span style="padding:1px 6px;background:#f59e0b;color:#fff;font-size:8px;font-weight:700;border-radius:99px;text-transform:uppercase">Current</span>':''}</div><div style="font-size:10px;color:#9ca3af;margin-top:1px">${s.app} — ${s.role}</div>${s.rem?`<div style="font-size:10px;color:#9ca3af;margin-top:3px">${s.rem}</div>`:''}</div></div>`;
            }).join('');
            new bootstrap.Modal(document.getElementById('wf-modal')).show();
        }

        // ═══════════════════════════════════════
        // NOTIFICATIONS
        // ═══════════════════════════════════════
        const NS = {
            success: {
                icon: 'fa-check-circle',
                c: '#16a34a',
                b: '#22c55e',
                bg: '#f0fdf4'
            },
            warning: {
                icon: 'fa-triangle-exclamation',
                c: '#d97706',
                b: '#f59e0b',
                bg: '#fffbeb'
            },
            info: {
                icon: 'fa-circle-info',
                c: '#2563eb',
                b: '#3b82f6',
                bg: '#eff6ff'
            },
            event: {
                icon: 'fa-calendar-check',
                c: '#7c3aed',
                b: '#8b5cf6',
                bg: '#f5f3ff'
            }
        };

        function drawNotifs() {
            const unrdLbl = document.getElementById('unrd-lbl');
            const rdLbl = document.getElementById('rd-lbl');
            const unrdList = document.getElementById('unrd-list');
            const rdList = document.getElementById('rd-list');
            if (!unrdLbl || !rdLbl || !unrdList || !rdList) return;

            const ur = notifs.filter(n => !n.read),
                rd = notifs.filter(n => n.read);
            unrdLbl.textContent = `Unread (${ur.length})`;
            rdLbl.textContent = `Read (${rd.length})`;
            const mk = n => {
                const s = NS[n.type];
                return `<div class="nc ${n.read?'read':''}" style="border-left-color:${n.read?'#d1d5db':s.b}"><div style="display:flex;align-items:flex-start;gap:11px"><div class="nc-icon" style="background:${n.read?'#f1f5f9':s.bg}"><i class="fa ${s.icon}" style="color:${n.read?'#9ca3af':s.c}"></i></div><div style="flex:1;min-width:0"><div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px"><h6 style="font-size:13px;font-weight:600;color:${n.read?'#9ca3af':'#1a202c'};margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${escHtml(n.title)}</h6><span style="font-size:11px;color:#9ca3af;white-space:nowrap;flex-shrink:0">${escHtml(n.time)}</span></div><p style="font-size:12px;color:${n.read?'#9ca3af':'#6b7280'};margin:4px 0 5px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical">${escHtml(n.msg)}</p><button onclick="togNR('${escAttr(n.id)}')" style="background:none;border:none;color:#2563eb;font-size:11px;font-weight:600;cursor:pointer;padding:0">${n.read?'Mark as unread':'Mark as read'}</button></div></div></div>`;
            };
            unrdList.innerHTML = ur.length ? ur.map(mk).join('') : '<div class="nc" style="border-left-color:#22c55e"><div style="display:flex;align-items:center;gap:11px"><div class="nc-icon" style="background:#f0fdf4"><i class="fa fa-check-circle" style="color:#22c55e;font-size:17px"></i></div><div><p style="font-size:13px;font-weight:600;color:#1a202c;margin:0">All caught up!</p><p style="font-size:11px;color:#9ca3af;margin:0">No unread notifications</p></div></div></div>';
            rdList.innerHTML = rd.map(mk).join('');
        }

        function togNR(id) {
            const n = notifs.find(x => x.id === id);
            if (n) n.read = !n.read;
            drawNotifs();
        }

        function markAllRd() {
            notifs.forEach(n => n.read = true);
            drawNotifs();
        }

        function togRdSec() {
            rdOpen = !rdOpen;
            const rdList = document.getElementById('rd-list');
            const rdTog = document.getElementById('rd-tog');
            if (!rdList || !rdTog) return;
            rdList.style.display = rdOpen ? 'block' : 'none';
            rdTog.innerHTML = `<i class="fa fa-chevron-${rdOpen?'down':'right'} fa-sm"></i>`;
        }

        // ═══════════════════════════════════════
        // CHATBOT
        // ═══════════════════════════════════════
        function togChat() {
            chatOpen = !chatOpen;
            const cpanel = document.getElementById('cpanel');
            if (cpanel) cpanel.classList.toggle('open', chatOpen);
            const glow = document.getElementById('glow-ring');
            if (glow) glow.style.display = chatOpen ? 'none' : 'block';
            if (chatOpen) {
                drawChat();
                setTimeout(() => {
                    const m = document.getElementById('cmsgs');
                    if (m) m.scrollTop = m.scrollHeight;
                }, 60);
            }
        }

        function drawChat() {
            const msgs = document.getElementById('cmsgs');
            if (!msgs) return;
            msgs.innerHTML = chatMsgs.map(m => `
    <div style="display:flex;flex-direction:column;align-items:${m.s==='user'?'flex-end':'flex-start'}">
      <div style="display:flex;align-items:flex-end;gap:8px;${m.s==='user'?'flex-direction:row-reverse':''}">
        <div style="width:24px;height:24px;border-radius:50%;background:${m.s==='user'?'#e5e7eb':'rgba(99,102,241,.1)'};display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:11px;color:${m.s==='user'?'#6b7280':'#6366f1'};font-weight:900;font-style:italic;font-family:Georgia,serif">${m.s==='user'?'<i class="fa fa-user" style="font-size:9px"></i>':'V'}</div>
        <div class="cbbl ${m.s==='bot'?'cbot':'cuser'}">${escHtml(m.text)}</div>
      </div>
      <span style="font-size:10px;color:#9ca3af;margin-top:3px;padding:0 30px">${escHtml(m.t)}</span>
    </div>`).join('');
            msgs.scrollTop = msgs.scrollHeight;
        }
        const cinpEl = document.getElementById('cinp');
        if (cinpEl) {
            cinpEl.addEventListener('input', function() {
                const sendBtn = document.getElementById('csend');
                if (sendBtn) sendBtn.disabled = !this.value.trim();
            });
        }

        function sendChat() {
            const inp = document.getElementById('cinp'),
                text = inp.value.trim();
            if (!text) return;
            chatMsgs.push({
                text,
                s: 'user',
                t: ts()
            });
            inp.value = '';
            document.getElementById('csend').disabled = true;
            drawChat();
            setTimeout(() => {
                chatMsgs.push({
                    text: "I'm currently a demo assistant, but I've noted your request. A real AI would process this shortly!",
                    s: 'bot',
                    t: ts()
                });
                drawChat();
            }, 900);
        }

        // ═══════════════════════════════════════
        // SETTINGS & MODERN MODE
        // ═══════════════════════════════════════
        function setOpt(opt) {
            const isCustomise = opt === 'customise';
            const isProfile = opt === 'profile';
            const isPassword = opt === 'password';
            const isFoodAppLogs = opt === 'food-app-logs';

            document.querySelectorAll('.set-nav-item').forEach(function(el) {
                el.classList.toggle('active', el.dataset.setOpt === opt);
            });

            const customisePane = document.getElementById('set-pane-customise');
            if (customisePane) customisePane.style.display = isCustomise ? 'block' : 'none';

            const profilePane = document.getElementById('set-pane-profile');
            if (profilePane) profilePane.style.display = isProfile ? 'block' : 'none';

            const passwordPane = document.getElementById('set-pane-password');
            if (passwordPane) passwordPane.style.display = isPassword ? 'block' : 'none';

            const foodAppLogsPane = document.getElementById('set-pane-food-app-logs');
            if (foodAppLogsPane) foodAppLogsPane.style.display = isFoodAppLogs ? 'block' : 'none';

            if (isCustomise) {
                hydrateSettingsUi();
            }

            if (isProfile && window.EDProfile && typeof window.EDProfile.onSettingsTab === 'function') {
                window.EDProfile.onSettingsTab('profile');
            }
        }

        const DEFAULT_THEME_URL = '/images/themes/dark-forest.webp';

        function defaultThemeIndex() {
            const idx = THEMES.findIndex((t) => t.u === DEFAULT_THEME_URL);
            return idx >= 0 ? idx : 0;
        }

        function applyDefaultSettingsState() {
            setModeState = 'modern';
            setThemeIdx = defaultThemeIndex();
            setCustomThemeId = null;
            setCustomThemeKey = null;
            setThemeMediaType = 'image';
        }

        const THEMES = [{
