    var loaded = false;
    var formOptionsLoaded = false;
    var isSubmitting = false;

    var state = { rows: [] };
    var filters = { search: '', location: '', category: '', status: '' };
    var formOptions = { locations: [], categories: [] };

    var pendingApprovals = [];
    var pendingSearch = '';
    var currentApprovalIndex = 0;
    var currentFiles = [];
    var currentFileIndex = 0;
    var currentFilesViewed = [];

    var requestModal = null;
    var rejectModal = null;
    var verificationModal = null;
    var auditModal = null;
    var activeAuditClaimId = null;
    var vstepperTimer = null;
    var searchTimer = null;

    var filterSearchSelects = { location: null, category: null, status: null };
    var formSearchSelects = { location: null, category: null };

    function $(id) {
        return document.getElementById(id);
    }

    function esc(s) {
        return String(s == null ? '' : s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function isActive() {
        var page = $('page-claim-request');
        return page && page.classList.contains('active');
    }

    function claimUrl(path) {
        return AJAX_BASE.replace(/\/$/, '') + '/' + String(path || '').replace(/^\//, '');
    }

    function fetchJson(url, options) {
        var opts = options || {};
        opts.credentials = 'same-origin';
        opts.headers = Object.assign({ Accept: 'application/json' }, opts.headers || {});
        return fetch(url, opts).then(function (res) {
            return res.text().then(function (text) {
                var json = null;
                try { json = text ? JSON.parse(text) : null; } catch (e) { json = null; }
                if (!json || typeof json !== 'object') throw new Error('Invalid server response');
                if (!json.success) throw new Error(json.message || json.error || ('Request failed (' + res.status + ')'));
                return json.data;
            });
        });
    }

    function fmtDate(val) {
        if (!val || val === 'Pending') return val === 'Pending' ? 'Pending' : '';
        var d = new Date(val);
        if (isNaN(d.getTime())) return String(val).split(' ')[0];
        return d.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
    }

    function statusBadge(status) {
        var s = String(status || 'Pending');
        var cls = 'cr-status-pending';
        var lower = s.toLowerCase();
        if (lower === 'approved' || lower === 'completed') cls = 'cr-status-approved';
        else if (lower === 'rejected') cls = 'cr-status-rejected';
        return '<span class="cr-status-badge ' + cls + '">' + esc(s) + '</span>';
    }

    function doaBadge(status) {
        if (!status) return '<span class="cr-muted">—</span>';
        var s = String(status);
        var cls = 'cr-doa-pending';
        var lower = s.toLowerCase();
        if (lower === 'approved' || lower === 'completed') cls = 'cr-doa-approved';
        else if (lower === 'rejected') cls = 'cr-doa-rejected';
        return '<span class="cr-doa-badge ' + cls + '">' + esc(s) + '</span>';
    }

    function duplicateBadge(isFlag, pct, matchType, matchedTrackId, claimId) {
        var cidAttr = claimId ? ' data-claim-id="' + esc(String(claimId)) + '"' : '';
        if (isFlag === 1 || isFlag === '1') {
            var p = Math.round(Number(pct) || 0);
            var title = 'Duplicate bill detected (' + p + '% match)';
            if (matchedTrackId) title += ' with ' + matchedTrackId;
            return '<span class="cr-flag-badge cr-flag-dup js-view-dup-report"' + cidAttr + ' title="' + esc(title) + ' — Click to view forensic report">'
                + '<i class="fa fa-triangle-exclamation"></i> Flagged (' + esc(String(p)) + '%)</span>';
        }
        if (isFlag === 0 || isFlag === '0') {
            return '<span class="cr-flag-badge cr-flag-clean js-view-dup-report"' + cidAttr + ' title="Verified unique document (0% duplicate) — Click to view forensic report">'
                + '<i class="fa fa-shield-check"></i> Clean (0%)</span>';
        }
        return '<span class="cr-flag-badge cr-flag-pending js-view-dup-report"' + cidAttr + ' title="Duplicate check in progress — Click to inspect" style="cursor:pointer">'
            + '<i class="fa fa-spinner fa-spin"></i> Checking</span>';
    }

    function renderVerificationStepper(claimTrackId, currentStepIdx, stepsData, verdictData) {
        var listEl = $('cr-vstepper-list');
        var barFill = $('cr-vstepper-progress-fill');
        var resWrap = $('cr-vstepper-result-wrap');
        var doneBtn = $('cr-vstepper-done-btn');
        var viewRepBtn = $('cr-vstepper-view-report-btn');
        var subTitle = $('cr-vstepper-track-subtitle');

        if (subTitle && claimTrackId) {
            subTitle.textContent = 'Verifying Claim: ' + claimTrackId;
        }

        var defaultSteps = [
            { step: 1, title: 'Document received', icon: 'fa-cloud-arrow-up', desc: 'Your uploaded bill is being checked' },
            { step: 2, title: 'Reading bill details', icon: 'fa-file-lines', desc: 'Confirming amounts and document content' },
            { step: 3, title: 'Checking uniqueness', icon: 'fa-magnifying-glass', desc: 'Comparing with earlier claims' },
            { step: 4, title: 'Cross-checking records', icon: 'fa-list-check', desc: 'Looking for matching bills in the same category' },
            { step: 5, title: 'Final result', icon: 'fa-shield-check', desc: 'Preparing your verification result' }
        ];

        if (listEl) {
            listEl.innerHTML = defaultSteps.map(function(s, idx) {
                var stateCls = 'pending';
                var statusTag = '<span class="cr-vstepper-status-tag pending">Waiting</span>';
                var iconHtml = '<i class="fa ' + s.icon + '"></i>';

                if (idx < currentStepIdx) {
                    stateCls = 'completed';
                    iconHtml = '<i class="fa fa-check"></i>';
                    statusTag = '<span class="cr-vstepper-status-tag completed">Done ✓</span>';
                } else if (idx === currentStepIdx) {
                    stateCls = 'running';
                    iconHtml = '<i class="fa fa-spinner fa-spin"></i>';
                    statusTag = '<span class="cr-vstepper-status-tag running">Processing…</span>';
                }

                if (currentStepIdx >= 5 && idx === 4) {
                    if (verdictData && (verdictData.is_flag === 1 || verdictData.is_flag === '1')) {
                        stateCls = 'flagged';
                        iconHtml = '<i class="fa fa-triangle-exclamation"></i>';
                        statusTag = '<span class="cr-vstepper-status-tag flagged">Flagged</span>';
                    } else {
                        stateCls = 'completed';
                        iconHtml = '<i class="fa fa-shield-check"></i>';
                        statusTag = '<span class="cr-vstepper-status-tag completed">Clean ✓</span>';
                    }
                }

                var detailText = s.desc;
                if (stepsData && stepsData[idx] && stepsData[idx].detail) {
                    detailText = stepsData[idx].detail;
                }

                return '<div class="cr-vstepper-item ' + stateCls + '">'
                    + '<div class="cr-vstepper-icon-box">' + iconHtml + '</div>'
                    + '<div class="cr-vstepper-content">'
                    +   '<div class="cr-vstepper-title">'
                    +     '<span>' + esc(s.title) + '</span>'
                    +     statusTag
                    +   '</div>'
                    +   '<div class="cr-vstepper-desc">' + esc(detailText) + '</div>'
                    + '</div>'
                    + '</div>';
            }).join('');
        }

        var pct = Math.min(100, Math.max(8, (currentStepIdx / 5) * 100));
        if (barFill) barFill.style.width = pct + '%';

        if (currentStepIdx >= 5 && verdictData) {
            if (resWrap) {
                resWrap.style.display = 'block';
                var isFlag = (verdictData.is_flag === 1 || verdictData.is_flag === '1');
                var dupPct = Math.round(Number(verdictData.duplicate_percentage) || 0);
                var mTrack = verdictData.matched_track_id || '';

                if (isFlag) {
                    resWrap.innerHTML = '<div class="cr-vresult-card flagged">'
                        + '<div class="cr-vresult-hdr">'
                        +   '<i class="fa fa-triangle-exclamation fa-lg"></i>'
                        +   '<span>Potential Duplicate Bill Detected (' + dupPct + '% Match)</span>'
                        + '</div>'
                        + '<div class="cr-vresult-body">'
                        +   '<div>' + esc(verdictData.summary || 'A matching bill document was detected in the database. Your claim has been submitted and flagged for review.') + '</div>'
                        +   '<div class="cr-vresult-meta-grid">'
                        +     '<div class="cr-vresult-meta-item">'
                        +       '<div class="cr-vresult-meta-label">Claim Track ID</div>'
                        +       '<div class="cr-vresult-meta-val">' + esc(claimTrackId || '—') + '</div>'
                        +     '</div>'
                        +     '<div class="cr-vresult-meta-item">'
                        +       '<div class="cr-vresult-meta-label">Matched Existing Claim</div>'
                        +       '<div class="cr-vresult-meta-val" style="color:#be123c">' + esc(mTrack || 'Previous Claim') + '</div>'
                        +     '</div>'
                        +     '<div class="cr-vresult-meta-item">'
                        +       '<div class="cr-vresult-meta-label">Match Type</div>'
                        +       '<div class="cr-vresult-meta-val">' + esc(verdictData.match_type || 'exact_file') + '</div>'
                        +     '</div>'
                        +     '<div class="cr-vresult-meta-item">'
                        +       '<div class="cr-vresult-meta-label">Risk Level</div>'
                        +       '<div class="cr-vresult-meta-val" style="color:#e11d48">' + esc(verdictData.risk_level || 'High') + '</div>'
                        +     '</div>'
                        +   '</div>'
                        + '</div>'
                        + '</div>';
                } else {
                    resWrap.innerHTML = '<div class="cr-vresult-card clean">'
                        + '<div class="cr-vresult-hdr">'
                        +   '<i class="fa fa-circle-check fa-lg"></i>'
                        +   '<span>Document Verified Unique (0% Duplicate Score)</span>'
                        + '</div>'
                        + '<div class="cr-vresult-body">'
                        +   '<div>' + esc(verdictData.summary || 'No matching bills were found across past claims. Your document is genuine and verified unique.') + '</div>'
                        +   '<div class="cr-vresult-meta-grid">'
                        +     '<div class="cr-vresult-meta-item">'
                        +       '<div class="cr-vresult-meta-label">Claim Track ID</div>'
                        +       '<div class="cr-vresult-meta-val">' + esc(claimTrackId || '—') + '</div>'
                        +     '</div>'
                        +     '<div class="cr-vresult-meta-item">'
                        +       '<div class="cr-vresult-meta-label">Database Scan Status</div>'
                        +       '<div class="cr-vresult-meta-val" style="color:#15803d">Clean — 0 Matches</div>'
                        +     '</div>'
                        +     '<div class="cr-vresult-meta-item">'
                        +       '<div class="cr-vresult-meta-label">Document check</div>'
                        +       '<div class="cr-vresult-meta-val">Verified</div>'
                        +     '</div>'
                        +   '</div>'
                        + '</div>'
                        + '</div>';
                }
            }

            if (doneBtn) {
                doneBtn.disabled = false;
                doneBtn.textContent = 'Go to My Claims';
            }
            if (viewRepBtn) {
                viewRepBtn.style.display = 'inline-block';
                viewRepBtn.onclick = function() {
                    if (verificationModal) verificationModal.hide();
                    if (verdictData.claim_request_id) {
                        openClaimAuditReport(verdictData.claim_request_id);
                    }
                };
            }
        }
    }

    function openClaimAuditReport(claimId, force) {
        if (!claimId) return;
        activeAuditClaimId = claimId;

        if (!auditModal && window.bootstrap && $('cr-audit-modal')) {
            auditModal = new bootstrap.Modal($('cr-audit-modal'));
        }
        if (auditModal) auditModal.show();

        var bodyEl = $('cr-audit-modal-body');
        var trackIdEl = $('cr-audit-track-id');
        var badgeSlot = $('cr-audit-badge-slot');
        var rescanBtn = $('cr-audit-rescan-btn');

        if (bodyEl) {
            bodyEl.innerHTML = '<div style="text-align:center;padding:40px 20px;color:#64748b">'
                + '<i class="fa fa-spinner fa-spin fa-2x mb-3 text-primary"></i>'
                + '<div style="font-weight:600;font-size:14px;color:#1e293b">Loading verification report…</div>'
                + '</div>';
        }

        if (rescanBtn) {
            rescanBtn.disabled = true;
            rescanBtn.onclick = function() {
                openClaimAuditReport(claimId, true);
            };
        }

        var url = claimUrl('get_claim_duplicate_report.php?claim_id=' + encodeURIComponent(claimId) + (force ? '&force=1' : ''));
        fetchJson(url)
            .then(function(res) {
                if (rescanBtn) rescanBtn.disabled = false;
                var data = (res && res.data) || {};
                var trackId = data.claim_track_id || ('Claim #' + claimId);

                if (trackIdEl) {
                    trackIdEl.innerHTML = esc(trackId)
                        + (data.category_name ? ' <span class="badge bg-light text-dark ms-2" style="font-size:11px;font-weight:600;border:1px solid #e2e8f0">' + esc(data.category_name) + '</span>' : '');
                }
                if (badgeSlot) {
                    badgeSlot.innerHTML = duplicateBadge(data.is_flag, data.duplicate_percentage, data.match_type, data.matched_track_id, claimId);
                }

                // Update local row in state if changed
                for (var i = 0; i < state.rows.length; i++) {
                    if (String(state.rows[i].id) === String(claimId)) {
                        state.rows[i].is_duplicate_flag = data.is_flag;
                        state.rows[i].duplicate_percentage = data.duplicate_percentage;
                        state.rows[i].duplicate_match_type = data.match_type;
                        state.rows[i].matched_track_id = data.matched_track_id;
                        break;
                    }
                }
                // Update table badges
                var badges = document.querySelectorAll('.cr-flag-badge[data-claim-id="' + claimId + '"]');
                badges.forEach(function(b) {
                    b.outerHTML = duplicateBadge(data.is_flag, data.duplicate_percentage, data.match_type, data.matched_track_id, claimId);
                });

                renderAuditReportBody(data);
            })
            .catch(function(err) {
                if (rescanBtn) rescanBtn.disabled = false;
                if (bodyEl) {
                    bodyEl.innerHTML = '<div class="alert alert-danger" style="border-radius:8px">'
                        + '<i class="fa fa-triangle-exclamation me-2"></i>'
                        + 'Failed to load report: ' + esc(err.message || 'Server error')
                        + '</div>';
                }
            });
    }

    function renderAuditReportBody(data) {
        var bodyEl = $('cr-audit-modal-body');
        if (!bodyEl) return;

        var docs = data.documents || [];
        if (!docs.length) {
            bodyEl.innerHTML = '<div style="text-align:center;padding:30px;color:#64748b">'
                + '<i class="fa fa-folder-open fa-2x mb-2"></i>'
                + '<div>No file documents attached to this claim.</div>'
                + '</div>';
            return;
        }

        var html = '';

        var isFlag = (data.is_flag === 1 || data.is_flag === '1');
        var maxPct = Math.round(Number(data.duplicate_percentage) || 0);

        if (isFlag) {
            html += '<div class="cr-audit-match-banner dup mb-3">'
                + '<div style="font-weight:700;color:#be123c;display:flex;align-items:center;gap:6px;font-size:13px">'
                +   '<i class="fa fa-triangle-exclamation"></i>'
                +   'Duplicate Bill Detected (' + maxPct + '% Match with ' + esc(data.matched_track_id || 'Existing Claim') + ')'
                + '</div>'
                + '<div style="color:#881337;font-size:11.5px;margin-top:3px">'
                +   esc(data.summary || 'One or more bill documents match previously submitted records in the database.')
                + '</div>'
                + '</div>';
        } else {
            html += '<div class="cr-audit-match-banner clean mb-3">'
                + '<div style="font-weight:700;color:#166534;display:flex;align-items:center;gap:6px;font-size:13px">'
                +   '<i class="fa fa-circle-check"></i>'
                +   'Document Verified Unique (0% Duplicate Score)'
                + '</div>'
                + '<div style="color:#14532d;font-size:11.5px;margin-top:3px">'
                +   'This claim was checked against historical records in this category. No duplicate documents were found.'
                + '</div>'
                + '</div>';
        }

        docs.forEach(function(doc, idx) {
            var roleBadgeCls = doc.is_bill ? 'invoice' : 'supporting';
            var roleLabel = doc.is_bill ? 'Primary Bill / Invoice' : 'Supporting Document';

            html += '<div class="cr-audit-doc-card">'
                + '<div class="cr-audit-doc-hdr">'
                +   '<div class="cr-audit-doc-title">'
                +     '<i class="fa fa-file-pdf text-danger"></i>'
                +     '<span>' + esc(doc.field_label || doc.field_name || ('File #' + (idx + 1))) + '</span>'
                +     '<span class="cr-audit-role-badge ' + roleBadgeCls + '">' + roleLabel + '</span>'
                +   '</div>'
                +   '<div>'
                +     (doc.is_flag === 1
                        ? '<span class="cr-flag-badge cr-flag-dup"><i class="fa fa-triangle-exclamation"></i> Flagged</span>'
                        : '<span class="cr-flag-badge cr-flag-clean"><i class="fa fa-shield-check"></i> Clean</span>')
                +   '</div>'
                + '</div>'

                + '<div class="cr-audit-doc-grid">'
                +   '<div class="cr-audit-grid-item">'
                +     '<div class="cr-audit-grid-label">File Name</div>'
                +     '<div class="cr-audit-grid-val">' + esc(doc.file_name || 'document.pdf') + '</div>'
                +   '</div>'
                +   '<div class="cr-audit-grid-item">'
                +     '<div class="cr-audit-grid-label">Status</div>'
                +     '<div class="cr-audit-grid-val">' + (doc.is_flag === 1 ? 'Possible duplicate' : 'Unique') + '</div>'
                +   '</div>'
                + '</div>';

            if (doc.is_flag === 1) {
                html += '<div class="cr-audit-match-banner dup mt-3">'
                    + '<div style="font-weight:700;color:#be123c">'
                    +   '<i class="fa fa-triangle-exclamation me-1"></i> Possible duplicate found'
                    + '</div>'
                    + '<div style="margin-top:3px;color:#881337">'
                    +   '<strong>Matched claim:</strong> ' + esc(doc.matched_track_id || ('ID #' + doc.matched_claim_request_id))
                    +   (doc.matched_field_label ? ' (' + esc(doc.matched_field_label) + ')' : '')
                    + '</div>'
                    + '</div>';
            } else {
                html += '<div class="cr-audit-match-banner clean mt-3">'
                    + '<div style="font-weight:700;color:#166534">'
                    +   '<i class="fa fa-shield-check me-1"></i> Unique document'
                    + '</div>'
                    + '<div style="margin-top:3px;color:#14532d">No matching bill found.</div>'
                    + '</div>';
            }

            html += '</div>';
        });

        bodyEl.innerHTML = html;
    }

    var pendingCheckQueue = {};
    function processPendingDuplicateBadges() {
        var pendingBadges = document.querySelectorAll('.cr-flag-badge.cr-flag-pending[data-claim-id]');
        if (!pendingBadges || !pendingBadges.length) return;

        pendingBadges.forEach(function (badge) {
            var cid = badge.getAttribute('data-claim-id');
            if (!cid || pendingCheckQueue[cid]) return;
            pendingCheckQueue[cid] = true;

            fetch(claimUrl('check_claim_duplicate.php?claim_id=' + encodeURIComponent(cid)), {
                credentials: 'same-origin'
            })
                .then(function (res) { return res.json(); })
                .then(function (json) {
                    delete pendingCheckQueue[cid];
                    var d = (json && json.data) || {};
                    var flag = (d.is_flag === 1 || d.is_flag === '1') ? 1 : 0;
                    var pct = Number(d.duplicate_percentage) || 0;
                    var track = d.matched_track_id || '';
                    var mtype = d.match_type || 'none';

                    for (var i = 0; i < state.rows.length; i++) {
                        if (String(state.rows[i].id) === String(cid)) {
                            state.rows[i].is_duplicate_flag = flag;
                            state.rows[i].duplicate_percentage = pct;
                            state.rows[i].duplicate_match_type = mtype;
                            state.rows[i].matched_track_id = track;
                            break;
                        }
                    }

                    var currentBadges = document.querySelectorAll('.cr-flag-badge[data-claim-id="' + cid + '"]');
                    currentBadges.forEach(function (el) {
                        el.outerHTML = duplicateBadge(flag, pct, mtype, track, cid);
                    });
                })
                .catch(function () {
                    delete pendingCheckQueue[cid];
                    var currentBadges = document.querySelectorAll('.cr-flag-badge.cr-flag-pending[data-claim-id="' + cid + '"]');
                    currentBadges.forEach(function (el) {
                        el.outerHTML = duplicateBadge(0, 0, 'none', '', cid);
                    });
                });
        });
    }

    function readFilters() {
        filters.search = (($('cr-search-input') || {}).value || '').trim().toLowerCase();
        filters.location = (filterSearchSelects.location && filterSearchSelects.location.getValue())
            || (($('cr-filter-location') || {}).value || '').trim();
        filters.category = (filterSearchSelects.category && filterSearchSelects.category.getValue())
            || (($('cr-filter-category') || {}).value || '').trim();
        filters.status = (filterSearchSelects.status && filterSearchSelects.status.getValue())
            || (($('cr-filter-status') || {}).value || '').trim();
    }

    function filteredRows() {
        readFilters();
        return state.rows.filter(function (r) {
            if (filters.location && String(r.location_code || '') !== filters.location) return false;
            if (filters.category && String(r.category_name || '') !== filters.category) return false;
            if (filters.status && String(r.overall_status || '') !== filters.status) return false;
            if (filters.search) {
                var hay = [
                    r.claim_track_id,
                    r.location_name,
                    r.location_code,
                    r.category_name,
                    r.overall_status,
                    r.accounts_status,
                ].join(' ').toLowerCase();
                if (hay.indexOf(filters.search) === -1) return false;
            }
            return true;
        });
    }

    function renderTable() {
        var body = $('cr-body');
        if (!body) return;

        var rows = filteredRows();
        if (!rows.length) {
            body.innerHTML = '<tr><td colspan="7" class="cr-td-empty">No claim requests found.</td></tr>';
            return;
        }

        body.innerHTML = rows.map(function (r, idx) {
            var loc = esc(r.location_name || '—');
            if (r.location_code) loc += ' <span class="cr-muted">(' + esc(r.location_code) + ')</span>';
            return '<tr>'
                + '<td data-label="#">' + esc(String(idx + 1)) + '</td>'
                + '<td data-label="Claim ID">' + esc(r.claim_track_id || '—') + '</td>'
                + '<td data-label="Location">' + loc + '</td>'
                + '<td data-label="Category">' + esc(r.category_name || '—') + '</td>'
                + '<td data-label="Status">' + statusBadge(r.overall_status) + '</td>'
                + '<td data-label="Accounts">' + doaBadge(r.accounts_status) + '</td>'
                + '<td class="cr-td-act" data-label="Action">'
                + '<button type="button" class="cr-view-btn js-cr-timeline" data-id="' + esc(String(r.id)) + '">'
                + '<i class="fa fa-clock-rotate-left fa-xs"></i> Timeline</button>'
                + '</td>'
                + '</tr>';
        }).join('');
    }

    function initFilterSearchSelects() {
        if (!window.EDSearchSelect) return;
        var filterTrigger = 'pr-ss-trigger finp cr-filter-select';
        var locSel = $('cr-filter-location');
        var catSel = $('cr-filter-category');
        var statusSel = $('cr-filter-status');

        if (locSel && !filterSearchSelects.location) {
            filterSearchSelects.location = new EDSearchSelect(locSel, {
                placeholder: 'All Locations',
                triggerClass: filterTrigger,
                onChange: renderTable,
            });
        }
        if (catSel && !filterSearchSelects.category) {
            filterSearchSelects.category = new EDSearchSelect(catSel, {
                placeholder: 'All Categories',
                triggerClass: filterTrigger,
                onChange: renderTable,
            });
        }
        if (statusSel && !filterSearchSelects.status) {
            filterSearchSelects.status = new EDSearchSelect(statusSel, {
                placeholder: 'All Status',
                triggerClass: filterTrigger,
                onChange: renderTable,
            });
            filterSearchSelects.status.setOptions([
                { value: '', label: 'All Status' },
                { value: 'Pending', label: 'Pending' },
                { value: 'Approved', label: 'Approved' },
                { value: 'Rejected', label: 'Rejected' },
            ]);
        }
    }

    function populateFilterOptions() {
        var locSel = $('cr-filter-location');
        var catSel = $('cr-filter-category');
        if (!locSel || !catSel) return;

        initFilterSearchSelects();

        var locs = {};
        var cats = {};
        state.rows.forEach(function (r) {
            if (r.location_code) locs[r.location_code] = r.location_name || r.location_code;
            if (r.category_name) cats[r.category_name] = r.category_name;
        });

        var curLoc = filterSearchSelects.location ? filterSearchSelects.location.getValue() : locSel.value;
        var curCat = filterSearchSelects.category ? filterSearchSelects.category.getValue() : catSel.value;

        var locItems = [{ value: '', label: 'All Locations' }].concat(
            Object.keys(locs).sort().map(function (code) {
                return { value: code, label: locs[code] };
            })
        );
        var catItems = [{ value: '', label: 'All Categories' }].concat(
            Object.keys(cats).sort().map(function (name) {
                return { value: name, label: name };
            })
        );

        locSel.innerHTML = locItems.map(function (o) {
            return '<option value="' + esc(o.value) + '">' + esc(o.label) + '</option>';
        }).join('');
        catSel.innerHTML = catItems.map(function (o) {
            return '<option value="' + esc(o.value) + '">' + esc(o.label) + '</option>';
        }).join('');

        if (filterSearchSelects.location) {
            filterSearchSelects.location.setOptions(locItems);
            if (curLoc) filterSearchSelects.location.selectValue(curLoc, locs[curLoc] || curLoc);
        }
        if (filterSearchSelects.category) {
            filterSearchSelects.category.setOptions(catItems);
            if (curCat) filterSearchSelects.category.selectValue(curCat, curCat);
        }
    }

    function loadRows() {
        var body = $('cr-body');
        if (body) body.innerHTML = '<tr><td colspan="7" class="cr-td-empty"><i class="fa fa-spinner fa-spin"></i> Loading…</td></tr>';

        return fetchJson(claimUrl('get_claim_requests.php'))
            .then(function (data) {
                state.rows = Array.isArray(data) ? data : [];
                loaded = true;
                populateFilterOptions();
                renderTable();
            })
            .catch(function (e) {
                if (body) body.innerHTML = '<tr><td colspan="7" class="cr-td-error">' + esc(e.message || 'Failed to load') + '</td></tr>';
            });
    }

    function ensureFormOptions() {
        if (formOptionsLoaded) return Promise.resolve(formOptions);
        return Promise.all([
            fetchJson(claimUrl('get_locations.php')),
            fetchJson(claimUrl('get_categories.php')),
        ]).then(function (results) {
            formOptions.locations = Array.isArray(results[0]) ? results[0] : [];
            formOptions.categories = Array.isArray(results[1]) ? results[1] : [];
            formOptionsLoaded = true;
            return formOptions;
        });
    }

    function resetFormSearchSelects() {
        Object.keys(formSearchSelects).forEach(function (key) {
            if (formSearchSelects[key]) formSearchSelects[key].clear();
        });
    }

    function populateFormSelects() {
        var locSel = $('cr-form-location');
        var catSel = $('cr-form-category');
        if (!locSel || !catSel) return;

        var locItems = (formOptions.locations || []).map(function (loc) {
            return {
                value: String(loc.location_code || ''),
                label: String((loc.location_name || loc.location_code || '')),
            };
        });
        var catItems = (formOptions.categories || []).map(function (cat) {
            return {
                value: String(cat.category_id || ''),
                label: String(cat.category_name || cat.category_id || ''),
            };
        });

        locSel.innerHTML = '<option value="">-- Select Location --</option>'
            + locItems.map(function (o) {
                return '<option value="' + esc(o.value) + '">' + esc(o.label) + '</option>';
            }).join('');
        catSel.innerHTML = '<option value="">-- Select Category --</option>'
            + catItems.map(function (o) {
                return '<option value="' + esc(o.value) + '">' + esc(o.label) + '</option>';
            }).join('');

        if (!formSearchSelects.location && window.EDSearchSelect) {
            formSearchSelects.location = new EDSearchSelect(locSel, { placeholder: 'Select location' });
            formSearchSelects.category = new EDSearchSelect(catSel, {
                placeholder: 'Select category',
                onChange: function (val) {
                    loadCategoryFields(val).catch(function (e) {
                        showFormError(e.message || 'Failed to load fields');
                    });
                },
            });
        }

        if (formSearchSelects.location) formSearchSelects.location.setOptions(locItems);
        if (formSearchSelects.category) formSearchSelects.category.setOptions(catItems);
    }

    function buildDynamicFields(fields) {
        var container = $('cr-dynamic-fields');
        if (!container) return;
        container.innerHTML = '';

        (fields || []).forEach(function (field) {
            var col = document.createElement('div');
            col.className = 'col-md-6';
            if (field.field_type === 'textarea') col.className = 'col-12';

            var label = document.createElement('label');
            label.className = 'cr-form-label';
            label.setAttribute('for', 'cr-field-' + field.field_name);
            label.textContent = field.field_label || field.field_name;
            if (parseInt(field.is_required, 10) === 1) {
                label.innerHTML += ' <span style="color:#dc2626">*</span>';
            }

            var input;
            var type = field.field_type || 'text';
            if (type === 'textarea') {
                input = document.createElement('textarea');
                input.rows = 3;
            } else if (type === 'select') {
                input = document.createElement('select');
                var def = document.createElement('option');
                def.value = '';
                def.textContent = '-- Select --';
                input.appendChild(def);
                var selectOpts = [];
                if (field.options_json) {
                    try {
                        var opts = JSON.parse(field.options_json);
                        if (Array.isArray(opts)) {
                            opts.forEach(function (v) {
                                var o = document.createElement('option');
                                o.value = v;
                                o.textContent = v;
                                input.appendChild(o);
                                selectOpts.push({ value: v, label: v });
                            });
                        }
                    } catch (e) { /* ignore */ }
                }
            } else {
                input = document.createElement('input');
                if (type === 'number') input.type = 'number';
                else if (type === 'date') input.type = 'date';
                else if (type === 'file') input.type = 'file';
                else input.type = 'text';
            }

            input.className = 'finp cr-form-inp';
            input.id = 'cr-field-' + field.field_name;
            input.name = 'fields[' + field.field_name + ']';
            if (parseInt(field.is_required, 10) === 1) input.required = true;
            if (type === 'file') input.accept = 'application/pdf,.pdf';

            var hiddenId = document.createElement('input');
            hiddenId.type = 'hidden';
            hiddenId.name = 'field_id[' + field.field_name + ']';
            hiddenId.value = field.field_id;

            var hiddenLabel = document.createElement('input');
            hiddenLabel.type = 'hidden';
            hiddenLabel.name = 'field_label[' + field.field_name + ']';
            hiddenLabel.value = field.field_label;

            var hiddenType = document.createElement('input');
            hiddenType.type = 'hidden';
            hiddenType.name = 'field_type[' + field.field_name + ']';
            hiddenType.value = field.field_type;

            col.appendChild(label);
            col.appendChild(input);
            col.appendChild(hiddenId);
            col.appendChild(hiddenLabel);
            col.appendChild(hiddenType);

            if (type === 'select' && window.EDSearchSelect) {
                var selectOpts = [];
                if (field.options_json) {
                    try {
                        JSON.parse(field.options_json).forEach(function (v) {
                            selectOpts.push({ value: v, label: v });
                        });
                    } catch (e) { /* ignore */ }
                }
                if (selectOpts.length) {
                    new EDSearchSelect(input, { placeholder: '-- Select --' }).setOptions(selectOpts);
                }
            }

            container.appendChild(col);
        });
    }

    function loadCategoryFields(categoryId) {
        var container = $('cr-dynamic-fields');
        if (container) container.innerHTML = '';
        if (!categoryId) return Promise.resolve();
        return fetchJson(claimUrl('get_category_fields.php?category_id=' + encodeURIComponent(categoryId)))
            .then(function (fields) {
                buildDynamicFields(fields || []);
            });
    }

    function generateIdempotencyKey() {
        try {
            var buf = new Uint8Array(16);
            window.crypto.getRandomValues(buf);
            return Array.from(buf).map(function (b) { return ('00' + b.toString(16)).slice(-2); }).join('');
        } catch (e) {
            return 'key-' + Date.now() + '-' + Math.floor(Math.random() * 1000000);
        }
    }

    function showFormError(msg) {
        var el = $('cr-form-error');
        if (!el) return;
        if (msg) {
            el.textContent = msg;
            el.style.display = 'block';
        } else {
            el.textContent = '';
            el.style.display = 'none';
        }
    }

    function resetForm() {
        var dyn = $('cr-dynamic-fields');
        if (dyn) dyn.innerHTML = '';
        showFormError('');
        var form = $('cr-request-form');
        if (form) form.reset();
        resetFormSearchSelects();
    }

    function openRequestModal() {
        ensureFormOptions()
            .then(function () {
                populateFormSelects();
                resetForm();
                if (!requestModal && window.bootstrap) {
                    requestModal = new bootstrap.Modal($('cr-request-modal'));
                }
                if (requestModal) requestModal.show();
            })
            .catch(function (e) {
                if (window.EDToast) window.EDToast.error(e.message || 'Failed to load form options');
            });
    }

    function submitClaim(e) {
        e.preventDefault();
        if (isSubmitting) return;

        var form = $('cr-request-form');
        if (!form) return;

        var fileInputs = form.querySelectorAll('input[type="file"][name^="fields["]');
        for (var i = 0; i < fileInputs.length; i += 1) {
            var f = fileInputs[i];
            if (!f.files || !f.files.length) continue;
            var file = f.files[0];
            if (file.size > 5 * 1024 * 1024) {
                showFormError('File ' + file.name + ' exceeds 5 MB limit.');
                return;
            }
            var ext = file.name.split('.').pop().toLowerCase();
            if (ext !== 'pdf') {
                showFormError('Only PDF files are allowed: ' + file.name);
                return;
            }
        }

        isSubmitting = true;
        showFormError('');
        var btn = $('cr-form-submit');
        if (btn) {
            btn.disabled = true;
            btn.dataset.origText = btn.textContent;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Submitting…';
        }

        if (window.EDSubmitProgress) {
            window.EDSubmitProgress.start({ title: 'Submitting claim' });
        }

        var formData = new FormData(form);
        if (!formData.get('idempotency_key')) {
            formData.append('idempotency_key', generateIdempotencyKey());
        }

        // Submit form directly without showing duplicate check stepper to employee
        if (btn) {
            btn.disabled = true;
            btn.dataset.origText = btn.innerHTML;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i> Submitting Claim...';
        }

        fetch(claimUrl('save_claim_request.php'), {
            method: 'POST',
            credentials: 'same-origin',
            body: formData,
        })
            .then(function (res) { return res.json(); })
            .then(function (json) {
                if (!json || !json.success) throw new Error((json && json.message) || 'Submit failed');
                var d = json.data || {};
                var trackId = d.claim_track_id || '';

                var afterProgress = window.EDSubmitProgress
                    ? window.EDSubmitProgress.succeed()
                    : Promise.resolve();

                return afterProgress.then(function () {
                    if (requestModal) {
                        requestModal.hide();
                    }
                    resetForm();

                    if (window.EDToast && typeof window.EDToast.success === 'function') {
                        window.EDToast.success('Claim ' + (trackId ? trackId + ' ' : '') + 'submitted successfully!');
                    } else {
                        alert('Claim ' + (trackId ? trackId + ' ' : '') + 'submitted successfully!');
                    }

                    loadRows();
                });
            })
            .catch(function (err) {
                if (window.EDSubmitProgress) window.EDSubmitProgress.fail();
                var msg = err.message || 'Submission failed. Please try again.';
                if (window.EDToast && typeof window.EDToast.error === 'function') {
                    window.EDToast.error(msg);
                } else {
                    alert(msg);
                }
            })
            .finally(function () {
                isSubmitting = false;
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = btn.dataset.origText || 'Submit Claim';
                }
            });
    }

    function mapClaimTimelineToWf(data) {
        var claim = (data && data.claim) || {};
        var steps = (data && data.timeline_steps) || [];
        var foundPending = false;
        var foundRejected = false;
        var wfSteps = [];
        steps.forEach(function (step) {
            if (foundRejected) return;

            var status = String(step.status || 'pending').toLowerCase();
            if (step.step_type === 'doa' && claim.doa_status) {
                status = String(claim.doa_status).toLowerCase();
            } else if (step.step_type === 'accounts' && claim.accounts_status) {
                status = String(claim.accounts_status).toLowerCase();
            }
            if (status === 'approved') status = 'completed';

            var st = 'up';
            if (status === 'completed') st = 'done';
            else if (status === 'rejected') {
                st = 'rejected';
                foundRejected = true;
            } else if ((status === 'pending' || status === 'in-progress') && !foundPending) {
                st = 'pending';
                foundPending = true;
            }
            var remark = step.notes || '';
            if (step.step_type === 'accounts' && step.transaction_id) {
                remark = (remark ? remark + ' · ' : '') + 'Transaction ID: ' + step.transaction_id;
            } else if (st === 'done' && !remark) {
                remark = 'Completed at this stage.';
            } else if (st === 'rejected' && !remark) {
                remark = 'Rejected at this stage.';
            } else if (st === 'pending' && !remark) {
                remark = 'Awaiting action at this stage.';
            }
            wfSteps.push({
                title: step.title || step.subtitle || 'Approval Step',
                approver: step.person || '—',
                role: step.department || '',
                date: step.date,
                status: st,
                remark: remark,
            });
        });

        var subtitle = claim.claim_track_id || 'Claim';
        if (claim.category_name) subtitle += ' · ' + claim.category_name;

        return {
            subtitle: subtitle,
            requester: claim.created_by_name || '—',
            department: claim.location_name || claim.location_code || '—',
            amount: '',
            steps: wfSteps,
        };
    }

    function openTimeline(claimId) {
        fetchJson(claimUrl('get_claim_status_timeline.php?id=' + encodeURIComponent(claimId)))
            .then(function (data) {
                if (window.EDWorkflowModal) {
                    EDWorkflowModal.show(mapClaimTimelineToWf(data));
                }
            })
            .catch(function (e) {
                if (window.EDToast) window.EDToast.error(e.message || 'Failed to load timeline');
            });
    }

    function checkApprover() {
        var tabItem = $('cr-approvals-tab-item');
        if (tabItem) tabItem.style.display = 'none';
        return Promise.resolve(null);
    }

    function loadPending() {
        return fetchJson(claimUrl('get_pending_approvals.php'))
            .then(function (data) {
                pendingApprovals = Array.isArray(data) ? data : [];
                currentApprovalIndex = 0;
                renderPendingList();
                renderCurrentApproval();
            });
    }

    function getFilteredPendingEntries() {
        var q = pendingSearch.trim().toLowerCase();
        return pendingApprovals.map(function (item, idx) {
            return { item: item, index: idx };
        }).filter(function (entry) {
            if (!q) return true;
            var item = entry.item;
            var hay = [
                item.claim_track_id,
                item.employee_name,
                item.department,
                item.location_name,
                item.category_name
            ].join(' ').toLowerCase();
            return hay.indexOf(q) !== -1;
        });
    }

    function updateApprovalsTabCount() {
        var el = $('cr-approvals-tab-count');
        var n = pendingApprovals.length;
        if (!el) return;
        el.textContent = String(n);
        el.style.display = n > 0 ? 'inline-flex' : 'none';
    }

    function onPendingSearchChange() {
        var input = $('cr-pending-search');
        pendingSearch = input ? (input.value || '') : '';
        var filtered = getFilteredPendingEntries();
        if (filtered.length && !filtered.some(function (entry) { return entry.index === currentApprovalIndex; })) {
            currentApprovalIndex = filtered[0].index;
            renderCurrentApproval();
        }
        renderPendingList();
    }

    function renderPendingList() {
        var list = $('cr-pending-list');
        var countEl = $('cr-pending-count');
        if (!list) return;

        updateApprovalsTabCount();

        if (!pendingApprovals.length) {
            list.innerHTML = '<li class="cr-muted" style="padding:12px;text-align:center">No pending items</li>';
            if (countEl) countEl.textContent = '0';
            return;
        }

        if (countEl) countEl.textContent = String(pendingApprovals.length);

        var filtered = getFilteredPendingEntries();
        if (!filtered.length) {
            list.innerHTML = '<li class="cr-muted" style="padding:12px;text-align:center">No matches found</li>';
            return;
        }

        list.innerHTML = filtered.map(function (entry) {
            var item = entry.item;
            var idx = entry.index;
            var submitted = fmtDate(item.claim_created_at);
            var emp = item.employee_name || 'Unknown';
            if (item.department) emp += ' / ' + item.department;
            var active = idx === currentApprovalIndex ? ' active' : '';
            return '<li class="cr-pending-item' + active + '" data-index="' + idx + '">'
                + '<div class="cr-pi-id"><span><i class="fa fa-hashtag fa-xs"></i> ' + esc(item.claim_track_id || '—') + '</span>'
                + '<span class="cr-pi-date">' + esc(submitted) + '</span></div>'
                + '<div class="cr-pi-emp"><i class="fa fa-user fa-xs"></i> ' + esc(emp) + '</div>'
                + '<div class="cr-pi-loc"><i class="fa fa-map-marker-alt fa-xs"></i> ' + esc(item.location_name || '—') + '</div>'
                + '</li>';
        }).join('');
    }

    function selectApproval(index) {
        currentApprovalIndex = index;
        renderPendingList();
        renderCurrentApproval();
    }

    function extractFiles(item) {
        var files = [];
        (item.fields || []).forEach(function (f) {
            if (f.field_type === 'file' && f.file_path) {
                var path = f.file_path;
                var fileName = path.split('/').pop();
                var ext = (fileName.split('.').pop() || '').toLowerCase();
                files.push({ label: f.field_label || f.field_name || fileName, path: path, ext: ext });
            }
        });
        return files;
    }

    function buildApprovalMeta(item) {
        var meta = $('cr-approval-meta');
        if (!meta) return;

        meta.innerHTML = '<div class="cr-detail-header">'
            + '<span class="cr-detail-id">' + esc(item.claim_track_id || '—') + '</span>'
            + '<span class="cr-detail-date">' + esc(fmtDate(item.claim_created_at) || '') + '</span>'
            + '</div>'
            + '<div class="cr-meta-card">'
            + '<div class="cr-meta-label">Category</div>'
            + '<div class="cr-meta-value">' + esc(item.category_name || '—') + '</div>'
            + '</div>';
    }

    function buildApprovalFields(item) {
        var fieldsEl = $('cr-approval-fields');
        if (!fieldsEl) return;

        var amountHtml = '';
        var cells = [];

        (item.fields || []).forEach(function (f) {
            if (f.field_type === 'file') return;
            var label = f.field_label || f.field_name || '';
            var raw = f.field_value || '—';
            var isAmount = label.toLowerCase().match(/(amount|total|value|payable)/) && !isNaN(parseFloat(raw));
            var isWide = isAmount || /description|details|note|remark|address|cycle/i.test(label);

            var valueHtml;
            if (isAmount) {
                valueHtml = '<span class="cr-amount-badge">₹' + parseFloat(raw).toFixed(2) + '</span>';
                amountHtml = '<div class="cr-amount-card">'
                    + '<span class="cr-field-label">' + esc(label) + '</span>'
                    + '<span class="cr-amount-badge">₹' + parseFloat(raw).toFixed(2) + '</span>'
                    + '</div>';
                return;
            }

            valueHtml = esc(raw);
            cells.push({
                label: label,
                value: valueHtml,
                wide: isWide
            });
        });

        var html = '<div class="cr-fields-section-hdr">Claim Details</div>';
        if (amountHtml) html += amountHtml;
        html += '<div class="cr-field-grid">';
        cells.forEach(function (cell) {
            html += '<div class="cr-field-cell' + (cell.wide ? ' is-wide' : '') + '">'
                + '<span class="cr-field-label">' + esc(cell.label) + '</span>'
                + '<span class="cr-field-value">' + cell.value + '</span>'
                + '</div>';
        });
        html += '</div>';
        fieldsEl.innerHTML = html;
    }

    function updateApproveRejectState() {
        var canAct = !currentFiles.length || (currentFilesViewed.length > 0 && currentFilesViewed.every(Boolean));
        var approveBtn = $('cr-approve-btn');
        var rejectBtn = $('cr-reject-btn');
        if (approveBtn) approveBtn.disabled = !canAct;
        if (rejectBtn) rejectBtn.disabled = !canAct;
    }

    function renderFilePager() {
        var label = $('cr-file-pager-label');
        var prev = $('cr-prev-file');
        var next = $('cr-next-file');
        if (!label || !prev || !next) return;

        if (!currentFiles.length) {
            label.textContent = 'No files attached';
            prev.disabled = true;
            next.disabled = true;
            return;
        }

        var file = currentFiles[currentFileIndex];
        label.textContent = (currentFileIndex + 1) + '/' + currentFiles.length + ' · ' + (file.label || 'File');
        prev.disabled = currentFileIndex === 0;
        next.disabled = currentFileIndex >= currentFiles.length - 1;
    }

    function markCurrentFileViewed(badgeEl) {
        if (!currentFilesViewed.length) return;
        if (!currentFilesViewed[currentFileIndex]) {
            currentFilesViewed[currentFileIndex] = true;
            if (badgeEl) badgeEl.textContent = '✓ Viewed';
            updateApproveRejectState();
        }
    }

    function setupFileViewedDetection(viewport, badgeEl) {
        if (!viewport) return;
        setTimeout(function () {
            if (viewport.scrollHeight <= viewport.clientHeight + 2) {
                markCurrentFileViewed(badgeEl);
            }
        }, 400);
        viewport.onscroll = function () {
            if (viewport.scrollTop + viewport.clientHeight >= viewport.scrollHeight - 10) {
                markCurrentFileViewed(badgeEl);
            }
        };
    }

    function renderCurrentFile() {
        var viewport = $('cr-file-viewport');
        if (!viewport) return;
        viewport.innerHTML = '';
        viewport.onscroll = null;

        if (!currentFiles.length) {
            viewport.innerHTML = '<div class="cr-file-empty">No files to display</div>';
            currentFilesViewed = [];
            updateApproveRejectState();
            renderFilePager();
            return;
        }

        var file = currentFiles[currentFileIndex];
        var wrapper = document.createElement('div');
        wrapper.className = 'cr-file-viewport-inner';

        var inner = document.createElement('div');
        inner.className = 'cr-file-viewer-inner';

        var ext = file.ext || '';
        var pdfParams = '#toolbar=1&navpanes=0&scrollbar=1&view=FitH';

        if (['png', 'jpg', 'jpeg', 'gif', 'webp'].indexOf(ext) !== -1) {
            var img = document.createElement('img');
            img.src = file.path;
            img.alt = file.label || 'Attachment';
            img.className = 'cr-doc-img';
            inner.appendChild(img);
        } else if (ext === 'pdf') {
            var iframe = document.createElement('iframe');
            iframe.className = 'cr-pdf-frame';
            iframe.title = file.label || 'PDF Document';
            iframe.src = file.path + (file.path.indexOf('#') === -1 ? pdfParams : '');
            inner.appendChild(iframe);
            if (!currentFilesViewed[currentFileIndex]) currentFilesViewed[currentFileIndex] = true;
        } else {
            var iframe = document.createElement('iframe');
            iframe.className = 'cr-pdf-frame';
            iframe.title = file.label || 'Document';
            iframe.src = file.path;
            inner.appendChild(iframe);
        }

        var badge = document.createElement('div');
        badge.className = 'cr-file-viewed-badge';
        badge.textContent = currentFilesViewed[currentFileIndex] ? '✓ Viewed' : 'Scroll to mark as viewed';

        wrapper.appendChild(inner);
        wrapper.appendChild(badge);
        viewport.appendChild(wrapper);
        viewport.scrollTop = 0;

