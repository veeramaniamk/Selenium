                    },
                    {
                        mod: window.EDOverallProjectApproval,
                        key: 'project'
                    },
                    {
                        mod: window.EDProjectRequest,
                        key: ''
                    },
                ];
                var queue = modules.filter(function(item) {
                    return item.mod && typeof item.mod.prefetch === 'function' && (!item.key || acc[item.key]);
