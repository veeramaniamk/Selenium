        }

        /* .viana-logo:hover {
            transform: scale(1.02);
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        } */

        .viana-logo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        /* ── bottom footer animation ── */
        .bottom-footer {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            padding: 0.85rem 0 0;
            flex-wrap: wrap;
            justify-content: center;
            opacity: 0;
            animation: fadeIn 0.8s var(--transition-smooth) 1.1s forwards;
        }

        .bottom-footer span {
            font-size: 0.72rem;
            color: black;
            position: relative;
        }

        .bottom-footer .dot {
            width: 2px;
            height: 2px;
            border-radius: 50%;
            background: black;
            flex-shrink: 0;
        }

        .bottom-footer a {
            font-size: 0.72rem;
            color: var(--ink-soft);
            text-decoration: none;
            font-weight: 500;
            transition: color .15s;
            position: relative;
        }

        .bottom-footer a::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 100%;
            height: 1px;
            background: var(--blue);
            transform: scaleX(0);
            transform-origin: right;
            transition: transform 0.3s ease;
        }

        .bottom-footer a:hover {
            color: var(--blue);
        }

        .bottom-footer a:hover::after {
            transform: scaleX(1);
            transform-origin: left;
        }

        /* ── loader ── */
        .loader-overlay {
            position: fixed;
            inset: 0;
            background: rgba(240, 243, 249, .88);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            z-index: 2000;
            display: grid;
            place-items: center;
            animation: fadeIn .2s ease both;
        }

        .loader-overlay.d-none {
            display: none;
        }

        @keyframes fadeIn {
            from {
                opacity: 0
            }

            to {
                opacity: 1
            }
        }

        .loader-box {
            background: white;
            border: 1px solid var(--line);
            border-radius: 20px;
            padding: 2.25rem 3rem;
            text-align: center;
            box-shadow: 0 20px 50px rgba(11, 24, 41, .10);
            animation: loaderPop 0.5s var(--transition-smooth);
        }

        @keyframes loaderPop {
            0% {
                opacity: 0;
                transform: scale(0.9);
            }

            100% {
                opacity: 1;
                transform: scale(1);
            }
        }

        .spin {
            width: 38px;
            height: 38px;
            border: 2.5px solid var(--line);
            border-top-color: var(--orange);
            border-radius: 50%;
            margin: 0 auto 1rem;
            animation: spin .75s linear infinite;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .loader-label {
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--ink-mid);
            animation: pulse 1.5s ease infinite;
        }

        @keyframes pulse {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.6;
            }
        }

        /* ── toast ── */
        .toast-wrap {
            position: fixed;
            bottom: 28px;
            right: 28px;
            z-index: 3000;
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-width: 340px;
        }

        .toast {
            background: white;
            border: 1px solid var(--line);
            border-radius: 14px;
            box-shadow: 0 8px 28px rgba(11, 24, 41, .10);
            padding: 0.9rem 1rem;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            animation: toastIn 0.4s var(--transition-smooth) forwards;
            transform-origin: right;
        }

        @keyframes toastIn {
            from {
                opacity: 0;
                transform: translateX(20px) scale(0.9);
            }

            to {
                opacity: 1;
                transform: translateX(0) scale(1);
            }
