/* Legacy budget item styles (request wizard) */
.er-budget-item {
    margin-bottom: 14px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
}

.er-budget-item .pa-section-hdr {
    background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    padding: 10px 14px;
    font-size: 12px;
    font-weight: 800;
    color: #334155;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.er-budget-item .pa-section-body {
    padding: 14px;
}

.er-budget-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    font-size: 12px;
    color: #64748b;
    margin-bottom: 10px;
}

.er-budget-stats strong {
    color: #1e293b;
    font-weight: 800;
}

.er-items-wrap {
    overflow-x: auto;
    margin-bottom: 12px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 10px;
}

.er-items-tbl {
    min-width: 560px;
    margin: 0;
}

.er-total-row {
    text-align: right;
    font-size: 14px;
    font-weight: 700;
