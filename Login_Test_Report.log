    <link href="https://fonts.googleapis.com/css2?family=Arvo:wght@400;700&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/particles.js/2.0.0/particles.min.js"></script>
    <style>
        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --ink: #0b1829;
            --ink-mid: #3d526b;
            --ink-soft: #7a8fa8;
            --ink-ghost: #b4c1d4;
            --surface: #ffffff;
            --bg: #f0f3f9;
            --line: #dde3ee;
            --orange: #f97316;
            --blue: #1a56db;
            --blue-dim: #dce9ff;
            --r-card: 28px;
            --r-btn: 14px;
            --r-chip: 100px;
            --transition-smooth: cubic-bezier(0.65, 0, 0.35, 1);
        }

        html,
        body {
            height: 100%;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            /* background:linear-gradient(90deg, rgb(209, 208, 233) 0%, rgb(198, 237, 238) 35%, rgb(230 207 239 / 23%) 100%); */
            min-height: 100vh;
            display: grid;
            place-items: center;
            color: var(--ink);
            overflow: hidden;
        }

        #particles-js {
            position: fixed;
            inset: 0;
            z-index: 0;
            opacity: 0;
            animation: fadeInParticles 1.2s var(--transition-smooth) forwards;
        }

        @keyframes fadeInParticles {
            0% {
                opacity: 0;
            }

            100% {
                opacity: 1;
            }
        }

        /* ── page layout ── */
        .scene {
            position: relative;
            z-index: 10;
            width: 100%;
            padding: 1.5rem 1.25rem;
            display: grid;
            place-items: center;
        }

        /* ── column: card + powered-by + footer ── */
        .column {
            width: 100%;
            max-width: 460px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* ── card animation wrapper ── */
        .card-wrapper {
            width: 100%;
            opacity: 0;
            transform: translateY(30px) scale(0.98);
            animation: cardEntrance 0.9s var(--transition-smooth) forwards;
        }

        @keyframes cardEntrance {
            0% {
                opacity: 0;
                transform: translateY(30px) scale(0.98);
            }

            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* ── card ── */
        .card {
            width: 100%;
            background: rgba(255, 255, 255, 0.93);
            backdrop-filter: blur(28px);
            -webkit-backdrop-filter: blur(28px);
            border-radius: var(--r-card);
            border: 1px solid rgba(221, 227, 238, 0.9);
            box-shadow:
                0 2px 4px rgba(11, 24, 41, 0.04),
                0 8px 24px rgba(11, 24, 41, 0.07),
                0 32px 64px rgba(11, 24, 41, 0.08);
            overflow: hidden;
        }

        .card-stripe {
            height: 4px;
            background: linear-gradient(90deg, var(--blue) 0%, var(--orange) 100%);
            transform: scaleX(0);
            transform-origin: left;
            animation: stripeExpand 1.2s var(--transition-smooth) 0.3s forwards;
        }

        @keyframes stripeExpand {
            0% {
                transform: scaleX(0);
            }

            100% {
                transform: scaleX(1);
            }
        }

        .card-body {
            padding: 2.5rem 2.75rem 2.25rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        /* ── logo animation ── */
        .logo-icon {
            width: 82px;
            height: 82px;
            border-radius: 50%;
            background: #fff;
            display: grid;
            place-items: center;
            margin-bottom: 1.2rem;
            box-shadow:
                0 0 0 3px rgba(26, 86, 219, 0.10),
                0 4px 16px rgba(11, 24, 41, 0.10);
            overflow: hidden;
            flex-shrink: 0;
            opacity: 0;
            transform: scale(0.5);
            animation: logoPop 0.7s var(--transition-smooth) 0.2s forwards;
        }

        @keyframes logoPop {
            0% {
                opacity: 0;
                transform: scale(0.5);
            }

            70% {
                transform: scale(1.05);
            }

            100% {
                opacity: 1;
                transform: scale(1);
            }
        }

        .logo-icon img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        /* ── brand animation ── */
        .brand-label {
            font-family: 'Arvo', serif;
            font-size: 0.92rem;
            font-weight: 700;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--ink-soft);
            margin-bottom: 1.4rem;
            opacity: 0;
            transform: translateY(10px);
            animation: slideUpFade 0.6s var(--transition-smooth) 0.3s forwards;
        }

        .brand-label em {
            font-style: normal;
            color: var(--orange);
        }

        /* ── headline animation ── */
        .headline {
            font-family: 'Arvo', serif;
            font-size: 2.2rem;
            font-weight: 700;
            color: var(--ink);
            line-height: 1.15;
            letter-spacing: -0.5px;
            margin-bottom: 0.45rem;
            opacity: 0;
            transform: translateY(10px);
            animation: slideUpFade 0.6s var(--transition-smooth) 0.4s forwards;
        }

        .subline {
            font-size: 15px;
            font-weight: 400;
            color: var(--ink-mid);
            line-height: 1.55;
            margin-bottom: 2rem;
            max-width: 275px;
            opacity: 0;
            transform: translateY(10px);
            animation: slideUpFade 0.6s var(--transition-smooth) 0.5s forwards;
        }

        @keyframes slideUpFade {
            0% {
                opacity: 0;
                transform: translateY(10px);
            }

            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ── alerts animation ── */
        .alert {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0.85rem 1.1rem;
            border-radius: 12px;
            font-size: 0.9rem;
            font-weight: 500;
            margin-bottom: 1.5rem;
            text-align: left;
            opacity: 0;
            transform: translateX(-10px);
            animation: alertSlideIn 0.5s var(--transition-smooth) 0.6s forwards;
        }

        @keyframes alertSlideIn {
            0% {
                opacity: 0;
                transform: translateX(-10px);
            }

            100% {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .alert svg {
            width: 17px;
            height: 17px;
            flex-shrink: 0;
        }

        .alert-info {
            background: var(--blue-dim);
            color: #1a3a72;
            border: 1px solid rgba(26, 86, 219, .18);
        }

        .alert-success {
            background: #eafaf2;
            color: #0e5c36;
            border: 1px solid rgba(22, 163, 74, .18);
        }

        /* ── google btn animation ── */
        .g-btn {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 1rem 1.5rem;
            background: var(--surface);
            border: 1.5px solid var(--line);
            border-radius: var(--r-btn);
            font-family: 'DM Sans', sans-serif;
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--ink);
            text-decoration: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            transition: border-color .18s, box-shadow .18s, transform .15s;
            box-shadow: 0 1px 3px rgba(11, 24, 41, .06);
            opacity: 0;
            transform: translateY(15px);
            animation: buttonRise 0.6s var(--transition-smooth) 0.7s forwards;
        }

        @keyframes buttonRise {
            0% {
                opacity: 0;
                transform: translateY(15px);
            }

            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .g-btn::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(26, 86, 219, .04), rgba(249, 115, 22, .04));
            opacity: 0;
            transition: opacity .2s;
        }

        .g-btn:hover {
            border-color: var(--ink-ghost);
            box-shadow: 0 4px 16px rgba(11, 24, 41, .10);
            transform: translateY(-1.5px);
        }

        .g-btn:hover::after {
            opacity: 1;
        }

        .g-btn:active {
            transform: none;
            box-shadow: none;
        }

        .g-logo {
            width: 22px;
            height: 22px;
            flex-shrink: 0;
            animation: googleIconSpin 0.8s var(--transition-smooth) 0.9s both;
        }

        @keyframes googleIconSpin {
            0% {
                transform: rotate(0deg) scale(0.5);
                opacity: 0;
            }

            70% {
                transform: rotate(360deg) scale(1.1);
            }

            100% {
                transform: rotate(360deg) scale(1);
                opacity: 1;
            }
        }

        /* ── trust chips animation ── */
        .trust-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            margin-top: 1.35rem;
            flex-wrap: wrap;
            opacity: 0;
            animation: fadeIn 0.8s var(--transition-smooth) 0.9s forwards;
        }

        @keyframes fadeIn {
            0% {
                opacity: 0;
            }

            100% {
                opacity: 1;
            }
        }

        .chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 0.77rem;
            font-weight: 500;
            color: var(--ink-soft);
            background: var(--bg);
            border: 1px solid var(--line);
            padding: 0.27rem 0.72rem;
            border-radius: var(--r-chip);
            transform: scale(1);
            transition: transform 0.2s ease, background-color 0.2s ease;
        }

        .chip:hover {
            transform: scale(1.05);
            background: #e8ecf5;
        }

        /* ── divider ── */
        .divider {
            display: flex;
            align-items: center;
            gap: 14px;
            width: 100%;
            margin: 1.5rem 0;
            opacity: 0;
            animation: slideUpFade 0.6s var(--transition-smooth) 0.8s forwards;
        }

        .divider::before,
        .divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--line);
        }

        .divider span {
            font-size: 0.82rem;
            font-weight: 500;
            color: var(--ink-ghost);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            white-space: nowrap;
        }

        /* ── ID/password button ── */
        .idpw-btn {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 1rem 1.5rem;
            background: var(--ink);
            border: 1.5px solid var(--ink);
            border-radius: var(--r-btn);
            font-family: 'DM Sans', sans-serif;
            font-size: 1.05rem;
            font-weight: 600;
            color: #fff;
            text-decoration: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            transition: background .2s, border-color .2s, box-shadow .18s, transform .15s;
            box-shadow: 0 1px 3px rgba(11, 24, 41, .12);
            opacity: 0;
            transform: translateY(15px);
            animation: buttonRise 0.6s var(--transition-smooth) 0.9s forwards;
        }

        .idpw-btn:hover {
            background: #1a2e4a;
            border-color: #1a2e4a;
            box-shadow: 0 4px 16px rgba(11, 24, 41, .16);
            transform: translateY(-1.5px);
        }

        .idpw-btn:active {
            transform: none;
            box-shadow: none;
        }

        .idpw-btn svg {
            width: 20px;
            height: 20px;
            flex-shrink: 0;
        }

        /* ── login form panel ── */
        .login-panel {
            width: 100%;
            display: none;
            flex-direction: column;
            gap: 1rem;
            opacity: 0;
            transform: translateY(10px);
            transition: opacity 0.16s ease-out, transform 0.16s ease-out;
        }

        .login-panel.visible {
            display: flex;
            opacity: 1;
            transform: translateY(0);
        }

        .form-field {
            width: 100%;
            text-align: left;
        }

        .form-field label {
            display: block;
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--ink-mid);
            margin-bottom: 0.4rem;
            letter-spacing: 0.02em;
        }

        .form-field input {
            width: 100%;
            padding: 0.85rem 1rem;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.95rem;
            color: var(--ink);
            background: var(--bg);
            border: 1.5px solid var(--line);
            border-radius: 12px;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        }

        .form-field input:focus {
            border-color: var(--blue);
            box-shadow: 0 0 0 3px rgba(26, 86, 219, 0.1);
            background: #fff;
        }

        .form-field input.input-error {
            border-color: #e53e3e;
            box-shadow: 0 0 0 3px rgba(229, 62, 62, 0.1);
        }

        .submit-btn {
            width: 100%;
            padding: 1rem 1.5rem;
            background: linear-gradient(135deg, var(--blue) 0%, #2563eb 100%);
            border: none;
            border-radius: var(--r-btn);
            font-family: 'DM Sans', sans-serif;
            font-size: 1.05rem;
            font-weight: 600;
            color: #fff;
            cursor: pointer;
            transition: box-shadow 0.2s, transform 0.15s;
            box-shadow: 0 2px 8px rgba(26, 86, 219, 0.25);
            margin-top: 0.25rem;
        }

        .submit-btn:hover {
            box-shadow: 0 4px 18px rgba(26, 86, 219, 0.35);
            transform: translateY(-1.5px);
        }

        .submit-btn:active {
            transform: none;
            box-shadow: 0 1px 4px rgba(26, 86, 219, 0.15);
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--ink-soft);
            cursor: pointer;
            border: none;
            background: none;
            padding: 0;
            margin-top: 0.5rem;
            transition: color 0.2s;
            font-family: 'DM Sans', sans-serif;
        }

        .back-link:hover {
            color: var(--blue);
        }

        .back-link svg {
            width: 16px;
            height: 16px;
        }

        /* After "Back to all sign-in options", skip staggered delays (otherwise buttons stay invisible ~1s) */
        #googleSection.google-reveal--instant .g-btn,
        #googleSection.google-reveal--instant .g-logo,
        #googleSection.google-reveal--instant .divider,
        #googleSection.google-reveal--instant .idpw-btn {
            animation: none !important;
            opacity: 1 !important;
            transform: translateY(0) !important;
        }

        #googleSection.google-reveal--instant .g-logo {
            transform: none !important;
        }

        .alert-error {
            background: #fff5f5;
            color: #c53030;
            border: 1px solid rgba(229, 62, 62, .18);
        }

        .chip svg {
            width: 11px;
            height: 11px;
            color: var(--blue);
            flex-shrink: 0;
            animation: chipIconPulse 2s infinite ease-in-out;
        }

        @keyframes chipIconPulse {

            0%,
            100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.1);
            }
        }

        .sep {
            width: 3px;
            height: 3px;
            border-radius: 50%;
            background: var(--ink-ghost);
            flex-shrink: 0;
        }

        /* ── powered-by block animation ── */
        .powered-wrap {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.6rem;
            padding: 1.4rem 0 0;
            opacity: 0;
            transform: translateY(20px);
            animation: slideUpFade 0.8s var(--transition-smooth) 1s forwards;
        }

        .powered-label {
            font-size: 0.7rem;
            font-weight: bold;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: black;
            position: relative;
            overflow: hidden;
        }

        .powered-label::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 100%;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--blue), transparent);
            transform: translateX(-100%);
            animation: shimmer 2s infinite;
        }

        @keyframes shimmer {
            100% {
                transform: translateX(100%);
            }
        }

        .viana-logo {
            width: 120px;
            height: 120px;
            border-radius: 11px;
            overflow: hidden;
            background: transparent;
            display: grid;
            place-items: center;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        /* .viana-logo:hover {
            transform: scale(1.02);
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        } */

        .viana-logo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        /* ── bottom footer animation ── */
        .bottom-footer {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            padding: 0.85rem 0 0;
            flex-wrap: wrap;
            justify-content: center;
            opacity: 0;
            animation: fadeIn 0.8s var(--transition-smooth) 1.1s forwards;
        }

        .bottom-footer span {
            font-size: 0.72rem;
            color: black;
            position: relative;
        }

        .bottom-footer .dot {
            width: 2px;
            height: 2px;
            border-radius: 50%;
            background: black;
            flex-shrink: 0;
        }

        .bottom-footer a {
            font-size: 0.72rem;
            color: var(--ink-soft);
            text-decoration: none;
            font-weight: 500;
            transition: color .15s;
            position: relative;
        }

        .bottom-footer a::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 100%;
            height: 1px;
            background: var(--blue);
            transform: scaleX(0);
            transform-origin: right;
            transition: transform 0.3s ease;
        }

        .bottom-footer a:hover {
            color: var(--blue);
        }

        .bottom-footer a:hover::after {
            transform: scaleX(1);
            transform-origin: left;
        }

        /* ── loader ── */
        .loader-overlay {
            position: fixed;
            inset: 0;
            background: rgba(240, 243, 249, .88);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            z-index: 2000;
            display: grid;
            place-items: center;
            animation: fadeIn .2s ease both;
        }

        .loader-overlay.d-none {
            display: none;
        }

        @keyframes fadeIn {
            from {
                opacity: 0
            }

            to {
                opacity: 1
            }
        }

        .loader-box {
            background: white;
            border: 1px solid var(--line);
            border-radius: 20px;
            padding: 2.25rem 3rem;
            text-align: center;
            box-shadow: 0 20px 50px rgba(11, 24, 41, .10);
            animation: loaderPop 0.5s var(--transition-smooth);
        }

        @keyframes loaderPop {
            0% {
                opacity: 0;
                transform: scale(0.9);
            }

            100% {
                opacity: 1;
                transform: scale(1);
            }
        }

        .spin {
            width: 38px;
            height: 38px;
            border: 2.5px solid var(--line);
            border-top-color: var(--orange);
            border-radius: 50%;
            margin: 0 auto 1rem;
            animation: spin .75s linear infinite;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .loader-label {
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--ink-mid);
            animation: pulse 1.5s ease infinite;
        }

        @keyframes pulse {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.6;
            }
        }

        /* ── toast ── */
        .toast-wrap {
            position: fixed;
            bottom: 28px;
            right: 28px;
            z-index: 3000;
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-width: 340px;
        }

        .toast {
            background: white;
            border: 1px solid var(--line);
            border-radius: 14px;
            box-shadow: 0 8px 28px rgba(11, 24, 41, .10);
            padding: 0.9rem 1rem;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            animation: toastIn 0.4s var(--transition-smooth) forwards;
            transform-origin: right;
        }

        @keyframes toastIn {
            from {
                opacity: 0;
                transform: translateX(20px) scale(0.9);
            }

            to {
                opacity: 1;
                transform: translateX(0) scale(1);
            }
        }

        .t-icon {
            width: 17px;
            height: 17px;
            flex-shrink: 0;
            margin-top: 1px;
        }

        .t-body {
            flex: 1;
        }

        .t-title {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--ink);
            margin-bottom: 2px;
        }

        .t-msg {
            font-size: 0.81rem;
            color: var(--ink-mid);
            line-height: 1.4;
        }

        .t-close {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--ink-ghost);
            font-size: 1.1rem;
            line-height: 1;
            padding: 0;
            transition: color 0.2s ease, transform 0.2s ease;
        }

        .t-close:hover {
            color: var(--ink);
            transform: scale(1.1);
        }
    </style>
</head>

<body>

    <div id="particles-js"></div>

    <div class="scene">
        <div class="column">

            <div class="card-wrapper">
                <div class="card">
                    <div class="card-stripe"></div>
                    <div class="card-body">

                        <div class="logo-icon">
                            <img src="assets/img/simats.jpeg">
                        </div>

                        <div class="brand-label">SIMATS <em>360</em></div>

                        <h1 class="headline">Welcome back</h1>
                        <span class="subline">Sign in with your Google account or Login ID to access your SIMATS workspace</span>

                        
                        
                        
                        
                                                    <div class="alert alert-error">
                                <svg viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                                </svg>
                                Invalid Login ID or password                            </div>
                        
                        <!-- ── Google Sign-In ── -->
                        <div id="googleSection">
                            <a href="/oauth-login" class="g-btn" id="googleSignInBtn">
                                <svg class="g-logo" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
                                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
                                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
                                </svg>
                                Continue with Google
                            </a>

                            <div class="divider"><span>or</span></div>

                            <button type="button" class="idpw-btn" id="showLoginFormBtn">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                                    <path d="M7 11V7a5 5 0 0110 0v4" />
                                </svg>
                                Sign in with Login ID
                            </button>
                        </div>

                        <!-- ── ID / Password Form ── -->
                        <div id="loginFormPanel" class="login-panel visible">
                            <form method="POST" action="" id="loginForm" autocomplete="off">
                                <input type="hidden" name="csrf_token" value="dd6242f71d259435abbfec0a918fefc5055e30a75525dbfbee9cd904ab62c004">
                                <div class="form-field">
                                    <label for="identifier">Login ID</label>
                                    <input type="text" id="identifier" name="identifier" placeholder="Enter your Login ID" required
                                        value="99999">
                                </div>
                                <div class="form-field" style="margin-top: 0.75rem;">
                                    <label for="password">Password</label>
                                    <input type="password" id="password" name="password" placeholder="Enter your password" required>
                                </div>
                                <div class="form-field" style="margin-top: 0.75rem; display: flex; align-items: center; gap: 8px;">
                                    <input type="checkbox" id="remember_me" name="remember_me" value="1" style="width: auto;">
                                    <label for="remember_me" style="margin-bottom: 0; font-weight: normal; font-size: 0.9rem; cursor: pointer;">Remember me</label>
                                </div>
                                <button type="submit" class="submit-btn" style="margin-top: 1rem;">Sign In</button>
                            </form>

                            <div style="text-align:center;">
                                <button type="button" class="back-link" id="backToOptionsBtn">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="19" y1="12" x2="5" y2="12" />
                                        <polyline points="12 19 5 12 12 5" />
                                    </svg>
                                    Back to all sign-in options
                                </button>
                            </div>
                        </div>

                        <div class="trust-row">
                            <span class="chip">
                                <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16" style="margin-right: 2px;">
                                    <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                                </svg>
                                <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16" style="margin-right: 2px;">
                                    <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                </svg>
                                <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16">
                                    <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z" />
                                    <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd" />
                                </svg>
                                Secure Authentication
                            </span>
                        </div>

                    </div>
                </div>
            </div>
            <!-- ── END CARD ── -->

            <!-- ── POWERED BY ── -->
            <div class="powered-wrap">
                <span class="powered-label">Powered by</span>
                <div class="viana-logo">
                    <img src="assets/img/viana.png" alt="Viana Soft">
                </div>
            </div>

            <!-- ── BOTTOM FOOTER ── -->
            <div class="bottom-footer">
                <span class="font-weight-bold">© 2023 Viana Soft Private Limited</span>
                <!-- <span class="dot"></span>
            <a href="#">Privacy Policy</a> -->
            </div>

        </div>
    </div>

    <!-- Loader -->
    <div id="loaderOverlay" class="loader-overlay d-none">
        <div class="loader-box">
            <div class="spin"></div>
            <div class="loader-label">Signing you in…</div>
        </div>
    </div>

    <div class="toast-wrap" id="toastWrap"></div>

    <script>
        particlesJS('particles-js', {
            particles: {
                number: {
                    value: 60,
                    density: {
                        enable: true,
                        value_area: 850
                    }
                },
                color: {
                    value: '#8faac8'
                },
                shape: {
                    type: 'circle'
                },
                opacity: {
                    value: 1,
                    random: true,
                    anim: {
                        enable: true,
                        speed: 0.5,
                        opacity_min: 0.05,
                        sync: false
                    }
                },
                size: {
                    value: 2,
                    random: true,
                    anim: {
                        enable: false
                    }
                },
                line_linked: {
                    enable: true,
                    distance: 145,
                    color: '#c4d0e3',
                    opacity: 1,
                    width: 1
                },
                move: {
                    enable: true,
                    speed: 0.65,
                    direction: 'none',
                    random: true,
                    straight: false,
                    out_mode: 'out',
                    bounce: false
                }
            },
            interactivity: {
                detect_on: 'window',
                events: {
                    onhover: {
                        enable: true,
                        mode: 'grab'
                    },
                    onclick: {
                        enable: true,
                        mode: 'push'
                    },
                    resize: true
                },
                modes: {
                    grab: {
                        distance: 155,
                        line_linked: {
                            opacity: 0.4
                        }
                    },
                    push: {
                        particles_nb: 2
                    }
                }
            },
            retina_detect: true
        });

        (function() {
            const loader = document.getElementById('loaderOverlay');
            const toastWrap = document.getElementById('toastWrap');

            const phpMsg = "";
            const phpType = "error";
            if (phpMsg) showToast(phpMsg, phpType);

            function showToast(msg, type) {
                const err = type === 'error';
                const t = document.createElement('div');
                t.className = 'toast';
                t.innerHTML = `
            <svg class="t-icon" viewBox="0 0 20 20" fill="${err ? '#e53e3e' : '#38a169'}">
                ${err
                    ? '<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>'
                    : '<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>'}
            </svg>
            <div class="t-body">
                <div class="t-title">${err ? 'Notice' : 'Success'}</div>
                <div class="t-msg">${msg}</div>
            </div>
            <button class="t-close">&times;</button>`;
                toastWrap.appendChild(t);
                t.querySelector('.t-close').onclick = () => t.remove();
                setTimeout(() => t?.parentNode && t.remove(), 5000);
            }

            const googleSection = document.getElementById('googleSection');
            const loginPanel = document.getElementById('loginFormPanel');
            const showFormBtn = document.getElementById('showLoginFormBtn');
            const backBtn = document.getElementById('backToOptionsBtn');
            const loginForm = document.getElementById('loginForm');

            function showPanel(panel) {
                if (panel === 'form') {
                    googleSection.classList.remove('google-reveal--instant');
                    googleSection.style.display = 'none';
                    loginPanel.classList.add('visible');
                    requestAnimationFrame(() => {
                        const idField = document.getElementById('identifier');
                        if (idField) {
                            idField.focus();
                        }
                    });
                } else {
                    googleSection.classList.add('google-reveal--instant');
                    googleSection.style.display = 'block';
                    loginPanel.classList.remove('visible');
                    requestAnimationFrame(() => {
                        const gBtn = document.getElementById('googleSignInBtn');
                        if (gBtn) {
                            gBtn.focus();
                        }
                    });
                }
            }

            showFormBtn.addEventListener('click', () => showPanel('form'));
            backBtn.addEventListener('click', () => showPanel('options'));

                            showPanel('form');
            
            loginForm.addEventListener('submit', () => {
                loader.classList.remove('d-none');
                document.title = 'Signing you in\u2026';
            });

            document.getElementById('googleSignInBtn').addEventListener('click', (e) => {
                e.preventDefault();
                loader.classList.remove('d-none');
                document.title = 'Signing you in\u2026';
                setTimeout(() => {
                    window.location.href = '/oauth-login';
                }, 300);
            });

            window.addEventListener('pageshow', e => {
                if (e.persisted) {
                    loader.classList.add('d-none');
                    document.title = 'Sign in \u00b7 SIMATS 360';
                }
            });

            document.addEventListener('DOMContentLoaded', () => loader.classList.add('d-none'));

        })();
    </script>
</body>

</html>

