    }

    #page-approvals .cr-approval-actions {
        position: sticky;
        bottom: 0;
        z-index: 2;
        padding: 10px 12px;
        padding-bottom: max(10px, env(safe-area-inset-bottom, 10px));
        background: #fff;
        border-top: 1px solid #e8edf3;
    }

    .ea-meta-cards {
        flex-direction: column;
    }

    .ea-budget-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 575.98px) {
    #page-approvals .ea-horiz-tabs .nav-link {
        padding: 7px 10px;
        font-size: 11px;
    }

    #page-approvals .cr-approvals-wrap {
