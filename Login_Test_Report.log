        var isOwn = birthdayBioId === (status.employee && status.employee.bio_id);
        var emp = isOwn ? status.employee : findColleague(status, birthdayBioId);
        if (!emp) return;

        var institution = (isOwn ? status.employee.institution : emp.institution) ||
