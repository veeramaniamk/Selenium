    function renderProfileLoading() {
        const pane = profilePane();
        if (!pane) return;
        pane.innerHTML =
            '<div class="set-prof-state load"><i class="fa fa-spinner fa-spin"></i>Loading profile…</div>';
    }

    function renderProfileError(message) {
        const pane = profilePane();
        if (!pane) return;
        pane.innerHTML =
            '<div class="set-prof-state err"><i class="fa fa-circle-exclamation"></i>' +
            esc(message) +
            '<div style="margin-top:12px"><button type="button" class="set-pwd-submit" onclick="EDProfile.reload()">Retry</button></div></div>';
    }

    function passwordApiUrl() {
        const base = (window.ED_CONFIG && window.ED_CONFIG.apiBase) || '/api/employee';
        return base.replace(/\/$/, '') + '/password.php';
    }

    async function submitPasswordChange() {
        const current = document.getElementById('pwd-current');
        const newPass = document.getElementById('pwd-new');
        const confirm = document.getElementById('pwd-confirm');
        const msg = document.getElementById('pwd-msg');
        if (!current || !newPass || !confirm) return;

        msg.className = 'set-pwd-msg';
        msg.textContent = '';

        try {
            const res = await fetch(passwordApiUrl(), {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify({
                    current_password: current.value,
                    new_password: newPass.value,
                    confirm_password: confirm.value,
                }),
            });
            const json = await res.json().catch(function () { return { success: false }; });
            if (!res.ok || !json.success) {
                throw new Error((json && json.error) || 'Password update failed');
            }
            current.value = '';
            newPass.value = '';
            confirm.value = '';
            msg.className = 'set-pwd-msg ok';
            msg.textContent = (json.data && json.data.message) || 'Password updated successfully.';
            if (window.EDToast) window.EDToast.success('Password updated successfully.');
        } catch (err) {
            msg.className = 'set-pwd-msg err';
            msg.textContent = err.message || 'Password update failed';
            if (window.EDToast) window.EDToast.error(msg.textContent);
        }
    }

    function updateHeader(profile) {
        const identity = profile.identity || {};
        const work = profile.work || {};
        const imgToken = profile._imgFresh || Date.now();

        const avatarEl = document.getElementById('ed-header-avatar');
        const nameEl = document.getElementById('ed-header-name');
        const roleEl = document.getElementById('ed-header-role');
        const staffEl = document.getElementById('ed-header-staff');

        if (nameEl) nameEl.textContent = identity.employee_name || 'Employee';
        if (roleEl) {
            const designation = work.designation || '';
            roleEl.innerHTML = designation
                ? '<span class="d-none d-sm-inline">' + esc(designation) + '</span>'
                : '';
        }
        if (staffEl) staffEl.textContent = identity.staff_id ? 'EMP-' + identity.staff_id : (identity.bio_id ? 'BIO-' + identity.bio_id : '');

        if (avatarEl && identity.profile_img_url) {
            var rawAvatar = String(identity.profile_img_url || '').trim();
            if (/dashboard\.php/i.test(rawAvatar) || /\.(php|html?)(\?|#|$)/i.test(rawAvatar)) {
                rawAvatar = '';
            }
            if (!rawAvatar) {
                return;
            }
            var freshUrl = withImageFreshness(rawAvatar, imgToken);
            avatarEl.dataset.edProfileUrl = rawAvatar;
            avatarEl.onerror = function () {
                if (avatarEl.dataset.edImgRetry === '1') return;
                avatarEl.dataset.edImgRetry = '1';
                profileInflight = null;
                loadProfile(false);
            };
            avatarEl.src = freshUrl;
            avatarEl.alt = identity.employee_name || 'Profile';
            avatarEl.style.opacity = '1';
        }
    }

    function applyProfile(profile, renderPane) {
        if (!profile._imgFresh) {
            profile._imgFresh = Date.now();
        }
        if (renderPane) {
            renderProfilePane(profile);
        }
        updateHeader(profile);
        if (window.EDAttendance && typeof window.EDAttendance.applyReportingAuthority === 'function') {
            const ra = (profile.work && profile.work.reporting_authority) || null;
            window.EDAttendance.applyReportingAuthority(ra);
        }
    }

    async function fetchProfile() {
        const baseUrl = apiUrl(API_ROUTE);
        const url = baseUrl + (baseUrl.indexOf('?') >= 0 ? '&' : '?') + '_ts=' + Date.now();
        const res = await fetch(url, {
            method: 'GET',
            credentials: 'same-origin',
            headers: {
                Accept: 'application/json',
                'Cache-Control': 'no-cache',
                Pragma: 'no-cache',
            },
            cache: 'no-store',
        });

        const json = await res.json().catch(function () {
            return { success: false, error: 'Invalid server response.' };
        });

        if (!res.ok || !json.success) {
            throw new Error(json.error || 'Request failed.');
        }

        const profile = json.data.profile;
        profile._imgFresh = Date.now();
        return profile;
    }

    function loadProfile(renderPane) {
        renderPane = renderPane !== false;

        // Settings profile tab always fetches live data (no stale in-flight reuse).
        if (renderPane) {
            profileInflight = null;
        } else if (profileInflight) {
            return profileInflight;
        }

        if (renderPane) {
            renderProfileLoading();
        }

        profileInflight = fetchProfile()
            .then(function (profile) {
                applyProfile(profile, renderPane);
            })
            .catch(function (err) {
                if (renderPane) {
                    renderProfileError(err.message || 'Unknown error');
                }
            })
            .finally(function () {
                profileInflight = null;
            });

        return profileInflight;
    }

    window.EDProfile = {
        load: loadProfile,
        reload: function () {
            profileInflight = null;
            return loadProfile(true);
        },
        clearAllCaches: clearAllCaches,
        logout: function () {
            clearAllCaches();
            window.location.href = 'logout.php';
        },
        onSettingsTab: function (opt) {
            if (opt === 'profile') {
                loadProfile(true);
            }
        },
        updateHeaderFromSummary: function (summary) {
            updateHeader({
                _imgFresh: Date.now(),
                identity: {
                    bio_id: summary.bio_id,
                    employee_name: summary.employee_name,
                    staff_id: summary.staff_id,
                    profile_img_url: summary.profile_img_url,
                },
                work: { designation: summary.designation },
            });
        },
        initHeader: function () {
            loadProfile(false);
        },
        bindPasswordForm: function () {
            var pwdBtn = document.getElementById('pwd-submit');
            if (pwdBtn && !pwdBtn.dataset.edWired) {
                pwdBtn.dataset.edWired = '1';
                pwdBtn.addEventListener('click', submitPasswordChange);
            }
        },
    };

    document.addEventListener('DOMContentLoaded', function () {
        if (window.EDProfile && typeof window.EDProfile.initHeader === 'function') {
            window.EDProfile.initHeader();
        }
        if (window.EDProfile && typeof window.EDProfile.bindPasswordForm === 'function') {
            window.EDProfile.bindPasswordForm();
        }
    });
})();

