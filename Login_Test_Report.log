/* Mode cards — modern mode glass consistency */
body.modern-mode #page-settings .mode-card {
    background:
        var(--aqua-gloss),
        linear-gradient(180deg, rgba(255, 255, 255, 0.72), rgba(237, 238, 244, 0.58)) !important;
