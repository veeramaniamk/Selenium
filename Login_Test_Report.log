            // Approval Notes (Required for all approval stages)
            '<div class="pa-section">' +
            '<div class="pa-section-hdr" style="padding:10px 14px;background:#f1f5f9;border-bottom:1px solid #e2e8f0;font-weight:700;font-size:12px;color:#334155;"><i class="fa fa-pen me-1"></i>Approval Notes / Comments *</div>' +
            '<div class="pa-section-body" style="padding:14px;background:#fff;">' +
            '<textarea class="form-control form-control-sm" id="sa-appr-notes" name="approval_notes" rows="3" placeholder="Enter comments..."></textarea>' +
            '</div>' +
            '</div>' +

            // PDF report upload (Common for this request, required for final stage, visible on all)
            '<div class="pa-section" id="sa-signed-pdf-sec">' +
            '<div class="pa-section-hdr" style="padding:10px 14px;background:#f1f5f9;border-bottom:1px solid #e2e8f0;font-weight:700;font-size:12px;color:#334155;"><i class="fa fa-file-signature me-1"></i>Approval Report (PDF) <span id="sa-pdf-req-star" style="color:red;display:none;">*</span></div>' +
            '<div class="pa-section-body" style="padding:14px;background:#fff;">' +
            '<input type="file" class="form-control form-control-sm" id="sa-signed-file" accept="application/pdf,.pdf">' +
            '<div style="font-size:11px;color:#64748b;margin-top:5px;font-style:italic">Upload the PDF report document to submit along with your approval.</div>' +
            '</div>' +
            '</div>' +

            // Reject Dialog box (hidden by default)
            '<div class="pa-section" id="sa-reject-sec" style="display:none;background:#fef2f2;border:1px solid #fecaca;border-radius:8px;">' +
            '<div class="pa-section-hdr" style="padding:10px 14px;background:#fee2e2;font-weight:700;font-size:12px;color:#991b1b;"><i class="fa fa-times-circle me-1"></i>Reject Request</div>' +
            '<div class="pa-section-body" style="padding:14px;">' +
            '<textarea class="form-control form-control-sm mb-2" id="sa-reject-reason" rows="3" placeholder="Enter reason for rejection..."></textarea>' +
            '<button type="button" class="btn btn-sm btn-danger" id="sa-confirm-reject-btn">Confirm Reject</button>' +
            '</div>' +
            '</div>' +

            // Local error notification
            '<div id="sa-approve-error" style="display:none;margin-top:10px;padding:10px;background:#fef2f2;border:1px solid #fecaca;border-radius:6px;color:#b91c1c;font-size:12px;font-weight:600;"></div>' +
            '</form>' +
            '</div>' + // end pa-detail-left

            // Right: timeline
            '<aside class="pa-detail-wf" style="width:340px;flex:0 0 340px;background:#f8fafc;border-left:1px solid #e2e8f0;padding:20px;">' +
            renderWorkflowCardHtml(workflow, data) +
            '</aside>' +
            '</div>'; // end sa-view-approve

        body.innerHTML = html;

        // 3. Render Footer Buttons
        var footer = document.getElementById('sa-modal-footer');
        if (footer) {
            if (isPendingForMe) {
                footer.innerHTML = 
                    '<button type="button" class="btn-sec" data-bs-dismiss="modal" id="sa-btn-close">Close</button>' +
                    '<button type="button" class="btn-sec" id="sa-btn-cancel" style="display:none">Cancel</button>' +
                    '<button type="button" class="pr-withdraw-btn" id="sa-btn-reject" style="display:none">Reject</button>' +
                    '<button type="button" class="btn-pri" id="sa-btn-review"><i class="fa fa-check-circle me-1"></i>Review & Approve</button>' +
                    '<button type="button" class="btn-pri" id="sa-btn-confirm" style="display:none"><i class="fa fa-check-circle me-1"></i>Confirm Approval</button>';
            } else {
                footer.innerHTML = '<button type="button" class="btn-sec" data-bs-dismiss="modal">Close</button>';
            }
        }

        // Check if final stage to toggle Signed PDF field requirement
        var maxStage = workflow.length ? Math.max.apply(null, workflow.map(function(s){return s.stage_number;})) : 0;
        var isFinal = maxStage > 0 && Number(data.stage_number) === maxStage;
        
        var pdfStar = document.getElementById('sa-pdf-req-star');
        if (pdfStar && isFinal) {
            pdfStar.style.display = 'inline';
        }

        // Initialize state variables
        selectedItems.clear();
        currentStageNumber = Number(data.stage_number) || 0;

        // Wire form controls if pending
        if (isPendingForMe) {
            wireFormControls(data, isFinal);
        }
    }

    function wireFormControls(data, isFinal) {
        var viewDetails = document.getElementById('sa-view-details');
        var viewApprove = document.getElementById('sa-view-approve');
        
        var btnClose = document.getElementById('sa-btn-close');
        var btnCancel = document.getElementById('sa-btn-cancel');
        var btnReject = document.getElementById('sa-btn-reject');
        var btnReview = document.getElementById('sa-btn-review');
        var btnConfirm = document.getElementById('sa-btn-confirm');
        
        var saItemInput = document.getElementById('sa-item-input');
        var saClearSearch = document.getElementById('sa-clear-search');
        var saDropdown = document.getElementById('sa-item-dropdown');

        function toggleView(mode) {
            if (mode === 'approve') {
                if (viewDetails) viewDetails.style.display = 'none';
                if (viewApprove) viewApprove.style.display = 'flex';
                
                if (btnClose) btnClose.style.display = 'none';
                if (btnCancel) btnCancel.style.display = '';
                if (btnReject) btnReject.style.display = '';
                if (btnReview) btnReview.style.display = 'none';
                if (btnConfirm) btnConfirm.style.display = '';
            } else {
                if (viewDetails) viewDetails.style.display = 'flex';
                if (viewApprove) viewApprove.style.display = 'none';
                
                if (btnClose) btnClose.style.display = '';
                if (btnCancel) btnCancel.style.display = 'none';
                if (btnReject) btnReject.style.display = 'none';
                if (btnReview) btnReview.style.display = '';
                if (btnConfirm) btnConfirm.style.display = 'none';
                
                // Hide reject block if visible
                var rejectSec = document.getElementById('sa-reject-sec');
                if (rejectSec) rejectSec.style.display = 'none';
                
                var boqSec = document.getElementById('sa-approve-boq-sec');
                var searchSec = document.getElementById('sa-search-panel-sec');
                if (boqSec) boqSec.style.display = '';
                if (searchSec) searchSec.style.display = '';
            }
            // Clear errors
            var err = document.getElementById('sa-approve-error');
            if (err) { err.style.display = 'none'; err.textContent = ''; }
        }

        if (btnReview) {
            btnReview.addEventListener('click', function() {
                toggleView('approve');
            });
        }

        if (btnCancel) {
            btnCancel.addEventListener('click', function() {
                toggleView('details');
            });
        }

        // Wire catalog autocomplete search and select listeners
        if (saItemInput) {
            saItemInput.addEventListener('focus', function() {
                filterCatalogItems();
            });
            saItemInput.addEventListener('input', function() {
                filterCatalogItems();
            });
        }
        
        if (saClearSearch) {
            saClearSearch.addEventListener('click', function() {
                if (saItemInput) saItemInput.value = '';
                filterCatalogItems();
            });
        }

        // Hide dropdown on click outside
        var clickHandler = function(e) {
            if (saDropdown && saItemInput && !saItemInput.contains(e.target) && !saDropdown.contains(e.target)) {
                saDropdown.style.display = 'none';
            }
        };
        document.addEventListener('click', clickHandler);

        // Prepopulate selection editor with existing items if they exist
        if (data.items && data.items.length) {
            data.items.forEach(function(it) {
                var uom = 'EA';
                var qty = it.qty !== undefined ? parseInt(it.qty, 10) || 1 : 1;
                var price = it.value !== undefined ? parseFloat(it.value) || 0 : 0;
                var cleanDesc = it.item_description || '';
                
                var match = cleanDesc.match(/^\[UOM:\s*([^|]+)\s*\|\s*Qty:\s*(\d+)\s*\|\s*Price:\s*([\d.]+)\]\s*(.*)$/);
                if (match) {
                    uom = match[1].trim();
                    if (it.qty === undefined) qty = parseInt(match[2], 10) || 1;
                    if (it.value === undefined) price = parseFloat(match[3]) || 0;
                    cleanDesc = match[4].trim();
                }

                selectedItems.set(it.item_name, {
                    code: it.item_name,
                    description: cleanDesc,
                    uom: uom,
                    item_amount: price,
                    quantity: qty,
                    total: qty * price
                });
            });
            syncSelectionUi();
        }

        // Reject View Toggling
        if (btnReject) {
            btnReject.addEventListener('click', function() {
                var rejectSec = document.getElementById('sa-reject-sec');
                var boqSec = document.getElementById('sa-approve-boq-sec');
                var searchSec = document.getElementById('sa-search-panel-sec');
                if (rejectSec) {
                    rejectSec.style.display = '';
                    if (boqSec) boqSec.style.display = 'none';
                    if (searchSec) searchSec.style.display = 'none';
                    if (btnConfirm) btnConfirm.style.display = 'none';
                    if (btnReject) btnReject.style.display = 'none';
                }
            });
        }

        // Confirm Rejection Action
        var confirmRejectBtn = document.getElementById('sa-confirm-reject-btn');
        if (confirmRejectBtn) {
            confirmRejectBtn.addEventListener('click', function() {
                var reasonText = document.getElementById('sa-reject-reason');
                var reason = reasonText ? (reasonText.value || '').trim() : '';
                var err = document.getElementById('sa-approve-error');
                if (err) err.style.display = 'none';

                if (!reason) {
                    if (err) { err.style.display = 'block'; err.textContent = 'Please enter a reason for rejection.'; }
                    return;
                }

                if (confirmRejectBtn.disabled) return;
                confirmRejectBtn.disabled = true;
                if (btnCancel) btnCancel.disabled = true;

                var fd = new FormData();
                fd.append('scrape_id', String(data.scrape_id));
                fd.append('stage_number', String(data.stage_number));
                fd.append('reject_reason', reason);

                fetch(apiUrl({ action: 'reject-stage' }), {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { Accept: 'application/json' },
                    body: fd,
                }).then(function (res) {
                    return res.text().then(function (text) {
                        var json = null;
                        try { json = text ? JSON.parse(text) : null; } catch (e) {}
                        if (!json || !json.success) throw new Error((json && json.error) || 'Rejection failed.');
                        return json;
                    });
                }).then(function () {
                    document.removeEventListener('click', clickHandler);
                    if (detailModal) detailModal.hide();
                    // Reload list
                    if (window.EDScrapeApproval) window.EDScrapeApproval.onScrapeTab();
                }).catch(function (e) {
                    if (err) { err.style.display = 'block'; err.textContent = e.message || 'Reject failed.'; }
                }).finally(function() {
                    confirmRejectBtn.disabled = false;
                    if (btnCancel) btnCancel.disabled = false;
                });
            });
        }

        // Confirm Approval Action (Sequential: Upsert Items if Stage 1, then Approve Stage)
        if (btnConfirm) {
            btnConfirm.addEventListener('click', function() {
                var err = document.getElementById('sa-approve-error');
                if (err) err.style.display = 'none';

                // Basic validation (must have items)
                if (selectedItems.size === 0) {
                    if (err) { err.style.display = 'block'; err.textContent = 'Please search and select at least one item.'; }
                    return;
                }

                // Notes Validation (Required for all approvals)
                var notesVal = (document.getElementById('sa-appr-notes').value || '').trim();
                if (!notesVal) {
                    if (err) { err.style.display = 'block'; err.textContent = 'Approval comments/notes are required.'; }
                    return;
                }

                // Basic validation for Final Stage (must have PDF upload)
                var signedFile = document.getElementById('sa-signed-file');
                if (isFinal) {
                    if (!signedFile || !signedFile.files || !signedFile.files[0]) {
                        if (err) { err.style.display = 'block'; err.textContent = 'Approval report PDF is required for final approval.'; }
                        return;
                    }
                }

                if (btnConfirm.disabled) return;
                btnConfirm.disabled = true;
                if (btnCancel) btnCancel.disabled = true;
                if (btnReject) btnReject.disabled = true;

                // Step 1: Save Items for all stages
                var promise = Promise.resolve();
                if (true) {
                    // Programmatically build form elements for selected items matching backend array expectations
                    var itemsForm = document.getElementById('sa-approve-form');
                    
                    // Remove any previous dynamic hidden inputs
                    itemsForm.querySelectorAll('.js-sa-hidden-field').forEach(function(el) { el.remove(); });
                    
                    var idx = 0;
                    selectedItems.forEach(function(item, code) {
                        var inputName = document.createElement('input');
                        inputName.type = 'hidden';
                        inputName.className = 'js-sa-hidden-field';
                        inputName.name = 'item_name[]';
                        inputName.value = code;
                        
                        var inputDesc = document.createElement('input');
                        inputDesc.type = 'hidden';
                        inputDesc.className = 'js-sa-hidden-field';
                        inputDesc.name = 'item_description[]';
                        inputDesc.value = '[UOM: ' + item.uom + ' | Qty: ' + item.quantity + ' | Price: ' + item.item_amount + '] ' + item.description;
                        
                        var inputRem = document.createElement('input');
                        inputRem.type = 'hidden';
                        inputRem.className = 'js-sa-hidden-field';
                        inputRem.name = 'remarks[]';
                        inputRem.value = '';
                        
                        var inputReas = document.createElement('input');
                        inputReas.type = 'hidden';
                        inputReas.className = 'js-sa-hidden-field';
                        inputReas.name = 'reason[]';
                        inputReas.value = '';

                        itemsForm.appendChild(inputName);
                        itemsForm.appendChild(inputDesc);
                        itemsForm.appendChild(inputRem);
                        itemsForm.appendChild(inputReas);
                        idx++;
                    });

                    var fdItems = new FormData(itemsForm);
                    promise = fetch(apiUrl({ action: 'upsert-items' }), {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { Accept: 'application/json' },
                        body: fdItems
                    }).then(function (res) {
                        return res.text().then(function (text) {
                            var json = null;
                            try { json = text ? JSON.parse(text) : null; } catch (e) {}
                            if (!json || !json.success) throw new Error((json && json.error) || 'Failed to save BOQ items.');
                            return json;
                        });
                    });
                }

                // Step 2: Approve Stage
                promise.then(function() {
                    var fdAppr = new FormData();
                    fdAppr.append('scrape_id', String(data.scrape_id));
                    fdAppr.append('stage_number', String(data.stage_number));
                    fdAppr.append('approval_notes', notesVal);

                    if (signedFile && signedFile.files && signedFile.files[0]) {
                        fdAppr.append('signed_pdf', signedFile.files[0]);
                    }

                    return fetch(apiUrl({ action: 'approve-stage' }), {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { Accept: 'application/json' },
                        body: fdAppr
                    });
                }).then(function (res) {
                    return res.text().then(function (text) {
                        var json = null;
                        try { json = text ? JSON.parse(text) : null; } catch (e) {}
                        if (!json || !json.success) throw new Error((json && json.error) || 'Failed to approve stage.');
                        return json;
                    });
                }).then(function() {
                    document.removeEventListener('click', clickHandler);
                    if (detailModal) detailModal.hide();
                    // Reload list
                    if (window.EDScrapeApproval) window.EDScrapeApproval.onScrapeTab();
                }).catch(function(e) {
                    if (err) { err.style.display = 'block'; err.textContent = e.message || 'Approval failed.'; }
                }).finally(function() {
                    btnConfirm.disabled = false;
                    if (btnCancel) btnCancel.disabled = false;
                    if (btnReject) btnReject.disabled = false;
                });
            });
        }
    }

    function filterCatalogItems() {
        var input = document.getElementById('sa-item-input');
        var dropdown = document.getElementById('sa-item-dropdown');
        if (!input || !dropdown) return;
        
        var term = input.value.trim().toLowerCase();
        if (term.length < 2) {
            dropdown.innerHTML = '<div class="dropdown-item text-muted">Type at least 2 characters to search...</div>';
            dropdown.style.display = 'block';
            return;
        }
        
        if (!allItems.length) {
            loadAllItems().then(function() {
                filterCatalogItems();
            });
            return;
        }
        
        var filtered = allItems.filter(function(item) {
            var hay = (item.code + ' ' + item.description).toLowerCase();
            return hay.indexOf(term) !== -1;
        }).slice(0, 50);
        
        if (!filtered.length) {
            dropdown.innerHTML = '<div class="dropdown-item text-muted">No items found</div>';
            dropdown.style.display = 'block';
            return;
        }
        
        dropdown.innerHTML = filtered.map(function(item) {
            var isSelected = selectedItems.has(item.code);
            return '<div class="dropdown-item d-flex justify-content-between align-items-center' + (isSelected ? ' disabled text-muted' : ' js-sa-pick-item') + '" data-code="' + esc(item.code) + '" style="cursor:pointer;padding:8px 12px;border-bottom:1px solid #f1f5f9;">'
                + '<div style="flex:1;min-width:0;margin-right:10px;"><b style="font-size:12px;color:#1e293b;">' + esc(item.code) + '</b><div style="font-size:10px;color:#64748b;white-space:normal;text-overflow:ellipsis;overflow:hidden;">' + esc(item.description) + '</div></div>'
                + '<div style="flex-shrink:0;"><span style="font-size:11px;font-weight:700;color:#2563eb;">' + (item.uom || 'EA') + '</span></div>'
                + '</div>';
        }).join('');
        dropdown.style.display = 'block';
        
        // Add click handlers for pick item
        var items = dropdown.querySelectorAll('.js-sa-pick-item');
        Array.prototype.forEach.call(items, function(itemEl) {
            itemEl.addEventListener('click', function(ev) {
                var code = itemEl.getAttribute('data-code');
                var picked = allItems.find(function(x) { return x.code === code; });
                if (picked) {
                    selectItem(picked);
                    input.value = '';
                    dropdown.style.display = 'none';
                }
            });
        });
    }

    function selectItem(item) {
        if (selectedItems.has(item.code)) return;
        selectedItems.set(item.code, {
            code: item.code,
            description: item.description,
            uom: item.uom || 'EA',
            item_amount: item.item_amount || 0,
            quantity: 1,
            total: item.item_amount || 0
        });
        syncSelectionUi();
    }

    function deselectItem(code) {
        selectedItems.delete(code);
        syncSelectionUi();
    }

    function handleQtyChange(code, newQty) {
        var item = selectedItems.get(code);
        if (!item) return;
        item.quantity = Math.max(1, parseInt(newQty, 10) || 1);
        item.total = item.quantity * item.item_amount;
        
        var grandTotalCell = document.getElementById('sa-grand-total');
        var grandTotal = 0;
        selectedItems.forEach(function(it) {
            grandTotal += (it.quantity * it.item_amount);
        });
        if (grandTotalCell) grandTotalCell.textContent = '₹' + grandTotal.toLocaleString('en-IN', { minimumFractionDigits: 2 });
        
        // Update specific row total text
        var tbody = document.getElementById('sa-selected-body');
        if (tbody) {
            var row = tbody.querySelector('tr[data-code="' + esc(code) + '"]');
            if (row) {
                var totalCell = row.children[6];
                if (totalCell) {
                    var itemTotal = item.quantity * item.item_amount;
                    totalCell.innerHTML = '₹' + itemTotal.toLocaleString('en-IN', { minimumFractionDigits: 2 });
                }
            }
        }
    }

    function syncSelectionUi() {
        var tbody = document.getElementById('sa-selected-body');
        var grandTotalCell = document.getElementById('sa-grand-total');
        if (!tbody) return;

        if (selectedItems.size === 0) {
            tbody.innerHTML = '<tr id="sa-no-items"><td colspan="8" class="text-center py-4 text-muted">No items selected</td></tr>';
            if (grandTotalCell) grandTotalCell.textContent = '₹0.00';
            return;
        }

        var html = '';
        var idx = 0;
        var grandTotal = 0;
        
        selectedItems.forEach(function(item, code) {
            var itemTotal = item.quantity * item.item_amount;
            grandTotal += itemTotal;
            
            // Render row 1: columns
            html += '<tr data-code="' + esc(code) + '" style="border-bottom:none;">'
                + '<td>' + (idx + 1) + '</td>'
                + '<td><b>' + esc(code) + '</b></td>'
                + '<td>' + esc(item.description) + '</td>'
                + '<td>' + esc(item.uom) + '</td>'
                + '<td>₹' + item.item_amount.toLocaleString('en-IN', { minimumFractionDigits: 2 }) + '</td>'
                + '<td><input type="number" class="form-control form-control-sm js-sa-qty-input" min="1" value="' + item.quantity + '" data-code="' + esc(code) + '" style="width:70px;"></td>'
                + '<td>₹' + itemTotal.toLocaleString('en-IN', { minimumFractionDigits: 2 }) + '</td>'
                + '<td class="text-center">' + (currentStageNumber === 1 ? '<button type="button" class="btn btn-sm btn-outline-danger js-sa-remove-item" data-code="' + esc(code) + '" style="padding:2px 6px;"><i class="fa fa-trash"></i></button>' : '') + '</td>'
                + '</tr>';
                
            // Image upload sub-row — Stage 1 only
            if (currentStageNumber === 1) {
                html += '<tr class="item-images-row" data-code="' + esc(code) + '" style="border-top:none;">'
                    + '<td colspan="8" style="background:#f8fafc;padding:8px 12px;">'
                    + '<div class="d-flex align-items-center gap-3" style="padding-left:20px;">'
                    + '<span style="font-size:11px;font-weight:700;color:#64748b;"><i class="fa fa-camera me-1"></i>Upload Scrap Images:</span>'
                    + '<input type="file" class="form-control form-control-sm" name="images_' + idx + '[]" multiple accept="image/*" style="max-width:300px;">'
                    + '</div>'
                    + '</td>'
                    + '</tr>';
            }
                
            idx++;
        });

        tbody.innerHTML = html;
        if (grandTotalCell) grandTotalCell.textContent = '₹' + grandTotal.toLocaleString('en-IN', { minimumFractionDigits: 2 });

        // Bind events
        tbody.querySelectorAll('.js-sa-qty-input').forEach(function(input) {
            input.addEventListener('change', function() {
                handleQtyChange(input.getAttribute('data-code'), input.value);
            });
            input.addEventListener('input', function() {
                handleQtyChange(input.getAttribute('data-code'), input.value);
            });
        });

        tbody.querySelectorAll('.js-sa-remove-item').forEach(function(btn) {
            btn.addEventListener('click', function() {
                deselectItem(btn.getAttribute('data-code'));
            });
        });
    }

    function loadAllItems() {
        if (allItems.length) return Promise.resolve(allItems);
        if (itemsLoadPromise) return itemsLoadPromise;
        itemsLoading = true;
        
        var dropdown = document.getElementById('sa-item-dropdown');
        if (dropdown) {
            dropdown.innerHTML = '<div class="dropdown-item text-muted"><i class="fas fa-spinner fa-spin me-2"></i>Loading items...</div>';
            dropdown.style.display = 'block';
        }
        
        itemsLoadPromise = fetch('/get_item_codes.php', { credentials: 'same-origin' })
            .then(function (resp) { return resp.json(); })
            .then(function (data) {
                if (!data || data.success === false || !Array.isArray(data.data)) throw new Error('Invalid data');
                allItems = data.data.map(function (item) {
                    return {
                        code: String(item.code || item.item_code || '').trim(),
                        description: String(item.description || ''),
                        uom: item.unitOfMeasure || item.uom || 'EA',
                        item_amount: parseFloat(item.item_amount || item.item_price || 0),
                        disabled: !(item.unitOfMeasure || item.uom)
                    };
                }).filter(function (item) { return item.code !== ''; });
                return allItems;
            })
            .catch(function (err) {
                if (dropdown) {
                    dropdown.innerHTML = '<div class="dropdown-item text-danger">Error loading items: ' + esc(err.message) + '</div>';
                }
                return [];
            })
            .finally(function () {
                itemsLoading = false;
                itemsLoadPromise = null;
            });
        return itemsLoadPromise;
    }

    function openDetail(row) {
        if (!row) return;
        detailState.row = row;
        ensureDetailModal();

        var title = document.getElementById('sa-detail-title');
        if (title) title.textContent = 'Scrape Request Scrape #' + esc(row.track_scrap_id || row.scrape_id);

        var body = document.getElementById('sa-detail-body');
        if (body) body.innerHTML = '<div style="padding:36px;color:#64748b;text-align:center;"><i class="fa fa-spinner fa-spin me-2"></i>Loading details...</div>';
        
        var err = document.getElementById('sa-detail-error');
        if (err) err.style.display = 'none';

        if (detailModal) detailModal.show();

        fetchJson(apiUrl({ action: 'detail', scrape_id: row.scrape_id })).then(function (data) {
