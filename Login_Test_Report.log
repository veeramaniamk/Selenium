            try {
                bindThemeUploadUi();
                bindVideoBackgroundEvents(getBgVideoEl());
                loadSettings();
            } catch (e) {
                console.error('Persistence failed', e);
            }

            document.addEventListener('visibilitychange', () => {
                const video = getBgVideoEl();
                if (!video || !document.body.classList.contains('ed-bg-video-active')) return;
                if (document.hidden || prefersReducedMotion()) {
                    try {
                        video.pause();
                    } catch (e) {}
                } else {
                    video.play().catch(() => {});
                }
            });

