                    }
                }).then(function(res) {
                    return res.text().then(function(text) {
                        var data = null;
                        try {
                            data = text ? JSON.parse(text) : null;
                        } catch (e) {
                            data = null;
                        }
                        if (!res.ok || !data || data.success === false) {
                            return;
                        }
                        applyDashboardCounts(data.data || data);
                    });
                }).catch(function() {});
            }

            loadApprovalCounts();

            function runDashboardPrefetch() {
                const acc = getApprovalAccess();
                const modules = [{
                        mod: window.EDPurchaseApproval,
                        key: 'purchase'
                    },
                    {
                        mod: window.EDPaymentApproval,
                        key: 'payment'
                    },
                    {
                        mod: window.EDConsumableApproval,
