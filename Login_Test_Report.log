    function submitGrievance(e) {
        e.preventDefault();
        if (isSubmitting) return;
        setFormError('');

        var form = $('grv-raise-form');
        if (!form) return;

        var type    = (form.querySelector('[name="grievance_type"]') || {}).value || '';
        var details = (form.querySelector('[name="details"]')        || {}).value || '';
        var remedy  = (form.querySelector('[name="remedy_request"]') || {}).value || '';
        var file    = (form.querySelector('[name="gv_file"]')        || {});

        if (!type)    return setFormError('Please select a grievance type.');
        if (!details.trim()) return setFormError('Please provide grievance details.');

        isSubmitting = true;
        var btn = $('grv-submit-btn');
        if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Submitting…'; }

        var fd = new FormData(form);
        fd.set('grievance_type', type);
        fd.set('details', details);
        fd.set('remedy_request', remedy);

        fetch(API + '?action=submit', {
            method: 'POST',
            credentials: 'same-origin',
            body: fd,
        })
        .then(function (res) { return res.json(); })
        .then(function (json) {
            if (!json || !json.success) throw new Error((json && json.error) || 'Submission failed');
            if (raiseModal) raiseModal.hide();
            form.reset();
            var previewEl = $('grv-file-preview');
            if (previewEl) previewEl.style.display = 'none';
            showToast(json.message || 'Grievance submitted successfully.', 'success');
            loadPage(1); // reload list
        })
        .catch(function (err) { setFormError(err.message || 'Failed to submit grievance.'); })
        .finally(function () {
            isSubmitting = false;
            if (btn) { btn.disabled = false; btn.textContent = 'Submit Grievance'; }
        });
    }

