#page-hierarchy .hy-group-chip {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 700;
    color: #475569;
    background: linear-gradient(180deg, #fff, #f1f5f9);
    border: 1px solid rgba(0, 0, 0, 0.08);
}

#page-hierarchy .cr-search-wrap {
    position: relative;
    flex: 1 1 220px;
    min-width: 180px;
    max-width: 420px;
}

#page-hierarchy .cr-search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: #94a3b8;
    font-size: 12px;
    pointer-events: none;
}

#page-hierarchy .cr-search-inp {
    width: 100%;
    padding: 7px 12px 7px 32px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 999px;
    font-size: 12px;
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.06);
    color: #1e293b;
}

#page-hierarchy .cr-search-inp:focus {
    border-color: #0ea5e9;
    outline: none;
    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.14), inset 0 1px 2px rgba(0, 0, 0, 0.06);
}

#page-hierarchy .cr-toolbar-bar.is-disabled {
    opacity: 0.55;
    pointer-events: none;
}

#page-hierarchy .hy-tbl {
    min-width: 860px;
}

#page-hierarchy .hy-th-photo,
#page-hierarchy .hy-td-photo {
    width: 56px;
    text-align: center;
}

#page-hierarchy .hy-th-sno {
    width: 48px;
}

#page-hierarchy .hy-th-id {
    width: 90px;
}

#page-hierarchy .hy-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    margin: 0 auto;
    background: linear-gradient(145deg, #e2e8f0, #cbd5e1);
    border: 2px solid #fff;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.10);
    display: flex;
    align-items: center;
    justify-content: center;
}

#page-hierarchy .hy-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

#page-hierarchy .hy-avatar-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 800;
    color: #475569;
}

#page-hierarchy .hy-td-empty,
#page-hierarchy .hy-td-error {
    text-align: center;
    padding: 36px 16px !important;
    color: #64748b;
}

#page-hierarchy .hy-empty-inline {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    text-align: left;
    max-width: 420px;
}

#page-hierarchy .hy-empty-inline i {
    font-size: 28px;
    color: #cbd5e1;
    flex-shrink: 0;
}

#page-hierarchy .hy-empty-inline strong {
    display: block;
    font-size: 14px;
    color: #334155;
    margin-bottom: 4px;
}

#page-hierarchy .hy-empty-inline p {
    margin: 0;
    font-size: 12px;
    color: #64748b;
}

#page-hierarchy .hy-pager-label {
    font-size: 11px;
    font-weight: 600;
    color: #64748b;
    padding: 0 8px;
}

@media (max-width: 575.98px) {
    #page-hierarchy .hy-total-badge {
        display: none;
    }
}

/* ── Hierarchy team stats + detail modal ── */

#page-hierarchy .hy-cycle-toggle,
#hy-detail-modal .hy-detail-cycle {
    display: inline-flex;
    align-items: center;
    padding: 3px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.28);
    gap: 2px;
}

#page-hierarchy .hy-cycle-toggle {
    background: #f1f5f9;
    border: 1px solid rgba(15, 23, 42, 0.08);
}

#page-hierarchy .hy-cycle-btn,
#hy-detail-modal .hy-cycle-btn {
    border: 0;
    background: transparent;
    color: #64748b;
    font-size: 11px;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 999px;
    cursor: pointer;
    line-height: 1.2;
    white-space: nowrap;
}

#hy-detail-modal .hy-cycle-btn {
    color: rgba(255, 255, 255, 0.78);
}

#page-hierarchy .hy-cycle-btn.is-active {
    background: linear-gradient(180deg, #fff, #e0f2fe);
    color: #0369a1;
    box-shadow: 0 1px 2px rgba(14, 165, 233, 0.18);
}

#hy-detail-modal .hy-cycle-btn.is-active {
    background: #fff;
    color: #0369a1;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.18);
}

#page-hierarchy .hy-refresh-btn {
    width: 30px;
    height: 30px;
    margin-left: 4px;
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-radius: 50%;
    background: #fff;
    color: #0369a1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
}

#page-hierarchy .hy-refresh-btn:hover { background: #e0f2fe; }

#page-hierarchy .hy-stats {
    position: relative;
    padding: 12px 16px 10px;
    background: linear-gradient(180deg, #f8fbff 0%, #f1f5f9 100%);
    border-bottom: 1px solid rgba(15, 23, 42, 0.06);
}

#page-hierarchy .hy-stats.is-loading .hy-kpi-grid,
#page-hierarchy .hy-stats.is-loading .hy-trend-row {
    opacity: 0.45;
}

#page-hierarchy .hy-stats-skel {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 8px;
    margin-bottom: 8px;
}

#page-hierarchy .hy-skel-kpi {
    height: 58px;
    border-radius: 12px;
    background: linear-gradient(90deg, #e2e8f0 0%, #f1f5f9 45%, #e2e8f0 100%);
    background-size: 200% 100%;
    animation: hy-shimmer 1.2s ease-in-out infinite;
}

@keyframes hy-shimmer {
    0% { background-position: 100% 0; }
    100% { background-position: -100% 0; }
}

#page-hierarchy .hy-kpi-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 8px;
}

#page-hierarchy .hy-kpi {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border-radius: 12px;
    background: #fff;
    border: 1px solid rgba(15, 23, 42, 0.07);
    min-width: 0;
}

#page-hierarchy .hy-kpi-icon {
    width: 30px;
    height: 30px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #0369a1;
    background: #e0f2fe;
    font-size: 12px;
}

#page-hierarchy .hy-kpi-present .hy-kpi-icon { background: #dcfce7; color: #15803d; }
#page-hierarchy .hy-kpi-absent .hy-kpi-icon { background: #fee2e2; color: #b91c1c; }
#page-hierarchy .hy-kpi-leave .hy-kpi-icon { background: #dbeafe; color: #1d4ed8; }
#page-hierarchy .hy-kpi-att .hy-kpi-icon { background: #ede9fe; color: #6d28d9; }
#page-hierarchy .hy-kpi-lop .hy-kpi-icon { background: #ffedd5; color: #c2410c; }

#page-hierarchy .hy-kpi-body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
}

#page-hierarchy .hy-kpi-label {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #94a3b8;
}

#page-hierarchy .hy-kpi-val {
    font-size: 17px;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.1;
}

#page-hierarchy .hy-kpi-sub {
    font-size: 10px;
    color: #64748b;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

#page-hierarchy .hy-trend-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
}

#page-hierarchy .hy-trend-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 9px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    font-size: 10px;
    color: #334155;
}

#page-hierarchy .hy-trend-chip .hy-trend-lbl {
    color: #94a3b8;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 8px;
}

#page-hierarchy .hy-trend-chip.hy-trend-good { background: #f0fdf4; border-color: #bbf7d0; color: #166534; }
#page-hierarchy .hy-trend-chip.hy-trend-warn { background: #fff7ed; border-color: #fed7aa; color: #9a3412; }
#page-hierarchy .hy-trend-chip.hy-trend-late { background: #fff7ed; border-color: #fdba74; color: #c2410c; }
#page-hierarchy .hy-trend-chip.hy-trend-buf { background: #eff6ff; border-color: #bfdbfe; color: #1d4ed8; }

#page-hierarchy .hy-status-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-left: auto;
}

#page-hierarchy .hy-filter-chip {
    border: 1px solid rgba(15, 23, 42, 0.1);
    background: #fff;
    color: #64748b;
    font-size: 10px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 999px;
    cursor: pointer;
}

#page-hierarchy .hy-filter-chip.is-active { background: #0ea5e9; border-color: #0284c7; color: #fff; }
#page-hierarchy .hy-filter-chip.hy-filter-present.is-active { background: #16a34a; border-color: #15803d; }
#page-hierarchy .hy-filter-chip.hy-filter-absent.is-active { background: #dc2626; border-color: #b91c1c; }
#page-hierarchy .hy-filter-chip.hy-filter-leave.is-active { background: #2563eb; border-color: #1d4ed8; }

#page-hierarchy .hy-tbl { min-width: 980px; }
#page-hierarchy .hy-th-today,
#page-hierarchy .hy-th-att { width: 88px; }

#page-hierarchy .hy-avatar-btn {
    border: 2px solid #fff;
    padding: 0;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
}

#page-hierarchy .hy-avatar-btn:hover,
#page-hierarchy .hy-avatar-btn:focus-visible {
    transform: scale(1.06);
    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.28);
    outline: none;
}

#page-hierarchy .hy-avatar-md,
#hy-detail-modal .hy-avatar-md { width: 44px; height: 44px; }
#page-hierarchy .hy-avatar-lg,
#hy-detail-modal .hy-avatar-lg { width: 56px; height: 56px; }

#page-hierarchy .hy-name-btn {
    border: 0;
    background: none;
    padding: 0;
    color: #0f172a;
    font-weight: 700;
    cursor: pointer;
    text-align: left;
}

#page-hierarchy .hy-name-btn:hover { color: #0284c7; text-decoration: underline; }

#page-hierarchy .hy-att-pct { font-weight: 800; color: #0f172a; }
#page-hierarchy .hy-att-pct.is-good { color: #15803d; }
#page-hierarchy .hy-att-pct.is-ok { color: #c2410c; }
#page-hierarchy .hy-att-pct.is-bad { color: #b91c1c; }

#page-hierarchy .hy-muted,
#hy-detail-modal .hy-muted { color: #94a3b8; font-size: 11px; }

.hy-status {
    display: inline-flex;
    align-items: center;
    padding: 2px 7px;
    border-radius: 999px;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.02em;
    white-space: nowrap;
    background: #f1f5f9;
    color: #475569;
}

.hy-status-present { background: #dcfce7; color: #166534; }
.hy-status-absent { background: #fee2e2; color: #b91c1c; }
.hy-status-leave { background: #dbeafe; color: #1d4ed8; }
.hy-status-half-day { background: #ffedd5; color: #c2410c; }
.hy-status-late { background: #ffedd5; color: #ea580c; }
.hy-status-sandwich-lop { background: #fecaca; color: #991b1b; }
.hy-status-pending { background: #ffedd5; color: #9a3412; }
.hy-status-approved { background: #dcfce7; color: #166534; }
.hy-status-rejected { background: #fee2e2; color: #b91c1c; }
.hy-status-weekend,
.hy-status-off,
.hy-status-holiday { background: #f1f5f9; color: #64748b; }

/* Premium detail modal */
#hy-detail-modal .hy-detail-dialog {
    max-width: 980px;
    width: calc(100% - 32px);
    margin: 1rem auto;
}

#hy-detail-modal .hy-detail-content {
    border: 0;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.28);
}

#hy-detail-modal .hy-detail-hdr {
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 55%, #0c4a6e 100%);
    color: #fff;
    border: 0;
    padding: 14px 16px 12px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
}

#hy-detail-modal .hy-detail-hdr-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
}

#hy-detail-modal .hy-detail-hdr .btn-close {
    filter: invert(1) grayscale(100%) brightness(200%);
    opacity: 0.9;
    margin: 2px 0 0;
    flex-shrink: 0;
}

#hy-detail-modal .hy-detail-hdr-main {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    flex: 1;
}

#hy-detail-modal .hy-detail-hdr-text { min-width: 0; }

#hy-detail-modal .hy-detail-cycle {
    width: 100%;
    max-width: 320px;
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.28);
}

#hy-detail-modal .hy-cycle-short { display: none; }
#hy-detail-modal .hy-cycle-full { display: inline; }

#hy-detail-modal .hy-detail-avatar .hy-avatar {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    overflow: hidden;
    background: linear-gradient(145deg, #e2e8f0, #cbd5e1);
    border: 2px solid rgba(255, 255, 255, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.22);
    flex-shrink: 0;
}

#hy-detail-modal .hy-detail-avatar .hy-avatar-skel {
    background: linear-gradient(90deg, rgba(255,255,255,0.25), rgba(255,255,255,0.45), rgba(255,255,255,0.25));
    background-size: 200% 100%;
    animation: hy-shimmer 1.2s ease-in-out infinite;
}

#hy-detail-modal .hy-detail-avatar .hy-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

#hy-detail-modal .hy-detail-avatar .hy-avatar-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 800;
    color: #475569;
}

#hy-detail-modal .modal-title {
    font-size: 18px;
    font-weight: 800;
    margin: 0;
    color: #fff;
    line-height: 1.25;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

#hy-detail-modal .hy-detail-meta {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.88);
    margin-top: 3px;
    line-height: 1.35;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

#hy-detail-modal .hy-detail-body {
    padding: 16px 18px 18px;
    background: #f5f7fb;
    max-height: min(82vh, 760px);
}

#hy-detail-modal .hy-detail-loading {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 320px;
}

#hy-detail-modal .hy-skel-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 14px;
}

#hy-detail-modal .hy-skel-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

#hy-detail-modal .hy-skel-pill,
#hy-detail-modal .hy-skel-quick span,
#hy-detail-modal .hy-skel-cal-grid i,
#hy-detail-modal .hy-skel-leave-grid b,
#hy-detail-modal .hy-skel-line {
    display: block;
    border-radius: 8px;
    background: linear-gradient(90deg, #e2e8f0 0%, #f8fafc 45%, #e2e8f0 100%);
    background-size: 200% 100%;
    animation: hy-shimmer 1.2s ease-in-out infinite;
}

#hy-detail-modal .hy-skel-pill { width: 110px; height: 24px; border-radius: 999px; }
#hy-detail-modal .hy-skel-quick {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 8px;
}
#hy-detail-modal .hy-skel-quick span { height: 58px; border-radius: 12px; }
#hy-detail-modal .hy-skel-split {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 12px;
}
#hy-detail-modal .hy-skel-line { height: 12px; margin-bottom: 10px; }
#hy-detail-modal .hy-skel-line.w-30 { width: 30%; }
#hy-detail-modal .hy-skel-line.w-40 { width: 40%; }
#hy-detail-modal .hy-skel-line.w-55 { width: 55%; }
#hy-detail-modal .hy-skel-line.w-70 { width: 70%; }
#hy-detail-modal .hy-skel-cal-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 6px;
    margin-top: 12px;
}
#hy-detail-modal .hy-skel-cal-grid i {
    aspect-ratio: 1;
    width: 100%;
    border-radius: 10px;
}
#hy-detail-modal .hy-skel-leave-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 12px 0 14px;
}
#hy-detail-modal .hy-skel-leave-grid b { height: 64px; border-radius: 12px; }

#hy-detail-modal .hy-detail-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
}

#hy-detail-modal .hy-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid #e2e8f0;
    font-size: 11px;
    font-weight: 600;
    color: #475569;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
}

#hy-detail-modal .hy-chip i { color: #0ea5e9; font-size: 10px; flex-shrink: 0; }
#hy-detail-modal .hy-chip-dept { background: #eff6ff; border-color: #bfdbfe; color: #1d4ed8; }
#hy-detail-modal .hy-chip-status { background: #dcfce7; border-color: #bbf7d0; color: #166534; }

#hy-detail-modal .hy-quick-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 8px;
    margin-bottom: 14px;
}

#hy-detail-modal .hy-quick-stat {
    background: #fff;
    border: 1px solid rgba(15, 23, 42, 0.07);
    border-radius: 12px;
    padding: 10px 11px;
    min-width: 0;
    border-top: 3px solid #cbd5e1;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);
}

#hy-detail-modal .hy-qs-present { border-top-color: #22c55e; }
#hy-detail-modal .hy-qs-absent,
#hy-detail-modal .hy-qs-lop { border-top-color: #ef4444; }
#hy-detail-modal .hy-qs-att { border-top-color: #8b5cf6; }
#hy-detail-modal .hy-qs-buf,
#hy-detail-modal .hy-qs-in { border-top-color: #0ea5e9; }
#hy-detail-modal .hy-qs-out { border-top-color: #f97316; }

#hy-detail-modal .hy-quick-lbl {
    display: block;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #94a3b8;
    margin-bottom: 3px;
}

#hy-detail-modal .hy-quick-stat strong {
    font-size: 14px;
    color: #0f172a;
    word-break: break-word;
}

#hy-detail-modal .hy-detail-split {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 12px;
    align-items: start;
}

#hy-detail-modal .hy-detail-section {
    background: #fff;
    border: 1px solid rgba(15, 23, 42, 0.07);
    border-radius: 14px;
    padding: 14px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);
}

#hy-detail-modal .hy-detail-sec-hd {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 10px;
}

#hy-detail-modal .hy-detail-sec-hd h6 {
    margin: 0;
    font-size: 13px;
    font-weight: 800;
    color: #0f172a;
}

#hy-detail-modal .hy-detail-cycle-lbl {
    margin: 3px 0 0;
    font-size: 11px;
    color: #64748b;
    font-weight: 600;
}

#hy-detail-modal .hy-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    margin-bottom: 10px;
}

#hy-detail-modal .hy-leg-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    font-weight: 700;
    color: #64748b;
}

#hy-detail-modal .hy-leg-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
}

#hy-detail-modal .hy-cal-shell {
    background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 12px;
}

#hy-detail-modal .hy-cal-dow,
#hy-detail-modal .hy-cal-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 6px;
    width: 100%;
}

#hy-detail-modal .hy-cal-dow {
    margin-bottom: 6px;
}

#hy-detail-modal .hy-cal-dow span {
    width: auto;
    text-align: center;
    font-size: 10px;
    font-weight: 800;
    color: #94a3b8;
    text-transform: uppercase;
}

#hy-detail-modal .hy-day {
    width: 100%;
    aspect-ratio: 1;
    min-height: 0;
    height: auto;
    border: 1px solid transparent;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 800;
    cursor: pointer;
    color: #334155;
    background: #fff;
    padding: 0;
    line-height: 1;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05);
}

#hy-detail-modal .hy-day-num { pointer-events: none; }

#hy-detail-modal .hy-day-empty {
    background: transparent;
    border: 0;
    box-shadow: none;
    pointer-events: none;
    cursor: default;
}

#hy-detail-modal .hy-day-future {
    background: #f1f5f9;
    color: #94a3b8;
    border-color: #e2e8f0;
    box-shadow: none;
}

#hy-detail-modal .hy-day-present {
    background: linear-gradient(180deg, #4ade80, #16a34a);
    color: #fff;
    border-color: #15803d;
}
#hy-detail-modal .hy-day-absent {
    background: linear-gradient(180deg, #f87171, #dc2626);
    color: #fff;
    border-color: #b91c1c;
}
#hy-detail-modal .hy-day-leave {
    background: linear-gradient(180deg, #60a5fa, #2563eb);
    color: #fff;
    border-color: #1d4ed8;
}
#hy-detail-modal .hy-day-late {
    background: linear-gradient(180deg, #fb923c, #ea580c);
    color: #fff;
    border-color: #c2410c;
}
#hy-detail-modal .hy-day-half-day {
    background: linear-gradient(180deg, #fbbf24, #d97706);
    color: #fff;
    border-color: #b45309;
}
#hy-detail-modal .hy-day-sandwich-lop {
    background: linear-gradient(180deg, #f87171, #991b1b);
    color: #fff;
    border-color: #7f1d1d;
}
#hy-detail-modal .hy-day-holiday {
    background: linear-gradient(180deg, #c084fc, #9333ea);
    color: #fff;
    border-color: #7e22ce;
}
#hy-detail-modal .hy-day-off {
    background: linear-gradient(180deg, #cbd5e1, #94a3b8);
    color: #fff;
    border-color: #64748b;
}
#hy-detail-modal .hy-day-weekend {
    background: #e2e8f0;
    color: #64748b;
    border-color: #cbd5e1;
}
#hy-detail-modal .hy-day-pending {
    background: linear-gradient(180deg, #fdba74, #fb923c);
    color: #fff;
    border-color: #ea580c;
}

#hy-detail-modal .hy-day:hover:not(.hy-day-empty),
#hy-detail-modal .hy-day:focus-visible:not(.hy-day-empty),
#hy-detail-modal .hy-day.is-selected {
    outline: 2px solid #0284c7;
    outline-offset: 1px;
    z-index: 1;
}

#hy-detail-modal .hy-cal-tip {
    margin-top: 8px;
    font-size: 11px;
    color: #64748b;
    font-weight: 600;
    min-height: 16px;
}

#hy-detail-modal .hy-att-summary { margin-top: 12px; }

#hy-detail-modal .hy-att-count-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
}

#hy-detail-modal .hy-daylog {
    max-height: 180px;
    overflow: auto;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    background: #fff;
    -webkit-overflow-scrolling: touch;
}

#hy-detail-modal .hy-daylog-hd {
    position: sticky;
    top: 0;
    background: #f8fafc;
    padding: 7px 10px;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #94a3b8;
    border-bottom: 1px solid #e2e8f0;
}

#hy-detail-modal .hy-daylog-row {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto;
    gap: 8px;
    align-items: center;
    padding: 7px 10px;
    border-bottom: 1px solid #f1f5f9;
    font-size: 11px;
}

#hy-detail-modal .hy-daylog-date { font-weight: 700; color: #0f172a; }
#hy-detail-modal .hy-daylog-times {
    color: #64748b;
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

#hy-detail-modal .hy-leave-bal {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin-bottom: 12px;
}

#hy-detail-modal .hy-leave-chip {
    padding: 10px;
    border-radius: 12px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

#hy-detail-modal .hy-leave-chip strong {
    font-size: 11px;
    font-weight: 800;
}

#hy-detail-modal .hy-leave-chip span {
    font-size: 18px;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.1;
}

#hy-detail-modal .hy-leave-chip em {
    font-style: normal;
    font-size: 9px;
    color: #64748b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

#hy-detail-modal .hy-leave-cl { background: #eff6ff; border-color: #bfdbfe; }
#hy-detail-modal .hy-leave-cl strong { color: #1d4ed8; }
#hy-detail-modal .hy-leave-sl { background: #fef2f2; border-color: #fecaca; }
#hy-detail-modal .hy-leave-sl strong { color: #b91c1c; }
#hy-detail-modal .hy-leave-el { background: #f0fdf4; border-color: #bbf7d0; }
#hy-detail-modal .hy-leave-el strong { color: #15803d; }
#hy-detail-modal .hy-leave-al { background: #faf5ff; border-color: #e9d5ff; }
#hy-detail-modal .hy-leave-al strong { color: #7e22ce; }
#hy-detail-modal .hy-leave-vl { background: #fff7ed; border-color: #fed7aa; }
#hy-detail-modal .hy-leave-vl strong { color: #c2410c; }
#hy-detail-modal .hy-leave-rh { background: #f8fafc; border-color: #cbd5e1; }
#hy-detail-modal .hy-leave-rh strong { color: #475569; }

#hy-detail-modal .hy-leave-hist-hd {
    font-size: 10px;
    font-weight: 800;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 8px;
}

#hy-detail-modal .hy-leave-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 0;
    border-bottom: 1px solid #f1f5f9;
    font-size: 12px;
}

#hy-detail-modal .hy-detail-error {
    padding: 10px 12px;
    border-radius: 10px;
    background: #fef2f2;
    color: #b91c1c;
    font-size: 12px;
    font-weight: 600;
}

@media (max-width: 1199.98px) {
    #page-hierarchy .hy-kpi-grid,
    #page-hierarchy .hy-stats-skel { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}

@media (max-width: 991.98px) {
    #hy-detail-modal .hy-detail-split,
    #hy-detail-modal .hy-skel-split { grid-template-columns: 1fr; }
    #hy-detail-modal .hy-quick-grid,
    #hy-detail-modal .hy-skel-quick { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    #hy-detail-modal .hy-detail-cycle {
        max-width: none;
    }
}

@media (max-width: 767.98px) {
    #page-hierarchy .hy-kpi-grid,
    #page-hierarchy .hy-stats-skel { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #page-hierarchy .hy-kpi {
        padding: 10px;
    }
    #page-hierarchy .hy-kpi-val { font-size: 16px; }
    #page-hierarchy .cr-toolbar-bar {
        flex-direction: column;
        align-items: stretch;
        gap: 8px;
    }
    #page-hierarchy .hy-status-filters {
        margin-left: 0;
        width: 100%;
    }
    #page-hierarchy .hy-filter-chip {
        flex: 1 1 auto;
        text-align: center;
        min-height: 34px;
    }
    #page-hierarchy .cr-win-bar {
        gap: 8px;
    }
    #page-hierarchy .hy-cycle-toggle {
        width: 100%;
        justify-content: stretch;
    }
    #page-hierarchy .hy-cycle-toggle .hy-cycle-btn {
        flex: 1;
        text-align: center;
        min-height: 34px;
    }

    #hy-detail-modal.modal {
        padding: 0 !important;
    }

    #hy-detail-modal .hy-detail-dialog {
        margin: 0;
        max-width: 100%;
        width: 100%;
        height: 100%;
        max-height: 100%;
    }

    #hy-detail-modal .modal-dialog-scrollable {
        height: 100%;
    }

    #hy-detail-modal .modal-dialog-scrollable .modal-content {
        max-height: 100%;
        height: 100%;
    }

    #hy-detail-modal .hy-detail-content {
        border-radius: 0;
        min-height: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    #hy-detail-modal .hy-detail-hdr {
        padding: 12px 12px 10px;
        padding-top: max(12px, env(safe-area-inset-top));
        flex-shrink: 0;
    }

    #hy-detail-modal .hy-detail-avatar .hy-avatar {
        width: 44px;
        height: 44px;
    }

    #hy-detail-modal .modal-title {
        font-size: 15px;
        white-space: normal;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    #hy-detail-modal .hy-detail-meta {
        font-size: 11px;
        white-space: normal;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    #hy-detail-modal .hy-detail-cycle {
        width: 100%;
        max-width: none;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
        padding: 3px;
    }

    #hy-detail-modal .hy-cycle-btn {
        width: 100%;
        min-height: 36px;
        font-size: 12px;
        padding: 8px 10px;
    }

    #hy-detail-modal .hy-cycle-full { display: none; }
    #hy-detail-modal .hy-cycle-short { display: inline; }

    #hy-detail-modal .hy-detail-body {
        flex: 1 1 auto;
        max-height: none;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        padding: 12px;
        padding-bottom: max(16px, env(safe-area-inset-bottom));
    }

    #hy-detail-modal .hy-quick-grid,
    #hy-detail-modal .hy-skel-quick {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
    }

    #hy-detail-modal .hy-quick-stat {
        padding: 12px;
    }

    #hy-detail-modal .hy-quick-lbl { font-size: 10px; }
    #hy-detail-modal .hy-quick-stat strong { font-size: 16px; }

    #hy-detail-modal .hy-detail-section {
        padding: 12px;
        border-radius: 12px;
    }

    #hy-detail-modal .hy-cal-shell {
        padding: 10px;
    }

    #hy-detail-modal .hy-cal-dow,
    #hy-detail-modal .hy-cal-grid {
        gap: 5px;
    }

    #hy-detail-modal .hy-cal-dow span {
        font-size: 9px;
    }

    #hy-detail-modal .hy-day {
        border-radius: 8px;
        font-size: 12px;
        min-height: 40px;
        aspect-ratio: 1;
    }

    #hy-detail-modal .hy-legend {
        gap: 8px;
    }

    #hy-detail-modal .hy-leg-item {
        font-size: 11px;
    }

    #hy-detail-modal .hy-daylog {
        max-height: 220px;
    }

    #hy-detail-modal .hy-daylog-row {
        grid-template-columns: 64px minmax(0, 1fr);
        grid-template-areas:
            "date status"
            "times status";
        gap: 2px 8px;
        padding: 10px;
    }

    #hy-detail-modal .hy-daylog-date { grid-area: date; }
    #hy-detail-modal .hy-daylog-times { grid-area: times; white-space: normal; }
    #hy-detail-modal .hy-daylog-row .hy-status {
        grid-area: status;
        justify-self: end;
        align-self: center;
    }

    #hy-detail-modal .hy-leave-bal {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
    }

    #hy-detail-modal .hy-leave-chip {
        padding: 12px;
    }

    #hy-detail-modal .hy-leave-chip span {
        font-size: 20px;
    }

    #hy-detail-modal .hy-chip {
        font-size: 12px;
        padding: 7px 11px;
        max-width: 100%;
    }

    #hy-detail-modal .hy-detail-contact {
        gap: 6px;
    }

    #hy-detail-modal .hy-skel-split { grid-template-columns: 1fr; }
    #hy-detail-modal .hy-skel-leave-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 419.98px) {
    #hy-detail-modal .hy-leave-bal {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    #page-hierarchy .hy-kpi-label {
        font-size: 8px;
    }
}


/* ═══════════════════════════════════════════════════════════════
   MOBILE / TABLET — block layout + body scroll (iOS-safe)
   Flex nested scroll is unreliable on mobile; use normal document flow.
   ═══════════════════════════════════════════════════════════════ */
@media (max-width: 991.98px) {
    html {
        height: auto !important;
        overflow-x: hidden !important;
        overflow-y: auto !important;
        -webkit-overflow-scrolling: touch;
    }

    body {
        display: block !important;
        height: auto !important;
        min-height: 100dvh !important;
        max-height: none !important;
        overflow-x: hidden !important;
        overflow-y: auto !important;
        -webkit-overflow-scrolling: touch;
    }

    #hdr {
        position: sticky;
        top: 0;
        z-index: 101;
    }

    #layout {
        display: block !important;
        height: auto !important;
        min-height: 0 !important;
        overflow: visible !important;
    }

    #main {
        display: block !important;
        width: 100% !important;
        height: auto !important;
        min-height: calc(100dvh - 60px) !important;
        max-height: none !important;
        overflow: visible !important;
        overscroll-behavior: auto !important;
        touch-action: manipulation !important;
        padding-bottom: max(28px, env(safe-area-inset-bottom, 28px)) !important;
        background-attachment: scroll !important;
    }

    .page,
    .page.active {
        max-width: 100% !important;
        min-width: 0 !important;
        min-height: 0 !important;
        height: auto !important;
        box-sizing: border-box !important;
        overflow: visible !important;
    }

    .tm-tab.active,
    .page.active {
        animation: none !important;
    }

    /* All dashboard pages — no height cages */
    [id^="page-"] {
        height: auto !important;
        max-height: none !important;
        overflow: visible !important;
    }

    [id^="page-"] .row,
    [id^="page-"] [class*="col-"] {
        height: auto !important;
        max-height: none !important;
    }

    .tm-tab,
    .tm-tab.active,
    #t-att,
    #t-duty,
    #t-leave {
        height: auto !important;
        max-height: none !important;
        overflow: visible !important;
    }

    /* Table/list regions: horizontal scroll only; page scrolls vertically */
    .ed-hscroll,
    .pr-table-wrap,
    .cr-table-wrap,
    .cn-table-wrap,
    #page-project-request.page.active .pr-table-wrap,
    #page-project-request .pr-table-wrap,
    #page-claim-request.page.active .cr-table-wrap,
    #page-event-request.page.active .cr-table-wrap,
    #page-consumable-request.page.active .cn-table-wrap,
    #page-equipment-entry.page.active .cr-table-wrap,
    #page-overtime.page.active .cr-table-wrap,
    #page-grievance.page.active .cr-table-wrap,
    #page-duty-wall.page.active .cr-table-wrap,
    #page-hierarchy.page.active .cr-table-wrap,
    #page-approvals:not(.appr-split-mode) #appr-table-shell,
    #page-approvals:not(.appr-split-mode) #appr-table-shell > div:last-child,
    .cr-request-page .cr-table-wrap,
    #page-home .tm-tab-table-wrap,
    #page-home .lv-scroll-wrap,
    #page-notifications .card,
    #page-settings .card,
    #page-salary .rep-card,
    #page-reports-360 .rep-card,
    #page-ph .card {
        max-height: none !important;
        height: auto !important;
        overflow-y: visible !important;
        overflow-x: auto !important;
        -webkit-overflow-scrolling: touch;
        touch-action: pan-x pan-y;
    }

    /* Card shells must not clip content below the fold */
    .pr-card-shell,
    .cr-card-shell,
    .cn-card-shell,
    #page-project-request .pr-card-shell,
    .cr-request-page .cr-card-shell,
    #page-overtime .cr-card-shell,
    #page-grievance .cr-card-shell,
    #page-duty-wall .cr-card-shell,
    #page-hierarchy .cr-card-shell,
    #page-proReview .cr-card-shell,
    #page-consumable-request .cn-card-shell,
    #page-approvals:not(.appr-split-mode) .appr-main-card,
    #page-consumable-request .cn-card-shell {
        overflow: visible !important;
        height: auto !important;
        max-height: none !important;
    }

    /* Approval category tabs — horizontal swipe (must NOT be overflow:visible) */
    #page-approvals #appr-cat-wrap {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        overflow-x: auto !important;
        overflow-y: hidden !important;
        -webkit-overflow-scrolling: touch !important;
        touch-action: pan-x pan-y !important;
        overscroll-behavior-x: contain;
        scrollbar-width: thin;
    }

    #page-approvals #appr-cat-wrap #cat-row {
        display: flex !important;
        flex-wrap: nowrap !important;
        gap: 4px;
        width: max-content !important;
        min-width: 100%;
    }

    #page-approvals #appr-cat-wrap .cat-tab {
        flex: 0 0 auto !important;
        flex-shrink: 0 !important;
    }

    /* Approvals — table mode: full page scroll */
    #page-approvals:not(.appr-split-mode).page.active {
        display: block !important;
        height: auto !important;
        overflow: visible !important;
    }

    /* Approvals — split panels stack and scroll with #main */
    #page-approvals.appr-split-mode.page.active {
        display: block !important;
        height: auto !important;
        min-height: 0 !important;
        max-height: none !important;
        overflow: visible !important;
        padding-bottom: max(20px, env(safe-area-inset-bottom, 20px)) !important;
    }

    #page-approvals.appr-split-mode .appr-main-card,
    #page-approvals.appr-split-mode .appr-split-panel,
    #page-approvals.appr-split-mode #ea-request-pane,
    #page-approvals.appr-split-mode #ea-bill-pane,
    #page-approvals.appr-split-mode #ea-fund-pane,
    #page-approvals.appr-split-mode #appr-claim-panel {
        flex: none !important;
        min-height: 0 !important;
        max-height: none !important;
        overflow: visible !important;
    }

    #page-approvals .cr-approvals-wrap,
    #page-approvals #ea-request-wrap,
    #page-approvals #ea-bill-wrap,
    #page-approvals #ea-fund-wrap,
    #page-approvals #ca-approvals-wrap {
        display: grid !important;
        grid-template-columns: 1fr !important;
        grid-template-rows: auto auto auto !important;
        height: auto !important;
        max-height: none !important;
        min-height: 0 !important;
        overflow: visible !important;
    }

    #page-approvals .cr-pending-list {
        max-height: min(42vh, 280px) !important;
        overflow-y: auto !important;
        -webkit-overflow-scrolling: touch;
    }

    #page-approvals .cr-file-viewport {
        min-height: min(62vh, 560px) !important;
        max-height: min(72vh, 720px) !important;
    }

    /* Claim / event request approver sub-tabs */
    .cr-request-page.page.active:has(#cr-tab-approvals.active),
    .cr-request-page.page.active:has(#er-tab-approvals.active) {
        display: block !important;
        min-height: 0 !important;
        height: auto !important;
        overflow: visible !important;
    }

    #page-claim-request .cr-approvals-wrap,
    #page-event-request .cr-approvals-wrap {
        grid-template-rows: auto auto auto !important;
        min-height: 0 !important;
        max-height: none !important;
        overflow: visible !important;
    }

    .cr-request-page .cr-approvals-wrap {
        grid-template-rows: auto auto auto !important;
        min-height: 0 !important;
        max-height: none !important;
        overflow: visible !important;
    }

    .cr-request-page .cr-file-pane,
    .cr-request-page .cr-pending-sidebar,
    .cr-request-page .cr-approval-panel {
        min-height: 0 !important;
        max-height: none !important;
        height: auto !important;
    }

    /* Settings / reports / notifications — natural flow */
    #page-settings .set-layout,
    #page-salary .rep-shell,
    #page-reports-360 .rep-shell,
    #page-notifications .row,
    #page-ph .row {
        overflow: visible !important;
    }

    #page-home .col-12.col-lg-7 > .card,
    #page-home .lv-tab-body {
        max-height: none !important;
        overflow: visible !important;
    }

    /* ── Horizontal scroll strips (tables, chips, tabs) ── */
    .ed-hscroll,
    .lv-chip-row,
    #t-duty > .ed-hscroll,
    .chip-scroll-row,
    #appr-cat-wrap.appr-cat-scroll,
    #page-approvals #appr-cat-wrap {
        overflow-x: auto !important;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
