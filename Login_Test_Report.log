/* ---- Status hero ---- */
.era-hero {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 18px 18px 16px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.7);
    background: linear-gradient(165deg, #ffffff 0%, #f8fafc 100%);
    box-shadow:
        0 8px 24px -12px rgba(15, 23, 42, 0.18),
        inset 0 1px 0 #fff,
        0 0 0 1px rgba(15, 23, 42, 0.04);
}

.era-hero.is-flagged {
    background: linear-gradient(165deg, #fff5f5 0%, #fff 70%);
    border-color: #fecaca;
}
.era-hero.is-review {
    background: linear-gradient(165deg, #fffbeb 0%, #fff 70%);
    border-color: #fde68a;
}
.era-hero.is-ok {
    background: linear-gradient(165deg, #f0fdf4 0%, #fff 70%);
    border-color: #bbf7d0;
}

.era-hero-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.5),
        0 4px 10px rgba(15, 23, 42, 0.12);
}

.era-hero.is-flagged .era-hero-icon {
    background: linear-gradient(180deg, #fb7185, #e11d48);
    color: #fff;
}
.era-hero.is-review .era-hero-icon {
    background: linear-gradient(180deg, #fbbf24, #d97706);
    color: #fff;
}
.era-hero.is-ok .era-hero-icon {
    background: linear-gradient(180deg, #4ade80, #16a34a);
    color: #fff;
}

.era-hero-body { flex: 1; min-width: 0; }

.era-hero-kicker {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 4px;
    color: #64748b;
}
.era-hero.is-flagged .era-hero-kicker { color: #be123c; }
.era-hero.is-review .era-hero-kicker { color: #b45309; }
.era-hero.is-ok .era-hero-kicker { color: #15803d; }

.era-hero-title {
    font-size: clamp(16px, 2.6vw, 19px);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: #0f172a;
    margin: 0 0 6px;
    line-height: 1.25;
}

.era-hero-text {
    font-size: 13.5px;
    font-weight: 500;
    color: #475569;
    margin: 0;
    line-height: 1.5;
}

.era-hero-text strong { color: #0f172a; font-weight: 700; }

.era-checklist {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 14px;
}

.era-check {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 12px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(226, 232, 240, 0.95);
    box-shadow: inset 0 1px 0 #fff, 0 1px 2px rgba(15, 23, 42, 0.04);
    min-width: 0;
}

.era-check-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    flex-shrink: 0;
    margin-top: 1px;
}
.era-check-dot.ok { background: #dcfce7; color: #15803d; }
.era-check-dot.warn { background: #fef3c7; color: #b45309; }
.era-check-dot.bad { background: #fee2e2; color: #be123c; }

.era-check-label {
    font-size: 11px;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 2px;
}
.era-check-value {
    font-size: 13px;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
    line-height: 1.3;
    word-break: break-word;
}

/* ---- Section shell ---- */
.era-panel {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    border: 1px solid rgba(226, 232, 240, 0.95);
    border-radius: 16px;
    padding: 16px;
    box-shadow:
        0 6px 18px -10px rgba(15, 23, 42, 0.14),
        inset 0 1px 0 #fff;
}

.era-panel + .era-panel,
.era-section + .era-section,
.amodal-section + .amodal-section {
    margin-top: 14px;
}

.era-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
    flex-wrap: wrap;
}

.era-section-head h4 {
    margin: 0;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #64748b;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.era-section-head h4 i {
    color: #94a3b8;
}

.era-section-note {
    font-size: 12px;
    font-weight: 600;
    color: #94a3b8;
}

/* ---- Amount cards (macOS tiles) ---- */
#conferenceDuplicateAuditModal .era-metric-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
}

#conferenceDuplicateAuditModal .era-metric-card {
    position: relative;
    background: linear-gradient(165deg, #ffffff 0%, #f1f5f9 100%);
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 14px 14px 12px;
    box-shadow:
        inset 0 1px 0 #fff,
        0 4px 12px -6px rgba(15, 23, 42, 0.12);
    min-width: 0;
    overflow: hidden;
}

#conferenceDuplicateAuditModal .era-metric-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: #cbd5e1;
}

#conferenceDuplicateAuditModal .era-metric-card.is-match::before {
    background: linear-gradient(90deg, #22c55e, #86efac);
}
#conferenceDuplicateAuditModal .era-metric-card.is-mismatch::before,
#conferenceDuplicateAuditModal .era-metric-card.is-missing::before {
    background: linear-gradient(90deg, #ef4444, #fca5a5);
}
#conferenceDuplicateAuditModal .era-metric-card.is-neutral::before {
    background: linear-gradient(90deg, #64748b, #cbd5e1);
}

#conferenceDuplicateAuditModal .era-metric-label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #64748b;
    margin: 0 0 8px;
    line-height: 1.3;
}

#conferenceDuplicateAuditModal .era-metric-value {
    font-size: clamp(18px, 3.2vw, 24px);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #0f172a;
