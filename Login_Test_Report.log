        rows = rows.filter(function (r) { return rowMatchesFilters(r, tab); });

        if (!rows.length) {
            body.innerHTML = '<tr><td colspan="7" class="pa-empty-cell">No privilege ' + (tab === 'history' ? 'history' : 'requests') + ' found</td></tr>';
            return true;
        }

        body.innerHTML = rows.map(function (row) {
            var requester = '<div style="display:flex;align-items:center;gap:9px">'
                + '<div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#e0e7ff,#c7d2fe);display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden">'
