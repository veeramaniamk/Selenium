    function handleDutyClaim(btn) {
        var dutyDate = btn.getAttribute('data-duty-date');
        var creditType = btn.getAttribute('data-credit-type');
        if (!dutyDate || !creditType || dutyClaiming) return;

        var card = btn.closest('.clm-duty-cr');
        var select = card ? card.querySelector('.clm-duty-claim-type') : null;
        var claimType = select ? select.value : '';
        if (!claimType) {
            toast('Please select CL or Encashment.', 'info');
            return;
        }

        var creditLabel = creditType;
        if (dutyState && dutyState.rows) {
            for (var r = 0; r < dutyState.rows.length; r++) {
                var row = dutyState.rows[r];
                if (row.duty_date !== dutyDate) continue;
                var credits = row.credits || [];
                for (var c = 0; c < credits.length; c++) {
                    if (credits[c].type === creditType) {
                        creditLabel = credits[c].label || creditType;
                        break;
                    }
                }
            }
        }

        if (!window.confirm('Claim 1 CL / 1 day (' + claimType + ') for ' + creditLabel + '?')) return;

        dutyClaiming = true;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i>';

        fetch(dutyApiUrl(), {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                Accept: 'application/json',
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                duty_date: dutyDate,
                credit_type: creditType,
                claim_type: claimType,
            }),
        })
            .then(function (r) {
                return r.json().then(function (j) { return { ok: r.ok, json: j }; });
            })
            .then(function (res) {
                if (!res.ok || !res.json || !res.json.success) {
                    throw new Error((res.json && res.json.error) || 'Claim failed');
                }
                showSuccessOverlay(res.json.data || {});
                dutyLoaded = false;
                if (res.json.data && res.json.data.pending_count != null) {
                    updateDutyPendingBadge(res.json.data.pending_count);
                }
                return fetchDutyOverview(true);
            })
            .catch(function (err) {
                toast(err.message || 'Unable to submit claim.', 'error');
            })
            .finally(function () {
                dutyClaiming = false;
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa fa-gift"></i> Claim';
                }
            });
    }

