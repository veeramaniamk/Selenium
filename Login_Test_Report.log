        .pa-boq-tbl {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

        .pa-boq-tbl thead th {
            font-size: 9px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: #64748b;
            padding: 9px 10px;
            background: linear-gradient(180deg, #f4f5f9, #dcdee5);
            border-bottom: 1px solid rgba(0, 0, 0, 0.12);
            white-space: nowrap;
        }

        .pa-boq-tbl tbody td {
            font-size: 12px;
            padding: 10px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.06);
            vertical-align: top;
            white-space: normal;
            word-break: break-word;
        }

        .pa-boq-tbl tbody tr:nth-child(odd) td {
            background: rgba(255, 255, 255, 0.8);
        }

        .pa-boq-tbl tbody tr:nth-child(even) td {
            background: rgba(244, 246, 250, 0.7);
        }

        .wf-step.rejected .wf-body span:first-child {
            color: #b91c1c;
        }

        .wf-dot.rejected-dot {
            background: linear-gradient(180deg, #f87171, #ef4444) !important;
            border-color: #dc2626 !important;
        }

        @media (max-width: 991.98px) {
            .pa-detail-split {
                flex-direction: column;
                min-height: auto;
            }

            .pa-detail-left {
                flex: 1 1 auto;
                border-right: none;
                border-bottom: 1px solid rgba(0, 0, 0, 0.08);
                max-height: none;
            }

            .pa-detail-wf {
                flex: 1 1 auto;
                max-width: none;
                min-width: 0;
                width: 100%;
            }

            .pa-wf-steps {
                max-height: 360px;
            }
        }

        @media (max-width: 575.98px) {
