        window.edWire($('cr-reject-confirm'), 'click', confirmReject, 'reject-confirm');
        window.edWire($('cr-reject-reason'), 'input', function () {
            var rejectReason = $('cr-reject-reason');
            if (rejectReason) rejectReason.classList.remove('is-invalid');
            clearRejectError();
        }, 'reject-reason');
