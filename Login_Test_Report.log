    }
}

#page-approvals #ea-request-wrap,
#page-approvals #ea-bill-wrap,
#page-approvals #ea-fund-wrap,
#page-approvals #ca-approvals-wrap {
    flex: 1 1 auto;
    min-height: 0;
}

/* ── Event Approval — meta cards row (identical to claim cr-meta-card) ── */
.ea-meta-cards {
    display: flex;
    gap: 8px;
    margin-top: 2px;
}

.ea-meta-cards .cr-meta-card {
    flex: 1 1 0;
    min-width: 0;
}

.ea-meta-cards .cr-meta-value {
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ea-dept {
    font-size: 11px;
    font-weight: 600;
    color: #9a3412;
    opacity: 0.75;
}

/* ── Budget section ── */
.ea-budget-section {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.ea-budget-hdr {
    display: flex;
    align-items: center;
    gap: 6px;
}

.ea-budget-hdr .cr-fields-section-hdr {
    flex: 0 0 auto;
}

.ea-budget-editable-tag {
    font-size: 9px;
    font-weight: 600;
    color: #d97706;
    background: #fff7ed;
    border: 1px solid #fde68a;
    border-radius: 999px;
    padding: 1px 6px;
    letter-spacing: 0.02em;
}

.ea-budget-grand {
    margin-left: auto;
    font-size: 13px;
    font-weight: 800;
    color: #047857;
    letter-spacing: -0.01em;
}

/* 2-column grid — no scroll — all visible */
.ea-budget-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
}

.ea-bcard {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 8px 10px;
    border-radius: 9px;
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    border: 1px solid #e8edf3;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
    min-width: 0;
}

.ea-bcard .cr-field-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ea-budget-amt-inp {
    width: 100%;
    padding: 5px 8px;
    font-size: 12px;
    font-weight: 700;
    color: #0f172a;
    text-align: right;
    border: 1px solid #cbd5e1;
    border-radius: 7px;
    background: #fff;
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.05);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.ea-budget-amt-inp:focus {
    border-color: #d97706;
    outline: none;
    box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.15);
}

/* Comment cell inside cr-field-cell */
.ea-comment-cell {
    gap: 6px !important;
}

.ea-comment-cell .cr-field-label {
    margin-bottom: 0;
}

.ea-comment-note {
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    color: #94a3b8;
}

.ea-comment-inp {
    width: 100%;
    padding: 6px 8px;
    font-size: 11.5px;
    line-height: 1.45;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    resize: none;
    min-height: 52px;
    color: #0f172a;
    background: #fff;
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.05);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.ea-comment-inp:focus {
    border-color: #d97706;
    outline: none;
    box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.12);
}

/* Approvals page — mobile stack (scroll via #main, not nested page scroller) */
@media (max-width: 991.98px) {
    #page-approvals.appr-split-mode.page.active {
        height: auto !important;
        min-height: 0 !important;
        overflow: visible !important;
        padding-bottom: max(12px, env(safe-area-inset-bottom, 12px));
    }

    #page-approvals.appr-split-mode .appr-main-card {
        min-height: auto;
        overflow: visible;
    }

    #page-approvals.appr-split-mode .appr-split-panel,
    #page-approvals.appr-split-mode #ea-request-pane,
    #page-approvals.appr-split-mode #ea-bill-pane,
    #page-approvals.appr-split-mode #ea-fund-pane,
    #page-approvals.appr-split-mode #appr-claim-panel {
