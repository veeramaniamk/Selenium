}

#er-expense-modal .er-summary-section .pa-section-hdr {
    background: linear-gradient(180deg, #f8fafc 0%, #e9eff7 100%);
    border-bottom: 1px solid #d4deea;
    padding: 10px 14px;
    font-size: 11px;
    font-weight: 800;
    color: #475569;
