        (function() {
            const loader = document.getElementById('loaderOverlay');
            const toastWrap = document.getElementById('toastWrap');

            const phpMsg = "";
            const phpType = "error";
            if (phpMsg) showToast(phpMsg, phpType);

            function showToast(msg, type) {
                const err = type === 'error';
                const t = document.createElement('div');
                t.className = 'toast';
                t.innerHTML = `
            <svg class="t-icon" viewBox="0 0 20 20" fill="${err ? '#e53e3e' : '#38a169'}">
                ${err
                    ? '<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>'
                    : '<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>'}
            </svg>
            <div class="t-body">
                <div class="t-title">${err ? 'Notice' : 'Success'}</div>
                <div class="t-msg">${msg}</div>
            </div>
            <button class="t-close">&times;</button>`;
                toastWrap.appendChild(t);
                t.querySelector('.t-close').onclick = () => t.remove();
                setTimeout(() => t?.parentNode && t.remove(), 5000);
            }

            const googleSection = document.getElementById('googleSection');
            const loginPanel = document.getElementById('loginFormPanel');
            const showFormBtn = document.getElementById('showLoginFormBtn');
            const backBtn = document.getElementById('backToOptionsBtn');
            const loginForm = document.getElementById('loginForm');

            function showPanel(panel) {
                if (panel === 'form') {
                    googleSection.classList.remove('google-reveal--instant');
                    googleSection.style.display = 'none';
                    loginPanel.classList.add('visible');
                    requestAnimationFrame(() => {
                        const idField = document.getElementById('identifier');
                        if (idField) {
                            idField.focus();
                        }
                    });
                } else {
                    googleSection.classList.add('google-reveal--instant');
                    googleSection.style.display = 'block';
                    loginPanel.classList.remove('visible');
                    requestAnimationFrame(() => {
                        const gBtn = document.getElementById('googleSignInBtn');
                        if (gBtn) {
                            gBtn.focus();
                        }
                    });
                }
            }

            showFormBtn.addEventListener('click', () => showPanel('form'));
            backBtn.addEventListener('click', () => showPanel('options'));

                            showPanel('form');
            
            loginForm.addEventListener('submit', () => {
                loader.classList.remove('d-none');
                document.title = 'Signing you in\u2026';
            });

            document.getElementById('googleSignInBtn').addEventListener('click', (e) => {
                e.preventDefault();
                loader.classList.remove('d-none');
                document.title = 'Signing you in\u2026';
                setTimeout(() => {
                    window.location.href = '/oauth-login';
                }, 300);
            });

            window.addEventListener('pageshow', e => {
                if (e.persisted) {
                    loader.classList.add('d-none');
                    document.title = 'Sign in \u00b7 SIMATS 360';
                }
            });

            document.addEventListener('DOMContentLoaded', () => loader.classList.add('d-none'));

        })();
    </script>
</body>

</html>

