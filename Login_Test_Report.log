    function totalPages() {
        var total = state.recordsFiltered || 0;
        return Math.max(1, Math.ceil(total / perPage));
    }

    function updateShowing() {
        var el = $('cn-showing');
        if (!el) return;
        var total = state.recordsFiltered || 0;
        if (!total) {
            el.textContent = '0';
            return;
        }
        var start = (page - 1) * perPage + 1;
        var end = Math.min(page * perPage, total);
        el.textContent = start + '–' + end + ' of ' + total;
    }

    function renderPager() {
        var pager = $('cn-pager');
        if (!pager) return;
        pager.innerHTML = '';

        var pages = totalPages();
        var prev = document.createElement('button');
        prev.type = 'button';
        prev.className = 'cn-pager-btn';
        prev.textContent = 'Prev';
        prev.disabled = page <= 1;
        prev.addEventListener('click', function () {
            if (page > 1) loadRows({ page: page - 1 });
        });
        pager.appendChild(prev);

        var start = Math.max(1, page - 2);
        var end = Math.min(pages, page + 2);
        for (var p = start; p <= end; p += 1) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'cn-pager-btn' + (p === page ? ' is-active' : '');
            btn.textContent = String(p);
            btn.addEventListener('click', (function (n) {
                return function () { loadRows({ page: n }); };
            })(p));
            pager.appendChild(btn);
        }

        var next = document.createElement('button');
        next.type = 'button';
        next.className = 'cn-pager-btn';
        next.textContent = 'Next';
        next.disabled = page >= pages;
        next.addEventListener('click', function () {
            if (page < pages) loadRows({ page: page + 1 });
        });
        pager.appendChild(next);
    }

    function loadRows(opts) {
        var options = opts || {};
        if (options.page) page = options.page;
        if (options.search != null) search = String(options.search).trim();

        var body = $('cn-body');
        if (body) body.innerHTML = skeletonRows(5);

        draw += 1;
        var fd = new FormData();
        fd.append('draw', String(draw));
        fd.append('start', String((page - 1) * perPage));
        fd.append('length', String(perPage));
        fd.append('q', search);
        var bioId = getBioId();
        if (bioId) fd.append('bio_id', bioId);

        return fetchHistoryJson(fd)
            .then(function (json) {
                state.rows = Array.isArray(json.data) ? json.data : [];
                state.recordsTotal = parseInt(json.recordsTotal, 10) || 0;
                state.recordsFiltered = parseInt(json.recordsFiltered, 10) || state.recordsTotal;
                loaded = true;
                renderTable();
            })
            .catch(function (e) {
                if (body) {
                    body.innerHTML = '<tr><td colspan="14" class="cn-td-error">' + esc(e.message || 'Failed to load') + '</td></tr>';
                }
                updateShowing();
            });
    }

    function showFormError(msg) {
        var el = $('cn-form-error');
        if (!el) return;
        if (msg) {
            el.textContent = msg;
            el.style.display = 'block';
        } else {
            el.textContent = '';
            el.style.display = 'none';
        }
    }

    function hideSuggestions(el) {
        if (el) el.style.display = 'none';
    }

    function portalSuggestList(input, list) {
        if (!input || !list || list.dataset.cnPortaled) return;
        list.dataset.cnPortaled = '1';
        list.classList.add('cn-suggest-portal');
        document.body.appendChild(list);
        input._cnSuggestList = list;

        function position() {
            if (!list || list.style.display === 'none') return;
            var rect = input.getBoundingClientRect();
            list.style.position = 'fixed';
            list.style.top = (rect.bottom + 4) + 'px';
            list.style.left = rect.left + 'px';
            list.style.width = Math.max(rect.width, 220) + 'px';
            list.style.zIndex = '1065';
            list.style.maxHeight = Math.max(120, window.innerHeight - rect.bottom - 12) + 'px';
        }

        input._cnPositionSuggest = position;
        input.addEventListener('focus', position);
        window.addEventListener('scroll', position, true);
        window.addEventListener('resize', position);
    }

    function showSuggestions(input, list) {
        portalSuggestList(input, list);
        list.style.display = 'block';
        if (input._cnPositionSuggest) input._cnPositionSuggest();
    }

    function applyItemUom(row, item) {
        var uomInput = row.querySelector('.cn-item-uom');
        if (!uomInput) return;
        var uomName = (item && item.uom_individual_name != null ? item.uom_individual_name : '').toString().trim();
        if (uomName && uomName.toLowerCase() !== 'null') {
            uomInput.value = uomName;
            if (item.uom_individual_id) uomInput.dataset.uomId = String(item.uom_individual_id);
            else delete uomInput.dataset.uomId;
        } else {
            uomInput.value = '';
            delete uomInput.dataset.uomId;
        }
    }

    function clearItemRowFields(row) {
        var descInput = row.querySelector('.cn-item-desc');
        var uomInput = row.querySelector('.cn-item-uom');
        if (descInput) descInput.value = '';
        if (uomInput) {
            uomInput.value = '';
            delete uomInput.dataset.uomId;
        }
    }

    function wireLocationDropdown() {
        var input = $('cn-form-location');
        var suggestions = $('cn-location-suggestions');
        if (!input || !suggestions || input.dataset.cnDropdownWired) return;
        input.dataset.cnDropdownWired = '1';

        function renderLocations(items) {
            suggestions.innerHTML = '';
            if (!items.length) {
                hideSuggestions(suggestions);
                return;
            }
            items.forEach(function (item) {
                var div = document.createElement('div');
                div.className = 'cn-suggest-option';
                div.textContent = item.text || item.name || item.id || '';
                div.addEventListener('click', function () {
                    input.value = item.text || item.name || item.id || '';
                    input.dataset.selected = JSON.stringify(item);
                    hideSuggestions(suggestions);
                });
                suggestions.appendChild(div);
            });
            showSuggestions(input, suggestions);
        }

        var fetchLocations = debounce(function (q) {
            var bioId = getBioId();
            var url = apiUrl('api_fetch_locations.php?q=' + encodeURIComponent(q || ''))
                + (bioId ? ('&bio_id=' + encodeURIComponent(bioId)) : '');
            fetch(url, { credentials: 'same-origin', headers: { Accept: 'application/json' } })
                .then(function (res) { return res.json(); })
                .then(function (json) {
                    renderLocations(Array.isArray(json) ? json.slice(0, 50) : []);
                })
                .catch(function () { hideSuggestions(suggestions); });
        }, 150);

        portalSuggestList(input, suggestions);
        input.addEventListener('focus', function () { fetchLocations(''); });
        input.addEventListener('input', function () {
            delete input.dataset.selected;
            fetchLocations(input.value.trim());
        });

        document.addEventListener('click', function (e) {
            if (e.target !== input && !suggestions.contains(e.target)) hideSuggestions(suggestions);
        });
    }

    function getSelectedItemCodes(excludeInput) {
        var codes = [];
        var table = $('cn-items-table');
        if (!table) return codes;
        table.querySelectorAll('.cn-item-code').forEach(function (inp) {
            if (inp === excludeInput) return;
            var v = (inp.value || '').trim();
            if (v) codes.push(v);
        });
        return codes;
    }

    function wireItemDropdown(input, row) {
        if (!input || input.dataset.cnItemWired) return;
        input.dataset.cnItemWired = '1';

        var suggestions = input.parentElement
            ? input.parentElement.querySelector('.cn-item-suggestions')
            : null;
        if (!suggestions) {
            suggestions = document.createElement('div');
            suggestions.className = 'cn-item-suggestions cn-suggest-list';
            if (input.parentElement) input.parentElement.appendChild(suggestions);
        }

        var descInput = row.querySelector('.cn-item-desc');

        function renderItems(items) {
            suggestions.innerHTML = '';
            var selected = getSelectedItemCodes(input);
            if (!items.length) {
                suggestions.innerHTML = '<div class="cn-suggest-empty">No items found</div>';
                showSuggestions(input, suggestions);
                return;
            }
            items.forEach(function (item) {
                var div = document.createElement('div');
                div.className = 'cn-suggest-option';
                var disabled = selected.indexOf(item.id) !== -1;
                div.innerHTML = '<strong>' + esc(item.id) + (disabled ? ' (selected)' : '') + '</strong>'
                    + '<span class="cn-suggest-sub">' + esc(item.description || '') + '</span>';
                if (!disabled) {
                    div.addEventListener('click', function () {
                        input.value = item.id || '';
                        input.dataset.selected = JSON.stringify(item);
                        if (descInput) descInput.value = item.description || '';
                        applyItemUom(row, item);
                        if (item.category_id) input.dataset.categoryId = String(item.category_id);
                        else delete input.dataset.categoryId;
                        hideSuggestions(suggestions);
                    });
                } else {
                    div.style.opacity = '0.55';
                    div.style.pointerEvents = 'none';
                }
                suggestions.appendChild(div);
            });
            showSuggestions(input, suggestions);
        }

        var fetchItems = debounce(function (q) {
            var bioId = getBioId();
            var url = apiUrl('api_search_items.php?q=' + encodeURIComponent(q || ''))
                + (bioId ? ('&bio_id=' + encodeURIComponent(bioId)) : '');
            fetch(url, { credentials: 'same-origin', headers: { Accept: 'application/json' } })
                .then(function (res) { return res.json(); })
                .then(function (json) {
                    if (json && json.error) {
                        suggestions.innerHTML = '<div class="cn-suggest-empty">' + esc(json.error) + '</div>';
                        showSuggestions(input, suggestions);
                        return;
                    }
                    var items = (json && Array.isArray(json.items)) ? json.items.slice(0, 50) : [];
                    renderItems(items);
                })
                .catch(function () {
                    suggestions.innerHTML = '<div class="cn-suggest-empty">Failed to load items</div>';
                    showSuggestions(input, suggestions);
                });
        }, 150);

        portalSuggestList(input, suggestions);
        input.addEventListener('focus', function () { fetchItems(''); });
        input.addEventListener('input', function () {
            delete input.dataset.selected;
            delete input.dataset.categoryId;
            clearItemRowFields(row);
            fetchItems(input.value.trim());
        });

        document.addEventListener('click', function (e) {
            if (e.target !== input && !suggestions.contains(e.target)) hideSuggestions(suggestions);
        });
    }

    function renumberItemRows() {
        var tbody = document.querySelector('#cn-items-table tbody');
        if (!tbody) return;
        Array.prototype.forEach.call(tbody.rows, function (row, i) {
            var cell = row.cells[0];
            if (cell) cell.textContent = String(i + 1);
        });
    }

    function addItemRow() {
        var tbody = document.querySelector('#cn-items-table tbody');
        if (!tbody) return;

        var tr = document.createElement('tr');
        tr.innerHTML = '<td class="cn-item-num">' + (tbody.rows.length + 1) + '</td>'
            + '<td class="cn-item-code-cell" data-label="Item Code">'
            + '<div class="cn-suggest-wrap">'
            + '<input type="text" class="finp cn-item-code" placeholder="Search item…" autocomplete="off">'
            + '<div class="cn-item-suggestions cn-suggest-list"></div>'
            + '</div>'
            + '</td>'
            + '<td data-label="Description"><input type="text" class="finp cn-item-desc" readonly tabindex="-1" placeholder="—"></td>'
            + '<td data-label="UOM"><input type="text" class="finp cn-item-uom" readonly tabindex="-1" placeholder="Auto"></td>'
            + '<td data-label="Qty"><input type="number" class="finp cn-item-qty" min="1" value="1"></td>'
            + '<td class="cn-item-del" data-label="">'
            + '<button type="button" class="cn-del-row" title="Remove row"><i class="fa fa-trash-alt"></i></button>'
            + '</td>';

        tbody.appendChild(tr);

        var codeInput = tr.querySelector('.cn-item-code');
        wireItemDropdown(codeInput, tr);

        var delBtn = tr.querySelector('.cn-del-row');
        if (delBtn) {
            delBtn.addEventListener('click', function () {
                if (tbody.rows.length <= 1) {
                    if (window.EDToast) window.EDToast.warning('At least one item is required.');
                    return;
                }
                tr.remove();
                renumberItemRows();
            });
        }
    }

    function resetRequestForm() {
        var form = $('cn-request-form');
        if (form) form.reset();
        var loc = $('cn-form-location');
        if (loc) {
            delete loc.dataset.selected;
            loc.value = '';
        }
        hideSuggestions($('cn-location-suggestions'));
        var tbody = document.querySelector('#cn-items-table tbody');
        if (tbody) tbody.innerHTML = '';
        addItemRow();
        showFormError('');
    }

    function openRequestModal() {
        wireLocationDropdown();
        resetRequestForm();
        var modalEl = $('cn-request-modal');
        if (modalEl && window.bootstrap && window.bootstrap.Modal) {
            requestModal = window.bootstrap.Modal.getOrCreateInstance(modalEl);
            requestModal.show();
        }
    }

    function collectFormItems() {
        var tbody = document.querySelector('#cn-items-table tbody');
        if (!tbody) return [];
        var items = [];
        var rows = Array.prototype.slice.call(tbody.rows);
        for (var i = 0; i < rows.length; i += 1) {
            var row = rows[i];
            var codeInput = row.querySelector('.cn-item-code');
            var qtyInput = row.querySelector('.cn-item-qty');
            var uomInput = row.querySelector('.cn-item-uom');
            if (!codeInput || !qtyInput || !uomInput) continue;

            var itemCode = (codeInput.value || '').trim();
            var qty = parseInt(qtyInput.value, 10) || 0;
            var issueType = (uomInput.value || '').trim();
            var categoryId = codeInput.dataset.categoryId ? parseInt(codeInput.dataset.categoryId, 10) : 0;

            if (!itemCode) throw new Error('Please select an item code for all rows.');
            if (!qty || qty <= 0) throw new Error('Quantity must be greater than zero.');
            if (!issueType) throw new Error('UOM not available for item ' + itemCode + '. Choose another item.');
            if (!categoryId) throw new Error('Missing category for item ' + itemCode + '.');

            items.push({
                item_code: itemCode,
                quantity: qty,
                issue_type: issueType,
                category_id: categoryId,
            });
        }
        if (!items.length) throw new Error('Add at least one item.');
        return items;
    }

    function submitRequest(e) {
        if (e) e.preventDefault();
        if (isSubmitting) return;

        var locInput = $('cn-form-location');
        var descInput = $('cn-form-description');
        if (!locInput) return;

        var locationCode = '';
        if (locInput.dataset.selected) {
            try {
                var sel = JSON.parse(locInput.dataset.selected);
                locationCode = sel.id || sel.location_code || '';
            } catch (err) { /* ignore */ }
        }
        if (!locationCode) {
            showFormError('Please select a location from the suggestions.');
            return;
        }

        var items;
        try {
            items = collectFormItems();
        } catch (err) {
            showFormError(err.message || 'Invalid form');
            return;
        }

        isSubmitting = true;
        showFormError('');
        var btn = $('cn-form-submit');
        if (btn) {
            btn.disabled = true;
            btn.dataset.origText = btn.textContent;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Submitting…';
        }

        var payload = {
            bio_id: getBioId(),
            location_code: locationCode,
            description: descInput ? (descInput.value || '').trim() : '',
            items: items,
        };

        fetch(apiUrl('api_submit_request.php'), {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(payload),
        })
            .then(function (res) { return res.json(); })
            .then(function (json) {
                if (!json || !json.success) throw new Error((json && (json.error || json.message)) || 'Submit failed');
                if (requestModal) requestModal.hide();
                if (window.EDToast) window.EDToast.success('Request submitted successfully.');
                page = 1;
                return loadRows();
            })
            .catch(function (err) {
                showFormError(err.message || 'Failed to submit request');
            })
            .finally(function () {
                isSubmitting = false;
                timelineCache = Object.create(null);
                if (btn) {
                    btn.disabled = false;
                    btn.textContent = btn.dataset.origText || 'Submit Request';
                }
            });
    }

    function buildConsumableMetaHtml(req, item) {
        req = req || {};
        item = item || {};
        function chip(label, val) {
            if (val == null || val === '') return '';
            return '<div class="wf-meta-chip"><span class="wf-meta-lbl">' + esc(label) + '</span>'
                + '<span class="wf-meta-val">' + esc(String(val)) + '</span></div>';
        }
        var html = '<div class="wf-meta-grid">'
            + chip('CID', req.cid)
            + chip('Item', item.item_code)
            + chip('Requested', item.requested_qty != null ? (item.requested_qty + (item.uom ? ' ' + item.uom : '')) : '')
            + chip('Issued', item.issued_qty)
            + chip('Received', item.received_qty)
            + chip('Store', item.store_status)
            + chip('Approval', item.final_status);
        if (req.description) {
            html += chip('Notes', req.description);
        }
        html += '</div>';
        return html;
    }

    function mapConsumableTimelineToWf(data) {
        data = data || {};
        var req = data.request || {};
        var item = data.item || {};
        var steps = data.timeline_steps || [];
        var foundPending = false;
        var wfSteps = steps.map(function (step) {
            var status = String(step.status || 'pending').toLowerCase();
            var st = 'up';
            if (status === 'completed' || status === 'approved') st = 'done';
            else if (status === 'rejected') st = 'rejected';
            else if ((status === 'pending' || status === 'in-progress') && !foundPending) {
                st = 'pending';
                foundPending = true;
            }
            var remark = step.remark || '';
            if (step.notes) {
                remark = remark ? (remark + ' · ' + step.notes) : step.notes;
            }
            if (st === 'pending' && !remark) remark = 'Awaiting action at this stage.';
            if (st === 'done' && !remark) remark = 'Completed at this stage.';
            return {
                title: step.title || 'Approval Step',
                approver: step.person || '—',
                role: step.department || '',
                date: step.date,
                status: st,
                remark: remark,
            };
        });

        var subtitle = req.cid || ('Request #' + (req.cons_id || ''));
        if (item.item_code) subtitle += ' · ' + item.item_code;

        return {
            subtitle: subtitle,
            requester: req.employee_name || '—',
            department: req.location_label || req.location_code || '—',
            amount: item.qty_label || '',
            metaHtml: buildConsumableMetaHtml(req, item),
            steps: wfSteps,
        };
    }

    var timelineCache = Object.create(null);

    function timelineCacheKey(consId, itemCode) {
        return String(consId || '') + '::' + String(itemCode || '');
    }

    function showTimelineLoading(row) {
        if (!window.EDWorkflowModal) return;
        window.EDWorkflowModal.show({
            subtitle: (row.cid || 'Request') + (row.item_code ? (' · ' + row.item_code) : ''),
            requester: row.employee_name || '—',
            department: row.location_code || '—',
            amount: '',
            loading: true,
            steps: [],
        });
    }

    function fetchTimelineData(consId, itemCode) {
        var key = timelineCacheKey(consId, itemCode);
        if (timelineCache[key]) {
            return Promise.resolve(timelineCache[key]);
        }

        var url = apiUrl('api_timeline.php')
            + '?cons_id=' + encodeURIComponent(String(consId))
            + '&item_code=' + encodeURIComponent(String(itemCode || ''));

        return fetch(url, { credentials: 'same-origin', headers: { Accept: 'application/json' } })
            .then(function (res) { return res.json(); })
            .then(function (json) {
                if (!json || !json.success) {
                    throw new Error((json && json.error) || 'Failed to load timeline');
                }
                timelineCache[key] = json.data || {};
                return timelineCache[key];
            });
    }

    function openTimeline(index) {
        var row = state.rows[index];
        if (!row || !window.EDWorkflowModal) return;

        var consId = row.cons_id;
        var itemCode = row.item_code || '';
        if (!consId) {
            if (window.EDToast) window.EDToast.warning('Missing request id for timeline.');
            return;
        }

        showTimelineLoading(row);

        fetchTimelineData(consId, itemCode)
            .then(function (data) {
                window.EDWorkflowModal.show(mapConsumableTimelineToWf(data));
            })
            .catch(function (err) {
                if (window.EDToast) window.EDToast.error(err.message || 'Failed to load timeline');
            });
    }

    function buildReceiveFormHtml(row) {
        var reqQty = parseInt(row.requested_qty || row.initial_quantity || 0, 10);
        var issQty = parseInt(row.issued_qty || 0, 10);
        var recQty = parseInt(row.received_qty || 0, 10);
        var pending = Math.max(0, issQty - recQty);

        return '<form id="cn-receive-form" class="cn-receive-form">'
            + '<input type="hidden" name="track_id" value="' + esc(String(row.track_id || row.id || '')) + '">'
            + '<input type="hidden" name="cons_id" value="' + esc(String(row.cons_id || '')) + '">'
            + '<input type="hidden" name="item_code" value="' + esc(String(row.item_code || '')) + '">'
            + '<div class="cn-receive-summary">'
            + '<div><span class="cn-tl-label">Item</span><strong>' + esc(row.item_code || '—') + '</strong></div>'
            + '<div><span class="cn-tl-label">Location</span>' + esc(row.location_code || '—') + '</div>'
            + '<div><span class="cn-tl-label">Requested</span>' + esc(String(reqQty)) + '</div>'
            + '<div><span class="cn-tl-label">Issued</span>' + esc(String(issQty)) + '</div>'
            + '<div><span class="cn-tl-label">Received</span>' + esc(String(recQty)) + '</div>'
            + '<div><span class="cn-tl-label">Pending</span><strong>' + esc(String(pending)) + '</strong></div>'
            + '</div>'
            + '<div class="cn-receive-section cn-receive-good">'
            + '<h6><i class="fa fa-check-circle"></i> Good Items</h6>'
            + '<label class="cn-form-label">Quantity to Receive *</label>'
            + '<input type="number" name="received_qty" class="finp cn-receive-inp" min="0" max="' + pending + '" value="' + pending + '" required>'
            + '<label class="cn-form-label">Receiving Notes</label>'
            + '<textarea name="receiver_notes" class="finp cn-receive-inp" rows="2" placeholder="Optional notes…"></textarea>'
            + '</div>'
            + '<div class="cn-receive-section cn-receive-defect">'
            + '<h6><i class="fa fa-exclamation-triangle"></i> Defective Items</h6>'
            + '<label class="cn-form-label">Defective Quantity</label>'
            + '<input type="number" name="defective_qty" class="finp cn-receive-inp" min="0" max="' + pending + '" value="0">'
            + '<label class="cn-form-label">Defective Reason</label>'
            + '<select name="defective_reason" class="finp cn-receive-inp">'
            + '<option value="">Select reason</option>'
            + '<option value="damaged">Damaged/Broken</option>'
            + '<option value="wrong_item">Wrong Item</option>'
            + '<option value="expired">Expired</option>'
            + '<option value="incorrect_spec">Incorrect Specification</option>'
            + '<option value="other">Other</option>'
            + '</select>'
            + '<label class="cn-form-label">Defective Notes</label>'
            + '<textarea name="defective_notes" class="finp cn-receive-inp" rows="2" placeholder="Describe the issue…"></textarea>'
            + '</div>'
            + '<div id="cn-receive-error" class="cn-form-error" style="display:none"></div>'
            + '<div class="cn-receive-actions">'
            + '<button type="button" class="cn-btn-ghost" data-cn-receive-cancel>Cancel</button>'
            + '<button type="submit" id="cn-receive-submit" class="cn-btn-primary">Process Items</button>'
            + '</div>'
            + '</form>';
    }

    function validateReceiveForm(form, pending) {
        var received = parseInt((form.querySelector('[name="received_qty"]') || {}).value, 10) || 0;
        var defective = parseInt((form.querySelector('[name="defective_qty"]') || {}).value, 10) || 0;
        var reason = (form.querySelector('[name="defective_reason"]') || {}).value || '';
        var total = received + defective;

        if (received < 0 || defective < 0) return 'Quantities cannot be negative.';
        if (received > pending || defective > pending) return 'Quantities cannot exceed pending amount (' + pending + ').';
        if (total === 0) return 'Process at least one item (good or defective).';
        if (total > pending) return 'Total processing exceeds pending quantity.';
        if (defective > 0 && !reason) return 'Select a reason for defective items.';
        return '';
    }

    function openReceiveModal(index) {
        var row = state.rows[index];
        if (!row) return;
        receiveRow = row;

        var issQty = parseInt(row.issued_qty || 0, 10);
        var recQty = parseInt(row.received_qty || 0, 10);
        var pending = Math.max(0, issQty - recQty);

        var content = $('cn-receive-content');
        if (content) content.innerHTML = buildReceiveFormHtml(row);

        var form = $('cn-receive-form');
        if (form) {
            form.addEventListener('submit', function (ev) {
                ev.preventDefault();
                if (isReceiving) return;

                var errEl = $('cn-receive-error');
                var msg = validateReceiveForm(form, pending);
                if (msg) {
                    if (errEl) { errEl.textContent = msg; errEl.style.display = 'block'; }
                    return;
                }
                if (errEl) errEl.style.display = 'none';

                isReceiving = true;
                var btn = $('cn-receive-submit');
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Processing…';
                }

                fetch(apiUrl('api_receive_items.php'), {
                    method: 'POST',
                    credentials: 'same-origin',
                    body: new FormData(form),
                })
                    .then(function (res) { return res.json(); })
                    .then(function (json) {
                        if (!json || !json.success) throw new Error((json && json.message) || 'Receive failed');
                        if (receiveModal) receiveModal.hide();
                        timelineCache = Object.create(null);
                        if (window.EDToast) window.EDToast.success('Items processed successfully.');
                        return loadRows({ page: page });
                    })
                    .catch(function (err) {
                        if (errEl) {
                            errEl.textContent = err.message || 'Failed to process items';
                            errEl.style.display = 'block';
                        }
                    })
                    .finally(function () {
                        isReceiving = false;
                        if (btn) {
                            btn.disabled = false;
                            btn.textContent = 'Process Items';
                        }
                    });
            });
        }

        var cancelBtn = content ? content.querySelector('[data-cn-receive-cancel]') : null;
        if (cancelBtn) {
            cancelBtn.addEventListener('click', function () {
                if (receiveModal) receiveModal.hide();
            });
        }

        var modalEl = $('cn-receive-modal');
        if (modalEl && window.bootstrap && window.bootstrap.Modal) {
            receiveModal = window.bootstrap.Modal.getOrCreateInstance(modalEl);
            receiveModal.show();
        }
    }

    function wirePageControls() {
        var searchInput = $('cn-search-input');
        window.edWire(searchInput, 'input', debounce(function () {
            search = (searchInput.value || '').trim();
            page = 1;
            loadRows();
        }, 300), 'search');

        window.edWire($('cn-request-btn'), 'click', openRequestModal, 'req');
        window.edWire($('cn-add-item-row'), 'click', addItemRow, 'add-row');
        window.edWire($('cn-request-form'), 'submit', submitRequest, 'form');
        wireLocationDropdown();
    }

    function wireEvents() {
        wirePageControls();
        if (wired) return;
        wired = true;

        document.addEventListener('click', function (e) {
            if (!isActive()) return;

            var tlBtn = e.target.closest('.js-cn-timeline');
            if (tlBtn) {
                var idx = parseInt(tlBtn.getAttribute('data-index'), 10);
                if (!isNaN(idx)) openTimeline(idx);
                return;
            }

            var rcvBtn = e.target.closest('.js-cn-receive');
            if (rcvBtn) {
                var rIdx = parseInt(rcvBtn.getAttribute('data-index'), 10);
                if (!isNaN(rIdx)) openReceiveModal(rIdx);
            }
        });
    }

    function onPage() {
        wireEvents();
        if (!loaded) return loadRows();
        renderTable();
        return Promise.resolve();
    }

    function init() {
        wireEvents();
    }

    window.EDConsumableRequest = {
        init: init,
        onPage: onPage,
        loadRows: loadRows,
    };
})();


