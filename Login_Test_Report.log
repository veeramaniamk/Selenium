    function onFilterChange() {
        if (isPrivilegeActive()) renderPrivilegeTable();
    }

    function ensureLoaded() {
        if (loaded && !needsPendingReload()) return Promise.resolve();
        if (isPrivilegeActive()) showLoadingRows();
        return loadPending(true, false);
    }

    function onPrivilegeTab() {
        var tab = typeof window.apprTabSt !== 'undefined' ? window.apprTabSt : 'pending';
        if (tab === 'history') {
            return ensureLoaded().then(function () { return loadHistory(false); });
        }
        if (needsPendingReload() || !loaded) {
            return ensureLoaded().then(function () {
