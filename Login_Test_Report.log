                btn.addEventListener('click', function () { loadPage(n); });
                pager.appendChild(btn);
            }(p));
        }

        var next = document.createElement('button');
        next.type = 'button'; next.className = 'cn-pager-btn'; next.textContent = 'Next →';
        next.disabled = state.page >= pages;
        next.addEventListener('click', function () { loadPage(state.page + 1); });
        pager.appendChild(next);

        var showing = $('grv-showing');
        if (showing) {
            var s = (state.page - 1) * PER_PAGE + 1;
