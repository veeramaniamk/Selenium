    <!-- ████ GRIEVANCE RAISE MODAL ████ -->
    <div class="modal fade" id="grv-raise-modal" tabindex="-1" aria-labelledby="grvRaiseModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content cr-modal-content">
                <div class="m-hdr" style="background:linear-gradient(135deg,#ef4444,#dc2626);display:flex;align-items:center;justify-content:space-between">
                    <div style="display:flex;align-items:center;gap:12px;position:relative;z-index:1">
                        <div class="cr-modal-icon"><i class="fa fa-circle-exclamation" style="color:#fff;font-size:14px"></i></div>
                        <div>
                            <div style="color:#fff;font-size:16px;font-weight:700" id="grvRaiseModalLabel">Raise Grievance</div>
                            <div style="font-size:12px;color:rgba(255,255,255,.8);margin-top:1px">Submit a formal grievance for review</div>
                        </div>
                    </div>
                    <button type="button" class="m-close" data-bs-dismiss="modal" aria-label="Close"><i class="fa fa-times fa-sm"></i></button>
                </div>
                <form id="grv-raise-form" enctype="multipart/form-data" onsubmit="return false">
                    <div class="cr-modal-body cn-modal-body">
                        <div id="grv-form-error" class="cr-form-error" style="display:none"></div>
                        <div class="pa-section">
                            <div class="pa-section-hdr">
                                <span class="pa-section-title"><i class="fa fa-tag me-1"></i>Grievance Details</span>
                            </div>
                            <div class="pa-section-body">
                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <label class="flbl">Type of Grievance <span style="color:#ef4444">*</span></label>
                                        <div class="fsel-wrap">
                                            <i class="fa fa-tag finp-icon"></i>
                                            <select class="finp" name="grievance_type" required>
                                                <option value="">Select type…</option>
                                                <option value="work_environment">Work Environment</option>
                                                <option value="harassment">Harassment</option>
                                                <option value="pay_dispute">Pay Dispute</option>
                                                <option value="discrimination">Discrimination</option>
                                                <option value="other">Other</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="flbl">Upload Document <span style="font-weight:400;color:#64748b;font-size:11px">(PDF, JPG, PNG, DOCX · max 5 MB)</span></label>
                                        <div class="grv-file-zone" onclick="this.querySelector('input[type=file]').click()">
                                            <i class="fa fa-cloud-arrow-up" style="color:#94a3b8;font-size:18px"></i>
                                            <span>Click to upload</span>
                                            <input type="file" name="gv_file" accept=".pdf,.jpg,.jpeg,.png,.docx" style="display:none">
                                        </div>
                                        <div id="grv-file-preview" class="grv-file-preview-name" style="display:none"></div>
                                    </div>
                                    <div class="col-12">
                                        <label class="flbl">Grievance Details <span style="color:#ef4444">*</span></label>
                                        <textarea class="finp cr-form-inp" name="details" rows="4" placeholder="Describe your grievance in detail…" required style="resize:vertical;min-height:90px;padding:10px 12px"></textarea>
                                    </div>
                                    <div class="col-12">
                                        <label class="flbl">Remedy Request <span style="font-weight:400;color:#64748b;font-size:11px">(Optional)</span></label>
                                        <textarea class="finp cr-form-inp" name="remedy_request" rows="3" placeholder="What resolution are you seeking?" style="resize:vertical;min-height:70px;padding:10px 12px"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
