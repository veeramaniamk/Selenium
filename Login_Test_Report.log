            title: document.getElementById('pboq-title'),
            subtitle: document.getElementById('pboq-subtitle'),
            itemCodeInput: document.getElementById('pboq-item-input'),
            dropdownMenu: document.getElementById('pboq-item-dropdown'),
            selectedItemsBody: document.getElementById('pboq-selected-body'),
            noItemsRow: document.getElementById('pboq-no-items'),
            grandTotalCell: document.getElementById('pboq-grand-total'),
            selectedItemsJson: document.getElementById('pboq-selected-json'),
            approveForm: document.getElementById('pboq-form'),
            clearSearch: document.getElementById('pboq-clear-search'),
            submitBtn: document.getElementById('pboq-submit'),
            rejectBtn: document.getElementById('pboq-reject-btn'),
            requestIdInput: document.getElementById('pboq-request-id'),
            stageNumberInput: document.getElementById('pboq-stage-number'),
            closeBtn: document.getElementById('pboq-close-btn'),
            alertHost: document.getElementById('pboq-alert-host'),
            workflowSteps: document.getElementById('pboq-workflow-steps'),
            workflowProgress: document.getElementById('pboq-workflow-progress'),
            workflowCount: document.getElementById('pboq-workflow-count'),
            workflowPending: document.getElementById('pboq-workflow-pending'),
            summaryRequester: document.getElementById('pboq-summary-requester'),
            summaryAmount: document.getElementById('pboq-summary-amount'),
            rejectModal: document.getElementById('pboq-reject-modal'),
            rejectForm: document.getElementById('pboq-reject-form'),
            rejectRequestId: document.getElementById('pboq-reject-request-id'),
            rejectStageId: document.getElementById('pboq-reject-stage-id'),
            rejectReason: document.getElementById('pboq-reject-reason'),
            rejectSubmitBtn: document.getElementById('pboq-reject-submit'),
            historyModalBody: document.getElementById('pboq-history-body'),
            notes: document.getElementById('pboq-notes'),
            documentInput: document.getElementById('pboq-document'),
            searchWrap: document.getElementById('pboq-search-wrap'),
            phaseAccountPanel: document.getElementById('pboq-phase-account-panel'),
            termIdInput: document.getElementById('pboq-term-id'),
            accountIdInput: document.getElementById('pboq-account-id'),
            termsBtn: document.getElementById('pboq-terms-btn'),
            termsLabel: document.getElementById('pboq-terms-label'),
            termsMenu: document.getElementById('pboq-terms-menu'),
            termsSearch: document.getElementById('pboq-terms-search'),
            termsItems: document.getElementById('pboq-terms-items'),
            termsEmpty: document.getElementById('pboq-terms-empty'),
            accountBtn: document.getElementById('pboq-account-btn'),
            accountLabel: document.getElementById('pboq-account-label'),
            accountMenu: document.getElementById('pboq-account-menu'),
            accountSearch: document.getElementById('pboq-account-search'),
            accountItems: document.getElementById('pboq-account-items'),
            accountEmpty: document.getElementById('pboq-account-empty'),
            phaseAccountError: document.getElementById('pboq-phase-account-error'),
        };
        refreshNoItemsRowRef();
    }

    function showAlert(message, type) {
        if (!elements.alertHost) return;
        elements.alertHost.innerHTML = '<div class="alert alert-' + esc(type) + ' alert-dismissible fade show mb-0" role="alert">'
            + message
            + '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>';
        setTimeout(function () {
            if (elements.alertHost) elements.alertHost.innerHTML = '';
        }, 5000);
    }

    function truncateText(text, maxLen) {
        var s = String(text == null ? '' : text).trim();
        if (!maxLen || s.length <= maxLen) return s;
        return s.slice(0, maxLen).trim() + '…';
    }

    function normalizeStatus(status) {
        var key = String(status || '').trim().toLowerCase();
        if (key === 'approved') return 'Approved';
        if (key === 'rejected') return 'Rejected';
        if (key === 'pending') return 'Pending';
        return String(status || '').trim();
    }

    function positionItemDropdown() {
        if (!elements.itemCodeInput || !elements.dropdownMenu) return;
        elements.dropdownMenu.style.top = 'calc(100% + 4px)';
        elements.dropdownMenu.style.left = '0';
        elements.dropdownMenu.style.width = '100%';
    }

    function dropdownHint(message) {
        if (!elements.dropdownMenu) return;
        elements.dropdownMenu.innerHTML = '<div class="dropdown-item text-muted">' + esc(message) + '</div>';
        positionItemDropdown();
        elements.dropdownMenu.classList.add('is-open');
    }

    function canApproveSubmit() {
        bindElements();
        if (actionBusy) return false;
        if (state.selectedItems.size === 0) return false;
        var notes = (elements.notes && elements.notes.value || '').trim();
        var fileInput = elements.documentInput;
        var file = fileInput && fileInput.files && fileInput.files[0];
        if (!notes) return false;
        if (!file) return false;
        if (state.isLastStage) {
            if (state.catalogsLoading || state.catalogsError) return false;
            if (!(parseInt(state.termId, 10) > 0) || !(parseInt(state.accountId, 10) > 0)) return false;
        }
        return true;
    }

    function closePhaseAccountMenus() {
        if (elements.termsMenu) elements.termsMenu.classList.add('d-none');
        if (elements.accountMenu) elements.accountMenu.classList.add('d-none');
        if (elements.termsBtn) elements.termsBtn.classList.remove('active');
        if (elements.accountBtn) elements.accountBtn.classList.remove('active');
    }

    function clearPhaseAccountSelection() {
        state.termId = 0;
        state.accountId = 0;
        if (elements.termIdInput) elements.termIdInput.value = '';
        if (elements.accountIdInput) elements.accountIdInput.value = '';
        if (elements.termsLabel) elements.termsLabel.textContent = 'Select payment terms…';
        if (elements.accountLabel) elements.accountLabel.textContent = 'Select payment account…';
        if (elements.phaseAccountError) {
            elements.phaseAccountError.textContent = '';
            elements.phaseAccountError.classList.add('d-none');
        }
        closePhaseAccountMenus();
    }

    function setPhaseAccountError(message) {
        if (!elements.phaseAccountError) return;
        if (!message) {
            elements.phaseAccountError.textContent = '';
            elements.phaseAccountError.classList.add('d-none');
            return;
        }
        elements.phaseAccountError.textContent = message;
        elements.phaseAccountError.classList.remove('d-none');
    }

    function termDisplayText(term) {
        if (!term) return 'Select payment terms…';
        if (term.display_text) return String(term.display_text);
        var phase = parseInt(term.phase, 10) || 0;
        var pct = term.percentages;
        if (phase > 1 && Array.isArray(pct) && pct.length) {
            return phase + '-Phase (' + pct.join('/') + ')';
        }
        return String(term.title || 'Selected Terms');
    }

    function flattenAccounts(companies) {
        var all = [];
        (companies || []).forEach(function (company) {
            if (!company || !company.has_accounts || !company.accounts || !company.accounts.length) return;
            company.accounts.forEach(function (acc) {
                all.push({
                    company_id: company.id,
                    company_name: company.company_name,
                    account_id: acc.id,
                    account_name: acc.account_name,
                    gst_number: acc.gst_number || '',
                });
            });
        });
        return all;
    }

    function renderTermsItems(filterTerm) {
        if (!elements.termsItems) return;
        var q = String(filterTerm || '').toLowerCase().trim();
        var terms = state.paymentTermsData || [];
        var html = '';
        var shown = 0;
        terms.forEach(function (term) {
            var label = termDisplayText(term);
            var search = (label + ' ' + (term.title || '') + ' ' + (term.description || '')).toLowerCase();
            if (q && search.indexOf(q) === -1) return;
            shown += 1;
            var selected = String(state.termId) === String(term.id);
            var shortDesc = String(term.description || '');
            if (shortDesc.length > 100) shortDesc = shortDesc.slice(0, 100) + '…';
            html += '<button type="button" class="pboq-dd-item' + (selected ? ' selected' : '') + '"'
                + ' data-term-id="' + escAttr(term.id) + '"'
                + ' data-label="' + escAttr(label) + '">'
                + '<div class="fw-semibold">' + esc(label) + '</div>'
                + (shortDesc ? '<span class="pboq-dd-sub">' + esc(shortDesc) + '</span>' : '')
                + '</button>';
        });
        elements.termsItems.innerHTML = html || '';
        if (elements.termsEmpty) {
            elements.termsEmpty.classList.toggle('d-none', shown > 0);
        }
    }

    function renderAccountItems(filterTerm) {
        if (!elements.accountItems) return;
        var q = String(filterTerm || '').toLowerCase().trim();
        var accounts = flattenAccounts(state.companiesAccountsData || []);
        var html = '';
        var shown = 0;
        accounts.forEach(function (acc) {
            var search = (acc.account_name + ' ' + acc.company_name + ' ' + acc.gst_number).toLowerCase();
            if (q && search.indexOf(q) === -1) return;
            shown += 1;
            var selected = String(state.accountId) === String(acc.account_id);
            var label = acc.account_name;
            html += '<button type="button" class="pboq-dd-item' + (selected ? ' selected' : '') + '"'
                + ' data-account-id="' + escAttr(acc.account_id) + '"'
                + ' data-label="' + escAttr(label) + '"'
                + ' data-company="' + escAttr(acc.company_name) + '">'
                + '<div class="fw-semibold">' + esc(label) + '</div>'
                + '<span class="pboq-dd-sub">' + esc(acc.company_name)
                + (acc.gst_number ? ' · GST: ' + esc(acc.gst_number) : '')
                + '</span></button>';
        });
        elements.accountItems.innerHTML = html || '';
        if (elements.accountEmpty) {
            elements.accountEmpty.classList.toggle('d-none', shown > 0);
        }
    }

    function loadPhaseAccountCatalogs() {
        if (state.paymentTermsData && state.companiesAccountsData) {
            renderTermsItems('');
            renderAccountItems('');
            setPhaseAccountError('');
            updateApproveButtonState();
            return Promise.resolve();
        }
        if (state.catalogsLoading) return Promise.resolve();

        state.catalogsLoading = true;
        state.catalogsError = '';
        setPhaseAccountError('Loading payment terms and accounts…');
        updateApproveButtonState();

        return Promise.all([
            fetch('/api_purchase/api_get_payment_terms.php', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
                .then(function (res) { return res.json(); }),
            fetch('/api_purchase/api_get_companies_accounts.php', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
                .then(function (res) { return res.json(); }),
        ]).then(function (results) {
            var termsRes = results[0] || {};
            var companiesRes = results[1] || {};
            if (!termsRes.success) throw new Error(termsRes.error || termsRes.message || 'Failed to load payment terms');
            if (!companiesRes.success) throw new Error(companiesRes.error || companiesRes.message || 'Failed to load accounts');
            state.paymentTermsData = termsRes.terms || [];
            state.companiesAccountsData = companiesRes.companies || [];
            state.catalogsError = '';
            setPhaseAccountError('');
            renderTermsItems('');
            renderAccountItems('');
        }).catch(function (err) {
            state.catalogsError = (err && err.message) ? err.message : 'Failed to load catalogs';
            setPhaseAccountError(state.catalogsError);
            DEBUG && console.error('phase/account catalogs', err);
        }).finally(function () {
            state.catalogsLoading = false;
            updateApproveButtonState();
        });
    }

    function setPhaseAccountPanelVisible(visible) {
        bindElements();
        state.isLastStage = !!visible;
        if (!elements.phaseAccountPanel) return;
        if (visible) {
            elements.phaseAccountPanel.hidden = false;
            loadPhaseAccountCatalogs();
        } else {
            elements.phaseAccountPanel.hidden = true;
            clearPhaseAccountSelection();
        }
        updateApproveButtonState();
    }

    function updateApproveButtonState() {
        bindElements();
        if (!elements.submitBtn) return;
        var ok = canApproveSubmit();
        elements.submitBtn.disabled = !ok;
    }

    function updateRejectButtonState() {
        if (!elements.rejectSubmitBtn) return;
        var reason = (elements.rejectReason && elements.rejectReason.value || '').trim();
        elements.rejectSubmitBtn.disabled = !reason || actionBusy;
    }

    function syncSelectionUi() {
        bindElements();
        updateSelectedItemsTable();
        updateGrandTotal();
        updateJsonInput();
        updateApproveButtonState();
        updateRejectButtonState();
    }

    function refreshNoItemsRowRef() {
        elements.noItemsRow = document.getElementById('pboq-no-items');
    }

    function renderEmptySelectedTable() {
        if (!elements.selectedItemsBody) return;
        elements.selectedItemsBody.innerHTML = ''
            + '<tr id="pboq-no-items">'
            + '<td colspan="8" class="text-center py-4 text-muted">No items selected</td>'
            + '</tr>';
        refreshNoItemsRowRef();
    }

    function resetSelectionUi() {
        if (elements.grandTotalCell) elements.grandTotalCell.textContent = formatCurrency(0);
        if (elements.selectedItemsJson) elements.selectedItemsJson.value = '[]';
        if (elements.itemCodeInput) elements.itemCodeInput.value = '';
        state.filteredItems = [];
        renderEmptySelectedTable();
    }

    function showItemDropdown() {
        if (!elements.dropdownMenu || !elements.itemCodeInput || elements.itemCodeInput.disabled) return;
        positionItemDropdown();
        var term = elements.itemCodeInput.value.trim();
        if (itemsLoading) {
            dropdownHint('Loading item catalogue...');
            return;
        }
        if (term.length < SEARCH_MIN_CHARS) {
            dropdownHint('Type at least ' + SEARCH_MIN_CHARS + ' characters to search items');
            return;
        }
        if (!state.allItems.length) {
            loadAllItems().then(function (items) {
                if (items && items.length) filterItems();
            });
            dropdownHint('Loading item catalogue...');
            return;
        }
        filterItems();
    }

    function normalizeSearch(value) {
        return String(value == null ? '' : value)
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, ' ')
            .trim();
    }

    function itemMatchesTerm(item, term, compactTerm) {
        var haystack = normalizeSearch([
            item.code,
            item.description,
            item.uom,
            item.unitOfMeasure,
            item.item_amount,
        ].join(' '));
        return haystack.indexOf(term) !== -1 || haystack.replace(/\s+/g, '').indexOf(compactTerm) !== -1;
    }

    function renderSearchResults() {
        var term = normalizeSearch(elements.itemCodeInput.value);
        var compactTerm = term.replace(/\s+/g, '');
        state.filteredItems = state.allItems.filter(function (item) {
            return itemMatchesTerm(item, term, compactTerm);
        }).slice(0, SEARCH_MAX_RESULTS);
        renderItems(state.filteredItems);
        elements.dropdownMenu.classList.add('is-open');
        positionItemDropdown();
    }

    function hideItemDropdown() {
        if (elements.dropdownMenu) elements.dropdownMenu.classList.remove('is-open');
    }

    function clearSearchInput() {
        elements.itemCodeInput.value = '';
        state.filteredItems = [];
        elements.itemCodeInput.focus();
        dropdownHint('Type at least ' + SEARCH_MIN_CHARS + ' characters to search items');
    }

    function filterItems() {
        bindElements();
        var term = normalizeSearch(elements.itemCodeInput && elements.itemCodeInput.value);
        if (term.length < SEARCH_MIN_CHARS) {
            state.filteredItems = [];
            dropdownHint('Type at least ' + SEARCH_MIN_CHARS + ' characters to search items');
            return;
        }
        if (itemsLoading || !state.allItems.length) {
            loadAllItems().then(function (items) {
                if (items && items.length) filterItems();
            });
            dropdownHint('Loading item catalogue...');
            return;
        }
        renderSearchResults();
    }

    function normalizeAmcBoqItem(item) {
        return {
            code: String(item.code || item.item_code || '').trim(),
            description: String(item.description || ''),
            uom: item.uom || item.unit_measure || 'EA',
            item_amount: parseFloat(item.item_amount || item.item_price || 0),
            disabled: false,
        };
    }

    function renderAmcProjectBoqPool(items) {
        state.allItems = (items || []).map(normalizeAmcBoqItem).filter(function (item) {
            return item.code !== '';
        });
        state.filteredItems = state.allItems.slice();
        if (state.filteredItems.length) {
            renderItems(state.filteredItems);
        } else {
            dropdownHint('No approved BOQ items found for the original project.');
        }
    }

    function loadAllItems() {
        if (state.amcRenewalType) return Promise.resolve(state.allItems);
        if (state.allItems.length) return Promise.resolve(state.allItems);
        if (itemsLoadPromise) return itemsLoadPromise;
        itemsLoading = true;
        if (elements.dropdownMenu) {
            elements.dropdownMenu.innerHTML = '<div class="dropdown-item text-muted"><i class="fas fa-spinner fa-spin me-2"></i>Loading items...</div>';
        }
        itemsLoadPromise = fetch('/get_item_codes.php', { credentials: 'same-origin' })
            .then(function (resp) { return resp.json(); })
            .then(function (data) {
                if (!data || data.success === false || !Array.isArray(data.data)) throw new Error(data && (data.error || data.message) || 'Invalid data');
                if (state.amcRenewalType) return state.allItems;
                state.allItems = data.data.map(function (item) {
                    return Object.assign({}, item, {
                        code: String(item.code || item.item_code || '').trim(),
                        description: String(item.description || ''),
                        uom: item.unitOfMeasure || item.uom || null,
                        disabled: !(item.unitOfMeasure || item.uom),
                    });
                }).filter(function (item) { return item.code !== ''; });
                state.filteredItems = [];
                if (elements.itemCodeInput && normalizeSearch(elements.itemCodeInput.value).length >= SEARCH_MIN_CHARS) {
                    renderSearchResults();
                }
                return state.allItems;
            })
            .catch(function (err) {
                if (elements.dropdownMenu) {
                    elements.dropdownMenu.innerHTML = '<div class="dropdown-item text-danger">Error loading items' + (err.message ? ': ' + esc(err.message) : '') + '</div>';
                }
                return null;
            })
            .finally(function () {
                itemsLoading = false;
                itemsLoadPromise = null;
            });
        return itemsLoadPromise;
    }

    function renderItems(items) {
        if (!elements.dropdownMenu) return;
        if (!items || !items.length) {
            dropdownHint('No items found');
            return;
        }

        var html = items.map(function (item) {
            var isSelected = state.selectedItems.has(item.code);
            var isDisabled = item.disabled;
            var maxLength = 50;
            var fullDescription = esc(item.description || '');
            var truncatedDesc = fullDescription.length > maxLength
                ? fullDescription.substring(0, maxLength) + '...'
                : fullDescription;
            var selectable = !isSelected && !isDisabled;
            return '<div class="dropdown-item d-flex justify-content-between align-items-center'
                + (isSelected ? ' is-selected' : '')
                + (isDisabled ? ' is-disabled' : '')
                + (selectable ? ' pboq-pick-item' : '')
                + '" data-item-code="' + escAttr(item.code) + '">'
                + '<div class="flex-grow-1"><b>' + esc(item.code) + '</b>'
                + '<div class="small ' + (isDisabled ? 'text-danger' : 'text-muted') + '">' + truncatedDesc
                + (isDisabled ? '<br><small class="text-danger">(No UOM defined)</small>' : '')
                + '</div></div>'
                + (isSelected ? '<span class="badge bg-primary">Selected</span>' : '')
                + '</div>';
        }).join('');

        elements.dropdownMenu.innerHTML = html;
        positionItemDropdown();
        elements.dropdownMenu.classList.add('is-open');

        elements.dropdownMenu.querySelectorAll('.pboq-pick-item').forEach(function (node) {
            node.addEventListener('mousedown', function (e) {
                e.preventDefault();
                e.stopPropagation();
            });
            node.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var code = node.getAttribute('data-item-code');
                var picked = state.allItems.find(function (it) { return it.code === code; });
                if (picked) {
                    toggleItemSelection(picked, true);
                    showItemDropdown();
                    elements.itemCodeInput.focus();
                }
            });
        });
    }

    function findCatalogItem(code) {
        var key = String(code || '');
        for (var i = 0; i < state.allItems.length; i++) {
            if (state.allItems[i].code === key) return state.allItems[i];
        }
        return null;
    }

    function checkExistingApprovals(requestId) {
        return fetch('/get_existing_approvals.php?request_id=' + encodeURIComponent(requestId))
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data && data.data && data.data.length) {
                    loadApprovedItems(data.data);
                    return true;
                }
                return false;
            })
            .catch(function () { return false; });
    }

    function loadApprovedItems(approvals) {
        approvals.forEach(function (approval) {
            var code = String(approval.item_code || '').trim();
            if (!code || state.selectedItems.has(code)) return;
            var qty = Math.max(1, parseInt(approval.quantity, 10) || 1);
            var unitAmount = parseFloat(approval.item_price || 0);
            var item = {
                code: code,
                description: String(approval.description || ''),
                item_amount: unitAmount,
                quantity: qty,
                total: unitAmount * qty,
                approved_by: approval.approved_by,
                approval_time: approval.approval_time,
                uom: approval.unit_measure || 'EA',
                modification_history: [],
            };
            state.originalStates.set(code, Object.assign({}, item));
            state.selectedItems.set(code, item);
        });
        if (approvals.length) {
            showAlert('Existing approvals loaded.', 'info');
        }
    }

    function toggleItemSelection(item, selected) {
        var code = String(item.code || '').trim();
        if (!code) return;
        if (selected) {
            var unitAmount = parseFloat(item.item_amount || 0);
            var qty = 1;
            var newItem = Object.assign({}, item, {
                code: code,
                quantity: qty,
                item_amount: unitAmount,
                total: unitAmount * qty,
                modification_history: [],
            });
            state.selectedItems.set(code, newItem);
            if (!state.originalStates.has(code)) {
                state.originalStates.set(code, Object.assign({}, newItem));
            }
        } else {
            state.selectedItems.delete(code);
            state.originalStates.delete(code);
        }
        state.modalDataChanged = true;
        syncSelectionUi();
        if (state.filteredItems.length) {
            renderItems(state.filteredItems);
        }
    }

    function updateSelectedItemsTable() {
        bindElements();
        if (!elements.selectedItemsBody) return;

        if (state.selectedItems.size === 0) {
            renderEmptySelectedTable();
            return;
        }

        var rowsHtml = '';
        var serial = 1;
        state.selectedItems.forEach(function (item, code) {
            var modClass = item.modification_history && item.modification_history.length ? ' table-warning' : '';
            rowsHtml += '<tr data-item-code="' + escAttr(code) + '" class="pboq-sel-row ' + modClass.trim() + '">'
                + '<td data-label="#">' + serial + '</td>'
                + '<td data-label="Code" class="' + (item.is_error ? 'text-danger fw-bold' : '') + '">' + esc(code) + '</td>'
                + '<td data-label="Description" class="' + (item.is_error ? 'text-danger' : '') + '">' + boqDescriptionCell(item.description || '', code) + '</td>'
                + '<td data-label="UOM">' + esc(item.uom || 'EA') + '</td>'
                + '<td data-label="Unit">' + formatCurrency(item.item_amount || 0) + '</td>'
                + '<td data-label="Qty"><input type="number" class="form-control form-control-sm quantity-input" min="1" step="1" inputmode="numeric" value="' + escAttr(String(item.quantity || 1)) + '" data-item-code="' + escAttr(code) + '" ' + (item.is_locked ? 'disabled' : '') + '></td>'
                + '<td data-label="Total" class="item-total">' + formatCurrency(item.total || 0) + '</td>'
                + '<td data-label="Act"><button type="button" class="btn btn-sm btn-outline-danger remove-item" data-item-code="' + escAttr(code) + '" ' + (item.is_locked ? 'disabled' : '') + '><i class="fas fa-trash-alt"></i></button>'
                + ((item.modification_history && item.modification_history.length)
                    ? '<button type="button" class="btn btn-sm btn-outline-info ms-1 view-history" data-item-code="' + escAttr(code) + '" title="View history"><i class="fas fa-history"></i></button>'
                    : '')
                + '</td></tr>';
            serial += 1;
        });

        elements.selectedItemsBody.innerHTML = rowsHtml;
        refreshNoItemsRowRef();

        elements.selectedItemsBody.querySelectorAll('.quantity-input').forEach(function (input) {
            input.addEventListener('input', handleQuantityChange);
        });
        elements.selectedItemsBody.querySelectorAll('.remove-item').forEach(function (btn) {
            btn.addEventListener('click', handleRemoveItem);
        });
        elements.selectedItemsBody.querySelectorAll('.view-history').forEach(function (btn) {
            btn.addEventListener('click', showItemHistory);
        });
    }

    function handleQuantityChange(e) {
        var itemCode = e.target.dataset.itemCode;
        var item = state.selectedItems.get(itemCode);
        if (!item) return;
        var oldQuantity = item.quantity;
        var quantity = Math.max(1, parseInt(e.target.value, 10) || 1);

        if (oldQuantity !== quantity) {
            trackItemModification(itemCode, 'quantity', oldQuantity, quantity);
            item.quantity = quantity;
            item.total = parseFloat(item.item_amount || 0) * quantity;
            var row = e.target.closest('tr');
            if (row) {
                var totalCell = row.querySelector('.item-total');
                if (totalCell) totalCell.textContent = formatCurrency(item.total);
                row.classList.add('table-warning');
            }
            state.modalDataChanged = true;
            updateGrandTotal();
            updateJsonInput();
            updateApproveButtonState();
        }
    }

    function handleRemoveItem(e) {
        var itemCode = e.target.closest('button').dataset.itemCode;
        var requestId = elements.requestIdInput.value;
        if (!confirm('Remove item ' + itemCode + '?')) return;

        fetch('/check_item_exists.php?request_id=' + encodeURIComponent(requestId) + '&item_code=' + encodeURIComponent(itemCode))
            .then(function (response) { return response.json(); })
            .then(function (data) {
                if (data.status !== 'success') throw new Error(data.message || 'Check error');
                toggleItemSelection({ code: itemCode }, false);
                if (data.exists) {
                    var deletedInput = document.createElement('input');
                    deletedInput.type = 'hidden';
                    deletedInput.name = 'deleted_items[]';
                    deletedInput.value = JSON.stringify({
                        item_code: itemCode,
                        request_id: requestId,
                        original_quantity: data.current_quantity,
                        original_price: data.current_price,
                        original_status: data.current_status,
                        original_uom: data.unit_measure,
                    });
                    elements.approveForm.appendChild(deletedInput);
                    showAlert('Item ' + itemCode + ' will be rejected', 'info');
                }
            })
            .catch(function (error) {
                showAlert('Error: ' + error.message, 'danger');
            });
    }

    function showItemHistory(e) {
        var itemCode = e.target.closest('button').dataset.itemCode;
        var item = state.selectedItems.get(itemCode);
        var originalItem = state.originalStates.get(itemCode);
        if (!item || !item.modification_history || !item.modification_history.length) {
            showAlert('No modification history', 'info');
            return;
        }

        var historyContent = '<div class="mb-3"><strong>Item:</strong> ' + esc(item.code) + '</div>'
            + '<div class="mb-2"><strong>Original State:</strong></div>'
            + '<ul class="small mb-3"><li>Quantity: ' + originalItem.quantity + '</li>'
            + '<li>Unit Price: ' + formatCurrency(originalItem.item_amount) + '</li>'
            + '<li>Total: ' + formatCurrency(originalItem.total) + '</li>'
            + '<li>UOM: ' + esc(originalItem.uom || 'EA') + '</li></ul>'
            + '<div class="mb-2"><strong>Modifications:</strong></div>'
            + '<table class="table table-sm small"><thead><tr><th>Field</th><th>Old</th><th>New</th><th>By</th><th>Time</th></tr></thead><tbody>'
            + item.modification_history.map(function (change) {
                return '<tr><td>' + esc(change.field) + '</td><td>' + esc(change.old_value || 'Not set') + '</td>'
                    + '<td>' + esc(change.new_value || 'Not set') + '</td><td>' + esc(change.modified_by) + '</td>'
                    + '<td>' + new Date(change.modification_time).toLocaleString() + '</td></tr>';
            }).join('')
            + '</tbody></table>';

        elements.historyModalBody.innerHTML = historyContent;
        new bootstrap.Modal(document.getElementById('pboq-history-modal')).show();
    }

    function updateGrandTotal() {
        var total = 0;
        state.selectedItems.forEach(function (item) { total += item.total; });
        elements.grandTotalCell.textContent = formatCurrency(total);
    }

    function updateJsonInput() {
        var itemsArray = Array.from(state.selectedItems.values()).map(function (item) {
            return {
                code: item.code,
                description: item.description,
                unit_value: item.item_amount,
                quantity: item.quantity,
                total: item.total,
                uom: item.uom || 'EA',
                approved_by: item.approved_by,
                approval_time: item.approval_time,
                modification_history: item.modification_history || [],
            };
        });
        elements.selectedItemsJson.value = JSON.stringify(itemsArray);
    }

    function trackItemModification(itemCode, field, oldValue, newValue) {
        var item = state.selectedItems.get(itemCode);
        if (!item) return;
        if (!item.modification_history) item.modification_history = [];
        item.modification_history.push({
            field: field,
            old_value: oldValue,
            new_value: newValue,
            modified_by: 'current_user',
            modification_time: new Date().toISOString(),
        });
    }

    function checkForConcurrentModifications(requestId) {
        return fetch('/check_concurrent_modifications.php?request_id=' + encodeURIComponent(requestId))
            .then(function (response) { return response.json(); })
            .then(function (data) {
                if (!data || !data.data) return [];
                var conflicts = [];
                var serverItems = new Map(data.data.map(function (it) { return [it.item_code, it]; }));
                state.selectedItems.forEach(function (clientItem, code) {
                    var serverItem = serverItems.get(code);
                    if (serverItem && serverItem.quantity !== clientItem.quantity) {
                        conflicts.push({
                            item: code,
                            message: 'Quantity mismatch',
                            server_state: serverItem,
                            client_state: clientItem,
                        });
                    }
                });
                return conflicts;
            })
            .catch(function () { return []; });
    }

    function handleFormSubmit(e) {
        e.preventDefault();
        if (actionBusy) return;

        if (state.selectedItems.size === 0) {
            showAlert('Please select at least one item', 'warning');
            return;
        }

        var notes = (elements.notes && elements.notes.value || '').trim();
        if (!notes) {
            showAlert('Approval notes are required.', 'warning');
            if (elements.notes) elements.notes.focus();
            return;
        }

        var fileInput = elements.documentInput;
        var documentFile = fileInput && fileInput.files && fileInput.files[0];
        if (!documentFile) {
            showAlert('Approval report PDF is required.', 'warning');
            if (fileInput) fileInput.focus();
            return;
        }
        if (documentFile.type && documentFile.type !== 'application/pdf') {
            showAlert('Please upload a PDF file for the approval report.', 'warning');
            return;
        }

        if (state.isLastStage) {
            if (!(parseInt(state.termId, 10) > 0) || !(parseInt(state.accountId, 10) > 0)) {
                showAlert('Please select Phase (payment terms) and payment account.', 'warning');
                setPhaseAccountError('Phase and payment account are required.');
                return;
            }
        }

        actionBusy = true;
        updateApproveButtonState();
        updateRejectButtonState();
        elements.submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Processing...';

        var formData = new FormData(elements.approveForm);
        var requestId = formData.get('item_id');

        checkForConcurrentModifications(requestId).then(function (conflicts) {
            if (conflicts.length) {
                showAlert('Conflict detected. Please refresh and try again.', 'warning');
                throw new Error('conflict');
            }

            var submissionData = {
                request_id: requestId,
                items: Array.from(state.selectedItems.values()).map(function (item) {
                    return {
                        code: item.code,
                        description: item.description,
                        unit_value: item.item_amount,
                        quantity: item.quantity,
                        total: item.total,
                        uom: item.uom || 'EA',
                        modification_history: item.modification_history || [],
                    };
                }),
                deleted_items: Array.from(document.querySelectorAll('#pboq-form input[name="deleted_items[]"]'))
                    .map(function (inp) { return JSON.parse(inp.value); }),
            };

            if (state.isLastStage) {
                submissionData.term_id = parseInt(state.termId, 10);
                submissionData.account_id = parseInt(state.accountId, 10);
            }

            var optimizedFormData = new FormData();
            optimizedFormData.append('action', 'approve');
            optimizedFormData.append('item_id', formData.get('item_id'));
            optimizedFormData.append('po_description', formData.get('po_description') || '');
            if (state.isLastStage) {
                optimizedFormData.append('term_id', String(parseInt(state.termId, 10)));
                optimizedFormData.append('account_id', String(parseInt(state.accountId, 10)));
            }
            var documentFile = formData.get('head_document');
            if (documentFile && documentFile.size > 0) {
                optimizedFormData.append('head_document', documentFile);
            }
            optimizedFormData.append('data', JSON.stringify(submissionData));

            return fetch('/item_action.php', {
                method: 'POST',
                body: optimizedFormData,
                headers: { 'X-Optimized-Submission': 'true' },
            });
        }).then(function (response) {
            if (!response.ok) throw new Error('Server returned ' + response.status);
            return response.json();
        }).then(function (data) {
            if (data.status !== 'success') throw new Error(data.message || 'Action failed');
            toast('Purchase request approved successfully.', 'success');
            onActionSuccess('Approved');
        }).catch(function (error) {
            if (error && error.message !== 'conflict') {
                showAlert('Error: ' + error.message, 'danger');
            }
        }).finally(function () {
            actionBusy = false;
            elements.submitBtn.innerHTML = '<i class="fas fa-check-circle me-1"></i> Confirm Approval';
            updateApproveButtonState();
            updateRejectButtonState();
        });
    }

    function handleRejectSubmit(e) {
        e.preventDefault();
        if (actionBusy) return;

        var reason = (elements.rejectReason.value || '').trim();
        if (!reason) {
            toast('Rejection reason is required.', 'warning');
            return;
        }

        actionBusy = true;
        updateRejectButtonState();
        var formData = new FormData(elements.rejectForm);

        fetch('/reject_item_status.php', { method: 'POST', body: formData })
            .then(function (response) { return response.json(); })
            .then(function (data) {
                if (!data.success) throw new Error(data.message || 'Reject failed');
                toast('Request rejected successfully.', 'success');
                var rejectModal = bootstrap.Modal.getInstance(elements.rejectModal);
                if (rejectModal) rejectModal.hide();
                onActionSuccess('Rejected', reason);
            })
            .catch(function (error) {
                toast(error.message || 'Failed to reject request.', 'error');
            })
            .finally(function () {
                actionBusy = false;
                updateRejectButtonState();
            });
    }

    function onActionSuccess(status, rejectReason) {
        var requestId = elements.requestIdInput.value;
        var row = state.currentRow || {};
        hideModal();
        state.modalDataChanged = false;

        if (window.EDPurchaseApproval) {
            window.EDPurchaseApproval.removePending(requestId);
            window.EDPurchaseApproval.prependHistory({
                id: String(requestId),
                request_id: parseInt(requestId, 10),
                project_id: row.project_id || '',
                description: row.description || '',
                status: status,
                action_date_display: 'Just now',
                reject_reason: rejectReason || '',
                _cat: 'purchase',
            });
            if (typeof window.drawAppr === 'function') window.drawAppr();
            if (typeof window.initAppr === 'function') window.initAppr();
        }
    }

    function findStepByStage(steps, stageNumber) {
        for (var i = 0; i < (steps || []).length; i++) {
            if (parseInt(steps[i].stage, 10) === stageNumber) return steps[i];
        }
        return null;
    }

    function findCurrentPendingStep(steps) {
        for (var i = 0; i < (steps || []).length; i++) {
            var step = steps[i];
            if (normalizeStatus(step.status) !== 'Pending') continue;
            if (parseInt(step.stage, 10) === 1) return step;
            var prev = findStepByStage(steps, parseInt(step.stage, 10) - 1);
            if (prev && normalizeStatus(prev.status) === 'Approved') return step;
        }
        return null;
    }

    function resolveWorkflowUiStatus(step, steps) {
        var status = normalizeStatus(step.status);
        if (status === 'Approved') return 'done';
        if (status === 'Rejected') return 'rejected';
        var current = findCurrentPendingStep(steps);
        if (status === 'Pending' && current && parseInt(current.stage, 10) === parseInt(step.stage, 10)) {
            return 'pending';
        }
        return 'up';
    }

    function stageReportHtml(step) {
        if (!step.report_url) return '';
        var icon = step.report_type === 'pdf' ? 'fa-file-pdf' : 'fa-file';
        return '<a href="' + esc(step.report_url) + '" target="_blank" rel="noopener noreferrer"'
            + ' style="display:inline-flex;align-items:center;gap:4px;font-size:10px;color:#2563eb;margin-top:4px;text-decoration:none">'
            + '<i class="fa ' + icon + '"></i> View Report</a>';
    }

    function renderWorkflow(steps, detail) {
        if (!elements.workflowSteps) return;

        if (!steps || !steps.length) {
            elements.workflowSteps.innerHTML = '<div style="padding:16px;color:#9ca3af;font-size:12px">No workflow data</div>';
            return;
        }

        var done = steps.filter(function (s) { return normalizeStatus(s.status) === 'Approved'; }).length;
        var rejected = steps.some(function (s) { return normalizeStatus(s.status) === 'Rejected'; });
        var progress = Math.round((done / steps.length) * 100);
        elements.workflowProgress.style.width = progress + '%';
        elements.workflowCount.textContent = done + '/' + steps.length;

        var pendingStep = findCurrentPendingStep(steps);
        if (elements.workflowPending) {
            if (pendingStep) {
                elements.workflowPending.textContent = 'Stage ' + pendingStep.stage + ' — ' + (pendingStep.head_name || 'Approver');
            } else if (rejected) {
                elements.workflowPending.textContent = 'Rejected';
            } else if (done === steps.length) {
                elements.workflowPending.textContent = 'All stages completed';
            } else {
                elements.workflowPending.textContent = 'None';
            }
        }

        if (elements.summaryRequester && detail) {
            elements.summaryRequester.textContent = (detail.employee_name || '') + (detail.bio_id ? ' (' + detail.bio_id + ')' : '');
        }
        if (elements.summaryAmount && detail) {
            elements.summaryAmount.textContent = formatCurrency(detail.total_approx_value || 0);
        }

        var statusStyles = {
            done: { bg: 'linear-gradient(180deg,#4ade80,#22c55e)', border: '#16a34a', icon: 'fa-check' },
            pending: { bg: 'linear-gradient(180deg,#fbbf24,#f59e0b)', border: '#d97706', icon: 'fa-clock' },
            rejected: { bg: 'linear-gradient(180deg,#f87171,#ef4444)', border: '#dc2626', icon: 'fa-times' },
            up: { bg: '#e5e7eb', border: '#d1d5db', icon: 'fa-circle' },
        };

        elements.workflowSteps.innerHTML = steps.map(function (step, index) {
            var ui = resolveWorkflowUiStatus(step, steps);
            var style = statusStyles[ui] || statusStyles.up;
            var dateLabel = step.action_date ? new Date(step.action_date).toLocaleDateString('en-IN', { month: 'short', day: 'numeric' }) : '—';
            return '<div class="wf-step d-flex ' + (ui === 'up' ? 'opacity-50' : '') + '">'
                + '<div class="wf-date">' + esc(dateLabel) + '</div>'
                + '<div class="wf-mid"><div class="wf-dot" style="background:' + style.bg + ';border:1.5px solid ' + style.border + '"><i class="fa ' + style.icon + '" style="font-size:8px"></i></div>'
                + (index < steps.length - 1 ? '<div class="wf-vline ' + (ui === 'done' ? 'done' : '') + '"></div>' : '')
                + '</div><div class="wf-body"><div style="display:flex;align-items:center;gap:6px">'
                + '<span style="font-size:12px;font-weight:700;color:#1a202c">Stage ' + step.stage + '</span>'
                + (ui === 'pending' ? '<span style="padding:1px 6px;background:#f59e0b;color:#fff;font-size:8px;font-weight:700;border-radius:99px;text-transform:uppercase">Current</span>' : '')
                + '</div><div style="font-size:10px;color:#9ca3af;margin-top:1px">' + esc(step.head_name || 'N/A') + ' — ' + esc(normalizeStatus(step.status) || 'Pending') + '</div>'
                + (step.reject_reason ? '<div style="font-size:10px;color:#9ca3af;margin-top:3px">' + esc(step.reject_reason) + '</div>' : '')
                + stageReportHtml(step)
                + '</div></div>';
        }).join('');
    }

    function loadWorkflowAndDetail(requestId) {
        Promise.all([
            fetchJson(apiUrl({ action: 'workflow', request_id: requestId })),
            fetchJson(apiUrl({ action: 'detail', request_id: requestId })),
        ]).then(function (results) {
            var workflowBlock = (results[0] && results[0].purchase_approval) || {};
            var detail = (results[1] && results[1].purchase_approval) || null;
            renderWorkflow(workflowBlock.steps || [], detail);
        }).catch(function (err) {
            DEBUG && console.error('workflow load', err);
            renderWorkflow([], null);
        });
    }

    function resetAmcUi() {
        state.amcRenewalType = null;
        elements.itemCodeInput.disabled = false;
        elements.clearSearch.disabled = false;
        elements.itemCodeInput.placeholder = 'Type item code or description...';
        elements.itemCodeInput.classList.remove('bg-light');
    }

    function loadModalData(requestId) {
        modalDataLoading = true;
        return checkExistingApprovals(requestId)
            .then(function () {
                return fetch('/get_amc_item_details.php?request_id=' + encodeURIComponent(requestId))
                    .then(function (res) { return res.json(); });
            })
            .then(function (amcData) {
                if (amcData && amcData.success && amcData.is_amc) {
                    state.amcRenewalType = amcData.type || 'equipment_renewal';
                    elements.itemCodeInput.disabled = true;
                    elements.clearSearch.disabled = true;
                    elements.itemCodeInput.value = '';
                    elements.itemCodeInput.classList.add('bg-light');

                    if (amcData.type === 'project_renewal') {
                        elements.itemCodeInput.placeholder = 'Select AMC item from approved project BOQ below';
                        renderAmcProjectBoqPool(amcData.items || []);
                        if (!amcData.items || !amcData.items.length) {
                            showAlert('No approved BOQ items found for the original project.', 'warning');
                        } else {
                            showAlert('Select only AMC equipment item codes from the approved project BOQ below.', 'info');
                        }
                        return;
                    }

                    var amcItem = amcData.item || amcData.data;
                    if (!amcItem || !amcItem.code) {
                        showAlert(amcData.message || 'Unable to load AMC equipment item details.', 'warning');
                        return;
                    }

                    elements.itemCodeInput.placeholder = 'AMC Request - Item auto-filled';
                    hideItemDropdown();
                    state.selectedItems.set(amcItem.code, {
                        code: amcItem.code,
                        description: amcItem.description,
                        uom: amcItem.uom || 'EA',
                        item_amount: amcItem.item_amount,
                        quantity: 1,
                        total: amcItem.item_amount,
                        is_locked: true,
                    });
                    showAlert('Item auto-filled from equipment registry. Adjust quantity if needed.', 'info');
                    return;
                }

                resetAmcUi();
                if (state.selectedItems.size === 0) {
                    var storedState = state.requestStates.get(requestId);
                    if (storedState && storedState.items && storedState.items.size > 0) {
                        state.selectedItems = new Map(storedState.items);
                        state.originalStates = new Map(storedState.originalStates);
                    }
                }
            })
            .catch(function (err) {
                DEBUG && console.error('loadModalData', err);
            })
            .finally(function () {
                modalDataLoading = false;
                syncSelectionUi();
            });
    }

    function openModal(row) {
        bindElements();
        if (!elements.modal) return;

        var requestId = String(row.request_id || row.id);
        var previousRequestId = state.currentRequestId;

        if (previousRequestId && previousRequestId !== requestId && state.selectedItems.size > 0) {
            state.requestStates.set(previousRequestId, {
                items: new Map(state.selectedItems),
                originalStates: new Map(state.originalStates),
            });
        }

        state.currentRow = row;
        state.currentRequestId = requestId;
        state.selectedItems.clear();
        state.originalStates.clear();
        state.modalDataChanged = false;
        state.filteredItems = [];
        state.amcRenewalType = null;

        elements.requestIdInput.value = requestId;
        elements.stageNumberInput.value = String(row.stage_number || '');
        elements.rejectRequestId.value = requestId;
        elements.rejectStageId.value = String(row.stage_number || '');

        if (elements.title) {
            elements.title.textContent = 'BOQ Approval - Project ' + (row.project_id || '');
        }
        if (elements.subtitle) {
            elements.subtitle.textContent = truncateText(row.description || '', 88);
        }

        elements.approveForm.querySelectorAll('input[name="deleted_items[]"]').forEach(function (n) { n.remove(); });
        if (elements.alertHost) elements.alertHost.innerHTML = '';
        if (elements.notes) elements.notes.value = '';
        if (elements.documentInput) elements.documentInput.value = '';

        clearPhaseAccountSelection();
        setPhaseAccountPanelVisible(!!row.is_last_stage);

        resetSelectionUi();
        resetAmcUi();
        hideItemDropdown();
        syncSelectionUi();

        loadAllItems();
        loadWorkflowAndDetail(requestId);
        loadModalData(requestId);

        if (!modalInstance) {
            modalInstance = new bootstrap.Modal(elements.modal);
        }
        modalInstance.show();
    }

    function hideModal() {
        if (modalInstance) modalInstance.hide();
    }

    function handleModalClose(e) {
        if (state.modalDataChanged) {
            if (!confirm('You have unsaved changes. Close anyway?')) {
                e.preventDefault();
                e.stopPropagation();
                return false;
            }
        }
        hideModal();
    }

    function openRejectPrompt() {
        bindElements();
        if (!elements.rejectModal) return;
        elements.rejectReason.value = '';
        updateRejectButtonState();
        new bootstrap.Modal(elements.rejectModal).show();
    }

    function openDocument(url, type) {
        if (!url) {
            toast('No document available.', 'warning');
            return;
        }
        var modalEl = document.getElementById('pboq-document-modal');
        if (!modalEl) {
            window.open(url, '_blank');
            return;
        }
        var imgElement = document.getElementById('pboq-document-image');
        var fileElement = document.getElementById('pboq-document-file');
        var frameElement = document.getElementById('pboq-document-frame');
        var downloadLink = document.getElementById('pboq-document-download');

        if (type === 'image') {
            imgElement.src = url;
            imgElement.style.display = 'block';
            fileElement.style.display = 'none';
        } else {
            imgElement.style.display = 'none';
            fileElement.style.display = 'block';
            frameElement.src = url;
            if (downloadLink) downloadLink.href = url;
        }
        new bootstrap.Modal(modalEl).show();
    }

    function init() {
        bindElements();
        if (!elements.approveForm || !elements.itemCodeInput) return;

        elements.itemCodeInput.addEventListener('focus', showItemDropdown);
        elements.itemCodeInput.addEventListener('click', showItemDropdown);
        elements.itemCodeInput.addEventListener('input', debounce(filterItems, 200));
        elements.clearSearch.addEventListener('click', clearSearchInput);
        elements.approveForm.addEventListener('input', updateApproveButtonState);
        elements.approveForm.addEventListener('change', updateApproveButtonState);
        elements.approveForm.addEventListener('submit', handleFormSubmit);
        if (elements.closeBtn) elements.closeBtn.addEventListener('click', handleModalClose);
        if (elements.rejectBtn) elements.rejectBtn.addEventListener('click', openRejectPrompt);
        if (elements.rejectForm) elements.rejectForm.addEventListener('submit', handleRejectSubmit);
        if (elements.rejectReason) elements.rejectReason.addEventListener('input', updateRejectButtonState);
        if (elements.notes) elements.notes.addEventListener('input', updateApproveButtonState);
        if (elements.documentInput) elements.documentInput.addEventListener('change', updateApproveButtonState);

        if (elements.termsBtn) {
            elements.termsBtn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var willOpen = elements.termsMenu && elements.termsMenu.classList.contains('d-none');
                closePhaseAccountMenus();
                if (willOpen) {
                    renderTermsItems(elements.termsSearch ? elements.termsSearch.value : '');
                    elements.termsMenu.classList.remove('d-none');
                    elements.termsBtn.classList.add('active');
                    if (elements.termsSearch) {
                        elements.termsSearch.value = '';
                        setTimeout(function () { elements.termsSearch.focus(); }, 50);
                    }
                }
            });
        }
        if (elements.accountBtn) {
            elements.accountBtn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var willOpen = elements.accountMenu && elements.accountMenu.classList.contains('d-none');
                closePhaseAccountMenus();
                if (willOpen) {
                    renderAccountItems(elements.accountSearch ? elements.accountSearch.value : '');
                    elements.accountMenu.classList.remove('d-none');
                    elements.accountBtn.classList.add('active');
                    if (elements.accountSearch) {
                        elements.accountSearch.value = '';
                        setTimeout(function () { elements.accountSearch.focus(); }, 50);
                    }
                }
            });
        }
        if (elements.termsSearch) {
            elements.termsSearch.addEventListener('input', function () {
                renderTermsItems(elements.termsSearch.value);
            });
            elements.termsSearch.addEventListener('keydown', function (e) {
