        #pa-detail-loading.is-hidden {
            display: none !important;
        }

        #pa-detail-content.is-open {
            display: flex !important;
        }

        .pa-detail-split {
            display: none;
            flex-direction: row;
            align-items: stretch;
            flex: 1 1 auto;
            min-height: min(68vh, 600px);
            background: linear-gradient(180deg, #f8f9fb 0%, #eef2f7 100%);
        }

        .pa-detail-left {
            flex: 1 1 58%;
