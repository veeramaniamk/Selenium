        var inner;
        if (url) {
            inner = '<img src="' + escAttr(url) + '" alt="" loading="lazy" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\'">'
                + '<span class="hy-avatar-fallback" style="display:none">' + initials + '</span>';
        } else {
            inner = '<span class="hy-avatar-fallback">' + initials + '</span>';
        }

        if (clickable) {
            return '<button type="button" class="hy-avatar hy-avatar-' + size + ' hy-avatar-btn" data-bio-id="' + bio + '" title="View profile &amp; attendance" aria-label="View details for ' + escAttr(emp.employee_name || emp.bio_id || '') + '">'
                + inner + '</button>';
        }
        return '<div class="hy-avatar hy-avatar-' + size + '">' + inner + '</div>';
    }

    function skeletonRows(count) {
        var html = '';
        for (var i = 0; i < (count || 5); i += 1) {
            html += '<tr class="hy-skel-row"><td colspan="9"><span class="ed-skel ed-skel-cell w-full"></span></td></tr>';
        }
        return html;
    }

    function setToolbarEnabled(enabled) {
        var toolbar = $('hy-toolbar');
        var badge = $('hy-total-badge');
        var cycleToggle = $('hy-cycle-toggle');
        var filters = $('hy-status-filters');
        if (toolbar) toolbar.classList.toggle('is-disabled', !enabled);
        if (badge) badge.style.display = enabled ? '' : 'none';
        if (cycleToggle) cycleToggle.style.display = enabled && state.headViewEnabled ? '' : 'none';
        if (filters) filters.style.display = enabled && state.headViewEnabled ? '' : 'none';
    }

    function syncDetailCycleButtons() {
        var wrap = $('hy-detail-cycle');
        if (!wrap) return;
        wrap.querySelectorAll('[data-detail-cycle]').forEach(function (btn) {
            var active = btn.getAttribute('data-detail-cycle') === state.detailCycle;
            btn.classList.toggle('is-active', active);
            btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
    }

    function empStatFor(bioId) {
        return state.empStats[bioId] || null;
    }

    function matchesStatusFilter(emp) {
        if (state.statusFilter === 'all') return true;
        var st = empStatFor(emp.bio_id);
        var today = st && st.today_status ? String(st.today_status) : 'Pending';
        if (state.statusFilter === 'Present') return today === 'Present' || today === 'Late';
        if (state.statusFilter === 'Absent') return today === 'Absent' || today === 'Sandwich LOP';
        if (state.statusFilter === 'Leave') return today === 'Leave' || today === 'Half Day';
        return true;
    }

    function visibleRows() {
        return state.rows.filter(matchesStatusFilter);
    }

    function renderTable() {
        var body = $('hy-body');
        var countEl = $('hy-total-count');
        if (!body) return;

        if (countEl) countEl.textContent = String(state.total || 0);
        setToolbarEnabled(state.isHead);

        if (!state.isHead) {
            body.innerHTML = '<tr><td colspan="9" class="hy-td-empty">'
                + '<div class="hy-empty-inline"><i class="fa fa-users-slash"></i>'
                + '<div><strong>No team assigned</strong>'
                + '<p>You are not set as a reporting head in hierarchy master.</p></div></div>'
                + '</td></tr>';
            hideStats();
            updateShowing();
            renderPager();
            return;
        }

        var rows = visibleRows();
        if (!state.rows.length) {
            body.innerHTML = '<tr><td colspan="9" class="hy-td-empty">'
                + (state.search
                    ? 'No employees match your search.'
                    : '<div class="hy-empty-inline"><i class="fa fa-user-group"></i><div><strong>No employees yet</strong><p>No one is assigned under you in hierarchy master.</p></div></div>')
                + '</td></tr>';
            updateShowing();
            renderPager();
            return;
        }

        if (!rows.length) {
            body.innerHTML = '<tr><td colspan="9" class="hy-td-empty">No employees match this status filter on the current page.</td></tr>';
            updateShowing();
            renderPager();
            return;
        }

        body.innerHTML = rows.map(function (emp) {
            var originalIdx = state.rows.indexOf(emp);
            var serial = (state.page - 1) * PER_PAGE + originalIdx + 1;
            var st = empStatFor(emp.bio_id);
            var today = st && st.today_status ? st.today_status : (state.stats ? '—' : '…');
            var att = st && st.cycle_att_pct != null ? (Math.round(st.cycle_att_pct) + '%') : (state.stats ? '—' : '…');
            var attClass = 'hy-att-pct';
            if (st && st.cycle_att_pct != null) {
                if (st.cycle_att_pct >= 90) attClass += ' is-good';
                else if (st.cycle_att_pct >= 75) attClass += ' is-ok';
                else attClass += ' is-bad';
            }
            return '<tr class="hy-row" data-bio-id="' + escAttr(emp.bio_id || '') + '">'
                + '<td data-label="#">' + esc(String(serial)) + '</td>'
                + '<td class="hy-td-photo" data-label="Photo">' + avatarHtml(emp, { clickable: state.headViewEnabled }) + '</td>'
                + '<td data-label="Bio ID"><strong>' + esc(emp.bio_id || '—') + '</strong></td>'
                + '<td data-label="Employee Name">'
                + (state.headViewEnabled
                    ? '<button type="button" class="hy-name-btn" data-bio-id="' + escAttr(emp.bio_id || '') + '">' + esc(emp.employee_name || '—') + '</button>'
                    : '<strong>' + esc(emp.employee_name || '—') + '</strong>') + '</td>'
                + '<td data-label="Today">' + (today === '…' || today === '—' ? '<span class="hy-muted">' + esc(today) + '</span>' : statusPill(today)) + '</td>'
                + '<td data-label="Att %"><span class="' + attClass + '">' + esc(att) + '</span></td>'
                + '<td data-label="Department">' + esc(emp.department || '—') + '</td>'
                + '<td data-label="Designation">' + esc(emp.designation || '—') + '</td>'
                + '<td data-label="Group">' + esc(emp.group_name || '—') + '</td>'
                + '</tr>';
        }).join('');

        updateShowing();
        renderPager();
    }

    function totalPages() {
        return Math.max(1, Math.ceil((state.total || 0) / PER_PAGE));
    }

    function updateShowing() {
        var el = $('hy-showing');
        if (!el) return;
        var total = state.total || 0;
        if (!total) {
            el.textContent = '0';
            return;
        }
        var start = (state.page - 1) * PER_PAGE + 1;
        var end = Math.min(state.page * PER_PAGE, total);
        el.textContent = start + '–' + end + ' of ' + total;
    }

    function renderPager() {
        var pager = $('hy-pager');
        if (!pager) return;
        pager.innerHTML = '';
        var pages = totalPages();
        if (pages <= 1 || !state.isHead) return;

        var prev = document.createElement('button');
        prev.type = 'button';
        prev.className = 'cn-pager-btn';
        prev.textContent = 'Prev';
        prev.disabled = state.page <= 1;
        prev.addEventListener('click', function () {
            if (state.page > 1) load({ page: state.page - 1 });
        });
        pager.appendChild(prev);

        var label = document.createElement('span');
        label.className = 'hy-pager-label';
        label.textContent = 'Page ' + state.page + ' / ' + pages;
        pager.appendChild(label);

        var next = document.createElement('button');
        next.type = 'button';
        next.className = 'cn-pager-btn';
        next.textContent = 'Next';
        next.disabled = state.page >= pages;
        next.addEventListener('click', function () {
            if (state.page < pages) load({ page: state.page + 1 });
        });
        pager.appendChild(next);
    }

    function renderGroups() {
        var el = $('hy-groups');
        if (!el) return;
        if (!state.groups || !state.groups.length || !state.isHead) {
            el.innerHTML = '';
            el.style.display = 'none';
            return;
        }
        el.style.display = '';
        el.innerHTML = '<span class="hy-groups-lbl">Groups:</span>'
            + state.groups.map(function (g) {
                return '<span class="hy-group-chip">' + esc(g) + '</span>';
            }).join('');
    }

    function hideStats() {
        var el = $('hy-stats');
        if (el) el.style.display = 'none';
        var skel = $('hy-stats-skel');
        if (skel) skel.style.display = 'none';
    }

    function showStatsLoading(hasExisting) {
        var el = $('hy-stats');
        var skel = $('hy-stats-skel');
        var grid = $('hy-kpi-grid');
        var trend = $('hy-trend-row');
        if (!el || !state.isHead) return;
        el.style.display = '';
        el.classList.add('is-loading');
        if (!hasExisting) {
            if (skel) skel.style.display = 'grid';
            if (grid) grid.style.display = 'none';
            if (trend) trend.style.display = 'none';
        } else {
            if (skel) skel.style.display = 'none';
            if (grid) grid.style.display = '';
            if (trend) trend.style.display = '';
        }
    }

    function applyStatsPayload(data) {
        state.stats = data;
        state.empStats = data.employees && typeof data.employees === 'object' && !Array.isArray(data.employees)
            ? data.employees
            : {};
        renderStats();
        renderTable();
    }

    function renderStats() {
        var el = $('hy-stats');
        var skel = $('hy-stats-skel');
        var grid = $('hy-kpi-grid');
        var trendEl = $('hy-trend-row');
        if (!el) return;
        if (!state.isHead || !state.stats) {
            hideStats();
            return;
        }

        var s = state.stats;
        var today = s.today_snapshot || {};
        var cycle = s.cycle_summary || {};
        var highlights = s.highlights || {};

        el.style.display = '';
        el.classList.remove('is-loading');
        if (skel) skel.style.display = 'none';
        if (grid) grid.style.display = '';
        if (trendEl) trendEl.style.display = '';

        setText('hy-kpi-team', String(s.team_size || 0));
        setText('hy-kpi-present', String(today.present != null ? today.present : 0));
        setText('hy-kpi-present-pct', today.present_percent != null ? (today.present_percent + '% working') : '');
        setText('hy-kpi-absent', String(today.absent != null ? today.absent : 0));
        setText('hy-kpi-leave', String(today.on_leave != null ? today.on_leave : 0));
        setText('hy-kpi-att', (cycle.avg_attendance_percent != null ? cycle.avg_attendance_percent : 0) + '%');
        setText('hy-kpi-att-cycle', (s.cycle && s.cycle.selector_label) ? s.cycle.selector_label : '');
        setText('hy-kpi-lop', String(cycle.avg_lop_days != null ? cycle.avg_lop_days : 0));
        setText('hy-kpi-absent-avg', 'Absent avg ' + (cycle.avg_absent_days != null ? cycle.avg_absent_days : 0));

        var chips = [];
        chips.push(trendChip('Half-day avg', cycle.avg_half_days != null ? cycle.avg_half_days : 0));
        chips.push(trendChip('Late today', today.late != null ? today.late : 0, 'hy-trend-late'));
        chips.push(trendChip('Pending', today.pending != null ? today.pending : 0));
        chips.push(trendChip('Buffer left', (cycle.avg_buffer_remaining != null ? cycle.avg_buffer_remaining : 0) + 'm', 'hy-trend-buf'));
        if (highlights.highest) {
            chips.push(trendChip('Top', highlights.highest.employee_name + ' · ' + Math.round(highlights.highest.attendance_percent) + '%', 'hy-trend-good'));
        }
        if (highlights.lowest) {
            chips.push(trendChip('Watch', highlights.lowest.employee_name + ' · ' + Math.round(highlights.lowest.attendance_percent) + '%', 'hy-trend-warn'));
        }
        if (trendEl) trendEl.innerHTML = chips.join('');
    }

    function setText(id, value) {
        var el = $(id);
        if (el) el.textContent = value;
    }

    function trendChip(label, value, extraClass) {
        return '<span class="hy-trend-chip ' + (extraClass || '') + '"><span class="hy-trend-lbl">' + esc(label) + '</span><strong>' + esc(String(value)) + '</strong></span>';
    }

    function load(opts) {
        var options = opts || {};
        if (options.page) state.page = options.page;
        if (options.search != null) {
            state.search = String(options.search).trim();
            state.page = 1;
        }

        var body = $('hy-body');
        if (body) body.innerHTML = skeletonRows(5);

        return api({
            action: 'list',
            page: String(state.page),
            per_page: String(PER_PAGE),
            search: state.search,
        }).then(function (data) {
            state.rows = Array.isArray(data.employees) ? data.employees : [];
            state.total = parseInt(data.total, 10) || 0;
            state.isHead = !!data.is_head;
            state.headViewEnabled = data.head_view_enabled !== false;
            state.groups = Array.isArray(data.groups) ? data.groups : [];
            var pageEl = $('page-hierarchy');
            if (pageEl) pageEl.classList.toggle('hy-head-view-disabled', !state.headViewEnabled);
            renderGroups();
            renderTable();
            if (state.isHead && state.headViewEnabled) {
                loadStats(false);
            } else {
                hideStats();
            }
        }).catch(function (e) {
            if (body) {
                body.innerHTML = '<tr><td colspan="9" class="hy-td-error">' + esc(e.message || 'Failed to load') + '</td></tr>';
            }
            if (window.EDToast) window.EDToast.error(e.message || 'Failed to load hierarchy data');
            updateShowing();
            renderPager();
        });
    }

    function loadStats(forceRefresh) {
        var cacheKey = 'team_stats:' + state.cycle;
        if (!forceRefresh) {
            var cached = cacheGet(cacheKey);
            if (cached) {
                applyStatsPayload(cached);
                return Promise.resolve(cached);
            }
        }

        showStatsLoading(!!state.stats);
        if (statsInFlight) return statsInFlight;

        var query = { action: 'team_stats', cycle: state.cycle };
        if (forceRefresh) query.refresh = '1';

        statsInFlight = api(query)
            .then(function (data) {
                cacheSet(cacheKey, data);
                applyStatsPayload(data);
                return data;
            })
            .catch(function (e) {
                var el = $('hy-stats');
                if (el) el.classList.remove('is-loading');
                var skel = $('hy-stats-skel');
                if (skel) skel.style.display = 'none';
                var grid = $('hy-kpi-grid');
                if (grid) grid.style.display = '';
                if (!state.stats) {
                    var trend = $('hy-trend-row');
                    if (trend) {
                        trend.style.display = '';
                        trend.innerHTML = '<span class="hy-trend-chip hy-trend-warn">Stats unavailable: ' + esc(e.message || 'error') + '</span>';
                    }
                }
                if (window.EDToast) window.EDToast.error(e.message || 'Failed to load team stats');
            })
            .finally(function () {
                statsInFlight = null;
            });

        return statsInFlight;
    }

    function ensureDetailModal() {
        if (detailModal) return detailModal;
        var el = $('hy-detail-modal');
        if (!el || !window.bootstrap || !window.bootstrap.Modal) return null;
        detailModal = window.bootstrap.Modal.getOrCreateInstance(el, { focus: true });
        return detailModal;
    }

    function showDetailSkeleton() {
        var loading = $('hy-detail-loading');
        var content = $('hy-detail-content');
        if (loading) loading.style.display = '';
        if (content) {
            content.style.display = 'none';
            content.innerHTML = '';
        }
    }

    function openDetail(bioId, cycle) {
        if (!bioId || !state.headViewEnabled) return;
        state.detailBioId = bioId;
        state.detailCycle = cycle || state.cycle || 'current';
        syncDetailCycleButtons();

        var modal = ensureDetailModal();
        var cacheKey = 'detail:' + bioId + ':' + state.detailCycle;
        var cached = cacheGet(cacheKey);
        if (cached) {
            renderDetail(cached);
            if (modal) modal.show();
            return;
        }

        setText('hy-detail-title', 'Loading…');
        setText('hy-detail-meta', 'Fetching attendance & leave');
        var av = $('hy-detail-avatar');
        if (av) av.innerHTML = '<div class="hy-avatar hy-avatar-md hy-avatar-skel"></div>';
        showDetailSkeleton();
        if (modal) modal.show();
        fetchDetail(false);
    }

    function switchDetailCycle(cycle) {
        if (!cycle || (cycle !== 'current' && cycle !== 'last')) return;
        if (cycle === state.detailCycle) return;
        state.detailCycle = cycle;
        syncDetailCycleButtons();
        fetchDetail(false);
    }

    function fetchDetail(forceRefresh) {
        var bioId = state.detailBioId;
        var cycle = state.detailCycle;
        if (!bioId) return Promise.resolve();

        var cacheKey = 'detail:' + bioId + ':' + cycle;
        if (!forceRefresh) {
            var cached = cacheGet(cacheKey);
            if (cached) {
                renderDetail(cached);
                return Promise.resolve(cached);
            }
        }

        showDetailSkeleton();
        var seq = ++detailRequestSeq;
        var query = {
            action: 'employee_detail',
            bio_id: bioId,
            cycle: cycle,
        };
        if (forceRefresh) query.refresh = '1';

        detailInFlight = api(query)
            .then(function (data) {
                if (seq !== detailRequestSeq) return data;
                if (state.detailBioId !== bioId || state.detailCycle !== cycle) return data;
                cacheSet(cacheKey, data);
                renderDetail(data);
                return data;
            })
            .catch(function (e) {
                if (seq !== detailRequestSeq) return;
                if (state.detailBioId !== bioId || state.detailCycle !== cycle) return;
                var loading = $('hy-detail-loading');
                var content = $('hy-detail-content');
                if (loading) loading.style.display = 'none';
                if (content) {
                    content.style.display = '';
                    content.innerHTML = '<div class="hy-detail-error"><i class="fa fa-circle-exclamation"></i> ' + esc(e.message || 'Failed to load details') + '</div>';
                }
                if (window.EDToast) window.EDToast.error(e.message || 'Failed to load employee details');
            })
            .finally(function () {
                if (seq === detailRequestSeq) detailInFlight = null;
            });

        return detailInFlight;
    }

    function renderDetail(data) {
        var profile = data.profile || {};
        var attendance = data.attendance || null;
        var leave = data.leave || {};
        var cycle = data.cycle || {};
        var summary = (attendance && attendance.summary) || {};

        syncDetailCycleButtons();
        setText('hy-detail-title', profile.employee_name || profile.bio_id || 'Employee');
        var metaBits = [
            profile.bio_id ? ('ID ' + profile.bio_id) : '',
            profile.designation || '',
            profile.group_name || '',
        ].filter(Boolean);
        setText('hy-detail-meta', metaBits.join(' · '));

        var av = $('hy-detail-avatar');
        if (av) av.innerHTML = avatarHtml(profile, { size: 'lg' });

        var contact = [];
        if (profile.department) contact.push('<span class="hy-chip hy-chip-dept"><i class="fa fa-building-columns"></i> ' + esc(profile.department) + '</span>');
        if (profile.phone) contact.push('<span class="hy-chip"><i class="fa fa-phone"></i> ' + esc(profile.phone) + '</span>');
        if (profile.email) contact.push('<span class="hy-chip"><i class="fa fa-envelope"></i> ' + esc(profile.email) + '</span>');
        if (profile.campus) contact.push('<span class="hy-chip"><i class="fa fa-location-dot"></i> ' + esc(profile.campus) + '</span>');
        if (profile.status) contact.push('<span class="hy-chip hy-chip-status">' + esc(profile.status) + '</span>');

        var quick = [
            quickStat('In', summary.today_in_time || '—', 'in'),
            quickStat('Out', summary.today_out_time || '—', 'out'),
            quickStat('Present', summary.total_present_days != null ? summary.total_present_days : '—', 'present'),
            quickStat('Absent', summary.total_absent_days != null ? summary.total_absent_days : '—', 'absent'),
            quickStat('LOP', summary.lop_days != null ? summary.lop_days : '—', 'lop'),
            quickStat('Att %', summary.attendance_percent != null ? (summary.attendance_percent + '%') : '—', 'att'),
            quickStat('Buffer', summary.remaining_buffer_minutes != null ? (summary.remaining_buffer_minutes + 'm') : '—', 'buf'),
        ].join('');

        var html = '';
        html += '<div class="hy-detail-contact">' + (contact.join('') || '<span class="hy-muted">No contact details</span>') + '</div>';
        html += '<div class="hy-quick-grid">' + quick + '</div>';

        html += '<div class="hy-detail-split">';
        html += '<div class="hy-detail-section hy-detail-att-sec">';
        html += '<div class="hy-detail-sec-hd">';
        html += '<div><h6>Attendance calendar</h6><p class="hy-detail-cycle-lbl">' + esc(cycle.label || '') + '</p></div>';
        html += '</div>';

        if (data.attendance_error) {
            html += '<div class="hy-detail-error">' + esc(data.attendance_error) + '</div>';
        } else if (!attendance) {
            html += '<div class="hy-muted">Attendance data unavailable.</div>';
        } else {
            html += renderLegendHtml();
            html += '<div class="hy-cal-shell">';
            html += '<div class="hy-cal-dow">' + DOW.map(function (d) { return '<span>' + d + '</span>'; }).join('') + '</div>';
            html += '<div class="hy-cal-grid" id="hy-cal-grid"></div>';
            html += '<div class="hy-cal-tip" id="hy-cal-tip">Tap a day for punch details</div>';
            html += '</div>';
            html += renderAttSummaryStrip(attendance.rows || []);
        }
        html += '</div>';

        html += '<div class="hy-detail-section hy-detail-leave-sec">';
        html += '<div class="hy-detail-sec-hd"><h6>Leave balances</h6></div>';
        if (leave.error) {
            html += '<div class="hy-detail-error">' + esc(leave.error) + '</div>';
        } else {
            html += renderLeaveBalances(leave.balances || []);
            html += renderLeaveHistory((leave.history && leave.history.rows) || [], leave.history || {});
        }
        html += '</div>';
        html += '</div>';

        var loading = $('hy-detail-loading');
        var content = $('hy-detail-content');
        if (loading) loading.style.display = 'none';
        if (content) {
            content.style.display = '';
            content.innerHTML = html;
            if (attendance && attendance.calendar) {
                drawDetailCalendar(attendance.calendar);
            }
        }
    }

    function quickStat(label, value, tone) {
        return '<div class="hy-quick-stat hy-qs-' + escAttr(tone || '') + '">'
            + '<span class="hy-quick-lbl">' + esc(label) + '</span>'
            + '<strong>' + esc(String(value)) + '</strong></div>';
    }

    function renderLegendHtml() {
        var items = LEGEND.map(function (item) {
            var style = 'background:' + item.color;
            if (item.border) style += ';border:' + item.border;
            return '<span class="hy-leg-item"><i class="hy-leg-dot" style="' + escAttr(style) + '"></i>' + esc(item.status) + '</span>';
        }).join('');
        return '<div class="hy-legend">' + items + '</div>';
    }

    function drawDetailCalendar(calendar) {
        var grid = $('hy-cal-grid');
        var tip = $('hy-cal-tip');
        if (!grid || !calendar) return;
        grid.innerHTML = '';

        var offset = parseInt(calendar.offset, 10) || 0;
        var daysMap = calendar.days || {};
        var keys = Object.keys(daysMap).sort();
        var i;
        for (i = 0; i < offset; i += 1) {
            var empty = document.createElement('div');
            empty.className = 'hy-day hy-day-empty';
            grid.appendChild(empty);
        }

        keys.forEach(function (iso) {
            var day = daysMap[iso] || {};
            var el = document.createElement('button');
            el.type = 'button';
            var displayNum = day.display_day != null ? day.display_day : iso.slice(-2);
            var status = day.is_future || !day.status ? 'Future' : String(day.status);
            var slug = status.toLowerCase().replace(/\s+/g, '-');
            el.className = 'hy-day hy-day-' + slug;
            el.innerHTML = '<span class="hy-day-num">' + esc(String(displayNum)) + '</span>';
            var tipText = (day.date || iso) + ' · ' + status
                + (day.in_time ? (' · In ' + day.in_time) : '')
                + (day.out_time ? (' · Out ' + day.out_time) : '');
            el.setAttribute('data-tip', tipText);
            el.title = tipText;
            el.addEventListener('mouseenter', function () {
                if (tip) tip.textContent = el.getAttribute('data-tip') || '';
            });
            el.addEventListener('focus', function () {
                if (tip) tip.textContent = el.getAttribute('data-tip') || '';
            });
            el.addEventListener('click', function () {
                if (tip) tip.textContent = el.getAttribute('data-tip') || '';
