        (function() {
            var DEFAULT_THEME_URL = '/images/themes/dark-forest.webp';
            try {
                var raw = localStorage.getItem('hr_portal_settings');
                var s = raw ? JSON.parse(raw) : null;
                if (!s) {
                    document.documentElement.style.setProperty('--bg-url', "url('" + DEFAULT_THEME_URL + "')");
                    document.documentElement.classList.add('modern-mode');
                    document.documentElement.dataset.edThemeBoot = '1';
                    return;
                }
                if (s.themeMediaType === 'video' && s.customThemeKey) {
                    document.documentElement.classList.add('modern-mode');
                    document.documentElement.dataset.edThemeBoot = '1';
                    document.documentElement.dataset.edThemeVideoPending = s.customThemeKey;
                    return;
                }
                var themeUrl = (s.themeUrl && s.mode !== 'classic') ? s.themeUrl : DEFAULT_THEME_URL;
                if (s.customThemeKey && themeUrl.indexOf('storage/themes/') === 0) {
                    themeUrl = DEFAULT_THEME_URL;
                }
                document.documentElement.style.setProperty('--bg-url', "url('" + themeUrl + "')");
                document.documentElement.classList.add('modern-mode');
                document.documentElement.dataset.edThemeBoot = '1';
            } catch (e) {}
        })();
    </script>
