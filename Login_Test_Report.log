        }

        .pa-detail-footer .btn-sec {
            flex: 1;
        }

        .pa-detail-footer .btn-pri,
        .pa-detail-footer .btn-success {
            flex: 1;
        }

        #pr-request-modal .pa-detail-footer .btn-pri,
        #pr-request-modal .pa-detail-footer .btn-sec,
        #pr-withdraw-modal .pa-detail-footer .btn-pri,
        #pr-withdraw-modal .pa-detail-footer .btn-sec,
        #pr-withdraw-modal .pa-detail-footer .pr-withdraw-btn,
        #cr-request-modal .pa-detail-footer .btn-pri,
        #cr-request-modal .pa-detail-footer .btn-sec,
        #cr-reject-modal .pa-detail-footer .btn-sec,
        #cr-reject-modal .pa-detail-footer .cr-reject-confirm-btn {
