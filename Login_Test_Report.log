/* ── Approval tables — uniform typography (Purchase & Payment) ── */
.att-tbl.pa-tbl {
    --pa-text: #0b1220;
    --pa-text-head: #1e293b;
}

.att-tbl.pa-tbl,
.att-tbl.pa-tbl thead th,
.att-tbl.pa-tbl tbody td,
.att-tbl.pa-tbl .pa-sno,
.att-tbl.pa-tbl .pa-pid,
.att-tbl.pa-tbl .pa-wrap-cell,
.att-tbl.pa-tbl .pa-loc,
.att-tbl.pa-tbl .pa-cell,
.att-tbl.pa-tbl .pa-actions {
    text-shadow: none !important;
}

.att-tbl.pa-tbl thead th {
    color: var(--pa-text-head) !important;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
}

.att-tbl.pa-tbl tbody td {
    color: var(--pa-text) !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    opacity: 1 !important;
}

.att-tbl.pa-tbl .pa-sno,
.att-tbl.pa-tbl .pa-wrap-cell,
.att-tbl.pa-tbl .pa-loc,
.att-tbl.pa-tbl .pa-cell {
    color: var(--pa-text) !important;
    font-weight: 500 !important;
}

.att-tbl.pa-tbl .pa-sno {
    font-variant-numeric: tabular-nums;
}

.att-tbl.pa-tbl .pa-pid {
    color: var(--pa-text) !important;
    font-weight: 800 !important;
    font-size: 13px !important;
    letter-spacing: 0.02em;
}

.att-tbl.pa-tbl .pa-empty-cell {
    text-align: center;
    padding: 32px !important;
    color: #64748b !important;
    font-size: 13px !important;
    font-weight: 500 !important;
}

.att-tbl.pa-tbl tr.pa-split-row td:not(:first-child) {
    color: var(--pa-text) !important;
}

body.modern-mode .att-tbl.pa-tbl,
body.modern-mode .att-tbl.pa-tbl thead th,
body.modern-mode .att-tbl.pa-tbl tbody td,
