        }

        .pa-wf-steps {
            flex: 1;
            overflow-y: auto;
            min-height: 200px;
            max-height: none;
        }

        .pa-section {
            background: #fff;
            border: 1px solid rgba(0, 0, 0, 0.12);
            border-radius: 12px;
            margin-bottom: 14px;
            overflow: hidden;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.9),
                0 2px 8px rgba(0, 0, 0, 0.06);
