                '<div class="ed-bday-modal-footer">' +
                '<button type="button" class="ed-bday-close-btn" id="ed-bday-close">Close</button>' +
                '</div>';
        }

        bindInteractionQuietMode(modal);

        document.getElementById('ed-bday-close').addEventListener('click', closeCelebration);
        var greetAgain = document.getElementById('ed-bday-greet-again');
        if (greetAgain) {
            greetAgain.addEventListener('click', function () {
                state.cardRevealed = false;
                openCelebration('greet_me', status, true);
            });
        }

        if (wishes.length > 0) {
            bindWishInteractions(birthdayBioId, status);
        }

        var sendWish = document.getElementById('ed-bday-send-wish');
        if (sendWish) {
            sendWish.addEventListener('click', function () {
                sendWishMessage(birthdayBioId, status);
            });
        }

        state.activeBirthdayBioId = birthdayBioId;
    }

    function findColleague(status, bioId) {
        var lists = [status.colleague_birthdays || [], status.pending_notifications || []];
        for (var i = 0; i < lists.length; i++) {
            var found = lists[i].find(function (c) { return c.bio_id === bioId; });
            if (found) return found;
        }
        return { bio_id: bioId, employee_name: 'Colleague', first_name: 'Colleague', profile_img_url: '' };
    }

    function bindInteractionQuietMode(root) {
        if (!root || root.__edBdayQuietBound) return;
        root.__edBdayQuietBound = true;
        root.addEventListener('click', function (e) {
            var t = e.target;
            if (!t) return;
            if (t.closest('.ed-bday-reply-btn, .ed-bday-reply-form, .ed-bday-compose, .ed-bday-wish-list, textarea')) {
                hideConfettiCanvas();
            }
        });
        root.addEventListener('focusin', function (e) {
            if (e.target && e.target.tagName === 'TEXTAREA') {
                hideConfettiCanvas();
            }
        });
    }

    function bindWishInteractions(birthdayBioId, status) {
        var list = document.getElementById('ed-bday-wish-list');
        var modal = document.getElementById('ed-bday-modal');
        bindInteractionQuietMode(modal);
        if (!list) return;

        list.querySelectorAll('.ed-bday-reply-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = btn.getAttribute('data-reply-id');
                var form = list.querySelector('[data-reply-form="' + id + '"]');
                if (form) form.classList.add('open');
            });
        });

        list.querySelectorAll('.ed-bday-cancel-reply').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = btn.getAttribute('data-cancel-reply');
                var form = list.querySelector('[data-reply-form="' + id + '"]');
                if (form) {
                    form.classList.remove('open');
                    var ta = form.querySelector('textarea');
                    if (ta) ta.value = '';
                }
            });
        });

        list.querySelectorAll('.ed-bday-send-reply').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                var id = btn.getAttribute('data-send-reply');
                var form = list.querySelector('[data-reply-form="' + id + '"]');
                if (!form) return;
                var ta = form.querySelector('textarea');
                var msg = ta ? ta.value.trim() : '';
                if (!msg) return;
                btn.disabled = true;
                try {
                    await fetchJson(apiUrl('reply'), {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ parent_id: parseInt(id, 10), message: msg }),
                    });
                    await refreshWishList(birthdayBioId, status);
                } catch (e) {
                    if (window.EDToast) window.EDToast.error(e.message);
                    else alert(e.message);
                } finally {
                    btn.disabled = false;
                }
            });
        });
    }

    async function refreshWishList(birthdayBioId, status) {
        var modal = document.getElementById('ed-bday-modal');
        if (!modal) return;
        var viewerIsBirthdayPerson = birthdayBioId === (status.employee && status.employee.bio_id);
        try {
            var wishes = await loadWishes(birthdayBioId);
            var existingSection = modal.querySelector('.ed-bday-wish-section');
            var compose = modal.querySelector('.ed-bday-compose');

            if (!wishes.length) {
                if (existingSection) existingSection.remove();
                return;
            }

            if (compose && !viewerIsBirthdayPerson) {
                compose.remove();
            }

            var listHtml = wishes.map(function (w) { return renderWishItem(w, true, birthdayBioId); }).join('');
            if (existingSection) {
                var title = existingSection.querySelector('.ed-bday-wish-title');
                if (title) {
                    title.innerHTML = '<i class="fa fa-heart"></i> ' + esc(wishSectionTitle(viewerIsBirthdayPerson));
                }
                var list = existingSection.querySelector('.ed-bday-wish-list');
                if (list) list.innerHTML = listHtml;
            } else {
                var footer = modal.querySelector('.ed-bday-modal-footer');
                if (footer) footer.insertAdjacentHTML('beforebegin', buildWishSectionHtml(wishes, viewerIsBirthdayPerson, birthdayBioId));
            }
            bindWishInteractions(birthdayBioId, status);
        } catch (e) {
            console.warn('[EDBirthday] refresh failed', e.message);
        }
    }

    async function sendWishMessage(birthdayBioId, status) {
        var input = document.getElementById('ed-bday-wish-input');
        if (!input) return;
        var msg = input.value.trim();
        if (!msg) return;
        var btn = document.getElementById('ed-bday-send-wish');
        if (btn) btn.disabled = true;
        try {
            await fetchJson(apiUrl('wish'), {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ birthday_bio_id: birthdayBioId, message: msg }),
            });
            input.value = '';
            await refreshWishList(birthdayBioId, status);
            await markWishThreadSeen(birthdayBioId);
            applySeenStateToStatus(birthdayBioId);
            if (window.EDToast) window.EDToast.success('Birthday wish sent!');
        } catch (e) {
            if (window.EDToast) window.EDToast.error(e.message);
            else alert(e.message);
        } finally {
            if (btn) btn.disabled = false;
        }
    }

