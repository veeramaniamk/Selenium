        }

        body.modern-mode .prole,
        body.modern-mode .brand-sub,
        body.modern-mode .hstat-lb {
            color: var(--text-tertiary) !important;
        }

        body.modern-mode .brand {
            border-right-color: rgba(0, 0, 0, 0.12) !important;
            box-shadow: none !important;
        }

        body.modern-mode .hbtn {
            background: var(--aqua-gloss), linear-gradient(180deg, rgba(250, 250, 252, 0.78), rgba(214, 215, 222, 0.65)) !important;
            border-color: rgba(0, 0, 0, 0.22) !important;
            color: var(--text-secondary) !important;
        }

        body.modern-mode .nbadge {
            border-color: rgba(255, 255, 255, 0.9) !important;
        }

        /* ════════════════════════════════════════════════════════════════
           POLISH PASS — refinement layer (keeps Aqua skeuo, elevates finish)
           ════════════════════════════════════════════════════════════════ */
        :root {
            --polish-ring: 0 0 0 3px rgba(30, 144, 255, 0.26);
            --polish-ring-soft: 0 0 0 2px rgba(30, 144, 255, 0.18);
            --polish-ambient: 0 20px 56px rgba(15, 23, 42, 0.065);
            --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
            --ease-smooth: cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        html {
            color-scheme: light;
            scroll-behavior: smooth;
        }

        @media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }

            .buf-fill {
                animation: none !important;
            }

            #fab::after {
                animation: none !important;
            }

            .glow {
                animation: none !important;
            }

            #fab {
                animation: none !important;
            }

            .page.active {
                animation: none !important;
            }

            .tm-tab.active {
                animation: none !important;
            }
        }

        body {
            text-rendering: optimizeLegibility;
            font-feature-settings: "kern" 1, "liga" 1, "tnum" 1, "ss01" 1;
            -webkit-text-size-adjust: 100%;
        }

        ::selection {
            background: rgba(30, 144, 255, 0.22);
            color: inherit;
        }

        .hdr-inner {
            min-height: 60px;
            height: 60px;
            padding-left: 2px;
            padding-right: 0;
            gap: 0.35rem;
            align-items: center;
        }

        #hdr {
            backdrop-filter: saturate(1.12);
            -webkit-backdrop-filter: saturate(1.12);
        }

        #main {
            -webkit-overflow-scrolling: touch;
            min-height: 0;
        }

        .card,
        .scard,
        .cal-wrap,
        .xcard,
        .ex-box,
        .cpanel {
            -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
        }

        .card {
            transition:
                box-shadow 0.42s var(--ease-out-expo),
                transform 0.42s var(--ease-out-expo),
                border-color 0.28s var(--ease-smooth);
        }

        .card:hover {
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 1),
                inset 0 -1px 0 rgba(0, 0, 0, 0.045),
                0 1px 0 rgba(255, 255, 255, 0.65),
                0 2px 6px rgba(0, 0, 0, 0.05),
                0 12px 32px rgba(0, 0, 0, 0.08),
                var(--polish-ambient);
            transform: translateY(-1px);
        }

        .scard {
            transition:
                box-shadow 0.45s var(--ease-out-expo),
                transform 0.45s var(--ease-spring);
        }

        .cal-wrap {
            transition: box-shadow 0.4s var(--ease-out-expo), transform 0.4s var(--ease-out-expo);
        }

        .cal-wrap:hover {
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 1),
                0 1px 0 rgba(255, 255, 255, 0.65),
                0 4px 18px rgba(0, 0, 0, 0.08),
                0 14px 36px rgba(0, 0, 0, 0.08),
                var(--polish-ambient);
        }

        .finp {
            transition:
                border-color 0.22s var(--ease-smooth),
                box-shadow 0.28s var(--ease-out-expo),
                background 0.22s var(--ease-smooth);
            caret-color: var(--aqua-blue-dk);
        }

        .finp:hover:not(:focus) {
            border-color: rgba(0, 0, 0, 0.22);
            box-shadow:
                inset 0 2px 3px rgba(0, 0, 0, 0.08),
                inset 0 -1px 0 rgba(255, 255, 255, 0.55),
                0 0 0 1px rgba(30, 144, 255, 0.08);
        }

        .finp:focus {
            border-color: var(--aqua-blue-dk);
            background: linear-gradient(180deg, #F4F8FF 0%, #FFFFFF 100%);
            box-shadow:
                var(--polish-ring),
                inset 0 2px 3px rgba(0, 0, 0, 0.07),
                inset 0 -1px 0 rgba(255, 255, 255, 0.55);
        }

        textarea.finp {
            line-height: 1.45;
        }

        .btn-pri,
        .btn-sec,
        .hbtn,
        .csend,
        .chain-btn,
        .m-close {
            transition:
                filter 0.2s var(--ease-smooth),
                transform 0.14s var(--ease-smooth),
                box-shadow 0.24s var(--ease-out-expo);
        }

        .btn-pri:focus-visible,
        .btn-sec:focus-visible,
        .hbtn:focus-visible,
        .seg-btn:focus-visible,
        .sitem:focus-visible,
        .sdd:focus-visible,
        .subitem:focus-visible,
        .dt-btn:focus-visible,
        .chip:focus-visible,
        .tab-btn:focus-visible,
        .lv-tab:focus-visible,
        .chain-btn:focus-visible,
        .set-item:focus-visible,
        .cat-tab:focus-visible,
        .csend:focus-visible,
        .m-close:focus-visible {
            outline: none;
            box-shadow:
                var(--polish-ring),
                inset 0 1px 0 rgba(255, 255, 255, 0.55);
        }

        .finp:focus-visible {
            outline: none;
        }

        .seg-pill {
            transition:
                left 0.48s var(--ease-spring),
                width 0.48s var(--ease-spring),
                box-shadow 0.35s var(--ease-out-expo);
        }

        .seg-btn {
            transition: color 0.22s var(--ease-smooth), transform 0.18s var(--ease-spring);
        }

        .seg-btn:active:not(.active) {
            transform: scale(0.98);
        }

        .sitem,
        .sdd,
        .subitem {
            transition:
                background 0.2s var(--ease-smooth),
                color 0.2s var(--ease-smooth),
                box-shadow 0.28s var(--ease-out-expo),
                transform 0.18s var(--ease-spring);
        }

        .sitem:active,
        .sdd:active {
            transform: scale(0.985);
        }

        .cal-cell {
            transition:
                transform 0.22s var(--ease-spring),
                box-shadow 0.28s var(--ease-out-expo),
                outline-color 0.2s var(--ease-smooth);
        }

        .att-tbl tbody td {
            transition: background 0.22s var(--ease-smooth), color 0.18s var(--ease-smooth);
        }

        .sp {
            transition: transform 0.18s var(--ease-spring), box-shadow 0.22s var(--ease-out-expo);
        }

        .sp:hover {
            transform: translateY(-0.5px);
            filter: brightness(1.02);
        }

        .bal-box {
            transition:
                transform 0.32s var(--ease-spring),
                box-shadow 0.35s var(--ease-out-expo);
        }

        .nc {
            transition: transform 0.22s var(--ease-spring), box-shadow 0.3s var(--ease-out-expo);
        }

        .brand-logo,
        .avatar img,
        #fab img {
            image-rendering: auto;
            -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
        }

        .hbtn i,
        .sitem i,
        .sdd i {
            transform: translateZ(0);
        }

        .page.active {
            animation: fadeEnterPolish 0.48s var(--ease-out-expo) forwards;
        }

        @keyframes fadeEnterPolish {
            from {
                opacity: 0;
                transform: translateY(10px) scale(0.992);
                filter: blur(1px);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
                filter: blur(0);
            }
        }

        .tm-tab.active {
            animation: fadeEnterTabPolish 0.48s var(--ease-out-expo) forwards;
        }

        @keyframes fadeEnterTabPolish {
            from {
                opacity: 0;
                transform: translateY(8px);
                filter: blur(0.5px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
                filter: blur(0);
            }
        }

        #soverlay.open {
            animation: overlayFade 0.28s var(--ease-smooth) forwards;
        }

        @keyframes overlayFade {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        .modal-content {
            border-radius: var(--r-xl) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.95),
                0 2px 6px rgba(0, 0, 0, 0.08),
                0 24px 64px rgba(0, 0, 0, 0.22) !important;
        }

        .modal-footer {
            border-top-color: rgba(0, 0, 0, 0.08) !important;
        }

        body.modern-mode .card:hover,
        body.modern-mode .scard:hover {
            transform: translateY(-1px);
        }

        body.modern-mode .finp:focus {
            box-shadow:
                0 0 0 3px rgba(30, 144, 255, 0.22),
                inset 0 2px 3px rgba(0, 0, 0, 0.05),
                inset 0 -1px 0 rgba(255, 255, 255, 0.55) !important;
        }

        /* ════════════════════════════════════════════════════════════════
           NEO SKEUO 2026 — modular refinement layer
           Cleaner depth, calmer highlights, shared component language
           ════════════════════════════════════════════════════════════════ */
        :root {
            --neo-radius-panel: 22px;
            --neo-radius-control: 14px;
            --neo-radius-pill: 999px;
            --neo-elev-1: 0 1px 0 rgba(255, 255, 255, 0.72), 0 10px 28px rgba(15, 23, 42, 0.10);
            --neo-elev-2: 0 1px 0 rgba(255, 255, 255, 0.86), 0 16px 44px rgba(15, 23, 42, 0.14);
            --neo-border-soft: rgba(255, 255, 255, 0.58);
            --neo-border-hard: rgba(84, 96, 124, 0.26);
            --neo-ink-soft: rgba(45, 56, 79, 0.88);
            --neo-ink-muted: rgba(74, 84, 104, 0.74);
            --neo-surface-main:
                linear-gradient(145deg,
                    rgba(255, 255, 255, 0.86) 0%,
                    rgba(250, 252, 255, 0.80) 42%,
                    rgba(236, 242, 255, 0.72) 100%);
            --neo-control-main:
                linear-gradient(175deg,
                    rgba(255, 255, 255, 0.90) 0%,
                    rgba(244, 248, 255, 0.84) 58%,
                    rgba(233, 240, 252, 0.78) 100%);
            --neo-accent-main:
                linear-gradient(165deg,
                    #9ED0FF 0%,
                    #3B90F8 50%,
                    #1B63D0 100%);
            --neo-accent-border: rgba(14, 74, 165, 0.78);
        }

