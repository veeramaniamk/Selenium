        else renderRows();
        refreshBadge();
    }

    // Bootstrap badge on dashboard load
    document.addEventListener('DOMContentLoaded', function () {
        refreshBadge();
    });
    refreshBadge();

    window.EDPendingTickets = {
        onPage: onPage,
        refreshBadge: refreshBadge,
        reload: function () { loaded = false; loadRows(); }
