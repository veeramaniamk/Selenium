        function getApprovalAccess() {
            if (window.__ED_APPROVAL_ACCESS && typeof window.__ED_APPROVAL_ACCESS === 'object') {
                return window.__ED_APPROVAL_ACCESS;
            }
            return (window.ED_CONFIG && window.ED_CONFIG.approvalAccess) || {};
        }

        function getVisibleCats() {
            const acc = getApprovalAccess();
            return CATS_ALL.filter(function(c) {
                if (!c.accessKey) return true;
                return !!acc[c.accessKey];
            });
        }

        /** Pending categories first (higher count first); zero-pending keep original order. */
        function sortCatsByPending(cats) {
            const pending = getApprovalAccess().pendingCounts || {};
            const decorated = (cats || []).map(function(c, i) {
                const n = (c.showPendingBadge === false) ? 0 : apprCategoryCount(c.id, pending);
                return {
                    c: c,
                    i: i,
                    n: n
                };
            });
            decorated.sort(function(a, b) {
                const aHas = a.n > 0 ? 1 : 0;
                const bHas = b.n > 0 ? 1 : 0;
                if (aHas !== bHas) return bHas - aHas;
                if (a.n !== b.n) return b.n - a.n;
                return a.i - b.i;
            });
            return decorated.map(function(x) {
                return x.c;
            });
        }

        let CATS = getVisibleCats();

        // ═══════════════════════════════════════
        // STATE
        // ═══════════════════════════════════════
        const apprFilterState = {};

        function syncApprSearchToState(cat) {
            const input = document.getElementById('pa-search-input');
            if (!cat || !input) return;
            if (!apprFilterState[cat]) apprFilterState[cat] = {
                search: ''
            };
            apprFilterState[cat].search = input.value || '';
        }

        function restoreApprSearchFromState(cat) {
            const input = document.getElementById('pa-search-input');
            if (!input) return;
            const st = apprFilterState[cat] || {
                search: ''
            };
            input.value = st.search || '';
        }

        function restorePaToolbarSearch() {
            const toolbar = document.getElementById('pa-toolbar');
            if (toolbar) toolbar.classList.remove('pa-ev-hide-search');
