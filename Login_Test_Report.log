    function mapScrapeStagesToWf(row) {
        var stages = row.stages || [];
        var foundPending = false;
        var wfSteps = stages.map(function (st, idx) {
            var norm = String(st.status || 'Pending').toLowerCase();
            var stKey = 'up';
            if (norm === 'approved') stKey = 'done';
            else if (norm === 'rejected') stKey = 'rejected';
            else if (!foundPending && (norm === 'pending' || !st.action_date)) {
                stKey = 'pending';
                foundPending = true;
            }
            var remark = '';
            if (norm === 'approved') remark = 'Approved at this stage.';
            else if (norm === 'rejected' && st.reject_reason) remark = st.reject_reason;
            else if (stKey === 'pending') remark = 'Awaiting approval at this stage.';
            return {
                title: 'Stage ' + (st.stage_number || (idx + 1)) + ' Approval',
                approver: st.head_name || 'TBD',
                role: st.head_id ? String(st.head_id) : '',
