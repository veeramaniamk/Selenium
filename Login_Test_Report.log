    background: rgba(255, 255, 255, 0.55);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
}

#page-overtime .clm-sub-tabs {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 8px;
    width: max-content;
    max-width: 100%;
    min-width: min-content;
    padding-bottom: 12px;
}

#page-overtime .clm-sub-tab {
    border: 1px solid rgba(15, 23, 42, 0.1);
    background: rgba(255, 255, 255, 0.92);
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    color: #475569;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    white-space: nowrap;
    line-height: 1.2;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition: transform 0.12s, box-shadow 0.15s, background 0.15s;
    flex: 0 0 auto;
}

#page-overtime .clm-sub-tab i {
    font-size: 11px;
    width: 14px;
    text-align: center;
}

#page-overtime .clm-sub-tab.active {
    border-color: transparent;
    color: #fff;
}

#page-overtime .clm-sub-tab[data-clm-sub="overtime"].active {
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.28);
}

#page-overtime .clm-sub-tab[data-clm-sub="buffer"].active {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    box-shadow: 0 4px 14px rgba(217, 119, 6, 0.28);
}

#page-overtime .clm-sub-tab[data-clm-sub="weekend"].active,
#page-overtime .clm-sub-tab[data-clm-sub="duty"].active {
    background: linear-gradient(135deg, #64748b, #475569);
    box-shadow: 0 4px 14px rgba(71, 85, 105, 0.22);
}

#page-overtime .clm-sub-panel {
    padding: 0;
    min-width: 0;
}

#page-overtime #clm-panel-buffer,
#page-overtime #clm-panel-weekend,
#page-overtime #clm-panel-duty {
    padding: 16px;
}

#page-overtime .clm-sub-panel-ot .cn-table-footer {
    padding: 10px 16px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
}

/* ── Buffer panel ── */
#page-overtime .clm-window-banner {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border-radius: 16px;
    margin-bottom: 16px;
    font-size: 12px;
    line-height: 1.45;
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
    width: 100%;
    box-sizing: border-box;
}

#page-overtime .clm-window-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
    flex-shrink: 0;
}

#page-overtime .clm-window-copy {
    flex: 1;
    min-width: 0;
}

#page-overtime .clm-window-copy strong {
    display: block;
    font-size: 13px;
    margin-bottom: 3px;
}

#page-overtime .clm-window-copy span {
    display: block;
}

#page-overtime .clm-window-copy em {
    display: block;
    margin-top: 4px;
    font-style: normal;
    font-size: 11px;
    opacity: 0.85;
}

#page-overtime .clm-window-open {
    background: linear-gradient(135deg, #ecfdf5, #d1fae5);
    border: 1px solid #86efac;
    color: #065f46;
}

#page-overtime .clm-window-open .clm-window-icon {
    background: rgba(16, 185, 129, 0.16);
    color: #059669;
}

#page-overtime .clm-window-closed {
    background: linear-gradient(135deg, #fff7ed, #ffedd5);
    border: 1px solid #fdba74;
    color: #9a3412;
}

#page-overtime .clm-window-closed .clm-window-icon {
    background: rgba(245, 158, 11, 0.16);
    color: #d97706;
}

#page-overtime .clm-notice {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 16px 18px;
    border-radius: 16px;
    background: linear-gradient(135deg, #eff6ff, #dbeafe);
    border: 1px solid #93c5fd;
    color: #1e40af;
    margin-bottom: 16px;
    font-size: 13px;
    box-shadow: 0 2px 10px rgba(59, 130, 246, 0.08);
    width: 100%;
    box-sizing: border-box;
}

#page-overtime .clm-notice-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: rgba(59, 130, 246, 0.14);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
}

#page-overtime .clm-notice p {
    margin: 4px 0 0;
    font-size: 12px;
    color: #334155;
}

/* ── Cycle cards grid — equal height & alignment ── */
#page-overtime .clm-cycles-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 16px;
    align-items: stretch;
    width: 100%;
}

#page-overtime .clm-cycle-card {
    position: relative;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 18px;
    padding: 18px 18px 16px;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
    display: flex;
    flex-direction: column;
    gap: 12px;
    overflow: hidden;
    height: 100%;
    min-height: 100%;
    box-sizing: border-box;
}

#page-overtime .clm-cycle-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #cbd5e1, #94a3b8);
}

#page-overtime .clm-cycle-last {
    border-color: rgba(245, 158, 11, 0.28);
    box-shadow: 0 10px 28px rgba(245, 158, 11, 0.12);
}

#page-overtime .clm-cycle-last .clm-cycle-accent {
    background: linear-gradient(90deg, #fbbf24, #f59e0b, #d97706);
}

#page-overtime .clm-cycle-current .clm-cycle-accent {
    background: linear-gradient(90deg, #60a5fa, #3b82f6);
}

#page-overtime .clm-cycle-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
}

#page-overtime .clm-cycle-title-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    flex: 1 1 auto;
}

#page-overtime .clm-cycle-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: rgba(15, 23, 42, 0.05);
    color: #475569;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

#page-overtime .clm-cycle-last .clm-cycle-icon {
    background: rgba(245, 158, 11, 0.12);
    color: #d97706;
}

#page-overtime .clm-cycle-current .clm-cycle-icon {
    background: rgba(59, 130, 246, 0.12);
    color: #2563eb;
}

#page-overtime .clm-cycle-tag {
    display: block;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #64748b;
}

#page-overtime .clm-cycle-range {
    font-size: 14px;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.3;
    word-break: break-word;
}

#page-overtime .clm-badge {
    font-size: 10px;
    font-weight: 800;
    padding: 5px 10px;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
    align-self: center;
}

#page-overtime .clm-badge-gold {
    background: linear-gradient(135deg, #fef3c7, #fde68a);
    color: #92400e;
}

#page-overtime .clm-badge-green {
    background: linear-gradient(135deg, #dcfce7, #bbf7d0);
    color: #166534;
}

#page-overtime .clm-badge-muted {
    background: #f1f5f9;
    color: #64748b;
}

#page-overtime .clm-buffer-meter {
    padding: 12px 14px;
    border-radius: 14px;
    background: linear-gradient(180deg, #f8fafc, #f1f5f9);
    border: 1px solid rgba(15, 23, 42, 0.06);
    width: 100%;
    box-sizing: border-box;
}

#page-overtime .clm-meter-head,
#page-overtime .clm-meter-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    color: #64748b;
}

#page-overtime .clm-meter-head strong {
    color: #0f172a;
    font-size: 12px;
    text-align: right;
}

#page-overtime .clm-meter-track {
    height: 10px;
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.08);
    overflow: hidden;
    margin: 8px 0;
}

#page-overtime .clm-meter-fill {
    height: 100%;
    border-radius: inherit;
    transition: width 0.35s ease;
}

#page-overtime .clm-meter-high .clm-meter-fill {
    background: linear-gradient(90deg, #34d399, #10b981);
}

#page-overtime .clm-meter-mid .clm-meter-fill {
    background: linear-gradient(90deg, #fbbf24, #f59e0b);
}

#page-overtime .clm-meter-low .clm-meter-fill {
    background: linear-gradient(90deg, #f87171, #ef4444);
}

#page-overtime .clm-cycle-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    width: 100%;
}

#page-overtime .clm-stat {
    background: rgba(248, 250, 252, 0.95);
    border: 1px solid rgba(15, 23, 42, 0.05);
    border-radius: 12px;
    padding: 10px 11px;
    min-height: 58px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
}

#page-overtime .clm-stat-lbl {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    font-weight: 700;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1.2;
}

#page-overtime .clm-stat-lbl i {
    font-size: 10px;
    width: 12px;
    text-align: center;
    flex-shrink: 0;
}

#page-overtime .clm-stat-val {
    display: block;
    font-size: 15px;
    font-weight: 800;
    color: #1e293b;
    margin-top: 4px;
    line-height: 1.2;
    word-break: break-word;
}

#page-overtime .clm-cycle-reason {
    font-size: 12px;
    color: #64748b;
    margin: 0;
    line-height: 1.55;
    padding: 10px 12px;
    border-radius: 12px;
    background: rgba(248, 250, 252, 0.9);
    border-left: 3px solid #cbd5e1;
    flex: 1 0 auto;
}

#page-overtime .clm-cycle-reason i {
    margin-right: 4px;
    color: #94a3b8;
}

#page-overtime .clm-cycle-last .clm-cycle-reason {
    border-left-color: #f59e0b;
}

#page-overtime .clm-cycle-actions {
    margin-top: auto;
    padding-top: 4px;
    width: 100%;
}

#page-overtime .clm-claim-btn {
    width: 100%;
    justify-content: center;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 800;
    border-radius: 12px !important;
    box-sizing: border-box;
}

#page-overtime .clm-claim-btn--locked {
    opacity: 0.92;
    cursor: pointer;
}

#page-overtime .clm-claim-btn--done {
    background: #ecfdf5 !important;
    border-color: #86efac !important;
    color: #166534 !important;
}

/* ── History ── */
#page-overtime .clm-history-section {
    margin-top: 0;
    padding: 16px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: 0 6px 20px rgba(15, 23, 42, 0.05);
    width: 100%;
    box-sizing: border-box;
}

#page-overtime .clm-history-hdr {
    margin-bottom: 0;
}

#page-overtime .clm-history-title {
    margin: 0;
    font-size: 15px;
    font-weight: 800;
    color: #0f172a;
    display: flex;
    align-items: center;
    gap: 8px;
}

#page-overtime .clm-history-wrap {
    border-radius: 12px;
    border: 1px solid rgba(15, 23, 42, 0.06);
    margin-top: 12px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    width: 100%;
}

#page-overtime .clm-history-tbl {
    width: 100%;
    min-width: 480px;
    border-collapse: collapse;
}

#page-overtime .clm-history-tbl thead th,
#page-overtime .clm-history-tbl tbody td {
    vertical-align: middle;
    text-align: left;
    padding: 10px 12px;
}

#page-overtime .clm-history-tbl thead th:first-child,
#page-overtime .clm-history-tbl tbody td:first-child {
    width: 48px;
    text-align: center;
}

#page-overtime .clm-empty {
    text-align: center;
    color: #94a3b8;
    padding: 28px 12px !important;
    font-size: 13px;
}

#page-overtime .clm-empty i {
    display: block;
    font-size: 22px;
    margin-bottom: 8px;
    opacity: 0.7;
}

#page-overtime .clm-period {
    font-weight: 700;
    color: #1e293b;
}

#page-overtime .clm-credit-pill,
#page-overtime .clm-status-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 11px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
    white-space: nowrap;
}

#page-overtime .clm-credit-pill {
    background: linear-gradient(135deg, #fef3c7, #fde68a);
    color: #92400e;
}

#page-overtime .clm-status-pill {
    gap: 5px;
    background: linear-gradient(135deg, #dcfce7, #bbf7d0);
    color: #166534;
}

#page-overtime .clm-skel-card {
    min-height: 280px;
}

#page-overtime .clm-error {
    grid-column: 1 / -1;
    padding: 22px;
    text-align: center;
    color: #b91c1c;
    font-size: 13px;
    background: #fef2f2;
    border-radius: 14px;
    border: 1px solid #fecaca;
}

#page-overtime .clm-coming-soon {
    text-align: center;
    padding: 56px 24px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.95), rgba(248, 250, 252, 0.95));
    border: 1px dashed rgba(15, 23, 42, 0.12);
    border-radius: 18px;
    width: 100%;
    box-sizing: border-box;
}

#page-overtime .clm-coming-soon h6 {
    margin: 0 0 8px;
    font-size: 16px;
    font-weight: 800;
    color: #0f172a;
}

#page-overtime .clm-coming-soon p {
    margin: 0 auto;
    font-size: 13px;
    color: #64748b;
    max-width: 360px;
    line-height: 1.5;
}

#page-overtime .clm-coming-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 16px;
    border-radius: 18px;
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    box-shadow: 0 8px 20px rgba(217, 119, 6, 0.25);
}

/* ── Success overlay (body level) ── */
.clm-success-overlay {
    position: fixed;
    inset: 0;
    z-index: 11150;
    background: rgba(15, 23, 42, 0.62);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: max(16px, env(safe-area-inset-top, 16px)) max(16px, env(safe-area-inset-right, 16px)) max(16px, env(safe-area-inset-bottom, 16px)) max(16px, env(safe-area-inset-left, 16px));
    box-sizing: border-box;
    isolation: isolate;
    pointer-events: auto;
}

.clm-success-overlay[hidden] {
    display: none !important;
}

.clm-success-card {
    background: linear-gradient(180deg, #fff 0%, #fffbeb 100%);
    border-radius: 22px;
    padding: 32px 28px 28px;
    width: min(100%, 400px);
    max-width: 400px;
    text-align: center;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.24);
    animation: clm-success-in 0.35s ease;
    border: 1px solid rgba(245, 158, 11, 0.18);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    margin: auto;
}

@keyframes clm-success-in {
    from { opacity: 0; transform: scale(0.92) translateY(14px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
}

.clm-success-icon {
    width: 72px;
    height: 72px;
    margin: 0 auto 16px;
    border-radius: 50%;
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
    box-shadow: 0 10px 24px rgba(217, 119, 6, 0.28);
    flex-shrink: 0;
}

.clm-success-card h5 {
    margin: 0 0 8px;
    font-size: clamp(20px, 4vw, 24px);
    font-weight: 900;
    color: #0f172a;
    width: 100%;
}

.clm-success-card p {
    margin: 0 0 8px;
    font-size: 14px;
    color: #475569;
    line-height: 1.55;
    width: 100%;
    max-width: 320px;
}

.clm-success-credit {
    font-size: clamp(16px, 3.5vw, 18px) !important;
    font-weight: 900 !important;
    color: #b45309 !important;
    margin: 4px 0 20px !important;
    width: 100%;
}

.clm-success-close {
    min-width: 160px;
    max-width: 100%;
    width: 100%;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px !important;
    box-sizing: border-box;
}

/* ── Responsive ── */
@media (max-width: 992px) {
    #page-overtime .clm-cycles-grid {
        grid-template-columns: 1fr;
    }

    #page-overtime .clm-cycle-card {
        min-height: 0;
    }
}

@media (max-width: 768px) {
    #page-overtime #clm-panel-buffer,
    #page-overtime #clm-panel-weekend,
    #page-overtime #clm-panel-duty {
        padding: 12px;
    }

    #page-overtime .clm-sub-tabs-wrap {
        padding-left: 12px;
        padding-right: 12px;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    #page-overtime .clm-sub-tabs {
        margin: 0;
        padding-bottom: 10px;
    }

    #page-overtime .clm-cycle-stats {
        grid-template-columns: 1fr 1fr;
    }

    #page-overtime .clm-history-section {
        padding: 12px;
    }

    #page-overtime .clm-sub-panel-ot .ot-filter-bar {
        flex-wrap: wrap;
        gap: 8px;
    }

    #page-overtime .clm-sub-panel-ot .ot-date-inp {
        flex: 1 1 120px;
        min-width: 0;
    }
}

@media (max-width: 540px) {
    #page-overtime .clm-sub-tab {
        font-size: 11px;
        padding: 7px 10px;
    }

    #page-overtime .clm-sub-tab span {
        max-width: none;
    }

    #page-overtime .clm-cycle-stats {
        grid-template-columns: 1fr;
    }

    #page-overtime .clm-cycle-top {
        flex-direction: column;
        align-items: stretch;
    }

    #page-overtime .clm-badge {
        align-self: flex-start;
    }

    #page-overtime .clm-meter-head,
    #page-overtime .clm-meter-foot {
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
    }

    #page-overtime .clm-meter-head strong {
        text-align: left;
    }

    .clm-success-card {
        padding: 28px 20px 22px;
        border-radius: 18px;
    }

    .clm-success-close {
        min-width: 0;
    }
}

@media (max-width: 380px) {
    #page-overtime .clm-sub-tab i + span,
    #page-overtime .clm-sub-tab {
        font-size: 10px;
    }
}

/* ── Weekend / Holiday claims ── */
#page-overtime .clm-pending-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 99px;
    background: #ef4444;
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    margin-left: 6px;
    line-height: 1;
}

#page-overtime .clm-pending-badge--inline {
    margin-left: auto;
}

#page-overtime .clm-weekend-toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    padding: 0 0 14px;
    margin-bottom: 4px;
}

#page-overtime .clm-cycle-btn.active {
    background: linear-gradient(135deg, #64748b, #475569);
    color: #fff;
    border-color: transparent;
}

#page-overtime .clm-weekend-notice {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 14px;
    margin-bottom: 14px;
    border-radius: 14px;
    background: rgba(59, 130, 246, 0.08);
    border: 1px solid rgba(59, 130, 246, 0.15);
    font-size: 12px;
    line-height: 1.45;
