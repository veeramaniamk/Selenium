        /**
 * Employee Dashboard — runtime notices (resignation, community modal).
 * Attendance and reporting authority are loaded via attendance.js.
 */
(function () {
    'use strict';

    function apiUrl(route) {
        if (typeof window.edApiUrl === 'function') {
            return window.edApiUrl(String(route).replace(/^employee\./, ''));
        }
        const base = (window.ED_CONFIG && window.ED_CONFIG.apiBase) || '/api/employee';
        const action = String(route).replace(/^employee\./, '');
        return base.replace(/\/$/, '') + '/' + encodeURIComponent(action) + '.php';
    }

    function esc(text) {
        const el = document.createElement('span');
        el.textContent = text == null ? '' : String(text);
        return el.innerHTML;
    }

    function setText(id, value) {
        const el = document.getElementById(id);
        if (!el) return;
        el.classList.remove('ed-skel-wrap');
        el.textContent = value;
    }

    function sumLeaveAvailability(types) {
        if (!Array.isArray(types) || !types.length) return '—';
        let total = 0;
        let hasNumber = false;
        types.forEach(function (t) {
            const v = parseFloat(t.availability);
            if (!isNaN(v)) {
                total += v;
                hasNumber = true;
            }
        });
        return hasNumber ? String(total) : '—';
    }

    function renderResignationNotice(notices) {
        const host = document.getElementById('ed-resignation-notice');
        if (!host || !notices || !notices.resignation_notice) return;
        host.innerHTML =
            '<div style="background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;padding:10px 16px;text-align:center;font-weight:700;border-radius:8px;margin:8px 16px 0">' +
            esc(notices.resignation_message || 'You are currently under the notice period!') +
            '</div>';
    }

    function showCommunityModal(community, legacyUrls) {
        if (!community || !community.required) return;

        const existing = document.getElementById('ed-community-backdrop');
        if (existing) return;

        const saveUrl = (legacyUrls && legacyUrls.save_community) || '/save_community.php';
        const resolvedSaveUrl = saveUrl.startsWith('/') || saveUrl.startsWith('http')
            ? saveUrl
            : '/save_community.php';
        const backdrop = document.createElement('div');
        backdrop.id = 'ed-community-backdrop';
        backdrop.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;z-index:10000;padding:20px';
        backdrop.innerHTML =
            '<div style="background:#fff;border-radius:10px;max-width:560px;width:100%;padding:20px">' +
            '<h2 style="margin:0 0 12px;font-size:18px">Add Community (required)</h2>' +
            '<form id="ed-community-form">' +
            '<label for="ed-community-category">Social Category</label>' +
            '<select id="ed-community-category" name="category" required style="width:100%;margin:8px 0 12px;padding:8px">' +
            '<option value="">-- select --</option>' +
            '<option value="General">General</option><option value="OBC">OBC</option>' +
            '<option value="SC">SC</option><option value="ST">ST</option></select>' +
            '<label for="ed-community-religious">Religious Community</label>' +
            '<select id="ed-community-religious" name="religious" required style="width:100%;margin:8px 0 12px;padding:8px">' +
            '<option value="">-- select --</option>' +
            '<option value="Hindu">Hindu</option><option value="Muslim">Muslim</option>' +
            '<option value="Christian">Christian</option><option value="Sikh">Sikh</option>' +
            '<option value="Buddhist">Buddhist</option><option value="Other">Other</option></select>' +
            '<button type="submit" style="width:100%;padding:10px;background:#0366d6;color:#fff;border:none;border-radius:8px;font-weight:700">Submit</button>' +
            '<div id="ed-community-error" style="display:none;color:#b91c1c;margin-top:10px"></div>' +
            '</form></div>';
        document.body.appendChild(backdrop);
        document.body.style.overflow = 'hidden';

        backdrop.querySelector('#ed-community-form').addEventListener('submit', async function (e) {
            e.preventDefault();
            const form = e.currentTarget;
            const category = (form.querySelector('[name="category"]') || {}).value || '';
            const religious = (form.querySelector('[name="religious"]') || {}).value || '';
            const bioId = (window.ED_CONFIG && window.ED_CONFIG.bioId) || '';

            if (!category || !religious) {
                const errEl = document.getElementById('ed-community-error');
                if (errEl) {
                    errEl.textContent = 'Please select both Social Category and Religious Community.';
                    errEl.style.display = 'block';
                }
                return;
            }

            const payload = {
                bio_id: bioId,
                category: category,
                religious: religious,
                community: religious,
            };
            try {
                const res = await fetch(resolvedSaveUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify(payload),
                });
                const data = await res.json().catch(function () { return {}; });
                if (res.ok && data.success) {
                    backdrop.remove();
                    document.body.style.overflow = '';
                } else if (data.code === 'already_submitted') {
                    backdrop.remove();
                    document.body.style.overflow = '';
                } else {
                    const err = document.getElementById('ed-community-error');
                    if (err) {
                        err.textContent = data.message || 'Save failed';
                        err.style.display = 'block';
                    }
                }
            } catch (err) {
                const el = document.getElementById('ed-community-error');
                if (el) {
                    el.textContent = 'Network error: ' + err.message;
                    el.style.display = 'block';
                }
            }
        });
    }

    async function loadHome() {
        const res = await fetch(apiUrl('employee.home'), {
            method: 'GET',
            credentials: 'same-origin',
            headers: { Accept: 'application/json' },
        });
        const json = await res.json().catch(function () { return { success: false }; });
        if (!res.ok || !json.success) {
            throw new Error((json && json.error) || 'Failed to load home data');
        }
        return json.data.home;
    }

    window.EDHome = {
        init: function () {
            loadHome()
                .then(function (home) {
                    renderResignationNotice(home.notices);
                    showCommunityModal(home.community, home.legacy_urls);
                    setText('ed-header-leave', sumLeaveAvailability((home.leave || {}).types));
                    if (home.statistics && home.statistics.current_month) {
                        setText('ed-current-month', home.statistics.current_month);
                    }
                })
                .catch(function (err) {
                    console.error('[EDHome]', err.message);
                    setText('ed-header-leave', '—');
                });
        },
    };

    document.addEventListener('DOMContentLoaded', function () {
        if (window.EDHome) window.EDHome.init();
    });
})();


