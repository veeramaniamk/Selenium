        if (code === 'SUBSTITUTE_NOT_FOUND'
            || /no faculty found|no substitute faculty was found|substituteBioId/i.test(raw)) {
            return 'No substitute faculty was found for the selected staff in the schedule system. Please choose a different substitute, or contact the administration for help.';
        }
        if (raw) {
            if (raw.indexOf(' | ') >= 0) {
                raw = raw.split(' | ')[0].trim();
            }
            return raw;
        }
        if (upstream) {
            if (upstream.indexOf(' | ') >= 0) {
                upstream = upstream.split(' | ')[0].trim();
            }
            return upstream;
        }
        return friendlyError(err, 'Unable to update leave status. Please try again.');
    }

    function friendlyError(err, fallback) {
        if (!err) return fallback || 'Something went wrong.';
        var msg = String(err.message || '').trim();
        if (!msg) return fallback || 'Something went wrong.';
        if (err.message === 'Failed to fetch' || /NetworkError/i.test(msg)) {
            return 'Network error. Check your connection and try again.';
        }
        if (/Invalid server response/i.test(msg)
            || /<\/?[a-z][\s\S]*>/i.test(msg)
            || /SQLSTATE|mysqli_|Fatal error|Stack trace|PDOException/i.test(msg)
            || /Failed to prepare|Failed to (lock|fetch|update|insert)/i.test(msg)) {
            return fallback || 'Something went wrong. Please try again.';
        }
        return msg;
    }

    function applyOverviewCounts(data) {
        var block = (data && data.leave_approval) || {};
        var pending = block.pending || {};
        var history = block.history || {};
        if (!window.ED_LEAVE_APPROVAL) window.ED_LEAVE_APPROVAL = defaultState();
        window.ED_LEAVE_APPROVAL.counts = {
            pending: pending.count || 0,
            history: history.count || 0,
        };
        updateLeaveBadge();
    }

    function applyPending(data, silent) {
        var block = (data && data.leave_approval) || {};
        var prev = window.ED_LEAVE_APPROVAL || defaultState();
        var totalCount = block.total_count != null ? block.total_count : (block.count != null ? block.count : (block.rows || []).length);
        window.ED_LEAVE_APPROVAL = {
            pending: block.rows || [],
            history: prev.history || [],
            counts: {
                pending: totalCount,
                history: prev.counts.history || 0,
            },
            pendingTotal: totalCount,
            pendingOffset: block.offset != null ? block.offset : pendingOffset,
            pendingLimit: block.limit || PER_PAGE,
            historyTotal: prev.historyTotal || 0,
            historyOffset: prev.historyOffset || 0,
            historyLimit: prev.historyLimit || PER_PAGE,
            loaded: true,
            historyLoaded: prev.historyLoaded || false,
            error: null,
        };
        loaded = true;
        updateLeaveBadge();
        if (!silent && isLeaveActive()) renderLeaveTable();
    }

    function applyHistory(data) {
        var block = (data && data.leave_approval) || {};
        if (!window.ED_LEAVE_APPROVAL) window.ED_LEAVE_APPROVAL = defaultState();
        var totalCount = block.total_count != null ? block.total_count : (block.count != null ? block.count : (block.rows || []).length);
        window.ED_LEAVE_APPROVAL.history = block.rows || [];
        window.ED_LEAVE_APPROVAL.counts.history = totalCount;
        window.ED_LEAVE_APPROVAL.historyTotal = totalCount;
        window.ED_LEAVE_APPROVAL.historyOffset = block.offset != null ? block.offset : historyOffset;
        window.ED_LEAVE_APPROVAL.historyLimit = block.limit || PER_PAGE;
        window.ED_LEAVE_APPROVAL.historyLoaded = true;
        window.ED_LEAVE_APPROVAL.date_from = block.date_from || '';
        window.ED_LEAVE_APPROVAL.date_to = block.date_to || '';
        window.ED_LEAVE_APPROVAL.cycle = block.cycle || null;
        historyLoaded = true;

        var fromEl = document.getElementById('pa-filter-from-date');
        var toEl = document.getElementById('pa-filter-to-date');
        if (fromEl && !fromEl.value && block.date_from) {
            fromEl.value = block.date_from;
        }
        if (toEl && !toEl.value && block.date_to) {
            toEl.value = block.date_to;
        }
    }

    function loadPending(silent, prefetch) {
        if (loading) return Promise.resolve();
        loading = true;
        readFilters();
        var query = { action: 'pending', limit: PER_PAGE, offset: pendingOffset };
        if (filters.search) query.q = filters.search;
        return fetchJson(apiUrl(query))
            .then(function (data) {
                applyPending(data, silent || prefetch);
            })
            .catch(function (err) {
                if (!prefetch && !(window.edApprovalDenied && window.edApprovalDenied(err))) {
                    showError(err.message);
                }
                if (window.edLogApprovalFailure) {
                    window.edLogApprovalFailure('[EDLeaveApproval] pending', err, !!prefetch);
                }
            })
            .finally(function () {
                loading = false;
            });
    }

    function loadHistory(silent) {
        readFilters();
        var query = { action: 'history', limit: PER_PAGE, offset: historyOffset };
        if (filters.status) query.status = filters.status;
        if (filters.search) query.q = filters.search;
        if (filters.date_from) query.from_date = filters.date_from;
        if (filters.date_to) query.to_date = filters.date_to;

        return fetchJson(apiUrl(query))
            .then(function (data) {
                applyHistory(data);
                if (!silent && isLeaveActive()) renderLeaveTable();
            })
            .catch(function (err) {
                if (window.edLogApprovalFailure) {
                    window.edLogApprovalFailure('[EDLeaveApproval] history', err, !!silent);
                }
            });
    }

    function loadOverviewCounts() {
        return fetchJson(apiUrl({ action: 'overview', slim: '1' }))
            .then(function (data) {
                applyOverviewCounts(data);
            })
            .catch(function (err) {
                if (window.edLogApprovalFailure) {
                    window.edLogApprovalFailure('[EDLeaveApproval] overview', err, true);
                }
            });
    }

    function needsPendingReload() {
        var state = window.ED_LEAVE_APPROVAL || defaultState();
        if (!state.loaded) return true;
        var count = state.counts.pending || 0;
        var rows = (state.pending || []).length;
        return count > 0 && rows === 0;
    }

    function rotateInlineImage(imgEl, step) {
        if (!imgEl) return;
        var current = parseInt(imgEl.getAttribute('data-rot') || '0', 10) || 0;
        var imageRotation = (current + step + 360) % 360;
        imgEl.setAttribute('data-rot', String(imageRotation));
        imgEl.style.transform = 'rotate(' + imageRotation + 'deg)';
    }

    function openImageViewer(url) {
        var modalEl = document.getElementById('leave-image-modal');
        var imgEl = document.getElementById('leave-image-modal-img');
        if (!modalEl || !imgEl || !url) return;
        imageRotation = 0;
        imgEl.style.transform = 'rotate(0deg)';
        imgEl.src = url;
        if ('decode' in imgEl) {
            imgEl.decode().catch(function () { /* ignore decode error */ });
        }
        var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
        modal.show();
    }

    function rotateImage(step) {
        var imgEl = document.getElementById('leave-image-modal-img');
        if (!imgEl) return;
        imageRotation = (imageRotation + step + 360) % 360;
        imgEl.style.transform = 'rotate(' + imageRotation + 'deg)';
    }

    function substituteChipsHtml(row) {
        var subs = row.substitutes || [];
        if (!subs.length) return '';
        return '<div class="lv-sub-chip-row">'
            + subs.map(function (s) {
                var st = String(s.status || 'Pending').toLowerCase();
                var cls = st === 'approved' ? 'is-approved' : (st === 'rejected' ? 'is-rejected' : 'is-pending');
                var label = (s.course_code || ('S' + s.session_number)) + ': ' + (s.substitute_name || s.substitute_bio_id || '—')
                    + ' (' + (s.status || 'Pending') + ')';
                return '<span class="lv-sub-chip ' + cls + '">' + esc(label) + '</span>';
            }).join('')
            + '</div>';
    }

    function subApiUrl(query) {
        if (typeof window.edApiUrl === 'function') {
            return window.edApiUrl('leave-substitutes', query);
        }
        var base = (window.ED_CONFIG && window.ED_CONFIG.apiBase) || '/api/employee';
        var url = base.replace(/\/$/, '') + '/leave-substitutes.php';
        if (query) {
            url += (url.indexOf('?') >= 0 ? '&' : '?') + new URLSearchParams(query).toString();
        }
        return url;
    }

    function loadFacultyForLeave(leaveId) {
        var key = String(leaveId || 0);
        if (facultyOptionsCache && facultyOptionsCache[key]) {
            return Promise.resolve(facultyOptionsCache[key]);
        }
        return fetchJson(subApiUrl({ action: 'faculty-options', leave_id: String(leaveId || '') }))
            .then(function (data) {
                var list = (data && data.faculty) || [];
                facultyOptionsCache = facultyOptionsCache || {};
                facultyOptionsCache[key] = list;
                return list;
            });
    }

    function loadAssignmentsForLeave(leaveId) {
        return fetchJson(subApiUrl({
            action: 'for-leave',
            leave_id: String(leaveId || ''),
        })).then(function (data) {
            return (data && data.substitutes) || [];
        });
    }

    function normalizeBioId(value) {
        return String(value == null ? '' : value).trim();
    }

    function facultyOptionLabel(f) {
        if (!f) return '';
        return f.label || ((f.employee_name || '') + (f.bio_id ? (' (' + f.bio_id + ')') : ''));
    }

    function buildFacultyOptions(faculty, currentBio, currentName) {
        var seen = {};
        var options = [];
        (faculty || []).forEach(function (f) {
            var bio = normalizeBioId(f.bio_id);
            if (!bio || seen[bio]) return;
            seen[bio] = true;
            options.push({ value: bio, label: facultyOptionLabel(f) });
        });
        // Ensure already-assigned faculty is always available for preselect (Approved/Pending).
        currentBio = normalizeBioId(currentBio);
        if (currentBio && !seen[currentBio]) {
            options.unshift({
                value: currentBio,
                label: (currentName ? (currentName + ' (' + currentBio + ')') : currentBio),
            });
        }
        return options;
    }

    function preselectFaculty(ss, nativeSel, options, currentBio, currentName) {
        currentBio = normalizeBioId(currentBio);
        if (!currentBio) return;
        var match = null;
        for (var i = 0; i < options.length; i++) {
            if (normalizeBioId(options[i].value) === currentBio) {
                match = options[i];
                break;
            }
        }
        var label = match
            ? match.label
            : (currentName ? (currentName + ' (' + currentBio + ')') : currentBio);

        if (ss && typeof ss.selectValue === 'function') {
            // Set value without relying on native <option> existence.
            ss.value = currentBio;
            if (ss.hidden) ss.hidden.value = currentBio;
            if (ss.labelEl) {
                ss.labelEl.textContent = label;
                ss.labelEl.classList.remove('is-placeholder');
            }
            if (ss.nativeSelect) {
                // Keep native select in sync for fallbacks.
                var hasOpt = false;
                Array.prototype.forEach.call(ss.nativeSelect.options || [], function (opt) {
                    if (normalizeBioId(opt.value) === currentBio) hasOpt = true;
                });
                if (!hasOpt) {
                    var opt = document.createElement('option');
                    opt.value = currentBio;
                    opt.textContent = label;
                    ss.nativeSelect.appendChild(opt);
                }
                ss.nativeSelect.value = currentBio;
            }
            if (typeof ss.renderList === 'function') ss.renderList();
            return;
        }

        if (nativeSel) {
            var found = false;
            Array.prototype.forEach.call(nativeSel.options || [], function (opt) {
                if (normalizeBioId(opt.value) === currentBio) found = true;
            });
            if (!found) {
                var o = document.createElement('option');
                o.value = currentBio;
                o.textContent = label;
                nativeSel.appendChild(o);
            }
            nativeSel.value = currentBio;
        }
    }

    function openHodReassignModal(leaveId, assignments, rejectedOnly) {
        pendingReassignLeaveId = leaveId;
        reassignSelects = {};
        clearHodReassignAlert();
        var list = document.getElementById('lv-hod-reassign-list');
        var modalEl = document.getElementById('lv-hod-reassign-modal');
        if (!list || !modalEl) {
            showError('Please assign and approve substitutes before approving leave.');
            return;
        }

        var rows = (assignments && assignments.length) ? assignments : (rejectedOnly || []);
        if (!rows.length) {
            list.innerHTML = '<div class="pa-empty-cell" style="padding:20px;text-align:center;color:#64748b">No session substitutes assigned to this leave request. You may proceed with leave approval or rejection below.</div>';
            if (typeof bootstrap !== 'undefined') {
                reassignModal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                reassignModal.show();
            }
            return;
        }

        loadFacultyForLeave(leaveId).then(function (faculty) {
            list.innerHTML = rows.map(function (row, idx) {
                var title = (row.course_code ? row.course_code + ': ' : '') + (row.course_name || 'Session');
                var offeringCode = String(row.offering_code || '').trim();
                var offeringBadge = offeringCode
                    ? ' <span class="badge bg-light text-secondary border ms-2" style="font-size:11px;font-weight:600;vertical-align:middle;padding:3px 6px;">' + esc(offeringCode) + '</span>'
                    : '';
                var time = [row.start_time, row.end_time].filter(Boolean).join(' - ') || '—';
                var status = String(row.status || 'Pending');
                var stLower = status.toLowerCase();
                var isInactive = stLower === 'inactive' || !!row.is_inactive;
                var chipCls = isInactive ? 'is-rejected' : (stLower === 'approved' ? 'is-approved' : (stLower === 'rejected' ? 'is-rejected' : 'is-pending'));
                var hasConflict = !isInactive && !!(row.conflict || row.conflict_hint || row.conflict_applicant_bio_id);
                var required = !isInactive && (stLower === 'rejected' || stLower === 'pending' || hasConflict);
                var selId = 'lv-hod-reassign-sel-' + idx;
                var label = isInactive
                    ? 'Old Entry (Inactive — schedule changed)'
                    : (hasConflict
                        ? 'Replacement Faculty (required — conflict)'
                        : (stLower === 'rejected'
                            ? 'Replacement Faculty (required)'
                            : (stLower === 'pending' ? (row.substitute_bio_id ? 'Confirm Faculty (required)' : 'Select Faculty (required — new session)') : 'Faculty (editable)')));
                var who = isInactive ? '— (Inactive)' : (row.substitute_name || row.substitute_bio_id || 'Not Assigned');
                var blockedBio = normalizeBioId(row.blocked_substitute_bio_id || (hasConflict ? row.substitute_bio_id : ''));
                var conflictName = String(row.conflict_applicant_name || '');
                var conflictBio = normalizeBioId(row.conflict_applicant_bio_id);
                var conflictWho = conflictName
                    ? (conflictName + (conflictBio ? (' (' + conflictBio + ')') : ''))
                    : (conflictBio || 'another applicant');
                var hint = isInactive
                    ? '<div class="lv-prior-card-meta" style="color:#64748b;font-weight:600"><i class="fa fa-ban me-1"></i>Schedule Changed — Old Entry (Inactive)</div>'
                    : (hasConflict
                        ? '<div class="lv-prior-card-meta" style="color:#b91c1c">'
                            + esc(row.conflict_hint || (
                                'Already assigned to ' + conflictWho
                                + ' on this date, session, and course. Choose a different substitute.'
                            ))
                            + '</div>'
                        : (stLower === 'rejected'
                            ? '<div class="lv-prior-card-meta" style="color:#b91c1c">Rejected — choose a replacement to proceed</div>'
                            : (stLower === 'pending'
                                ? (!row.substitute_bio_id
                                    ? '<div class="lv-prior-card-meta" style="color:#b45309">New Session from Schedule — Select substitute to proceed</div>'
                                    : '<div class="lv-prior-card-meta" style="color:#b45309">Pending — confirm or change substitute to proceed</div>')
                                : '<div class="lv-prior-card-meta" style="color:#64748b">Pre-selected — you may keep or change this faculty</div>')));
                var cardStyle = isInactive ? ' style="opacity:0.65;background:#f8fafc;border-color:#cbd5e1;"' : '';
                var selectControl = isInactive
                    ? '<select class="finp" id="' + selId + '" disabled><option value="">Inactive (Disabled)</option></select>'
                    : '<select class="finp" id="' + selId + '"><option value="">Select faculty...</option></select>';

                return '<div class="lv-prior-card' + (isInactive ? ' is-inactive-card' : '') + '"' + cardStyle
                    + ' data-assignment-id="' + esc(String(row.assignment_id || '')) + '"'
                    + ' data-status="' + esc(status) + '"'
                    + ' data-current-bio="' + esc(normalizeBioId(row.substitute_bio_id)) + '"'
                    + ' data-conflict="' + (hasConflict ? '1' : '0') + '"'
                    + ' data-blocked-bio="' + esc(blockedBio) + '">'
                    + '<div class="lv-prior-card-info">'
                    + '<div class="lv-prior-card-title"><i class="fa fa-book"></i> ' + esc(title) + offeringBadge + '</div>'
                    + '<div class="lv-prior-card-meta"><i class="fa fa-clock"></i> ' + esc(time) + '</div>'
                    + '<div class="lv-prior-card-meta">Current: <strong>' + esc(who) + '</strong>'
                    + ' <span class="lv-sub-chip ' + chipCls + '">' + esc(status) + '</span></div>'
                    + hint
                    + '</div>'
                    + '<div class="lv-prior-card-assign">'
                    + '<label class="flbl" for="' + selId + '">' + label + '</label>'
                    + selectControl
                    + '</div></div>';
            }).join('');

            rows.forEach(function (row, idx) {
                var stLower = String(row.status || '').toLowerCase();
                if (stLower === 'inactive' || row.is_inactive) return;
                var sel = document.getElementById('lv-hod-reassign-sel-' + idx);
                if (!sel) return;
                var currentBio = normalizeBioId(row.substitute_bio_id);
                var currentName = String(row.substitute_name || '');
                var isRejected = stLower === 'rejected';
                var hasConflict = !!(row.conflict || row.conflict_hint || row.conflict_applicant_bio_id);
                var needsConfirm = isRejected || stLower === 'pending' || hasConflict;
                var options = buildFacultyOptions(faculty, currentBio, currentName);

                if (window.EDSearchSelect) {
                    reassignSelects[idx] = new EDSearchSelect(sel, {
                        placeholder: (isRejected || hasConflict) ? 'Select replacement...' : 'Select faculty...',
                        triggerClass: 'pr-ss-trigger finp',
                        onSearch: function (q, done) {
                            fetchJson(subApiUrl({ action: 'faculty-options', leave_id: String(leaveId || ''), q: q }))
                                .then(function (data) {
                                    var list = (data && data.faculty) || [];
                                    var formatted = list.map(function (f) {
                                        return { value: String(f.bio_id || ''), label: facultyOptionLabel(f) };
                                    });
                                    done(formatted);
                                }).catch(function () {
                                    done([]);
                                });
                        },
                    });
                    reassignSelects[idx].setOptions(options);
                    reassignSelects[idx]._assignmentId = row.assignment_id;
                    reassignSelects[idx]._required = needsConfirm;
                    if (!isRejected && !hasConflict && currentBio) {
                        preselectFaculty(reassignSelects[idx], sel, options, currentBio, currentName);
                    }
                } else {
                    options.forEach(function (f) {
                        var opt = document.createElement('option');
                        opt.value = f.value;
                        opt.textContent = f.label;
                        if (!isRejected && !hasConflict && normalizeBioId(f.value) === currentBio) opt.selected = true;
                        sel.appendChild(opt);
                    });
                    sel.dataset.assignmentId = String(row.assignment_id || '');
                    sel.dataset.required = needsConfirm ? '1' : '0';
                    if (!isRejected && !hasConflict && currentBio) {
                        preselectFaculty(null, sel, options, currentBio, currentName);
                    }
                }
            });

            if (typeof bootstrap !== 'undefined') {
                reassignModal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                reassignModal.show();
            }
        }).catch(function (err) {
            showHodReassignAlert(friendlyError(err, 'Failed to load faculty for reassignment.'));
        });
    }

    function confirmHodReassign(action) {
        action = action || 'Approved';
        var list = document.getElementById('lv-hod-reassign-list');
        if (!list || !pendingReassignLeaveId) return;
        clearHodReassignAlert();

        if (action === 'Rejected') {
            var rejectBtn = document.getElementById('lv-hod-reassign-reject');
            approveRejectLeave(pendingReassignLeaveId, 'Rejected', rejectBtn);
            return;
        }

        var cards = list.querySelectorAll('.lv-prior-card');
        var reassignments = [];
        for (var i = 0; i < cards.length; i++) {
            var card = cards[i];
            var aid = parseInt(card.getAttribute('data-assignment-id') || '0', 10);
            var status = String(card.getAttribute('data-status') || '');
            var stLower = status.toLowerCase();
            if (stLower === 'inactive') continue;
            var hasConflict = String(card.getAttribute('data-conflict') || '') === '1';
            var needsConfirm = stLower === 'rejected' || stLower === 'pending' || hasConflict;
            var currentBio = normalizeBioId(card.getAttribute('data-current-bio'));
            var blockedBio = normalizeBioId(card.getAttribute('data-blocked-bio'));
            var bio = '';
            if (reassignSelects[i] && typeof reassignSelects[i].getValue === 'function') {
                bio = normalizeBioId(reassignSelects[i].getValue());
            } else {
                var sel = document.getElementById('lv-hod-reassign-sel-' + i);
                bio = normalizeBioId(sel ? sel.value : '');
            }
            if (!bio && !hasConflict && currentBio) {
                bio = currentBio;
            }
            if (!aid) continue;
            if (needsConfirm && !bio) {
                showHodReassignAlert(hasConflict
                    ? 'Please choose a different substitute for every conflicting session.'
                    : (stLower === 'rejected'
                        ? 'Please select a replacement for every rejected session.'
                        : 'Please confirm a substitute for every pending session.'));
                return;
            }
            if (hasConflict && blockedBio && bio === blockedBio) {
                showHodReassignAlert(
                    'This substitute is already covering another approved leave for the same date, session, and course. Please choose a different faculty.'
                );
                return;
            }
            if (bio) {
                reassignments.push({ assignment_id: aid, substitute_bio_id: bio, source: 'web' });
            }
        }
        var missingRequired = Array.prototype.some.call(cards, function (c, idx) {
            var st = String(c.getAttribute('data-status') || '').toLowerCase();
            if (st === 'inactive') return false;
            var conflict = String(c.getAttribute('data-conflict') || '') === '1';
            if (st !== 'rejected' && st !== 'pending' && !conflict) return false;
            var v = '';
            if (reassignSelects[idx] && typeof reassignSelects[idx].getValue === 'function') {
                v = normalizeBioId(reassignSelects[idx].getValue());
            } else {
                var s = document.getElementById('lv-hod-reassign-sel-' + idx);
                v = normalizeBioId(s ? s.value : '');
            }
            if (!v && st !== 'rejected' && !conflict) {
                v = normalizeBioId(c.getAttribute('data-current-bio'));
            }
            return !v;
        });
        if (missingRequired) {
            showHodReassignAlert('Please assign and confirm a substitute for every pending, rejected, or conflicting session.');
            return;
        }
        var confirmBtn = document.getElementById('lv-hod-reassign-confirm');
        approveRejectLeave(pendingReassignLeaveId, 'Approved', confirmBtn, reassignments);
    }

    function approveRejectLeave(leaveId, status, button, reassignments) {
        if (!leaveId || !status) return Promise.resolve();
        if (button) button.disabled = true;
        var payload = { leave_id: leaveId, status: status };
        if (reassignments && reassignments.length) {
            payload.reassignments = reassignments;
        }
        if (isHodReassignModalOpen()) {
            clearHodReassignAlert();
        }
        return fetchJson(apiUrl({ action: 'action' }), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(payload),
        })
            .then(function (data) {
                clearHodReassignAlert();
                clearInlineError();
                if (reassignModal) reassignModal.hide();
                pendingReassignLeaveId = 0;
                return loadPending(true, false).then(function () {
                    if (typeof window.drawAppr === 'function' && isLeaveActive()) {
                        window.drawAppr();
                    }
                });
            })
            .catch(function (err) {
                if (status === 'Approved' && err && err.code === 'SUBSTITUTE_REJECTED') {
                    var responseAssignments = (err.data && err.data.assignments) || [];
                    var responseRejected = (err.data && err.data.rejected_assignments) || [];

                    // Always reload the leave's complete assignment list. Some deployed
                    // API responses omit `data`, and the HOD must see every session when
                    // any Pending/Rejected substitute blocks leave approval.
                    return loadAssignmentsForLeave(leaveId)
                        .then(function (assignments) {
                            openHodReassignModal(
                                leaveId,
                                assignments.length ? assignments : responseAssignments,
                                responseRejected
                            );
                        })
                        .catch(function () {
                            if (responseAssignments.length || responseRejected.length) {
