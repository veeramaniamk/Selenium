            '<div class="pa-wf-summary" style="padding:12px;background:#f8fafc;border-bottom:1px solid #e2e8f0;">' +
            '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px">' +
            '<div style="display:flex;align-items:center;gap:5px;font-size:11px;min-width:0;flex:1">' +
            '<i class="fa fa-user" style="color:#9ca3af;flex-shrink:0"></i>' +
            '<span style="font-weight:600;color:#4a5568;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + esc(req.requested_by_name || 'Initiator') + '</span>' +
            '</div>' +
            '</div>' +
            '<div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">' +
            '<div class="pbar flex-grow-1" style="height:6px;background:#e2e8f0;border-radius:3px;overflow:hidden;">' +
            '<div class="pfill" style="width:' + progress + '%;height:100%;background:#3b82f6;"></div>' +
            '</div>' +
            '<span style="font-size:10px;font-weight:700;color:#64748b;flex-shrink:0">' + done + '/' + stages.length + '</span>' +
            '</div>' +
            '<div style="font-size:10px;color:#64748b"><i class="fa fa-circle-exclamation" style="color:#f59e0b"></i> Pending: <strong style="color:#334155">' + pendingText + '</strong></div>' +
            '</div>' +
            '<div class="pa-wf-steps" style="padding:16px 12px;max-height:400px;overflow-y:auto;">' +
            renderWorkflowTimeline(stages) +
            '</div>' +
            '</div>';
    }

