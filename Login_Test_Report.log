        .pa-wf-card .m-hdr {
            padding: 12px 14px;
            flex-shrink: 0;
        }

        .pa-wf-card .m-hdr .wf-hdr-icon {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .pa-wf-summary {
            padding: 12px 16px;
            background: linear-gradient(180deg, #f8f9fb, #eef2f7);
            border-bottom: 1px solid #e2e8f0;
