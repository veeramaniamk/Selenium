    function wireLeaveCardActions(scope) {
        var root = scope || document;
        root.querySelectorAll('.js-lv-rot-l').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = btn.getAttribute('data-target') || '';
                var img = id ? document.getElementById(id) : null;
                rotateInlineImage(img, -90);
            });
        });
        root.querySelectorAll('.js-lv-rot-r').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = btn.getAttribute('data-target') || '';
                var img = id ? document.getElementById(id) : null;
                rotateInlineImage(img, 90);
            });
        });
        root.querySelectorAll('.js-lv-open-modal').forEach(function (img) {
            img.addEventListener('click', function () {
                openImageViewer(img.getAttribute('data-img-src') || img.getAttribute('src') || '');
            });
        });
        root.querySelectorAll('.js-lv-approve').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var leaveId = parseInt(btn.getAttribute('data-lv-id') || '0', 10);
                if (!leaveId) return;
                loadAssignmentsForLeave(leaveId)
                    .then(function (assignments) {
                        openHodReassignModal(leaveId, assignments);
                    })
                    .catch(function () {
                        openHodReassignModal(leaveId, []);
                    });
            });
        });
        root.querySelectorAll('.js-lv-reject').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var leaveId = parseInt(btn.getAttribute('data-lv-id') || '0', 10);
                if (!leaveId) return;
                loadAssignmentsForLeave(leaveId)
                    .then(function (assignments) {
                        openHodReassignModal(leaveId, assignments);
                    })
                    .catch(function () {
                        openHodReassignModal(leaveId, []);
                    });
            });
        });
    }

    function renderPaginationControls(tab, totalCount, offset, limit, rowsCount) {
        if (totalCount <= 0) return '';
        var start = totalCount > 0 ? (offset + 1) : 0;
        var end = Math.min(offset + rowsCount, totalCount);
        var hasPrev = offset > 0;
        var hasNext = (offset + rowsCount) < totalCount;

        return '<div class="pa-lv-pagination" id="pa-lv-pagination" style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;background:#f8fafc;border-top:1px solid #e2e8f0;border-radius:0 0 8px 8px;margin-top:12px;flex-wrap:wrap;gap:10px">'
            + '<div class="pa-lv-page-info" style="font-size:12px;color:#64748b;font-weight:600">'
            + 'Showing <strong style="color:#1e293b">' + start + '</strong> - <strong style="color:#1e293b">' + end + '</strong> of <strong style="color:#1e293b">' + totalCount + '</strong> entries'
            + '</div>'
            + '<div class="pa-lv-page-btns" style="display:flex;gap:6px">'
            + '<button type="button" class="pa-view-btn js-lv-page-prev" style="padding:6px 12px;font-size:12px;display:flex;align-items:center;gap:4px"' + (hasPrev ? '' : ' disabled') + '><span aria-hidden="true">‹</span> Previous</button>'
            + '<button type="button" class="pa-view-btn js-lv-page-next" style="padding:6px 12px;font-size:12px;display:flex;align-items:center;gap:4px"' + (hasNext ? '' : ' disabled') + '>Next <span aria-hidden="true">›</span></button>'
            + '</div>'
            + '</div>';
    }

    function wirePaginationActions(root) {
        var prevBtn = root.querySelector('.js-lv-page-prev');
        var nextBtn = root.querySelector('.js-lv-page-next');
        var tab = typeof window.apprTabSt !== 'undefined' ? window.apprTabSt : 'pending';

        if (prevBtn) {
            prevBtn.addEventListener('click', function () {
                if (tab === 'history') {
                    if (historyOffset >= PER_PAGE) {
                        historyOffset -= PER_PAGE;
                        showLoadingCards();
                        loadHistory(false);
                    }
                } else {
                    if (pendingOffset >= PER_PAGE) {
                        pendingOffset -= PER_PAGE;
                        showLoadingCards();
                        loadPending(false, false);
                    }
                }
            });
        }
        if (nextBtn) {
            nextBtn.addEventListener('click', function () {
                if (tab === 'history') {
                    historyOffset += PER_PAGE;
                    showLoadingCards();
                    loadHistory(false);
                } else {
                    pendingOffset += PER_PAGE;
                    showLoadingCards();
                    loadPending(false, false);
                }
            });
        }
