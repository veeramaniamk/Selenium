                }, 200);
                return;
            }
            if (t.id === 'sg-inbox-search') {
                clearTimeout(inboxSearchTimer);
                inboxSearchTimer = setTimeout(function () {
                    inboxFilters.search = t.value.trim();
                    loadInboxRows();
                }, 250);
                return;
            }
            if (t.id === 'sg-emp-search') {
                clearTimeout(empSearchTimer);
                empSearchTimer = setTimeout(function () { loadEmployees(t.value.trim()); }, 250);
            }
        });

        document.addEventListener('shown.bs.tab', function (e) {
            if (e.target && e.target.id === 'sg-assigned-tab') {
                if (!inboxLoaded) loadInboxRows();
            }
        });
    }

    function setSubjectMode(isOther) {
        var wrap = $('sg-subject-wrap');
        if (!wrap) return;
        if (isOther) {
            wrap.hidden = false;
            loadEmployees(($('sg-emp-search') || {}).value || '');
        } else {
            wrap.hidden = true;
            clearEmployee();
            var results = $('sg-emp-results');
            if (results) {
                results.innerHTML = '';
                results.hidden = true;
            }
        }
    }

    function clearEmployee() {
        var hid = $('sg-subject-bio');
        if (hid) hid.value = '';
        var chip = $('sg-emp-selected');
        if (chip) {
            chip.hidden = true;
            chip.innerHTML = '';    
        }
        var search = $('sg-emp-search');
        if (search) search.value = '';
    }

    function selectEmployee(bio, name) {
        var hid = $('sg-subject-bio');
        if (hid) hid.value = bio || '';
        var chip = $('sg-emp-selected');
        if (chip) {
            chip.hidden = false;
            chip.innerHTML =
                '<span class="sg-emp-chip"><i class="fa fa-user"></i> ' + esc(name || bio) +
                ' <small>(' + esc(bio) + ')</small>' +
                ' <button type="button" class="sg-emp-chip-x" id="sg-emp-clear" aria-label="Clear">&times;</button></span>';
        }
        var results = $('sg-emp-results');
        if (results) {
            results.innerHTML = '';
            results.hidden = true;
        }
        var search = $('sg-emp-search');
        if (search) search.value = '';
    }

    function openRaiseModal() {
        var el = $('sgRaiseModal');
        if (!el) {
            toast('Raise form not loaded. Refresh the page.', false);
            return;
        }
        if (!window.bootstrap) {
            toast('UI not ready. Please refresh.', false);
            return;
        }
        if (!raiseModal) raiseModal = new bootstrap.Modal(el);
        var form = $('sg-raise-form');
        if (form) form.reset();
        var selfRadio = $('sg-self');
        if (selfRadio) selfRadio.checked = true;
        var otherRadio = $('sg-other');
        if (otherRadio) otherRadio.checked = false;
        setSubjectMode(false);
        clearEmployee();
        var prev = $('sg-image-preview');
        if (prev) prev.innerHTML = '';
        var alertBox = $('sg-form-error');
        if (alertBox) {
            alertBox.style.display = 'none';
            alertBox.textContent = '';
        }
        raiseModal.show();
    }

    function loadEmployees(q) {
        var results = $('sg-emp-results');
        if (!results) return;
        results.hidden = false;
        results.innerHTML = '<li class="sg-emp-empty">Searching…</li>';
        fetch(raiseUrl('employees', '&q=' + encodeURIComponent(q || '')), {
            credentials: 'same-origin',
            headers: { Accept: 'application/json' }
        }).then(readJsonResponse).then(function (json) {
            var data = (json && json.data) || [];
            if (!data.length) {
                results.innerHTML = '<li class="sg-emp-empty">No employees found</li>';
                return;
            }
            results.innerHTML = data.map(function (e) {
                return '<li><button type="button" class="sg-emp-item" data-sg-emp="' + esc(e.bio_id) +
                    '" data-sg-name="' + esc(e.employee_name) + '">' +
                    '<strong>' + esc(e.employee_name) + '</strong>' +
                    '<span>' + esc(e.bio_id) + '</span></button></li>';
            }).join('');
        }).catch(function () {
            results.innerHTML = '<li class="sg-emp-empty">Failed to load employees</li>';
        });
    }

    function submitTicket(e) {
        e.preventDefault();
        var subjectType = (document.querySelector('input[name="sg_subject_type"]:checked') || {}).value || 'self';
        var subjectBio = ($('sg-subject-bio') || {}).value || '';
        var errorMessage = (($('sg-error-message') || {}).value || '').trim();
        var remarks = (($('sg-remarks') || {}).value || '').trim();
        var files = ($('sg-images') || {}).files;
        var alertBox = $('sg-form-error');

        function showErr(msg) {
            if (!alertBox) { toast(msg, false); return; }
            alertBox.style.display = '';
            alertBox.textContent = msg;
        }

        if (subjectType === 'other' && !subjectBio) return showErr('Please select an employee');
        if (!errorMessage || !remarks) return showErr('Error message and detailed remarks are required');
        if (!files || files.length < 1) return showErr('At least one image is required');

        var fd = new FormData();
        fd.append('action', 'create');
        fd.append('subject_type', subjectType);
        if (subjectType === 'other') fd.append('subject_bio_id', subjectBio);
        fd.append('error_message', errorMessage);
        fd.append('detailed_remarks', remarks);
        var campus = window.ED_CONFIG && window.ED_CONFIG.softwareGrievanceCampusBioId;
        if (campus) fd.append('campus_bio_id', campus);
        Array.from(files).forEach(function (f) { fd.append('images[]', f); });

        var btn = $('sg-submit-btn');
        if (btn) { btn.disabled = true; btn.textContent = 'Submitting…'; }

        fetch(raiseUrl('create'), {
            method: 'POST',
            credentials: 'same-origin',
            body: fd,
            headers: csrfHeaders(false)
        }).then(readJsonResponse).then(function (json) {
            if (!json || !json.success) throw new Error((json && (json.message || json.error)) || 'Failed');
            toast(json.message || 'Ticket raised', true);
            if (raiseModal) raiseModal.hide();
            mineLoaded = false;
            loadMineRows();
            // Switch to My Tickets tab
            var mineTab = $('sg-mine-tab');
            if (mineTab && window.bootstrap && bootstrap.Tab) {
                bootstrap.Tab.getOrCreateInstance(mineTab).show();
            }
            refreshHandlerMeta();
            if (window.EDPendingTickets && window.EDPendingTickets.refreshBadge) {
                window.EDPendingTickets.refreshBadge();
            }
        }).catch(function (err) {
            showErr(err.message || 'Failed to raise ticket');
        }).finally(function () {
            if (btn) { btn.disabled = false; btn.textContent = 'Submit ticket'; }
        });
    }

    function loadMineRows() {
        var body = $('sg-body');
        if (!body) return;
        body.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">Loading…</td></tr>';
        fetch(raiseUrl('my_list', '&per_page=100'), {
            credentials: 'same-origin',
            headers: { Accept: 'application/json' }
        }).then(readJsonResponse).then(function (json) {
            if (!json || !json.success) throw new Error((json && (json.message || json.error)) || 'Failed');
            mineRows = json.data || [];
            mineLoaded = true;
            setTabCount('sg-mine-tab-count', mineRows.length);
            renderMineRows();
        }).catch(function (err) {
            body.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-danger">' + esc(err.message || 'Failed to load') + '</td></tr>';
        });
    }

    function renderMineRows() {
        var body = $('sg-body');
        if (!body) return;
        var filtered = mineRows.filter(function (r) {
            if (mineFilters.status && String(r.status) !== mineFilters.status) return false;
            if (!mineFilters.search) return true;
            var blob = [r.ticket_no, r.subject_name, r.subject_bio_id, r.error_message, r.status].join(' ').toLowerCase();
            return blob.indexOf(mineFilters.search) !== -1;
        });
        if (!filtered.length) {
            body.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">No tickets yet. Click <strong>Raise Ticket</strong> to submit one.</td></tr>';
            return;
        }
        body.innerHTML = filtered.map(function (r, i) {
            return '<tr>' +
                '<td>' + (i + 1) + '</td>' +
                '<td><strong>' + esc(r.ticket_no) + '</strong></td>' +
                '<td>' + esc(r.subject_name || r.subject_bio_id) + ' <small class="text-muted">(' + esc(r.subject_type) + ')</small></td>' +
                '<td>' + esc(String(r.error_message || '').slice(0, 80)) + '</td>' +
                '<td>' + statusBadge(r.status) + '</td>' +
                '<td>' + esc(r.created_at || '') + '</td>' +
                '<td><button type="button" class="btn btn-sm btn-outline-primary" data-sg-view="' + esc(r.id) + '">View</button></td>' +
                '</tr>';
        }).join('');
    }

    function refreshHandlerMeta() {
        return fetch(TICKET_API + '?action=pending_count', {
            credentials: 'same-origin',
            headers: { Accept: 'application/json' }
        }).then(readJsonResponse).then(function (json) {
            if (!json || !json.success || !json.data) return;
            isHandler = !!json.data.is_handler;
            var count = Number(json.data.count) || 0;
            updateGlobalBadge(count);
            var tabItem = $('sg-assigned-tab-item');
            if (tabItem) tabItem.style.display = isHandler ? '' : 'none';
        }).catch(function () { /* ignore */ });
    }

    function loadInboxRows() {
        var body = $('sg-inbox-body');
        if (!body) return;
        body.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-muted">Loading…</td></tr>';
        var qs = '?action=inbox_list&per_page=100';
        if (inboxFilters.status) qs += '&status=' + encodeURIComponent(inboxFilters.status);
        if (inboxFilters.search) qs += '&search=' + encodeURIComponent(inboxFilters.search);
        fetch(TICKET_API + qs, {
            credentials: 'same-origin',
            headers: { Accept: 'application/json' }
        }).then(readJsonResponse).then(function (json) {
            if (!json || !json.success) throw new Error((json && json.message) || 'Failed');
            inboxRows = (json.data && json.data.rows) || [];
