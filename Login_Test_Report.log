                opacity: 1;
            }
        }

        /* ── page layout ── */
        .scene {
            position: relative;
            z-index: 10;
            width: 100%;
            padding: 1.5rem 1.25rem;
            display: grid;
            place-items: center;
        }

        /* ── column: card + powered-by + footer ── */
        .column {
            width: 100%;
            max-width: 460px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* ── card animation wrapper ── */
        .card-wrapper {
            width: 100%;
            opacity: 0;
            transform: translateY(30px) scale(0.98);
            animation: cardEntrance 0.9s var(--transition-smooth) forwards;
        }

        @keyframes cardEntrance {
            0% {
                opacity: 0;
                transform: translateY(30px) scale(0.98);
            }

            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* ── card ── */
        .card {
            width: 100%;
            background: rgba(255, 255, 255, 0.93);
            backdrop-filter: blur(28px);
            -webkit-backdrop-filter: blur(28px);
            border-radius: var(--r-card);
            border: 1px solid rgba(221, 227, 238, 0.9);
            box-shadow:
                0 2px 4px rgba(11, 24, 41, 0.04),
                0 8px 24px rgba(11, 24, 41, 0.07),
                0 32px 64px rgba(11, 24, 41, 0.08);
            overflow: hidden;
        }

        .card-stripe {
            height: 4px;
            background: linear-gradient(90deg, var(--blue) 0%, var(--orange) 100%);
            transform: scaleX(0);
            transform-origin: left;
            animation: stripeExpand 1.2s var(--transition-smooth) 0.3s forwards;
        }

        @keyframes stripeExpand {
            0% {
                transform: scaleX(0);
            }

            100% {
                transform: scaleX(1);
            }
        }

        .card-body {
            padding: 2.5rem 2.75rem 2.25rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        /* ── logo animation ── */
        .logo-icon {
            width: 82px;
