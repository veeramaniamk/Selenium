}

.claim-audit-callout.clean>i {
    color: #16a34a;
}

.claim-audit-callout-label {
    font-size: var(--fs-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #9a3412;
    margin: 0 0 4px;
}

.claim-audit-callout.clean .claim-audit-callout-label {
    color: #166534;
}

.claim-audit-callout-text {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: #1e293b;
    margin: 0;
    line-height: 1.45;
}

.claim-audit-callout-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
}

.claim-meta-pill {
    font-size: var(--fs-xs);
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 9999px;
    background: #fff;
    border: 1px solid #e2e8f0;
    color: #475569;
    display: inline-flex;
    align-items: center;
    gap: 4px;
}

.claim-meta-pill.danger {
    background: #fee2e2;
    color: #991b1b;
    border-color: #fca5a5;
}

.claim-meta-pill.success {
    background: #dcfce7;
    color: #15803d;
    border-color: #86efac;
}

/* Comparison Cards */
.claim-compare-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.claim-summary-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
}

.claim-summary-card.is-primary {
    border-top: 3px solid #2563eb;
}

.claim-summary-card.is-matched {
    border-top: 3px solid #7c3aed;
}

.claim-summary-card.is-verified {
    border-top: 3px solid #16a34a;
}

.claim-summary-card-head {
    padding: 12px 16px;
    background: #f8fafc;
    border-bottom: 1px solid #eef2f7;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
}

.claim-summary-card-head h4 {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: 800;
    color: #0f172a;
}

.claim-summary-card-head span {
    font-size: var(--fs-xs);
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.06em;
}

.claim-summary-card-body {
    padding: 14px 16px;
}

.claim-kv-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 14px;
}

.claim-kv-item label {
    display: block;
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #94a3b8;
    margin-bottom: 3px;
}

.claim-kv-item span {
    display: block;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: #1e293b;
    line-height: 1.35;
    word-break: break-word;
}

.claim-kv-item.full {
    grid-column: 1 / -1;
}

.claim-status-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
}

.claim-wf-pill {
    font-size: var(--fs-xs);
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 9999px;
    border: 1px solid transparent;
}

.claim-wf-pill.approved {
    background: #dcfce7;
    color: #15803d;
    border-color: #86efac;
}

.claim-wf-pill.pending {
    background: #fef9c3;
    color: #854d0e;
    border-color: #fde047;
}

.claim-wf-pill.rejected {
    background: #fee2e2;
    color: #991b1b;
    border-color: #fca5a5;
}

/*Evidence Card */
.duplicate-evidence-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
}

.duplicate-evidence-head {
    padding: 14px 18px;
    background: linear-gradient(180deg, #f8fafc 0%, #fff 100%);
    border-bottom: 1px solid #eef2f7;
}

.duplicate-evidence-head h4 {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.35;
}

.duplicate-evidence-grid {
    padding: 4px 18px 14px;
}

.duplicate-evidence-row {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 12px;
    align-items: start;
    font-size: var(--fs-xs);
    padding: 10px 0;
    border-bottom: 1px solid #f1f5f9;
}

.duplicate-evidence-row:last-child {
    border-bottom: none;
}

.duplicate-evidence-row>span:first-child {
    color: #64748b;
    font-weight: 600;
}

.duplicate-evidence-row>span:last-child,
.duplicate-evidence-row>strong {
    color: #0f172a;
    font-weight: 700;
    text-align: right;
    word-break: break-word;
}

.duplicate-evidence-row code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: var(--fs-xs);
    color: #334155;
    background: #f1f5f9;
    padding: 3px 6px;
    border-radius: 6px;
}

/* Document Comparison */
.claim-doc-compare {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0;
    min-height: 520px;
    align-items: stretch;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
}

.claim-doc-vs {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    background: #f1f5f9;
    border-left: 1px solid #e2e8f0;
    border-right: 1px solid #e2e8f0;
    color: #64748b;
    font-size: var(--fs-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
}

.claim-doc-pane {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: #fafbfc;
}

.claim-doc-pane-head {
    padding: 12px 16px;
    background: #fff;
    border-bottom: 1px solid #eef2f7;
}

.claim-doc-pane-title {
    font-size: var(--fs-sm);
    font-weight: 800;
    color: #0f172a;
    margin: 0;
}

.claim-doc-pane-sub {
    display: block;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: #64748b;
    margin-top: 3px;
}

.claim-doc-iframe {
    flex: 1;
    width: 100%;
    min-height: 460px;
    border: none;
    background: #fff;
}

.claim-doc-empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 36px 20px;
    text-align: center;
    color: #64748b;
}

.claim-doc-empty i {
    font-size: 32px;
    color: #cbd5e1;
}

.claim-doc-empty p {
    margin: 0;
    font-size: var(--fs-xs);
    font-weight: 600;
    line-height: 1.45;
}

.claim-files-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.claim-file-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: 10px;
    background: #fff;
    border: 1px solid #e2e8f0;
    color: #1e40af;
    font-size: var(--fs-xs);
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
}

.claim-file-chip:hover {
    background: #eff6ff;
    border-color: #bfdbfe;
    color: #1d4ed8;
}

/* Timeline / Workflow */
.amodal-timeline {
    position: relative;
    padding-left: 28px;
}

.amodal-timeline::before {
    content: '';
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 11px;
    width: 2px;
    background: #e2e8f0;
}

.amodal-tl-step {
    position: relative;
    padding-bottom: 20px;
}

.amodal-tl-step:last-child {
    padding-bottom: 0;
}

.amodal-tl-dot {
    position: absolute;
    left: -28px;
    top: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid #3b82f6;
    color: #3b82f6;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--fs-xs);
    font-weight: 700;
    box-shadow: 0 0 0 3px #eff6ff;
}

.amodal-tl-step.completed .amodal-tl-dot {
    background: #22c55e;
    border-color: #22c55e;
    color: #fff;
    box-shadow: 0 0 0 3px #dcfce7;
}

.amodal-tl-step.flagged .amodal-tl-dot {
    background: #ef4444;
    border-color: #ef4444;
    color: #fff;
    box-shadow: 0 0 0 3px #fee2e2;
}

.amodal-tl-content {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 12px 16px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
}

.amodal-tl-title {
    font-size: var(--fs-sm);
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 4px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.amodal-tl-detail {
    font-size: var(--fs-xs);
    color: #64748b;
    margin: 0;
    line-height: 1.4;
}

/* Risk Badges */
.claim-risk-critical {
    font-size: var(--fs-xs);
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 9999px;
    background: #fee2e2;
    color: #991b1b;
    border: 1px solid #fca5a5;
}

.claim-risk-high {
    font-size: var(--fs-xs);
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 9999px;
    background: #ffedd5;
    color: #c2410c;
    border: 1px solid #fdba74;
}

.claim-risk-medium {
    font-size: var(--fs-xs);
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 9999px;
    background: #fef9c3;
    color: #854d0e;
    border: 1px solid #fde047;
}

.claim-risk-low,
.claim-risk-none {
    font-size: var(--fs-xs);
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 9999px;
    background: #dcfce7;
    color: #166534;
    border: 1px solid #86efac;
}

/* Snippet box */
.cr-text-snippet-box {
    background: #0f172a;
    color: #e2e8f0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: var(--fs-sm);
    line-height: 1.5;
    padding: 12px 14px;
    border-radius: 8px;
    max-height: 140px;
    overflow-y: auto;
    white-space: pre-wrap;
    word-break: break-word;
}

@media (max-width: 991px) {
    .claim-doc-compare {
        grid-template-columns: 1fr;
    }

    .claim-doc-vs {
        width: 100%;
        height: 34px;
        writing-mode: horizontal-tb;
        transform: none;
        border-top: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
        border-left: none;
        border-right: none;
    }
}

/* Pending / attachment duplicate badges (shared with claim bill report UI) */
.pending-dup-badge {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    letter-spacing: 0.2px;
    white-space: nowrap;
    transition: all 0.15s ease;
}

.pending-dup-badge.flagged {
    background: #fee2e2;
    color: #b91c1c;
    border: 1px solid #fca5a5;
}

.pending-dup-badge.flagged:hover {
    background: #fecaca;
    color: #991b1b;
    border-color: #f87171;
    box-shadow: 0 2px 5px rgba(185, 28, 28, 0.15);
}

.pending-dup-badge.clean {
    background: #dcfce7;
    color: #15803d;
    border: 1px solid #86efac;
}

.pending-dup-badge.clean:hover {
    background: #bbf7d0;
    color: #166534;
    border-color: #4ade80;
    box-shadow: 0 2px 5px rgba(21, 128, 61, 0.15);
}

.pending-dup-badge.cleared {
    background: #e0f2fe;
    color: #0369a1;
    border: 1px solid #7dd3fc;
}

.pending-dup-badge.under-audit {
    background: #fef3c7;
    color: #b45309;
    border: 1px solid #fcd34d;
}

.pending-dup-badge.unscanned {
    background: #f1f5f9;
    color: #64748b;
    border: 1px solid #cbd5e1;
}

.pending-list-spacer {
    padding: 0 !important;
    margin: 0 !important;
    border: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    pointer-events: none;
    list-style: none;
}

/* Claim / event approval pending list: match DOA compact badges */
.cr-pending-item .pending-dup-badge,
.cr-pi-id .pending-dup-badge {
    font-size: 10px;
    padding: 2px 7px;
    vertical-align: middle;
}

.cr-pending-item.is-flagged {
    border-color: #fca5a5 !important;
    background: linear-gradient(180deg, #fff 0%, #fef2f2 100%);
}

.cr-dup-banner-slot {
    margin: 0 0 10px;
}

@media (max-width: 767px) {
    .pending-dup-badge {
        font-size: 10px;
        padding: 2px 6px;
    }

    .cr-pending-item .pending-dup-badge {
        margin-left: 4px !important;
    }
}

@media (max-width: 767px) {
    .claim-compare-cards {
        grid-template-columns: 1fr;
    }

    .duplicate-evidence-row {
        grid-template-columns: 1fr;
        gap: 4px;
    }

    .duplicate-evidence-row>span:last-child,
    .duplicate-evidence-row>strong {
        text-align: left;
    }

    .claims-mode .amodal-head {
        padding: 14px 16px;
    }

    .claims-mode .amodal-tab-pane {
        padding: 14px 16px;
    }
}

/* ===== Professional audit progress loader ===== */
.amodal-progress {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 420px;
    padding: 48px 28px;
    text-align: center;
    background:
        radial-gradient(ellipse 80% 50% at 50% 0%, rgba(30, 64, 175, 0.06), transparent 70%),
        #f8fafc;
}

.amodal-progress-ring {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0f2747 0%, #1e4976 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 22px;
    margin-bottom: 20px;
    box-shadow: 0 12px 28px -8px rgba(15, 39, 71, 0.45);
    animation: amodalPulse 1.6s ease-in-out infinite;
}

.amodal-progress-ring i {
    animation: amodalSpin 1.1s linear infinite;
}

@keyframes amodalSpin {
    to { transform: rotate(360deg); }
}

@keyframes amodalPulse {
    0%, 100% { transform: scale(1); box-shadow: 0 12px 28px -8px rgba(15, 39, 71, 0.45); }
    50% { transform: scale(1.04); box-shadow: 0 16px 32px -6px rgba(15, 39, 71, 0.55); }
}

.amodal-progress-title {
    font-size: 17px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
    margin: 0 0 6px;
}

.amodal-progress-sub {
    font-size: 13px;
    font-weight: 500;
    color: #64748b;
    margin: 0 0 28px;
    max-width: 360px;
    line-height: 1.45;
}

.amodal-progress-bar-wrap {
    width: min(420px, 88%);
    margin: 0 auto;
}

.amodal-progress-track {
    height: 10px;
    border-radius: 9999px;
    background: #e2e8f0;
    overflow: hidden;
    position: relative;
    box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.08);
}

.amodal-progress-fill {
    height: 100%;
    width: 0%;
    border-radius: 9999px;
    background: linear-gradient(90deg, #1e40af 0%, #3b82f6 45%, #60a5fa 100%);
    background-size: 200% 100%;
    box-shadow: 0 0 12px rgba(59, 130, 246, 0.45);
    transition: width 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    animation: amodalShimmer 1.4s linear infinite;
    position: relative;
}

.amodal-progress-fill::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.35), transparent);
    animation: amodalGlide 1.8s ease-in-out infinite;
}

@keyframes amodalShimmer {
    0% { background-position: 100% 0; }
    100% { background-position: -100% 0; }
}

@keyframes amodalGlide {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
}

.amodal-progress-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 10px;
    font-size: 12px;
    font-weight: 700;
    color: #475569;
}

.amodal-progress-pct {
    font-variant-numeric: tabular-nums;
    color: #1e40af;
    font-size: 13px;
}

.amodal-progress-steps {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 28px;
    max-width: 480px;
}

.amodal-progress-step {
    font-size: 11px;
    font-weight: 700;
    padding: 5px 11px;
    border-radius: 9999px;
    background: #fff;
    border: 1px solid #e2e8f0;
    color: #94a3b8;
    transition: all 0.25s ease;
}

.amodal-progress-step.is-active {
    background: #eff6ff;
    border-color: #93c5fd;
    color: #1d4ed8;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
}

.amodal-progress-step.is-done {
    background: #f0fdf4;
    border-color: #86efac;
    color: #15803d;
}

/* Event audit metric cards */
.era-metric-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
}

.era-metric-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 16px 18px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
}

.era-metric-card.is-match {
    border-color: #86efac;
    background: linear-gradient(180deg, #f0fdf4 0%, #fff 70%);
}

.era-metric-card.is-mismatch {
    border-color: #fecaca;
    background: linear-gradient(180deg, #fef2f2 0%, #fff 70%);
}

.era-metric-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #64748b;
    margin: 0 0 6px;
}

.era-metric-value {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #0f172a;
    margin: 0;
    line-height: 1.2;
}

.era-metric-card.is-match .era-metric-value { color: #166534; }
.era-metric-card.is-mismatch .era-metric-value { color: #b91c1c; }

.era-metric-hint {
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
    margin-top: 6px;
}

@media (max-width: 767px) {
    .era-metric-grid {
        grid-template-columns: 1fr;
    }
}

/* =========================================================
   Event Request Audit — macOS skeuomorphic / glass theme
   Scoped to #conferenceDuplicateAuditModal .era-macos
   ========================================================= */
#conferenceDuplicateAuditModal .era-dialog,
#conferenceDuplicateAuditModal .modal-dialog.era-dialog {
    max-width: 1120px !important;
    width: 96vw !important;
    margin-left: auto;
    margin-right: auto;
}

#conferenceDuplicateAuditModal .modal-dialog.modal-xl {
    max-width: 1120px !important;
}

#conferenceDuplicateAuditModal .era-macos {
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 18px;
    overflow: hidden;
    background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.92) 0%, rgba(248, 250, 252, 0.96) 100%);
    box-shadow:
        0 30px 80px -20px rgba(15, 23, 42, 0.45),
        0 0 0 1px rgba(15, 23, 42, 0.06),
        inset 0 1px 0 rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(24px) saturate(1.35);
    -webkit-backdrop-filter: blur(24px) saturate(1.35);
}

#conferenceDuplicateAuditModal .era-head {
    background:
        linear-gradient(180deg, #2a3f5f 0%, #1a2d4a 48%, #152438 100%);
    border-bottom: 1px solid rgba(0, 0, 0, 0.25);
    padding: 14px 16px 14px 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
}

#conferenceDuplicateAuditModal .era-traffic {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 4px;
    flex-shrink: 0;
}

#conferenceDuplicateAuditModal .era-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    box-shadow:
        inset 0 1px 1px rgba(255, 255, 255, 0.45),
        0 1px 1px rgba(0, 0, 0, 0.25);
    cursor: default;
}

#conferenceDuplicateAuditModal .era-dot-close {
    background: linear-gradient(180deg, #ff6b6b, #e5484d);
    cursor: pointer;
}
#conferenceDuplicateAuditModal .era-dot-min {
    background: linear-gradient(180deg, #ffd60a, #e5a000);
}
#conferenceDuplicateAuditModal .era-dot-max {
