body.appearance-dark.modern-mode .att-tbl.pa-tbl thead th {
    color: #e2e8f0 !important;
}

.att-tbl.pa-tbl .pa-view-btn {
    color: #0f172a;
    font-weight: 700;
    border-color: #cbd5e1;
