                    }
                    if (typeof window.requestIdleCallback === 'function') {
                        window.requestIdleCallback(runNext, {
                            timeout: 1500
                        });
                    } else {
                        setTimeout(runNext, 80);
                    }
                }
                runNext();
            }
            if (typeof window.requestIdleCallback === 'function') {
                window.requestIdleCallback(warmHomeSegTabs, {
                    timeout: 1200
                });
                window.requestIdleCallback(runDashboardPrefetch, {
                    timeout: 1500
                });
            } else {
                setTimeout(warmHomeSegTabs, 250);
                setTimeout(runDashboardPrefetch, 400);
            }

            const startParams = new URLSearchParams(window.location.search);
            const startPage = startParams.get('page');
            const privSlug = startParams.get('priv_slug');
            const privCampusBioId = startParams.get('campus_bio_id') || '';

            if (startPage === 'privilege' && privSlug) {
                let privNav = document.querySelector('.subitem[data-slug="' + privSlug + '"]');
                if (!privNav && privCampusBioId) {
                    privNav = document.querySelector(
                        '.subitem[data-slug="' + privSlug + '"][data-campus-bio-id="' + privCampusBioId + '"]'
                    );
                }
                if (privNav) {
                    goPrivilege(privNav);
                } else {
                    goPage('privilege');
                }
            } else if (startPage && document.querySelector('.sitem[data-page="' + startPage + '"], .subitem[data-page="' + startPage + '"]')) {
                goPage(startPage);
            }

            document.body.classList.remove('ed-boot-pending');
            document.body.classList.add('ed-boot-ready');

            // Safety net: if skeleton rows remain after scripts settle, force a render pass.
            window.addEventListener('load', function() {
                setTimeout(function() {
                    var attBody = document.getElementById('att-body');
                    if (!attBody || !attBody.querySelector('.ed-skel-tr')) return;
                    if (window.EDAttendance && typeof window.EDAttendance.refresh === 'function') {
                        window.EDAttendance.refresh();
                    }
                }, 120);
            });
        });
