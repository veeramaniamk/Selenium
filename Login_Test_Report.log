        .bottom-footer span {
            font-size: 0.72rem;
            color: black;
            position: relative;
        }

        .bottom-footer .dot {
            width: 2px;
            height: 2px;
            border-radius: 50%;
            background: black;
            flex-shrink: 0;
        }

        .bottom-footer a {
            font-size: 0.72rem;
            color: var(--ink-soft);
