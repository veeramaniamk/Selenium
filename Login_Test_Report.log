        ensureRoot();
        var backdrop = document.getElementById('ed-bday-backdrop');
        if (!backdrop) return;

        var bioId = (status && status.employee && status.employee.bio_id) || state.activeBirthdayBioId;
        if (!bioId) return;

        if (skipEnvelope) state.cardRevealed = true;

        document.body.style.overflow = 'hidden';
        backdrop.classList.add('visible');
        hideConfettiCanvas();

        // Confetti only on envelope open or "Celebrate again" — never loops
        if (skipEnvelope && trigger === 'greet_me') {
            loadConfettiLib(fireConfetti);
        }

        if (trigger === 'auto_login' || trigger === 'greet_me') {
            await markOpened(trigger);
        }

        await renderModal(status, bioId, trigger, !!skipEnvelope);
    }

    function closeCelebration() {
        var backdrop = document.getElementById('ed-bday-backdrop');
        if (backdrop) backdrop.classList.remove('visible');
        document.body.style.overflow = '';
        hideConfettiCanvas();
    }

    function renderColleagueBanner(status) {
        var host = document.getElementById('ed-bday-colleague-banner');
        if (!host) return;

        var colleagues = status.colleague_birthdays || [];
        var notified = status.pending_notifications || [];
        var seen = {};
        var merged = [];
        colleagues.concat(notified).forEach(function (c) {
            if (!seen[c.bio_id] && c.show_reminder !== false) {
                seen[c.bio_id] = true;
                merged.push(c);
            }
        });

        if (!merged.length) {
            host.classList.remove('visible');
            host.innerHTML = '';
            return;
        }

        host.innerHTML = merged.map(function (c) {
            var wished = !!c.already_wished;
            var unread = parseInt(c.unread_reply_count, 10) || 0;
            var sub = !wished
                ? 'Send a warm wish to your colleague'
                : ('You have ' + unread + ' new repl' + (unread === 1 ? 'y' : 'ies') + ' — tap to read');
            return '<div class="ed-bday-banner-card" data-birthday-bio="' + esc(c.bio_id) + '">' +
                (c.profile_img_url
                    ? '<img src="' + esc(c.profile_img_url) + '" alt="" class="ed-bday-banner-avatar">'
                    : '<div class="ed-bday-banner-avatar-placeholder">' + esc(initials(c.employee_name)) + '</div>') +
                '<div class="ed-bday-banner-text">' +
                '<strong>' + esc(c.first_name || c.employee_name) + '\'s birthday today</strong>' +
                '<span>' + esc(sub) + '</span></div>' +
                '<div class="ed-bday-banner-actions">' +
                '<button type="button" class="ed-bday-btn ed-bday-btn-primary ed-bday-wish-colleague" data-bio="' + esc(c.bio_id) + '">' +
                (wished ? 'View Reply' : 'Send Wish') + '</button>' +
                '<button type="button" class="ed-bday-btn ed-bday-btn-ghost ed-bday-dismiss-banner" data-bio="' + esc(c.bio_id) + '">Later</button>' +
                '</div></div>';
        }).join('');
        host.classList.add('visible');

        host.querySelectorAll('.ed-bday-wish-colleague').forEach(function (btn) {
            btn.addEventListener('click', function () {
                openColleagueCelebration(status, btn.getAttribute('data-bio'));
            });
        });
        host.querySelectorAll('.ed-bday-dismiss-banner').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var card = host.querySelector('[data-birthday-bio="' + btn.getAttribute('data-bio') + '"]');
                if (card) card.style.display = 'none';
                if (!host.querySelector('.ed-bday-banner-card:not([style*="display: none"])')) {
                    host.classList.remove('visible');
                }
            });
        });
    }

    async function openColleagueCelebration(status, birthdayBioId) {
        ensureRoot();
        state.cardRevealed = true;
        var backdrop = document.getElementById('ed-bday-backdrop');
        if (!backdrop) return;
        document.body.style.overflow = 'hidden';
        backdrop.classList.add('visible');
        hideConfettiCanvas();
        await renderModal(status, birthdayBioId, 'colleague', true);
        var isColleagueView = birthdayBioId !== (status.employee && status.employee.bio_id);
        if (isColleagueView) {
            await markWishThreadSeen(birthdayBioId);
            applySeenStateToStatus(birthdayBioId);
        }
    }

    function showGreetFab(show) {
        var fab = document.getElementById('ed-bday-greet-fab');
        if (fab) fab.classList.toggle('visible', !!show);
    }

    async function init() {
        ensureRoot();
        try {
            var status = await fetchJson(apiUrl('status'));
            state.status = status;

            if (status.is_birthday_today) {
                showGreetFab(true);
                if (!status.has_auto_opened) {
                    state.cardRevealed = false;
                    setTimeout(function () {
                        openCelebration('auto_login', status, false);
                    }, 900);
                }
            }

            renderColleagueBanner(status);
        } catch (e) {
            console.warn('[EDBirthday]', e.message);
        }
    }

    window.EDBirthday = {
        init: init,
        openCelebration: function (trigger) {
            if (state.status) {
                state.cardRevealed = trigger === 'greet_me';
                openCelebration(trigger || 'greet_me', state.status, trigger === 'greet_me');
            }
        },
        refresh: init,
    };

    document.addEventListener('DOMContentLoaded', function () {
        init();
    });
})();


