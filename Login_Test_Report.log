    function statusBadge(status) {
        var s = String(status || 'Pending');
        var cls = 'cr-status-pending';
        var lower = s.toLowerCase();
        if (lower === 'approved' || lower === 'completed' || lower === 'issued') cls = 'cr-status-approved';
        else if (lower === 'rejected' || lower === 'cancelled') cls = 'cr-status-rejected';
        else if (lower === 'partial') cls = 'cr-status-pending';
        return '<span class="cr-status-badge ' + cls + '">' + esc(s) + '</span>';
    }

    function storeStatusBadge(status) {
        var s = String(status || 'Pending');
        var cls = 'cr-status-pending';
        var lower = s.toLowerCase();
        if (lower === 'issued') cls = 'cr-status-approved';
        else if (lower === 'cancelled') cls = 'cr-status-rejected';
        else if (lower === 'partial') cls = 'cr-status-pending';
        return '<span class="cr-status-badge ' + cls + '">' + esc(s) + '</span>';
    }

    function progressBar(requestedQty, issuedQty, receivedQty) {
        var req = parseInt(requestedQty, 10) || 0;
        var iss = parseInt(issuedQty, 10) || 0;
        var rec = parseInt(receivedQty, 10) || 0;
        if (req <= 0) {
            return '<div class="cn-progress">'
                + '<div class="cn-progress-track"><div class="cn-progress-bar cn-progress-issued" style="width:0%"></div></div>'
                + '<div class="cn-progress-meta"><span class="cn-muted">0%</span></div>'
                + '</div>';
        }
        var issuedPct = Math.min(100, (iss / req) * 100);
        var receivedPct = Math.min(100, (rec / req) * 100);
        var pending = Math.max(0, req - rec);
        return '<div class="cn-progress">'
            + '<div class="cn-progress-track">'
            + '<div class="cn-progress-bar cn-progress-issued" style="width:' + issuedPct + '%"></div>'
            + '<div class="cn-progress-bar cn-progress-received" style="width:' + receivedPct + '%"></div>'
            + '</div>'
