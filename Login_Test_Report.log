    #page-approvals #ca-approvals-wrap {
        display: grid !important;
        grid-template-columns: 1fr !important;
        grid-template-rows: auto auto auto !important;
        height: auto !important;
        max-height: none !important;
        min-height: 0 !important;
        gap: 12px !important;
        padding: 10px !important;
    }

    #page-approvals .cr-pending-sidebar,
    #page-approvals .cr-file-pane,
    #page-approvals .cr-approval-panel {
        height: auto !important;
        max-height: none !important;
    }

    #page-approvals .cr-pending-sidebar {
        width: 100% !important;
        max-width: none !important;
        order: 1;
    }

    #page-approvals .cr-file-pane {
        order: 2;
        min-height: 0 !important;
    }

    #page-approvals .cr-file-viewport {
        min-height: min(62vh, 560px);
        max-height: min(72vh, 720px);
    }

    #page-approvals .cr-pdf-frame {
        min-height: min(62vh, 560px) !important;
        height: min(72vh, 720px) !important;
    }

    #page-approvals .cr-approval-panel {
        order: 3;
        width: 100% !important;
        max-width: none !important;
        min-height: 0;
    }

    #page-approvals .cr-approval-body {
        overflow-y: visible;
        max-height: none;
    }

    #page-approvals .cr-pending-list {
        max-height: min(42vh, 280px);
        overflow-y: auto;
