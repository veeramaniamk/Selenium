}

#er-expense-modal .er-summary-section {
    background: linear-gradient(180deg, #ffffff 0%, #f7f9fc 60%, #edf2f8 100%);
    border: 1px solid #c8d3e0;
    border-radius: 14px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05), inset 0 1px 0 #ffffff, 0 1px 2px rgba(0, 0, 0, 0.04);
    overflow: hidden;
