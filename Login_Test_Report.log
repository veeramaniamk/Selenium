        return new Promise(function (resolve, reject) {
            var reader = new FileReader();
            reader.onload = function () { resolve(reader.result); };
            reader.onerror = reject;
            reader.readAsDataURL(file);
        });
    }

    function submitRequest(e) {
        if (e) e.preventDefault();
        var err = validateStep(3);
        if (err) { showFormError(err); return; }
        if (isSubmitting) return;
        isSubmitting = true;
        showFormError('');
        var btn = $('er-form-submit');
        if (btn) btn.disabled = true;
        if (window.EDSubmitProgress) {
            window.EDSubmitProgress.start({ title: 'Submitting event request' });
        }

        readFileAsBase64($('er-form-file').files[0]).then(function (fileData) {
            var entries = getBudgetEntries();
            var total = entries.reduce(function (s, it) { return s + it.amount; }, 0);
            var payload = {
                conference_title: $('er-form-title').value.trim(),
                conference_date: $('er-form-date').value,
                location_code: formSearchSelects.location.getValue(),
                description: $('er-form-description').value.trim(),
                total_budget: total,
                budget_components: entries.map(function (it) {
                    return { id: it.id, amount: it.amount };
                }),
                file_name: $('er-form-file').files[0].name,
                file_size: $('er-form-file').files[0].size,
                file_data: fileData,
            };
            return fetchRaw(apiUrl('submit_conference_request.php'), {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });
        }).then(function (json) {
            var afterProgress = window.EDSubmitProgress
                ? window.EDSubmitProgress.succeed()
                : Promise.resolve();
            return afterProgress.then(function () {
                if (requestModal) requestModal.hide();
                if (window.EDToast) window.EDToast.success((json.message || 'Event request submitted') + (json.request_id ? ' · ID: ' + json.request_id : ''));
                return loadRows();
            });
        }).catch(function (e) {
            if (window.EDSubmitProgress) window.EDSubmitProgress.fail();
            showFormError(e.message || 'Submit failed');
        }).finally(function () {
            isSubmitting = false;
            if (btn) btn.disabled = false;
        });
    }

    function mapEventTimelineToWf(data) {
        var event = (data && data.event) || {};
        var steps = (data && data.timeline_steps) || [];
        var foundPending = false;
        var wfSteps = steps.map(function (step) {
            var status = String(step.status || 'pending').toLowerCase();
            var st = 'up';
            if (status === 'completed' || status === 'approved') st = 'done';
            else if (status === 'rejected') st = 'rejected';
            else if ((status === 'pending' || status === 'in-progress') && !foundPending) {
                st = 'pending';
                foundPending = true;
            }
            return {
                title: step.title || 'Step',
                approver: step.person || '—',
                role: step.department || '',
                date: step.date,
                status: st,
                remark: step.notes || '',
            };
        });
        var subtitle = (event.request_id || 'Event') + (event.conference_title ? ' · ' + event.conference_title : '');
        return {
            subtitle: subtitle,
            requester: event.created_by_name || event.requested_by_name || '—',
            department: event.department || event.location_name || '—',
            amount: fmtMoney(event.total_budget),
            steps: wfSteps,
        };
    }

    function openTimeline(id) {
        fetchJson(apiUrl('get_event_status_timeline.php?id=' + encodeURIComponent(id)))
            .then(function (data) {
                if (window.EDWorkflowModal) EDWorkflowModal.show(mapEventTimelineToWf(data));
            })
            .catch(function (e) { if (window.EDToast) window.EDToast.error(e.message || 'Failed to load timeline'); });
    }

    function mapExpenseTimelineToWf(expense) {
        var steps = [];
        var anyRejected = false;
        var foundPending = false;

        // 1. Initial Submission
        steps.push({
            title: 'Expense Submitted',
            approver: 'Requester',
            role: expense.company_name ? 'Payee: ' + expense.company_name : 'Bill Submission',
            date: expense.created_at || expense.expense_date,
            status: 'done',
            remark: expense.bill_file_name ? 'Bill Attachment: ' + expense.bill_file_name : '',
        });

        // 2. Bill Approver Stages
        (expense.timeline || []).forEach(function (t, i) {
            var st = 'up';
            var status = String(t.status || 'pending').toLowerCase();
            if (anyRejected) {
                st = 'up';
            } else if (status === 'approved') {
                st = 'done';
            } else if (status === 'rejected') {
                st = 'rejected';
                anyRejected = true;
            } else if (status === 'pending' && !foundPending) {
                st = 'pending';
                foundPending = true;
            }
            steps.push({
                title: 'Bill Approver ' + (t.approver_order || (i + 1)),
                approver: t.approver_name || 'Approver',
                role: t.approver_department || 'Bill Verification',
                date: t.action_date || 'Pending',
                status: st,
                remark: t.comments || '',
            });
        });

        // 3. DOA Approval Stage
        var doaSt = 'up';
        var doaStatus = String(expense.doa_status || 'pending').toLowerCase();
        if (anyRejected) {
            doaSt = 'up';
        } else if (doaStatus === 'approved') {
            doaSt = 'done';
        } else if (doaStatus === 'rejected') {
            doaSt = 'rejected';
            anyRejected = true;
        } else if (!foundPending) {
            doaSt = 'pending';
            foundPending = true;
        }
        steps.push({
            title: 'DOA Approval',
            approver: 'Director of Administration',
            role: 'Administrative Sanction',
            date: expense.doa_date || 'Pending',
            status: doaSt,
            remark: expense.doa_comments || '',
        });

        // 4. Accounts Processing / Disbursal Stage
        var accSt = 'up';
        var accStatus = String(expense.accounts_status || 'pending').toLowerCase();
        if (anyRejected) {
            accSt = 'up';
        } else if (accStatus === 'approved') {
            accSt = 'done';
        } else if (accStatus === 'rejected') {
            accSt = 'rejected';
            anyRejected = true;
        } else if (!foundPending && doaStatus === 'approved') {
            accSt = 'pending';
            foundPending = true;
        }
        var accRemark = [];
        if (expense.utr_number) accRemark.push('UTR: ' + expense.utr_number);
        steps.push({
            title: 'Accounts Settlement',
            approver: 'Accounts Department',
            role: 'Disbursal & Verification',
            date: expense.account_date || 'Pending',
            status: accSt,
            remark: accRemark.join(' · '),
        });

        var metaHtml = '';
        if (expense.status === 'rejected' || anyRejected) {
            metaHtml += '<div style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;padding:8px 12px;border-radius:10px;font-size:11px;margin-bottom:10px;display:flex;align-items:center;gap:8px">'
                + '<i class="fa fa-rotate-left" style="color:#ef4444"></i>'
                + '<div><strong>Amount Returned:</strong> ' + fmtMoney(expense.expense_amount) + ' is credited back to Available budget.</div>'
                + '</div>';
        }

        var bankDetails = [];
        if (expense.company_name) bankDetails.push('<strong>Payee:</strong> ' + esc(expense.company_name));
        if (expense.bank_name) bankDetails.push('<strong>Bank:</strong> ' + esc(expense.bank_name));
        if (expense.account_number) bankDetails.push('<strong>A/C:</strong> ' + esc(expense.account_number));
        if (expense.ifsc_code) bankDetails.push('<strong>IFSC:</strong> ' + esc(expense.ifsc_code));
        if (bankDetails.length) {
            metaHtml += '<div style="background:#f8fafc;border:1px solid #e2e8f0;padding:8px 12px;border-radius:10px;font-size:10px;color:#475569;margin-bottom:10px">'
                + bankDetails.join(' &bull; ')
                + '</div>';
        }

        return {
            title: 'Approval Workflow',
            subtitle: 'Expense #' + (expense.id || ''),
            requester: fmtMoney(expense.expense_amount),
            department: expense.description || '',
            amount: '',
            metaHtml: metaHtml,
            steps: steps,
        };
    }

    function mapFundTimelineToWf(fund) {
        var steps = [];
        var anyRejected = false;
        var foundPending = false;

        steps.push({
            title: 'Fund Request Submitted',
            approver: fund.requested_by_name || 'Requester',
            role: 'Additional Fund Request',
            date: fund.created_at || '—',
            status: 'done',
            remark: fund.authorization_letter_name
                ? 'Authorization Letter: ' + fund.authorization_letter_name
                : '',
        });

        (fund.timeline || []).forEach(function (t, i) {
            var st = 'up';
            var status = String(t.status || 'pending').toLowerCase();
            if (anyRejected) {
                st = 'up';
            } else if (status === 'approved') {
                st = 'done';
            } else if (status === 'rejected') {
                st = 'rejected';
                anyRejected = true;
            } else if (status === 'pending' && !foundPending) {
                st = 'pending';
                foundPending = true;
            }
            steps.push({
                title: 'Fund Approver ' + (t.approver_order || (i + 1)),
                approver: t.approver_name || 'Approver',
                role: t.approver_department || 'Fund Verification',
                date: t.action_date || 'Pending',
                status: st,
                remark: t.comments || '',
            });
        });

        var doaSt = 'up';
        var doaStatus = String(fund.doa_status || 'pending').toLowerCase();
        var computed = String(fund.status || '').toLowerCase();
        if (anyRejected || computed === 'rejected') {
            doaSt = 'up';
            if (computed === 'rejected' && !anyRejected) {
                doaSt = 'rejected';
                anyRejected = true;
            }
        } else if (doaStatus === 'approved' || computed === 'completed') {
            doaSt = 'done';
        } else if (doaStatus === 'rejected') {
            doaSt = 'rejected';
            anyRejected = true;
        } else if (!foundPending) {
            doaSt = 'pending';
            foundPending = true;
        }
        steps.push({
            title: 'DOA Approval',
            approver: 'Director of Administration',
            role: 'Budget Clearance',
            date: fund.doa_action_date || 'Pending',
            status: doaSt,
            remark: fund.doa_comments || '',
        });

        var metaHtml = '';
        if (fund.reason) {
            metaHtml += '<div style="background:#f8fafc;border:1px solid #e2e8f0;padding:8px 12px;border-radius:10px;font-size:11px;color:#475569;margin-bottom:10px">'
                + '<strong>Reason:</strong> ' + esc(fund.reason)
                + '</div>';
        }
        if (fund.authorization_letter_path) {
            metaHtml += '<div style="margin-bottom:10px">'
                + '<a href="' + esc(fund.authorization_letter_path) + '" target="_blank" rel="noopener" class="cr-view-btn cr-view-btn-sm">'
                + '<i class="fa fa-file-alt fa-xs"></i> View Authorization Letter</a>'
                + '</div>';
        }
        if (computed === 'rejected' || anyRejected) {
            metaHtml += '<div style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;padding:8px 12px;border-radius:10px;font-size:11px;margin-bottom:10px;display:flex;align-items:center;gap:8px">'
                + '<i class="fa fa-ban" style="color:#ef4444"></i>'
                + '<div><strong>Request rejected</strong> — budget was not increased.</div>'
                + '</div>';
        } else if (doaStatus === 'approved' || computed === 'completed') {
            metaHtml += '<div style="background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46;padding:8px 12px;border-radius:10px;font-size:11px;margin-bottom:10px;display:flex;align-items:center;gap:8px">'
                + '<i class="fa fa-check-circle" style="color:#10b981"></i>'
                + '<div><strong>Fund approved</strong> — ' + fmtMoney(fund.requested_amount) + ' added to component budget.</div>'
                + '</div>';
        }

        return {
            title: 'Fund Approval Workflow',
            subtitle: 'Fund Request #' + (fund.id || ''),
            requester: fmtMoney(fund.requested_amount),
            department: fund.reason || 'Additional Fund',
            amount: '',
            metaHtml: metaHtml,
            steps: steps,
        };
    }

    function fundStatusMeta(fund) {
        var st = String(fund.status || 'pending').toLowerCase();
        var stCls = 'cr-doa-pending';
        var stLabel = 'Pending';
        if (st === 'rejected') {
            stCls = 'cr-doa-rejected';
            stLabel = 'Rejected';
        } else if (st === 'completed') {
            stCls = 'cr-doa-approved';
            stLabel = 'DOA Approved';
        } else if (st === 'pending_doa') {
            stCls = 'cr-doa-pending';
            stLabel = 'Pending DOA';
        } else if (st === 'approved') {
            stCls = 'cr-doa-approved';
            stLabel = 'Approved';
        }
        return { stCls: stCls, stLabel: stLabel, st: st };
    }

    function renderExpenseModal(data) {
        state.expenseData = data;
        state.conferenceId = data.conference.id;
        var conf = data.conference;
        var totals = data.totals || {};
        var approvedTotal = parseFloat(totals.approved) || 0;
        var spentTotal = parseFloat(totals.spent) || 0;
        var availableTotal = parseFloat(totals.available) || 0;

        $('er-expense-title').textContent = conf.conference_title || 'Manage Expenses';
        $('er-expense-sub').textContent = conf.request_id || '';

        var summaryEl = $('er-expense-summary');
        if (summaryEl) {
            summaryEl.innerHTML = ''
                + '<div class="pa-section er-summary-section">'
                + '<div class="pa-section-hdr">Budget Overview</div>'
                + '<div class="pa-section-body er-summary-grid">'
                + '<div class="er-summary-stat"><span class="er-summary-lbl">Total Approved</span><span class="er-summary-val">' + fmtMoney(approvedTotal) + '</span></div>'
                + '<div class="er-summary-stat"><span class="er-summary-lbl">Total Spent</span><span class="er-summary-val er-summary-val-spent">' + fmtMoney(spentTotal) + '</span></div>'
                + '<div class="er-summary-stat"><span class="er-summary-lbl">Available</span><span class="er-summary-val er-summary-val-avail">' + fmtMoney(availableTotal) + '</span></div>'
                + '</div></div>';
        }

        var html = (data.budget_components || []).map(function (item) {
            var compId = String(item.id);
            var history = (data.expense_history && data.expense_history[compId]) || [];
            var fundHistory = (data.fund_history && data.fund_history[compId]) || [];
            var approved = parseFloat(item.approved_amount) || 0;
            var spent = parseFloat(item.spent_amount) || 0;
            var available = parseFloat(item.available_amount) || 0;
            var util = approved > 0 ? Math.min(100, (spent / approved) * 100) : 0;
            var utilBadgeCls = util >= 90 ? 'cr-doa-rejected' : (util >= 70 ? 'cr-doa-pending' : 'cr-doa-approved');
            var utilBarCls = util >= 90 ? 'er-util-critical' : (util >= 70 ? 'er-util-warn' : 'er-util-ok');
            var canAdd = available > 0.009;
            var canFund = history.length > 0;

            var pendingCount = 0;
            var approvedCount = 0;
            var rejectedCount = 0;

            var histHtml = history.length
                ? history.map(function (ex) {
                    var st = String(ex.status || 'pending').toLowerCase();
                    var stCls = 'cr-doa-pending';
                    var stLabel = 'Pending';
                    if (st === 'rejected') {
                        stCls = 'cr-doa-rejected';
                        stLabel = 'Rejected (Returned)';
                        rejectedCount++;
                    } else if (st === 'completed' || st === 'approved') {
                        stCls = 'cr-doa-approved';
                        stLabel = (st === 'completed') ? 'Completed' : 'Approved';
                        approvedCount++;
                    } else if (st === 'doa_approved') {
                        stCls = 'cr-doa-approved';
                        stLabel = 'DOA Approved';
                        approvedCount++;
                    } else if (st === 'pending_doa') {
                        stCls = 'cr-doa-pending';
                        stLabel = 'Pending DOA';
                        pendingCount++;
                    } else {
                        pendingCount++;
                    }

                    var isRejected = (st === 'rejected');
                    return '<div class="er-exp-item' + (isRejected ? ' er-exp-rejected' : '') + '">'
                        + '<div class="er-exp-item-main">'
                        + '<span class="er-exp-amt' + (isRejected ? ' text-decoration-line-through text-danger' : '') + '">' + fmtMoney(ex.expense_amount) + '</span>'
                        + '<span class="er-exp-date">' + esc(fmtDate(ex.created_at || ex.expense_date)) + '</span>'
                        + '</div>'
                        + '<div class="er-exp-item-act">'
                        + '<span class="cr-doa-badge ' + stCls + '">' + esc(stLabel) + '</span>'
                        + '<button type="button" class="cr-view-btn cr-view-btn-sm js-er-exp-timeline" data-exp-id="' + esc(String(ex.id)) + '">'
                        + '<i class="fa fa-clock-rotate-left fa-xs"></i> Timeline</button>'
                        + '</div></div>';
                }).join('')
                : '<div class="er-exp-empty"><i class="fa fa-receipt fa-sm"></i> No expenses recorded yet</div>';

            var fundHistHtml = fundHistory.length
                ? fundHistory.map(function (fund) {
                    var meta = fundStatusMeta(fund);
                    var isRejected = meta.st === 'rejected';
                    return '<div class="er-exp-item er-fund-item' + (isRejected ? ' er-exp-rejected' : '') + '">'
                        + '<div class="er-exp-item-main">'
                        + '<span class="er-exp-amt' + (isRejected ? ' text-decoration-line-through text-danger' : '') + '">' + fmtMoney(fund.requested_amount) + '</span>'
                        + '<span class="er-exp-date">' + esc(fmtDate(fund.created_at)) + '</span>'
                        + (fund.reason ? '<span class="er-fund-reason" title="' + esc(fund.reason) + '">' + esc(fund.reason) + '</span>' : '')
                        + '</div>'
                        + '<div class="er-exp-item-act">'
                        + '<span class="cr-doa-badge ' + meta.stCls + '">' + esc(meta.stLabel) + '</span>'
                        + '<button type="button" class="cr-view-btn cr-view-btn-sm js-er-fund-timeline" data-fund-id="' + esc(String(fund.id)) + '">'
                        + '<i class="fa fa-clock-rotate-left fa-xs"></i> Timeline</button>'
                        + '</div></div>';
                }).join('')
                : '<div class="er-exp-empty"><i class="fa fa-hand-holding-dollar fa-sm"></i> No fund requests yet</div>';

            return '<article class="pa-section er-budget-card er-budget-collapsed" data-comp-id="' + esc(compId) + '">'
                + '<div class="pa-section-hdr er-budget-card-hdr js-er-toggle-card" role="button" tabindex="0" title="Click to expand/collapse">'
                + '<div class="er-budget-hdr-top">'
                + '<div class="er-budget-title-wrap">'
                + '<span class="er-budget-title">' + esc(item.label_name || 'Component') + '</span>'
                + '<span class="er-budget-quick-stat">' + fmtMoney(approved) + '</span>'
                + '</div>'
                + '<div class="er-budget-hdr-right">'
                + '<span class="cr-doa-badge er-util-badge ' + utilBadgeCls + '">' + util.toFixed(0) + '% used</span>'
                + '<i class="fa fa-chevron-down er-card-chevron"></i>'
                + '</div>'
                + '</div>'
                + '<div class="er-budget-status-row">'
                + '<div class="er-status-pill er-status-pill-pending"><i class="fa fa-clock fa-xs"></i><span class="er-status-num">' + pendingCount + '</span><span class="er-status-lbl">Pending</span></div>'
                + '<div class="er-status-pill er-status-pill-approved"><i class="fa fa-check fa-xs"></i><span class="er-status-num">' + approvedCount + '</span><span class="er-status-lbl">Approved</span></div>'
                + '<div class="er-status-pill er-status-pill-rejected"><i class="fa fa-times fa-xs"></i><span class="er-status-num">' + rejectedCount + '</span><span class="er-status-lbl">Rejected</span></div>'
                + '</div>'
                + '</div>'
                + '<div class="pa-section-body">'
                + '<div class="er-budget-stats">'
                + '<div class="er-budget-stat-box"><span class="er-budget-stat-lbl">Approved</span><span class="er-budget-stat-val">' + fmtMoney(approved) + '</span></div>'
                + '<div class="er-budget-stat-box"><span class="er-budget-stat-lbl">Spent</span><span class="er-budget-stat-val er-stat-spent">' + fmtMoney(spent) + '</span></div>'
                + '<div class="er-budget-stat-box"><span class="er-budget-stat-lbl">Available</span><span class="er-budget-stat-val er-stat-avail">' + fmtMoney(available) + '</span></div>'
                + '</div>'
                + '<div class="er-util-bar ' + utilBarCls + '"><div class="er-util-fill" style="width:' + util.toFixed(1) + '%"></div></div>'
                + '<div class="er-item-actions">'
                + '<button type="button" class="btn-pri er-inline-btn js-er-add-expense" data-component-id="' + esc(compId) + '" data-available="' + esc(String(available)) + '" ' + (canAdd ? '' : 'disabled') + '>'
                + '<i class="fa fa-plus fa-xs"></i> Add Expense</button>'
                + '<button type="button" class="cr-view-btn js-er-add-fund" data-component-id="' + esc(compId) + '" ' + (canFund ? '' : 'disabled') + '>'
                + '<i class="fa fa-hand-holding-dollar fa-xs"></i> Request Fund</button>'
                + '</div>'
                + '<div class="er-exp-history">'
                + '<div class="er-exp-history-hdr">Recent expenses (' + history.length + ')</div>'
                + '<div class="er-exp-list">' + histHtml + '</div>'
                + '</div>'
                + '<div class="er-exp-history er-fund-history">'
                + '<div class="er-exp-history-hdr"><i class="fa fa-hand-holding-dollar fa-xs me-1"></i> Additional fund requests (' + fundHistory.length + ')</div>'
                + '<div class="er-exp-list">' + fundHistHtml + '</div>'
                + '</div>'
                + '</div></article>';
        }).join('');

        $('er-expense-body').innerHTML = html || '<div class="cr-td-empty er-exp-empty-state">No budget components configured for this event.</div>';

        $('er-expense-body').querySelectorAll('.js-er-exp-timeline').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var expId = btn.getAttribute('data-exp-id');
                var found = null;
                Object.keys(data.expense_history || {}).forEach(function (k) {
                    (data.expense_history[k] || []).forEach(function (ex) {
                        if (String(ex.id) === String(expId)) found = ex;
                    });
                });
                if (found && window.EDWorkflowModal) {
                    EDWorkflowModal.show(mapExpenseTimelineToWf(found));
                }
            });
        });

        $('er-expense-body').querySelectorAll('.js-er-fund-timeline').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var fundId = btn.getAttribute('data-fund-id');
                var found = null;
                Object.keys(data.fund_history || {}).forEach(function (k) {
                    (data.fund_history[k] || []).forEach(function (fund) {
                        if (String(fund.id) === String(fundId)) found = fund;
                    });
                });
                if (found && window.EDWorkflowModal) {
                    EDWorkflowModal.show(mapFundTimelineToWf(found));
                } else if (window.EDToast) {
                    window.EDToast.error('Unable to load fund timeline');
                }
            });
        });
    }

    function openExpenseModal(id) {
        fetchJson(apiUrl('get_conference_details.php?id=' + encodeURIComponent(id)))
            .then(function (data) {
                renderExpenseModal(data);
                if (!expenseModal) expenseModal = new bootstrap.Modal($('er-expense-modal'));
                expenseModal.show();
            })
            .catch(function (e) { if (window.EDToast) window.EDToast.error(e.message || 'Failed to load expenses'); });
    }

    function openAddExpenseModal(componentId, available) {
        $('er-expense-component-id').value = componentId;
        $('er-expense-max').textContent = fmtMoney(available);
        $('er-expense-amount').max = available;
        $('er-expense-amount').value = '';
        $('er-expense-desc').value = '';
        $('er-expense-date').value = new Date().toISOString().split('T')[0];
        var err = $('er-expense-form-error');
        if (err) { err.style.display = 'none'; err.textContent = ''; }
        var form = $('er-add-expense-form');
        if (form) form.reset();
        $('er-expense-component-id').value = componentId;
        if (!addExpenseModal) addExpenseModal = new bootstrap.Modal($('er-add-expense-modal'));
        addExpenseModal.show();
    }

    function submitExpense(e) {
        if (e) e.preventDefault();
        var componentId = parseInt($('er-expense-component-id').value, 10);
        var amount = parseFloat($('er-expense-amount').value) || 0;
        var max = parseFloat($('er-expense-amount').max) || 0;
        var errEl = $('er-expense-form-error');
        if (!componentId || amount <= 0 || amount > max + 0.009) {
            if (errEl) { errEl.textContent = 'Amount must be between 0.01 and ' + fmtMoney(max); errEl.style.display = 'block'; }
            return;
        }
        var billFile = $('er-expense-bill').files[0];
        if (!billFile) return;
        var btn = $('er-expense-submit');
        if (btn) btn.disabled = true;
        if (window.EDSubmitProgress) {
            window.EDSubmitProgress.start({ title: 'Submitting expense' });
        }

        Promise.all([
            readFileAsBase64(billFile),
            ($('er-expense-gst-file').files[0] ? readFileAsBase64($('er-expense-gst-file').files[0]) : Promise.resolve(null)),
        ]).then(function (files) {
            var payload = {
                conference_request_id: state.conferenceId,
                budget_component_id: componentId,
                expense_amount: amount,
                description: $('er-expense-desc').value.trim(),
                expense_date: $('er-expense-date').value,
                gst_number: $('er-expense-gst').value.trim(),
                bank_name: $('er-expense-bank').value.trim(),
                account_number: $('er-expense-account').value.trim(),
                ifsc_code: $('er-expense-ifsc').value.trim(),
                bank_branch: $('er-expense-branch').value.trim(),
                company_name: $('er-expense-company').value.trim(),
                file_name: billFile.name,
                file_data: files[0],
            };
            if (files[1] && $('er-expense-gst-file').files[0]) {
                payload.gst_invoice_name = $('er-expense-gst-file').files[0].name;
                payload.gst_invoice_data = files[1];
            }
            return fetchRaw(apiUrl('submit_expense.php'), {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });
        }).then(function () {
            var afterProgress = window.EDSubmitProgress
                ? window.EDSubmitProgress.succeed()
                : Promise.resolve();
            return afterProgress.then(function () {
                if (addExpenseModal) addExpenseModal.hide();
                if (window.EDToast) window.EDToast.success('Expense submitted for approval');
                return fetchJson(apiUrl('get_conference_details.php?id=' + encodeURIComponent(state.conferenceId)));
            });
        }).then(function (data) {
            if (data) renderExpenseModal(data);
        }).catch(function (err) {
            if (window.EDSubmitProgress) window.EDSubmitProgress.fail();
            if (errEl) { errEl.textContent = err.message || 'Submit failed'; errEl.style.display = 'block'; }
        }).finally(function () {
            if (btn) btn.disabled = false;
        });
    }

    function openAddFundModal(componentId) {
        $('er-fund-component-id').value = componentId;
        var form = $('er-add-fund-form');
        if (form) form.reset();
        $('er-fund-component-id').value = componentId;
        var letter = $('er-fund-letter');
        if (letter) letter.value = '';
        var err = $('er-fund-form-error');
        if (err) { err.style.display = 'none'; err.textContent = ''; }
        if (!addFundModal) addFundModal = new bootstrap.Modal($('er-add-fund-modal'));
        addFundModal.show();
    }

    function submitFund(e) {
        if (e) e.preventDefault();
        var componentId = parseInt($('er-fund-component-id').value, 10);
        var amount = parseFloat($('er-fund-amount').value) || 0;
        var reason = ($('er-fund-reason').value || '').trim();
        var letterInput = $('er-fund-letter');
        var letterFile = letterInput && letterInput.files ? letterInput.files[0] : null;
        var errEl = $('er-fund-form-error');
        if (!componentId || amount <= 0 || !reason) {
            if (errEl) { errEl.textContent = 'Amount and reason are required'; errEl.style.display = 'block'; }
            return;
        }
        if (!letterFile) {
            if (errEl) { errEl.textContent = 'Authorization letter is required'; errEl.style.display = 'block'; }
            return;
        }
        var btn = $('er-fund-submit');
        if (btn) btn.disabled = true;
        readFileAsBase64(letterFile).then(function (fileData) {
            return fetchRaw(apiUrl('submit_additional_fund.php'), {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    conference_id: state.conferenceId,
                    component_id: componentId,
                    amount: amount,
                    reason: reason,
                    file_name: letterFile.name,
                    file_data: fileData,
                }),
            });
        }).then(function () {
            if (addFundModal) addFundModal.hide();
            if (window.EDToast) window.EDToast.success('Additional fund request submitted');
            return fetchJson(apiUrl('get_conference_details.php?id=' + encodeURIComponent(state.conferenceId)));
        }).then(function (data) {
            renderExpenseModal(data);
        }).catch(function (err) {
            if (errEl) { errEl.textContent = err.message || 'Submit failed'; errEl.style.display = 'block'; }
        }).finally(function () {
            if (btn) btn.disabled = false;
        });
    }

    /* ── Approvals tab ── */
    function loadPending() {
        var fd = new FormData();
        fd.append('draw', '1');
        fd.append('start', '0');
        fd.append('length', '500');
        return fetch(apiUrl('get_pending_approvals.php'), { method: 'POST', body: fd, credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (json) {
                pendingApprovals = Array.isArray(json.data) ? json.data : [];
                currentApprovalIndex = 0;
                updateApprovalsUI();
                renderPendingList();
                renderCurrentApproval();
            });
    }

    function checkApprover() {
        var tabItem = $('er-approvals-tab-item');
        if (tabItem) tabItem.style.display = 'none';
        return Promise.resolve(null);
    }

    function updateApprovalsUI() {
        var wrap = $('er-approvals-wrap');
        var empty = $('er-approvals-empty');
        var has = pendingApprovals.length > 0;
        if (wrap) wrap.style.display = has ? '' : 'none';
        if (empty) empty.style.display = has ? 'none' : '';
        var cnt = $('er-pending-count');
        if (cnt) cnt.textContent = String(pendingApprovals.length);
    }

    function getFilteredPending() {
        var q = pendingSearch.trim().toLowerCase();
        return pendingApprovals.filter(function (item, idx) {
            if (!q) return true;
            var hay = [item.request_id, item.conference_title, item.requested_by, item.department].join(' ').toLowerCase();
            return hay.indexOf(q) !== -1;
        }).map(function (item, i) { return { item: item, index: pendingApprovals.indexOf(item) }; });
    }

    function renderPendingList() {
        var list = $('er-pending-list');
        if (!list) return;
        var entries = getFilteredPending();
        if (!entries.length) {
            list.innerHTML = '<li class="cr-empty-list">No pending approvals</li>';
            return;
        }
        list.innerHTML = entries.map(function (entry) {
            var r = entry.item;
            var active = entry.index === currentApprovalIndex ? ' active' : '';
            return '<li class="cr-pending-item' + active + '" data-idx="' + entry.index + '">'
                + '<div class="cr-pi-id"><span><i class="fa fa-hashtag fa-xs"></i> ' + esc(r.request_id || '—') + '</span></div>'
                + '<div class="cr-pi-emp"><i class="fa fa-calendar fa-xs"></i> ' + esc(r.conference_title || '—') + '</div>'
                + '<div class="cr-pi-loc"><i class="fa fa-user fa-xs"></i> ' + esc(r.requested_by || '—') + '</div>'
                + '</li>';
        }).join('');
    }

    function renderCurrentApproval() {
        var meta = $('er-approval-meta');
        var fields = $('er-approval-fields');
        var viewport = $('er-file-viewport');
        var item = pendingApprovals[currentApprovalIndex];
        if (!item) {
            if (meta) meta.innerHTML = '';
            if (fields) fields.innerHTML = '<div class="cr-td-empty">Select a pending approval</div>';
            if (viewport) viewport.innerHTML = '';
            return;
        }
        if (meta) {
            meta.innerHTML = '<div class="cr-detail-header">'
                + '<div class="cr-detail-id">' + esc(item.request_id || '—') + '</div>'
                + '<div class="cr-detail-date">' + esc(item.conference_date || '') + '</div>'
                + '</div>'
                + '<div class="cr-meta-card">'
                + '<div class="cr-meta-label">Event</div>'
                + '<div class="cr-meta-value">' + esc(item.conference_title || '—') + '</div>'
                + '</div>'
                + '<div class="cr-meta-card">'
                + '<div class="cr-meta-label">Requested By</div>'
                + '<div class="cr-meta-value">' + esc(item.requested_by || '—') + ' · ' + esc(item.department || '') + '</div>'
                + '</div>';
        }
        var approveBtn = $('er-approve-btn');
        var rejectBtn = $('er-reject-btn');
        if (approveBtn) approveBtn.disabled = false;
        if (rejectBtn) rejectBtn.disabled = false;

        fetch(apiUrl('get_approval_details.php?id=' + item.id + '&approval_id=' + item.approval_id), { credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (json) {
                if (!json.success) throw new Error(json.message || 'Failed to load details');
                currentApprovalDetail = json.data || json;
                var conf = currentApprovalDetail.conference || {};
                var components = currentApprovalDetail.budget_components || [];
                if (fields) {
                    fields.innerHTML = '<div class="pa-section"><div class="pa-section-hdr">Budget Components</div><div class="pa-section-body">'
                        + '<table class="cr-tbl"><thead><tr><th>Component</th><th>Amount</th></tr></thead><tbody>'
                        + components.map(function (it) {
                            return '<tr><td>' + esc(it.label_name || '—') + '</td><td>' + fmtMoney(it.amount) + '</td></tr>';
                        }).join('')
                        + '</tbody></table></div></div>'
                        + '<div class="pa-section"><div class="pa-section-hdr">Description</div><div class="pa-section-body">' + esc(conf.description || '') + '</div></div>';
                }
                var pdfUrl = conf.attachment_inline_url || conf.attachment_path || conf.attachment_url;
                if (viewport) {
                    viewport.innerHTML = pdfUrl
                        ? '<iframe src="' + esc(pdfUrl) + '" style="width:100%;height:100%;border:none"></iframe>'
                        : '<div class="cr-td-empty">No document available</div>';
                }
            })
            .catch(function (e) {
                if (fields) fields.innerHTML = '<div class="cr-td-error">' + esc(e.message) + '</div>';
            });

        var prevBtn = $('er-prev-approval');
        var nextBtn = $('er-next-approval');
        if (prevBtn) prevBtn.disabled = currentApprovalIndex <= 0;
        if (nextBtn) nextBtn.disabled = currentApprovalIndex >= pendingApprovals.length - 1;
    }

    function updateApproval(decision, comments) {
        var item = pendingApprovals[currentApprovalIndex];
        if (!item) return;
        var payload = {
            approval_id: item.approval_id,
            conference_id: item.id,
            decision: decision,
            comments: comments || '',
        };
        if (currentApprovalDetail && currentApprovalDetail.budget_components) {
            payload.budget_components = currentApprovalDetail.budget_components.map(function (it) {
                return { id: it.id, amount: parseFloat(it.amount) || 0 };
            });
        }
        return fetchRaw(apiUrl('submit_approval_decision.php'), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
        }).then(function () {
            if (window.EDToast) window.EDToast.success(decision === 'approved' ? 'Request approved' : 'Request rejected');
            return loadPending();
        }).catch(function (e) { if (window.EDToast) window.EDToast.error(e.message || 'Action failed'); });
    }

    function openRejectModal() {
        var item = pendingApprovals[currentApprovalIndex];
        if (!item) return;
        $('er-reject-eid').textContent = item.request_id || '—';
        $('er-reject-title').textContent = item.conference_title || '—';
        $('er-reject-reason').value = '';
        var err = $('er-reject-error');
        if (err) err.style.display = 'none';
        if (!rejectModal) rejectModal = new bootstrap.Modal($('er-reject-modal'));
        rejectModal.show();
    }

    function confirmReject() {
        var reason = ($('er-reject-reason').value || '').trim();
        var err = $('er-reject-error');
        if (!reason) {
            if (err) { err.textContent = 'Reason is required'; err.style.display = 'block'; }
            return;
        }
        if (rejectModal) rejectModal.hide();
        updateApproval('rejected', reason);
    }

