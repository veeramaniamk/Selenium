                '<div id="ed-bday-reveal-slot"></div>' +
                wishSectionHtml +
                '<div class="ed-bday-modal-footer">' +
                '<button type="button" class="ed-bday-close-btn" id="ed-bday-close">Continue to Dashboard</button>' +
                footerExtra +
                '</div>';
            bindEnvelopeReveal(modal, emp, greeting, institution, false);
        } else if (isOwn) {
            modal.innerHTML =
                buildRevealedHtml(emp, greeting, institution) +
                wishSectionHtml +
                '<div class="ed-bday-modal-footer">' +
                '<button type="button" class="ed-bday-close-btn" id="ed-bday-close">Continue to Dashboard</button>' +
                footerExtra +
                '</div>';
        } else {
            modal.innerHTML =
                buildRevealedHtml(emp, greeting, institution) +
