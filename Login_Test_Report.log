        const THEME_CACHE_NAME = 'ed-theme-wallpapers-v2';
        const THEME_MAX_UPLOAD_BYTES = 25 * 1024 * 1024;
        const themeReadyMap = new Map();
        const themeBlobUrls = new Map();
        const themeLumCache = new Map();
        let themeCacheWarmStarted = false;
        let customThemes = [];
        let customThemesLoaded = false;
        let customThemesLoading = null;
        let activeVideoCacheKey = null;
        let activeVideoPlayUrl = null;
        let videoLuminanceSampled = false;

        let setModeState = 'modern';
        let setThemeIdx = 0;
        let setCustomThemeId = null;
        let setCustomThemeKey = null;
        let setThemeMediaType = 'image';

        function themeCacheRequestUrl(cacheKey) {
            return '/ed-theme-cache/' + encodeURIComponent(cacheKey);
        }

        function themeDisplayUrl(url) {
            return themeBlobUrls.get(url) || url;
        }

        function getBgVideoEl() {
            return document.getElementById('ed-bg-video');
        }

        function prefersReducedMotion() {
            return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        }

        function clearVideoBackground() {
            const video = getBgVideoEl();
            if (!video) return;
            try {
                video.pause();
            } catch (e) {}
            video.removeAttribute('src');
            try {
                video.load();
            } catch (e) {}
            document.body.classList.remove('ed-bg-video-active');
            activeVideoCacheKey = null;
            activeVideoPlayUrl = null;
            videoLuminanceSampled = false;
        }

        function warmVideoCache(cacheKey, fetchUrl) {
            if (!cacheKey || !fetchUrl || !('caches' in window)) return;
            const cacheReqUrl = themeCacheRequestUrl(cacheKey);
            caches.open(THEME_CACHE_NAME).then((cache) => cache.match(cacheReqUrl)).then((hit) => {
                if (hit) return null;
                return fetch(fetchUrl, {
                    credentials: 'same-origin'
                });
            }).then((res) => {
                if (!res || !res.ok) return;
                return caches.open(THEME_CACHE_NAME).then((cache) => cache.put(cacheReqUrl, res.clone()));
            }).catch(() => {});
        }

        async function resolveVideoPlayUrl(cacheKey, fetchUrl) {
            if (themeBlobUrls.has(cacheKey)) {
                return {
                    playUrl: themeBlobUrls.get(cacheKey),
                    fromCache: true
                };
            }

            if ('caches' in window) {
                try {
                    const cache = await caches.open(THEME_CACHE_NAME);
                    const hit = await cache.match(themeCacheRequestUrl(cacheKey));
                    if (hit && hit.ok) {
                        const blob = await hit.blob();
                        const blobUrl = URL.createObjectURL(blob);
                        themeBlobUrls.set(cacheKey, blobUrl);
                        return {
                            playUrl: blobUrl,
                            fromCache: true
                        };
                    }
                } catch (e) {}
            }

            const blobUrl = await cacheThemeBlob(cacheKey, fetchUrl);
            return {
                playUrl: blobUrl,
                fromCache: false
            };
        }

        async function cacheThemeBlob(cacheKey, fetchUrl) {
            if (themeBlobUrls.has(cacheKey)) {
                return themeBlobUrls.get(cacheKey);
            }

            let blobUrl = null;
            const cacheReqUrl = themeCacheRequestUrl(cacheKey);
            const fetchOpts = {
                credentials: isSameOriginUrl(fetchUrl) ? 'same-origin' : 'omit',
                cache: 'force-cache'
            };

            try {
                if ('caches' in window) {
                    const cache = await caches.open(THEME_CACHE_NAME);
                    let res = await cache.match(cacheReqUrl);
                    if (!res) {
                        res = await fetch(fetchUrl, fetchOpts);
                        if (res && res.ok) {
                            try {
                                await cache.put(cacheReqUrl, res.clone());
                            } catch (e) {}
                        }
                    }
                    if (res && res.ok) {
                        const blob = await res.blob();
                        blobUrl = URL.createObjectURL(blob);
                        themeBlobUrls.set(cacheKey, blobUrl);
                    }
                }
            } catch (e) {}

            if (!blobUrl) {
                const res = await fetch(fetchUrl, {
                    credentials: isSameOriginUrl(fetchUrl) ? 'same-origin' : 'omit'
                });
                if (!res.ok) {
                    throw new Error('theme fetch failed');
                }
                const blob = await res.blob();
                blobUrl = URL.createObjectURL(blob);
                themeBlobUrls.set(cacheKey, blobUrl);
                try {
                    if ('caches' in window) {
                        const cache = await caches.open(THEME_CACHE_NAME);
                        await cache.put(cacheReqUrl, new Response(blob.slice(0)));
                    }
                } catch (e) {}
            }

            return blobUrl;
        }

        function loadThemeImage(url) {
            if (themeReadyMap.has(url)) return themeReadyMap.get(url);
            const p = (async () => {
                let blobUrl = themeBlobUrls.get(url) || null;
                try {
                    if (!blobUrl && 'caches' in window) {
                        const cache = await caches.open(THEME_CACHE_NAME);
                        let res = await cache.match(url);
                        if (!res) {
                            res = await fetch(url, {
                                credentials: 'same-origin',
                                cache: 'force-cache'
                            });
                            if (res && res.ok) {
                                try {
                                    await cache.put(url, res.clone());
                                } catch (e) {}
                            }
                        }
                        if (res && res.ok) {
                            const blob = await res.blob();
                            blobUrl = URL.createObjectURL(blob);
                            themeBlobUrls.set(url, blobUrl);
                        }
                    }
                } catch (e) {}

                const src = blobUrl || url;
                const img = await new Promise((resolve, reject) => {
                    const el = new Image();
                    el.decoding = 'async';
                    el.onload = () => resolve(el);
                    el.onerror = () => {
                        if (blobUrl) {
                            const fallback = new Image();
                            fallback.decoding = 'async';
                            fallback.onload = () => resolve(fallback);
                            fallback.onerror = reject;
                            fallback.src = url;
                        } else {
                            reject(new Error('theme image failed'));
                        }
                    };
                    el.src = src;
                });

                if (blobUrl) img._blobUrl = blobUrl;
                return img;
            })();

            themeReadyMap.set(url, p);
            return p;
        }

        function loadThemeVideo(cacheKey, fetchUrl) {
            const mapKey = 'video:' + cacheKey;
            if (themeReadyMap.has(mapKey)) return themeReadyMap.get(mapKey);

            const p = resolveVideoPlayUrl(cacheKey, fetchUrl).then((payload) => ({
                playUrl: payload.playUrl,
                cacheKey,
                fromCache: payload.fromCache
            }));
            themeReadyMap.set(mapKey, p);
            return p;
        }

        function sampleVideoLuminance(video, cacheKey) {
            if (videoLuminanceSampled || !video) return;
            const sampleKey = cacheKey || 'video';
            if (themeLumCache.has(sampleKey)) {
                applyTextColorsForBrightness(themeLumCache.get(sampleKey));
                videoLuminanceSampled = true;
                return;
            }

            try {
                if (video.readyState < 2) return;
                const c = document.createElement('canvas');
                c.width = 64;
                c.height = 64;
                const ctx = c.getContext('2d');
                if (!ctx) return;
                ctx.drawImage(video, 0, 0, 64, 64);
                const d = ctx.getImageData(0, 0, 64, 64).data;
                let total = 0,
                    n = 0;
                for (let i = 0; i < d.length; i += 16) {
                    const r = d[i] / 255,
                        g = d[i + 1] / 255,
                        b = d[i + 2] / 255;
                    total += 0.2126 * r + 0.7152 * g + 0.0722 * b;
                    n++;
                }
                const lum = n > 0 ? total / n : 0.45;
                themeLumCache.set(sampleKey, lum);
                applyTextColorsForBrightness(lum);
                videoLuminanceSampled = true;
            } catch (e) {
                applyTextColorsForBrightness(0.45);
                videoLuminanceSampled = true;
            }
        }

        function bindVideoBackgroundEvents(video) {
            if (!video || video.dataset.edBound === '1') return;
            video.dataset.edBound = '1';

            video.addEventListener('loadeddata', () => {
                if (activeVideoCacheKey) {
                    sampleVideoLuminance(video, activeVideoCacheKey);
                }
            }, {
                passive: true
            });

            video.addEventListener('playing', () => {
                document.body.classList.add('ed-bg-video-active');
            }, {
                passive: true
            });
        }

        function warmThemeCache() {
            if (themeCacheWarmStarted) return;
            themeCacheWarmStarted = true;

            const run = () => {
                THEMES.forEach((t, i) => {
                    setTimeout(() => {
                        loadThemeImage(t.u).catch(() => {});
                    }, 40 * i);
                });
            };

            if ('requestIdleCallback' in window) {
                requestIdleCallback(run, {
                    timeout: 1200
                });
            } else {
                setTimeout(run, 300);
            }
        }

        function themeApiUrl() {
            const base = (window.ED_CONFIG && window.ED_CONFIG.apiBase) || '/api/employee';
            return base.replace(/\/$/, '') + '/dashboard-theme.php';
        }

        function themeStreamUrl(themeId) {
            return themeApiUrl() + '?action=stream&id=' + encodeURIComponent(String(themeId));
        }

        function themeMediaFetchUrl(theme) {
            if (!theme || !theme.id) return '';
            return themeStreamUrl(theme.id);
        }

        function isSameOriginUrl(url) {
            try {
                return new URL(url, window.location.origin).origin === window.location.origin;
            } catch (e) {
                return true;
            }
        }

        function themeApiHeaders(isJson) {
            const headers = new Headers();
            if (isJson) headers.set('Content-Type', 'application/json');
            const token = window.ED_CONFIG && window.ED_CONFIG.csrfToken;
            if (token) headers.set('X-CSRF-Token', token);
            return headers;
        }

        function fetchCustomThemes(force) {
            if (customThemesLoaded && !force) {
                return Promise.resolve(customThemes);
            }
            if (customThemesLoading && !force) {
                return customThemesLoading;
            }

            customThemesLoading = fetch(themeApiUrl(), {
                    credentials: 'same-origin'
                })
                .then((res) => res.json())
                .then((json) => {
                    if (!json || !json.success) {
                        throw new Error((json && json.error) || 'Failed to load custom themes');
                    }
                    customThemes = Array.isArray(json.data && json.data.themes) ? json.data.themes : [];
                    customThemesLoaded = true;
                    return customThemes;
                })
                .catch((err) => {
                    console.warn('Custom themes unavailable', err);
                    customThemes = [];
                    customThemesLoaded = true;
                    return customThemes;
                })
                .finally(() => {
                    customThemesLoading = null;
                });

            return customThemesLoading;
        }

        function setThemeUploadStatus(msg, isError) {
            const el = document.getElementById('ed-theme-upload-status');
            if (!el) return;
            el.textContent = msg || '';
            el.style.display = msg ? 'block' : 'none';
            el.style.color = isError ? '#dc2626' : '';
        }

        function bindThemeUploadUi() {
            const btn = document.getElementById('ed-theme-upload-btn');
            const input = document.getElementById('ed-theme-upload-input');
            if (!btn || !input || btn.dataset.bound === '1') return;
            btn.dataset.bound = '1';

            btn.addEventListener('click', () => input.click());
            input.addEventListener('change', async () => {
                const file = input.files && input.files[0];
                input.value = '';
                if (!file) return;

                if (file.size > THEME_MAX_UPLOAD_BYTES) {
                    setThemeUploadStatus('File must be 25 MB or smaller.', true);
                    return;
                }

                btn.disabled = true;
                setThemeUploadStatus('Uploading…');

                try {
                    const fd = new FormData();
                    fd.append('file', file);
                    fd.append('display_name', file.name);

                    const res = await fetch(themeApiUrl(), {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: themeApiHeaders(false),
                        body: fd
                    });
                    let json = null;
                    try {
                        json = await res.json();
                    } catch (parseErr) {
                        throw new Error(res.ok ? 'Upload failed.' : ('Upload failed (' + res.status + ').'));
                    }
                    if (!res.ok || !json || !json.success || !json.data || !json.data.theme) {
                        throw new Error((json && json.error) || ('Upload failed (' + res.status + ').'));
                    }

                    customThemesLoaded = false;
                    await fetchCustomThemes(true);
                    drawCustomThemeGallery();
                    setThemeUploadStatus('Upload complete.');
                    selCustomTheme(json.data.theme.id);
                } catch (err) {
                    setThemeUploadStatus(err.message || 'Upload failed.', true);
                } finally {
                    btn.disabled = false;
                }
            });
        }

        async function deleteCustomTheme(themeId, ev) {
            if (ev) {
                ev.preventDefault();
                ev.stopPropagation();
            }
            if (!confirm('Delete this background?')) return;

            try {
                const res = await fetch(themeApiUrl() + '?id=' + encodeURIComponent(themeId), {
                    method: 'DELETE',
                    credentials: 'same-origin',
                    headers: themeApiHeaders(true)
                });
                const json = await res.json();
                if (!json || !json.success) {
                    throw new Error((json && json.error) || 'Delete failed');
                }

                customThemes = customThemes.filter((t) => t.id !== themeId);
                if (setCustomThemeId === themeId) {
                    setCustomThemeId = null;
                    setCustomThemeKey = null;
                    setThemeMediaType = 'image';
                    clearVideoBackground();
                    setThemeIdx = defaultThemeIndex();
                    applyBuiltinTheme(setThemeIdx);
                    saveSettings();
                }
                drawCustomThemeGallery();
                drawThemeGallery();
            } catch (err) {
                alert(err.message || 'Delete failed.');
            }
        }

        window.deleteCustomTheme = deleteCustomTheme;

        function selMode(m) {
            setModeState = 'modern';
            const sect = document.getElementById('sect-themes');
            if (sect) {
                sect.style.display = 'block';
                sect.style.opacity = '1';
                sect.style.pointerEvents = 'auto';
            }
            drawThemeGallery();
            applyTheme(setThemeIdx);
            warmThemeCache();
            saveSettings();
        }

        function applySettingsFromState() {
            setModeState = 'modern';
            const sect = document.getElementById('sect-themes');
            if (sect) {
                sect.style.display = 'block';
                sect.style.opacity = '1';
                sect.style.pointerEvents = 'auto';
            }
            drawThemeGallery();
            drawCustomThemeGallery();
            if (setCustomThemeId) {
                applyCustomThemeById(setCustomThemeId);
            } else {
                applyBuiltinTheme(setThemeIdx);
            }
            warmThemeCache();
        }

        function hydrateSettingsUi() {
            const sect = document.getElementById('sect-themes');
            if (sect) {
                sect.style.display = 'block';
                sect.style.opacity = '1';
                sect.style.pointerEvents = 'auto';
            }
            bindThemeUploadUi();
            fetchCustomThemes().then(() => {
                drawCustomThemeGallery();
                drawThemeGallery();
            });
        }

        function drawCustomThemeGallery() {
            const grid = document.getElementById('custom-theme-grid');
            const empty = document.getElementById('custom-theme-empty');
            if (!grid) return;

            if (!customThemes.length) {
                grid.innerHTML = empty ? empty.outerHTML : '<p class="text-secondary mb-0" style="font-size:12px">No custom backgrounds yet.</p>';
                return;
            }

            grid.innerHTML = customThemes.map((t) => {
                const active = setCustomThemeId === t.id;
                const storedThumb = themeBlobUrls.get(t.file_url) || '';
                const thumb = t.media_type === 'video' ?
                    `<div class="theme-thumb"><video class="theme-thumb-video" muted playsinline preload="none"${storedThumb ? ` src="${storedThumb}"` : ''}></video></div>` :
                    `<div class="theme-thumb" style="height:110px;background-color:#e2e8f0;${storedThumb ? `background-image:url('${storedThumb}');background-size:cover;background-position:center;` : ''}"></div>`;
                const safeName = String(t.display_name || 'My background').replace(/</g, '&lt;');
                return `
        <div class="mode-card custom-theme-card ${active ? 'active' : ''}" onclick="selCustomTheme(${t.id})">
          ${thumb}
          <div class="mode-txt">
            <div class="mode-name">${safeName}</div>
            <div class="mode-desc">${t.media_type === 'video' ? 'Video background' : 'Custom image'}</div>
          </div>
          <button type="button" class="theme-card-delete" onclick="deleteCustomTheme(${t.id}, event)" aria-label="Delete background"><i class="fa fa-trash"></i></button>
          <div class="mode-chk"><i class="fa fa-check"></i></div>
        </div>`;
            }).join('');

            customThemes.forEach((t, i) => {
                const cacheKey = t.file_url;
                const fetchUrl = themeMediaFetchUrl(t);
                if (!cacheKey || !fetchUrl) return;
                cacheThemeBlob(cacheKey, fetchUrl).then((blobUrl) => {
                    const card = grid.children[i];
                    if (!card || !blobUrl) return;
                    if (t.media_type === 'video') {
                        const video = card.querySelector('video');
                        if (video) video.src = blobUrl;
                        return;
                    }
                    const thumbEl = card.querySelector('.theme-thumb');
                    if (thumbEl) {
                        thumbEl.style.backgroundImage = `url('${blobUrl}')`;
                    }
                }).catch(() => {});
            });
        }

        function drawThemeGallery() {
            const wg = document.getElementById('theme-grid');
            if (!wg) return;
            const builtinActive = setCustomThemeId === null;
            wg.innerHTML = THEMES.map((t, i) => {
                const thumb = themeDisplayUrl(t.u);
                return `
        <div class="mode-card ${builtinActive && i===setThemeIdx?'active':''}" onclick="selTheme(${i})">
          <div class="theme-thumb" style="height:110px;background:url('${thumb}') center/cover;background-color:#e2e8f0"></div>
          <div class="mode-txt">
            <div class="mode-name">${t.n}</div>
            <div class="mode-desc">${t.d}</div>
          </div>
          <div class="mode-chk"><i class="fa fa-check"></i></div>
        </div>`;
            }).join('');

            THEMES.forEach((t, i) => {
                loadThemeImage(t.u).then((img) => {
                    const card = wg.children[i];
                    if (!card) return;
                    const thumbEl = card.querySelector('.theme-thumb');
                    if (thumbEl && img._blobUrl) {
                        thumbEl.style.backgroundImage = `url('${img._blobUrl}')`;
                    }
                }).catch(() => {});
            });
        }

        function selTheme(idx) {
            setCustomThemeId = null;
            setCustomThemeKey = null;
            setThemeMediaType = 'image';
            setThemeIdx = idx;
            drawThemeGallery();
            drawCustomThemeGallery();
            applyBuiltinTheme(idx);
            saveSettings();
        }

        function selCustomTheme(themeId) {
            setCustomThemeId = themeId;
            setThemeIdx = defaultThemeIndex();
            drawThemeGallery();
            drawCustomThemeGallery();
            applyCustomThemeById(themeId);
            saveSettings();
        }

        window.selCustomTheme = selCustomTheme;

        function computeThemeColors(imageUrl, callback) {
            if (themeLumCache.has(imageUrl)) {
                callback(themeLumCache.get(imageUrl));
                return;
            }

            const run = (img) => {
                try {
                    const c = document.createElement('canvas');
                    c.width = 64;
                    c.height = 64;
                    const ctx = c.getContext('2d');
                    if (!ctx) {
                        callback(0.55);
                        return;
                    }
                    ctx.drawImage(img, 0, 0, 64, 64);
                    const d = ctx.getImageData(0, 0, 64, 64).data;
                    let total = 0,
                        n = 0;
                    for (let i = 0; i < d.length; i += 16) {
                        const r = d[i] / 255,
                            g = d[i + 1] / 255,
                            b = d[i + 2] / 255;
                        total += 0.2126 * r + 0.7152 * g + 0.0722 * b;
                        n++;
                    }
                    const lum = n > 0 ? total / n : 0.55;
                    themeLumCache.set(imageUrl, lum);
                    callback(lum);
                } catch (e) {
                    callback(0.55);
                }
            };

            loadThemeImage(imageUrl).then(run).catch(() => callback(0.55));
        }

        function applyTextColorsForBrightness(lum) {
            const r = document.documentElement;
            if (lum > 0.55) {
                r.style.setProperty('--text-primary', '#1B1B1F');
                r.style.setProperty('--text-secondary', '#3E3E45');
                r.style.setProperty('--text-tertiary', '#6A6A75');
                r.style.setProperty('--text-quaternary', '#9090A0');
            } else {
                r.style.setProperty('--text-primary', '#F2F2F8');
                r.style.setProperty('--text-secondary', '#D6D6E4');
                r.style.setProperty('--text-tertiary', '#AEAEC0');
                r.style.setProperty('--text-quaternary', '#8A8A9E');
            }
        }

        function resetTextColors() {
            const r = document.documentElement;
            r.style.removeProperty('--text-primary');
            r.style.removeProperty('--text-secondary');
            r.style.removeProperty('--text-tertiary');
            r.style.removeProperty('--text-quaternary');
        }

        function paintWallpaper(url) {
            clearVideoBackground();
            const paintUrl = themeDisplayUrl(url) || url;
            document.documentElement.style.setProperty('--bg-url', `url('${paintUrl}')`);
            document.body.classList.add('modern-mode');
            document.documentElement.classList.add('modern-mode');
            const mainEl = document.getElementById('main');
            if (mainEl) mainEl.classList.add('theme-active');
        }

        function paintVideoWallpaper(playUrl, cacheKey) {
            const video = getBgVideoEl();
            if (!video || !playUrl) return;

            bindVideoBackgroundEvents(video);

            document.body.classList.add('modern-mode');
            document.documentElement.classList.add('modern-mode');
            document.documentElement.style.setProperty('--bg-url', 'none');
            const mainEl = document.getElementById('main');
            if (mainEl) mainEl.classList.add('theme-active');

            if (activeVideoCacheKey === cacheKey && activeVideoPlayUrl === playUrl && video.src) {
                document.body.classList.add('ed-bg-video-active');
                if (!prefersReducedMotion() && !document.hidden) {
                    video.play().catch(() => {});
                }
                return;
            }

            activeVideoCacheKey = cacheKey;
            activeVideoPlayUrl = playUrl;
            videoLuminanceSampled = false;

            if (video.src !== playUrl) {
                video.src = playUrl;
            }

            try {
                video.load();
            } catch (e) {}

            document.body.classList.add('ed-bg-video-active');

            if (prefersReducedMotion() || document.hidden) {
                try {
                    video.pause();
                } catch (e) {}
                sampleVideoLuminance(video, cacheKey);
                return;
            }

            const startPlayback = () => {
                video.play().then(() => {
                    sampleVideoLuminance(video, cacheKey);
                }).catch(() => {
                    applyTextColorsForBrightness(0.45);
                });
            };

            if (video.readyState >= 2) {
                startPlayback();
            } else {
                video.addEventListener('canplay', startPlayback, {
                    once: true,
                    passive: true
                });
            }
        }

        function applyBuiltinTheme(idx) {
            const t = THEMES[idx];
            const mainEl = document.getElementById('main');
            if (!t) {
                if (mainEl) mainEl.classList.remove('theme-active');
                return;
            }

            setThemeMediaType = 'image';
            paintWallpaper(t.u);
            loadThemeImage(t.u).then((img) => {
                if (setCustomThemeId !== null || setThemeIdx !== idx) return;
                if (img._blobUrl) {
                    document.documentElement.style.setProperty('--bg-url', `url('${img._blobUrl}')`);
                }
                if (typeof img.decode === 'function') {
                    img.decode().catch(() => {});
                }
                computeThemeColors(t.u, applyTextColorsForBrightness);
            }).catch(() => {
                computeThemeColors(t.u, applyTextColorsForBrightness);
            });
        }

        function applyCustomThemeById(themeId) {
            const theme = customThemes.find((t) => t.id === themeId);
            if (!theme) {
                fetchCustomThemes(true).then(() => {
                    const retry = customThemes.find((t) => t.id === themeId);
                    if (retry) applyCustomTheme(retry);
                });
                return;
            }
            applyCustomTheme(theme);
        }

        function applyCustomTheme(theme) {
            if (!theme) return;

            setCustomThemeId = theme.id;
            setCustomThemeKey = theme.file_url;
            setThemeMediaType = theme.media_type === 'video' ? 'video' : 'image';

            const fetchUrl = themeMediaFetchUrl(theme);
            const cacheKey = theme.file_url;
            if (!fetchUrl || !cacheKey) return;

            if (setThemeMediaType === 'video') {
                applyTextColorsForBrightness(0.45);
                loadThemeVideo(cacheKey, fetchUrl).then((payload) => {
                    if (setCustomThemeId !== theme.id) return;
                    paintVideoWallpaper(payload.playUrl, payload.cacheKey);
                }).catch(() => {
                    applyTextColorsForBrightness(0.45);
                });
                return;
            }

            cacheThemeBlob(cacheKey, fetchUrl).then((blobUrl) => {
                if (setCustomThemeId !== theme.id) return;
                clearVideoBackground();
                document.documentElement.style.setProperty('--bg-url', `url('${blobUrl}')`);
                document.body.classList.add('modern-mode');
                document.documentElement.classList.add('modern-mode');
                const mainEl = document.getElementById('main');
                if (mainEl) mainEl.classList.add('theme-active');

                const img = new Image();
                img.onload = () => computeThemeColors(cacheKey, applyTextColorsForBrightness);
                img.onerror = () => applyTextColorsForBrightness(0.55);
                img.src = blobUrl;
            }).catch(() => {
                applyTextColorsForBrightness(0.55);
            });
        }

        function applyTheme(idx) {
            applyBuiltinTheme(idx);
        }

        function saveSettings() {
            const payload = {
                mode: 'modern',
                themeMediaType: setThemeMediaType
            };

            if (setCustomThemeId) {
                const ct = customThemes.find((t) => t.id === setCustomThemeId);
                payload.customThemeId = setCustomThemeId;
                payload.customThemeKey = setCustomThemeKey || (ct && ct.file_url) || null;
                payload.themeUrl = payload.customThemeKey || DEFAULT_THEME_URL;
                payload.theme = setThemeIdx;
            } else {
                const t = THEMES[setThemeIdx];
                payload.theme = setThemeIdx;
                payload.themeUrl = t ? t.u : DEFAULT_THEME_URL;
                payload.customThemeId = null;
                payload.customThemeKey = null;
            }

            localStorage.setItem('hr_portal_settings', JSON.stringify(payload));
        }

        function loadSettings() {
            const saved = localStorage.getItem('hr_portal_settings');
            if (saved) {
                try {
                    const s = JSON.parse(saved);
                    if (s.mode === 'classic') {
                        applyDefaultSettingsState();
                        saveSettings();
                    } else {
                        setModeState = 'modern';
                        setThemeIdx = (s.theme !== undefined && s.theme < THEMES.length) ? s.theme : defaultThemeIndex();
                        if (s.themeUrl && !s.customThemeId) {
                            const byUrl = THEMES.findIndex((t) => t.u === s.themeUrl);
                            if (byUrl >= 0) setThemeIdx = byUrl;
                        }
                        setCustomThemeId = s.customThemeId || null;
                        setCustomThemeKey = s.customThemeKey || null;
                        setThemeMediaType = s.themeMediaType === 'video' ? 'video' : 'image';
                    }

                    fetchCustomThemes().then(() => {
                        applySettingsFromState();
                    });
                    return;
                } catch (e) {
                    applyDefaultSettingsState();
                    fetchCustomThemes().then(() => applySettingsFromState());
                    return;
                }
            }

            applyDefaultSettingsState();
            fetchCustomThemes().then(() => applySettingsFromState());
        }

        // ═══════════════════════════════════════
        // INIT
        // ═══════════════════════════════════════
        document.addEventListener('ed-page-ready', function(ev) {
            const pageKey = ev.detail && ev.detail.pageKey;
            if (pageKey === 'home-tab-duty' && activeSeg === 1) {
                ensureDutySegReady();
            }
            if (pageKey === 'home-tab-leave' && activeSeg === 2) {
                ensureLeaveSegReady();
            }
        });

        document.addEventListener('DOMContentLoaded', () => {
            var edBoot = document.getElementById('ed-boot');
            if (edBoot) {
                edBoot.classList.add('is-done');
                setTimeout(function() {
                    edBoot.remove();
                }, 380);
