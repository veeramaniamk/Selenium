        var footerExtra = isOwn
            ? '<button type="button" class="ed-bday-greet-again-btn" id="ed-bday-greet-again">Celebrate again</button>'
            : '';

        if (isOwn && !skipEnvelope && !state.cardRevealed) {
            modal.innerHTML =
