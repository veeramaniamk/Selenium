                requester_bio: String(r.requester_bio || req.bio_id || ''),
                description: String(r.description || req.description || ''),
                requested_date: String(r.requested_date || req.requested_date || ''),
                location_display: String(r.location_display || req.location_name || req.location_code || '—'),
                selected_items: items,
                pending_items: items.length || r.pending_items || 0,
            };
        });
    }

    function normalizeHistoryRows(json) {
        var rows = json.rows || json.data || (json.consumable_approval && json.consumable_approval.rows) || [];
        if (!Array.isArray(rows)) return [];
        return rows.map(function (r) {
            return {
                cons_id: String(r.cons_id || r.request_id || ''),
                cid: String(r.cid || r.project_id || ('CONS-' + (r.cons_id || r.request_id || ''))),
                requester_name: String(r.requester_name || r.employee_name || r.bio_id || 'Unknown'),
                description: String(r.description || ''),
                requested_date: String(r.requested_date || ''),
                location_display: String(r.location_display || r.location_name || r.location_code || '—'),
                item_code: String(r.item_code || (r.selected_items && r.selected_items[0] && r.selected_items[0].item_code) || ''),
                item_description: String(r.item_description || r.item_summary || ''),
                quantity: String(r.quantity || ''),
                issue_type: String(r.issue_type || ''),
                status: String(r.status || ''),
                action_date: String(r.action_date || ''),
            };
        });
    }

    function populateLocationFilter() {
        var select = document.getElementById('pa-filter-location');
        if (!select) return;
        var current = select.value;
        var set = {};
        (state.pending || []).concat(state.history || []).forEach(function (r) {
            if (r.location_display) set[r.location_display] = true;
        });
        var html = '<option value="">All Locations</option>';
        Object.keys(set).sort().forEach(function (loc) {
            html += '<option value="' + esc(loc) + '">' + esc(loc) + '</option>';
        });
        select.innerHTML = html;
        if (current && set[current]) select.value = current;
    }

    function filteredPendingRows() {
        var q = filters.search;
        return (state.pending || []).filter(function (r) {
            if (filters.location && (r.location_display || '') !== filters.location) return false;
            if (!q) return true;
            var hay = [
                r.cid, r.requester_name, r.requester_bio, r.description, r.location_display,
                (r.selected_items || []).map(function (it) { return it.item_code || ''; }).join(' '),
            ].join(' ').toLowerCase();
            return hay.indexOf(q) !== -1;
        });
    }

    function filteredHistoryRows() {
        var q = filters.search;
        return (state.history || []).filter(function (r) {
            if (filters.location && (r.location_display || '') !== filters.location) return false;
            if (filters.status && (r.status || '') !== filters.status) return false;
            if (!q) return true;
            var hay = [r.cid, r.requester_name, r.description, r.item_code, r.item_description, r.status].join(' ').toLowerCase();
            return hay.indexOf(q) !== -1;
        });
    }

    function rowActionButtons(consId, suffix) {
        return '<button type="button" class="pa-view-btn js-cons-approve-all" data-cons-id="' + esc(consId) + '" data-sfx="' + esc(suffix) + '"><span aria-hidden="true" class="me-1">✓</span>Approve All</button>'
            + '<button type="button" class="pa-view-btn js-cons-reject-all" data-cons-id="' + esc(consId) + '" data-sfx="' + esc(suffix) + '" style="margin-left:6px;border-color:#fca5a5;color:#991b1b"><span aria-hidden="true" class="me-1">✕</span>Reject All</button>'
            + '<button type="button" class="pa-view-btn js-cons-add-item" data-cons-id="' + esc(consId) + '" data-sfx="' + esc(suffix) + '" style="margin-left:6px"><span aria-hidden="true" class="me-1">＋</span>Add Item</button>';
    }

    function itemRowsHtml(req, suffix) {
        var items = req.selected_items || [];
        if (!items.length) {
            return '<tr><td colspan="8" class="pa-empty-cell" style="padding:14px">No pending items</td></tr>';
        }
        return items.map(function (it, idx) {
            var code = String(it.item_code || '');
            var qty = Number(it.quantity || 0);
            var issue = String(it.uom_individual_name || it.issue_type || it.uom_bulk_name || '');
            return '<tr data-item-code="' + esc(code) + '" data-is-new="0">'
                + '<td class="pa-sno">' + (idx + 1) + '</td>'
                + '<td class="pa-pid">' + esc(code) + '</td>'
                + '<td class="pa-wrap-cell">' + esc(String(it.description || '—')) + '</td>'
                + '<td class="pa-cell">' + esc(String(qty)) + '</td>'
                + '<td class="pa-cell"><input type="number" min="0" class="form-control form-control-sm js-cons-qty" value="' + esc(String(qty)) + '" style="max-width:90px"></td>'
                + '<td class="pa-cell"><input type="text" class="form-control form-control-sm js-cons-issue" value="' + esc(issue) + '" readonly style="max-width:150px"></td>'
                + '<td class="pa-actions">'
                + '<button type="button" class="pa-view-btn js-cons-item-approve" data-code="' + esc(code) + '" data-cons-id="' + esc(req.cons_id) + '" data-sfx="' + esc(suffix) + '" title="Approve item"><span aria-hidden="true">✓</span></button>'
                + '<button type="button" class="pa-view-btn js-cons-item-reject" data-code="' + esc(code) + '" data-cons-id="' + esc(req.cons_id) + '" data-sfx="' + esc(suffix) + '" title="Reject item" style="margin-left:6px;border-color:#fca5a5;color:#991b1b"><span aria-hidden="true">✕</span></button>'
                + '</td>'
                + '<td></td>'
                + '</tr>';
        }).join('');
    }

    function renderPending() {
        var head = document.getElementById('appr-head');
        var body = document.getElementById('appr-body');
        if (!head || !body) return;
        var rows = filteredPendingRows();

        head.innerHTML = '<tr><th class="pa-sno">S.NO</th><th>CID</th><th>REQUESTER</th><th>DESCRIPTION</th><th>LOCATION</th><th>PENDING</th><th class="pa-actions">ACTIONS</th><th></th></tr>';
        if (!rows.length) {
            body.innerHTML = '<tr><td colspan="8" class="pa-empty-cell">No pending consumable approvals found</td></tr>';
            return;
        }

        body.innerHTML = rows.map(function (r, i) {
            var sfx = 'cons_' + i + '_' + String(r.cons_id || '');
            return '<tr>'
                + '<td class="pa-sno">' + (i + 1) + '</td>'
                + '<td class="pa-pid">' + esc(r.cid) + '</td>'
                + '<td class="pa-wrap-cell">' + esc(r.requester_name) + (r.requester_bio ? (' <span class="pa-cell">(' + esc(r.requester_bio) + ')</span>') : '') + '</td>'
                + '<td class="pa-wrap-cell">' + esc(r.description || '—') + '</td>'
                + '<td class="pa-loc">' + esc(r.location_display || '—') + '</td>'
                + '<td class="pa-cell">' + esc(String(r.pending_items || 0)) + '</td>'
                + '<td class="pa-actions">' + rowActionButtons(r.cons_id, sfx) + '</td>'
                + '<td class="pa-actions"><button type="button" class="pa-view-btn js-cons-toggle" data-target="' + esc(sfx) + '" aria-expanded="false" title="Expand items"><span class="js-cons-toggle-ico" aria-hidden="true">▾</span></button></td>'
                + '</tr>'
                + '<tr id="' + esc(sfx) + '" class="pa-cons-detail-row" hidden><td colspan="8" class="pa-cons-detail-cell">'
                + '<div class="pa-cons-detail-wrap"><table class="att-tbl pa-tbl pa-cons-items"><thead>'
                + '<tr><th class="pa-sno">#</th><th>ITEM CODE</th><th>DESCRIPTION</th><th>REQ</th><th>REVISED</th><th>ISSUE TYPE</th><th class="pa-actions">ACTION</th><th></th></tr>'
                + '</thead><tbody>' + itemRowsHtml(r, sfx) + '</tbody></table></div>'
                + '</td></tr>';
        }).join('');

        wirePendingActions();
    }

    function renderHistory() {
        var head = document.getElementById('appr-head');
        var body = document.getElementById('appr-body');
        if (!head || !body) return;
        var rows = filteredHistoryRows();
        head.innerHTML = '<tr><th class="pa-sno">S.NO</th><th>CID</th><th>REQUESTER</th><th>ITEM</th><th>QTY</th><th>UOM</th><th>STATUS</th><th>DATE</th></tr>';
        if (!rows.length) {
            body.innerHTML = '<tr><td colspan="8" class="pa-empty-cell">No consumable history found</td></tr>';
            return;
        }
        body.innerHTML = rows.map(function (r, i) {
            return '<tr>'
                + '<td class="pa-sno">' + (i + 1) + '</td>'
                + '<td class="pa-pid">' + esc(r.cid) + '</td>'
                + '<td class="pa-wrap-cell">' + esc(r.requester_name) + '</td>'
                + '<td class="pa-wrap-cell"><div><strong>' + esc(r.item_code) + '</strong></div><div class="pa-cell">' + esc(r.item_description || '—') + '</div></td>'
                + '<td class="pa-cell">' + esc(r.quantity) + '</td>'
                + '<td class="pa-cell">' + esc(r.issue_type || '—') + '</td>'
                + '<td class="pa-cell">' + (String(r.status).toLowerCase() === 'approved' ? '<span class="sp sp-approved">Approved</span>' : '<span class="sp sp-rejected">Rejected</span>') + '</td>'
                + '<td class="pa-cell">' + esc(r.action_date || r.requested_date || '—') + '</td>'
                + '</tr>';
        }).join('');
    }

    function collectRowItems(detailRow) {
        var out = [];
        detailRow.querySelectorAll('tbody tr').forEach(function (tr) {
            var code = tr.getAttribute('data-item-code') || '';
            if (!code) return;
            var qty = (tr.querySelector('.js-cons-qty') || {}).value || '0';
            var issue = (tr.querySelector('.js-cons-issue') || {}).value || '';
            out.push({ item_code: code, new_quantity: qty, issue_type: issue });
        });
        return out;
    }

    function sendAction(payload, btn) {
        if (btn) btn.disabled = true;
        return fetchJson(API.action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(payload),
        }).finally(function () {
            if (btn) btn.disabled = false;
        });
    }

    function wirePendingActions() {
        if (pendingActionBound) return;
        pendingActionBound = true;
        var body = document.getElementById('appr-body');
        if (!body) return;

        body.addEventListener('click', function (ev) {
            var btn = ev.target && ev.target.closest ? ev.target.closest('button') : null;
            if (!btn) return;

            if (btn.classList.contains('js-cons-toggle')) {
                var id = btn.getAttribute('data-target');
                var tr = document.getElementById(id);
                if (!tr) return;
                var shouldOpen = tr.hasAttribute('hidden');
                if (shouldOpen) {
                    tr.removeAttribute('hidden');
                    btn.setAttribute('aria-expanded', 'true');
                    btn.classList.add('is-open');
                    var openIco = btn.querySelector('.js-cons-toggle-ico');
                    if (openIco) openIco.textContent = '▴';
                } else {
                    tr.setAttribute('hidden', 'hidden');
                    btn.setAttribute('aria-expanded', 'false');
                    btn.classList.remove('is-open');
                    var closeIco = btn.querySelector('.js-cons-toggle-ico');
                    if (closeIco) closeIco.textContent = '▾';
                }
                return;
            }

            if (btn.classList.contains('js-cons-approve-all')) {
                var consIdA = btn.getAttribute('data-cons-id');
                var detailA = document.getElementById(btn.getAttribute('data-sfx'));
                if (!consIdA || !detailA) return;
                var itemsA = collectRowItems(detailA);
                sendAction({ action: 'approve_all', cons_id: consIdA, items: itemsA }, btn).then(refreshAll).catch(function (e) { showError(e.message); });
                return;
            }

            if (btn.classList.contains('js-cons-reject-all')) {
                var consIdR = btn.getAttribute('data-cons-id');
                var detailR = document.getElementById(btn.getAttribute('data-sfx'));
                if (!consIdR || !detailR) return;
                var itemsR = collectRowItems(detailR);
                sendAction({ action: 'reject_all', cons_id: consIdR, items: itemsR }, btn).then(refreshAll).catch(function (e) { showError(e.message); });
                return;
            }

            if (btn.classList.contains('js-cons-item-approve')) {
                var consIdI = btn.getAttribute('data-cons-id');
                var trI = btn.closest('tr');
                if (!consIdI || !trI) return;
                var codeI = trI.getAttribute('data-item-code') || '';
                var qtyI = (trI.querySelector('.js-cons-qty') || {}).value || '0';
                var issueI = (trI.querySelector('.js-cons-issue') || {}).value || '';
                var isNewI = trI.getAttribute('data-is-new') === '1';
                var actionI = isNewI ? 'append_items' : 'approve_item';
                sendAction({ action: actionI, cons_id: consIdI, items: [{ item_code: codeI, new_quantity: qtyI, issue_type: issueI }] }, btn)
                    .then(refreshAll).catch(function (e) { showError(e.message); });
                return;
            }

            if (btn.classList.contains('js-cons-item-reject')) {
                var consIdJ = btn.getAttribute('data-cons-id');
                var trJ = btn.closest('tr');
                if (!consIdJ || !trJ) return;
                var isNewJ = trJ.getAttribute('data-is-new') === '1';
                if (isNewJ) {
                    trJ.remove();
                    return;
                }
                var codeJ = trJ.getAttribute('data-item-code') || '';
                var qtyJ = (trJ.querySelector('.js-cons-qty') || {}).value || '0';
                var issueJ = (trJ.querySelector('.js-cons-issue') || {}).value || '';
                sendAction({ action: 'reject_item', cons_id: consIdJ, items: [{ item_code: codeJ, new_quantity: qtyJ, issue_type: issueJ }] }, btn)
                    .then(refreshAll).catch(function (e) { showError(e.message); });
                return;
            }

            if (btn.classList.contains('js-cons-add-item')) {
                var consIdAdd = btn.getAttribute('data-cons-id');
                var detailId = btn.getAttribute('data-sfx');
                if (!consIdAdd || !detailId) return;
                openAddItemModal(consIdAdd, detailId);
            }
        });
    }

    function ensureAddModal() {
        if (document.getElementById('cons-add-item-modal')) return;
        var html = '<div class="modal fade" id="cons-add-item-modal" tabindex="-1" aria-hidden="true">'
            + '<div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">'
            + '<div class="modal-header"><h5 class="modal-title">Add Consumable Item</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>'
            + '<div class="modal-body"><div class="row g-2">'
            + '<div class="col-md-6"><input type="text" id="cons-add-search" class="form-control" placeholder="Search item code or description..."><div id="cons-add-results" class="mt-2" style="max-height:240px;overflow:auto;border:1px solid #e2e8f0;border-radius:8px"></div></div>'
            + '<div class="col-md-6"><div id="cons-add-selected" class="pa-cell">No item selected</div>'
            + '<label class="mt-2 pa-cell">Quantity</label><input type="number" min="1" id="cons-add-qty" class="form-control" value="1">'
            + '<label class="mt-2 pa-cell">Issue Type (Individual UOM)</label><input type="text" id="cons-add-issue" class="form-control" placeholder="Auto-filled from individual UOM" readonly></div>'
            + '</div></div>'
            + '<div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="cons-add-confirm">Add</button></div>'
            + '</div></div></div>';
        var wrap = document.createElement('div');
        wrap.innerHTML = html;
        document.body.appendChild(wrap.firstChild);
    }

    function openAddItemModal(consId, detailId) {
        ensureAddModal();
        selectedAddItem = null;
        var modalEl = document.getElementById('cons-add-item-modal');
        addModal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
        var resBox = document.getElementById('cons-add-results');
        var search = document.getElementById('cons-add-search');
        var selected = document.getElementById('cons-add-selected');
        var confirmBtn = document.getElementById('cons-add-confirm');
        var qtyEl = document.getElementById('cons-add-qty');
        var issueEl = document.getElementById('cons-add-issue');
        selected.textContent = 'No item selected';
        resBox.innerHTML = '';
        search.value = '';
        qtyEl.value = '1';
        issueEl.value = '';

        var timer = null;
        search.oninput = function () {
            clearTimeout(timer);
            timer = setTimeout(function () {
                var q = (search.value || '').trim();
                if (!q) { resBox.innerHTML = ''; return; }
                fetchJson(API.itemCodes + '?q=' + encodeURIComponent(q) + '&limit=30')
                    .then(function (json) {
                        var rows = json.rows || [];
                        if (!rows.length) {
                            resBox.innerHTML = '<div class="pa-empty-cell" style="padding:10px">No results</div>';
                            return;
                        }
                        resBox.innerHTML = rows.map(function (r) {
                            return '<button type="button" class="btn btn-link text-start w-100 js-cons-result" data-code="' + esc(r.item_code) + '" data-desc="' + esc(r.description || '') + '" style="padding:8px 10px;border-bottom:1px solid #f1f5f9;text-decoration:none">'
                                + '<div><strong>' + esc(r.item_code) + '</strong></div><div class="pa-cell">' + esc(r.description || '') + '</div></button>';
                        }).join('');
                        resBox.querySelectorAll('.js-cons-result').forEach(function (b) {
                            b.addEventListener('click', function () {
                                selectedAddItem = { item_code: b.getAttribute('data-code') || '', description: b.getAttribute('data-desc') || '' };
                                selected.innerHTML = '<strong>' + esc(selectedAddItem.item_code) + '</strong><div class="pa-cell">' + esc(selectedAddItem.description) + '</div>';
                                fetchJson(API.itemUom + '?item_code=' + encodeURIComponent(selectedAddItem.item_code))
                                    .then(function (u) {
                                        if (u.success) {
                                            issueEl.value = u.uom_individual_name || u.uom_bulk_name || '';
                                        }
                                    }).catch(function () {});
                            });
                        });
                    })
                    .catch(function (e) {
                        resBox.innerHTML = '<div class="pa-empty-cell" style="padding:10px">' + esc(e.message) + '</div>';
                    });
            }, 260);
        };

        confirmBtn.onclick = function () {
            if (!selectedAddItem || !selectedAddItem.item_code) return;
            var detailRow = document.getElementById(detailId);
            if (!detailRow) return;
            var tbody = detailRow.querySelector('tbody');
            if (!tbody) return;
            var qty = Number(qtyEl.value || '0');
            var issue = (issueEl.value || '').trim();
            if (qty <= 0 || !issue) return;

            var exists = !!tbody.querySelector('tr[data-item-code="' + CSS.escape(selectedAddItem.item_code) + '"]');
            if (exists) return;

            var idx = tbody.querySelectorAll('tr').length + 1;
            var tr = document.createElement('tr');
            tr.setAttribute('data-item-code', selectedAddItem.item_code);
            tr.setAttribute('data-is-new', '1');
            tr.innerHTML = '<td class="pa-sno">' + idx + '</td>'
                + '<td class="pa-pid">' + esc(selectedAddItem.item_code) + '</td>'
                + '<td class="pa-wrap-cell">' + esc(selectedAddItem.description || '—') + '</td>'
                + '<td class="pa-cell">' + esc(String(qty)) + '</td>'
                + '<td class="pa-cell"><input type="number" min="0" class="form-control form-control-sm js-cons-qty" value="' + esc(String(qty)) + '" style="max-width:90px"></td>'
                + '<td class="pa-cell"><input type="text" class="form-control form-control-sm js-cons-issue" value="' + esc(issue) + '" readonly style="max-width:150px"></td>'
                + '<td class="pa-actions">'
                + '<button type="button" class="pa-view-btn js-cons-item-approve" data-code="' + esc(selectedAddItem.item_code) + '" data-cons-id="' + esc(consId) + '" data-sfx="' + esc(detailId) + '" title="Approve item"><span aria-hidden="true">✓</span></button>'
                + '<button type="button" class="pa-view-btn js-cons-item-reject" data-code="' + esc(selectedAddItem.item_code) + '" data-cons-id="' + esc(consId) + '" data-sfx="' + esc(detailId) + '" title="Remove row" style="margin-left:6px;border-color:#fca5a5;color:#991b1b"><span aria-hidden="true">✕</span></button>'
                + '</td><td></td>';
            tbody.appendChild(tr);
            wirePendingActions();
            addModal.hide();
        };

        addModal.show();
    }

    function renderTable() {
        if (!isConsumableActive()) {
            toggleToolbar(false);
            return false;
        }
        toggleToolbar(true);
        toggleFilterFields();
        readFilters();

        if (!loaded) {
            showLoading('Loading consumable approvals...');
            return true;
        }
        if ((typeof window.apprTabSt !== 'undefined' ? window.apprTabSt : 'pending') === 'history') {
            renderHistory();
        } else {
            renderPending();
        }
        return true;
    }

    function loadPending(silent) {
        if (loading) return Promise.resolve();
        loading = true;
        return fetchJson(API.pending)
            .catch(function () {
                return fetchJson('/api/employee/consumable-approvals.php?action=pending');
            })
            .then(function (json) {
                state.pending = normalizePendingRows(json);
                state.counts.pending = state.pending.length;
                loaded = true;
                updateBadge();
                populateLocationFilter();
                if (!silent && isConsumableActive()) renderTable();
            })
            .catch(function (e) {
                loaded = true;
                showError(e.message || 'No pending consumable requests found.');
            })
            .finally(function () { loading = false; });
    }

    function loadHistory(silent) {
        return fetchJson(API.history)
            .catch(function () {
                return fetchJson('/api/employee/consumable-approvals.php?action=history');
            })
            .then(function (json) {
                state.history = normalizeHistoryRows(json);
                state.counts.history = state.history.length;
                historyLoaded = true;
                if (!silent && isConsumableActive()) renderTable();
            })
            .catch(function (e) {
                if (window.edLogApprovalFailure) {
                    window.edLogApprovalFailure('[EDConsumableApproval] history', e, !!silent);
                }
                historyLoaded = true;
            });
    }

    function refreshAll() {
        return loadPending(true).then(function () { return loadHistory(true); }).then(function () {
            if (isConsumableActive()) renderTable();
        });
    }

    function ensureLoaded() {
        if (loaded) return Promise.resolve();
        showLoading('Loading consumable approvals...');
        return loadPending(true).then(function () { return loadHistory(true); }).then(function () {
            if (isConsumableActive()) renderTable();
        });
    }

    function onConsumableTab() {
        return ensureLoaded().then(function () {
            if (isConsumableActive()) renderTable();
        });
    }

    function onFilterChange() {
        if (isConsumableActive()) renderTable();
    }

    function getPendingCount() {
        return state.counts.pending || 0;
    }

    function schedulePrefetch() {
        if (prefetchStarted) return;
        prefetchStarted = true;
        var run = function () {
            loadPending(true);
        };
        if (typeof window.requestIdleCallback === 'function') {
            window.requestIdleCallback(run, { timeout: 2500 });
        } else {
            setTimeout(run, 500);
        }
    }

    function init() {
        /* data loads on first tab visit via ensureLoaded */
    }

    window.EDConsumableApproval = {
        init: init,
        ensureLoaded: ensureLoaded,
        onConsumableTab: onConsumableTab,
        renderConsumableTable: renderTable,
        getPendingCount: getPendingCount,
        isLoaded: function () { return loaded; },
        onFilterChange: onFilterChange,
        prefetch: schedulePrefetch,
    };
})();



