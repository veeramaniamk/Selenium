        var select = document.getElementById('pa-filter-location');
        if (!select || !window.ED_PURCHASE) return;

        var tab = typeof window.apprTabSt !== 'undefined' ? window.apprTabSt : 'pending';
        var rows = tab === 'history' ? (window.ED_PURCHASE.history || []) : (window.ED_PURCHASE.pending || []);
        var locations = {};
        rows.forEach(function (row) {
            var key = row.location_display || row.location_name || '';
            if (key) locations[key] = true;
        });

        var current = select.value;
        var html = '<option value="">All Locations</option>';
        Object.keys(locations).sort().forEach(function (loc) {
            html += '<option value="' + esc(loc) + '">' + esc(loc) + '</option>';
        });
        select.innerHTML = html;
        if (current && locations[current]) {
            select.value = current;
        }
    }

    function readFiltersFromUi() {
        filters.search = (document.getElementById('pa-search-input') || {}).value || '';
        filters.doa = (document.getElementById('pa-filter-doa') || {}).value || '';
        filters.location = (document.getElementById('pa-filter-location') || {}).value || '';
        filters.status = (document.getElementById('pa-filter-status') || {}).value || '';
    }

    function rowMatchesFilters(row, tab) {
        var q = filters.search.trim().toLowerCase();
        if (q) {
            var hay = [
                row.project_id,
                row.description,
                row.location_name,
                row.location_code,
                row.location_display,
                row.employee_name,
                row.bio_id,
                row.type_name,
            ].join(' ').toLowerCase();
            if (hay.indexOf(q) === -1) return false;
        }

        if (filters.doa && (row.doa_status || 'pending') !== filters.doa) {
            return false;
        }

        if (filters.location) {
            var loc = row.location_display || row.location_name || '';
            if (loc !== filters.location) return false;
        }

        if (tab === 'history' && filters.status && normalizeStatus(row.status) !== normalizeStatus(filters.status)) {
            return false;
        }

        return true;
    }

    function doaBadge(status, label) {
        var key = status || 'pending';
        var text = label || (key.charAt(0).toUpperCase() + key.slice(1));
        return '<span class="pa-doa-badge ' + esc(key) + '">' + esc(text) + '</span>';
    }

    function actionBadge(status) {
        var normalized = normalizeStatus(status);
        if (normalized === 'Approved') return '<span class="sp sp-approved">Approved</span>';
        if (normalized === 'Rejected') return '<span class="sp sp-rejected">Rejected</span>';
        return '<span class="sp">Pending</span>';
    }

    function findRowById(requestId, tab) {
        var state = window.ED_PURCHASE || defaultState();
        var rows = tab === 'history' ? (state.history || []) : (state.pending || []);
        var id = String(requestId);
        for (var i = 0; i < rows.length; i++) {
            if (String(rows[i].request_id || rows[i].id) === id) {
                return rows[i];
            }
        }
        return null;
    }

    function viewButton(row, tab) {
        return '<button type="button" class="pa-view-btn" data-request-id="' + esc(String(row.request_id || row.id)) + '" data-pa-tab="' + esc(tab) + '" onclick="EDPurchaseApproval.openDetailById(this)">'
            + '<i class="fa fa-eye fa-xs me-1"></i>View</button>';
    }

    function openDetailById(btn) {
        if (!btn) return;
        var requestId = btn.getAttribute('data-request-id');
        var tab = btn.getAttribute('data-pa-tab') || 'pending';
        var row = findRowById(requestId, tab);
        if (row) {
            openDetail(row, tab);
        }
    }

    function showLoadingRow(colspan) {
        var body = document.getElementById('appr-body');
        if (!body) return;
        body.innerHTML = approvalSkeletonRows(colspan, 6);
    }

    function approvalSkeletonRows(colspan, rows) {
        var out = '';
        var rCount = rows || 5;
        var cCount = Math.max(1, colspan || 1);
        for (var i = 0; i < rCount; i += 1) {
            out += '<tr class="pa-skel-row">';
            for (var c = 0; c < cCount; c += 1) {
                var w = c === 0 ? 'w-sm' : (c === 1 ? 'w-md' : (c === 2 ? 'w-lg' : 'w-md'));
                out += '<td><span class="ed-skel ed-skel-cell ' + w + '"></span></td>';
            }
            out += '</tr>';
        }
        return out;
    }

    function showError(message) {
        window.ED_PURCHASE = defaultState();
        window.ED_PURCHASE.error = message;
        var body = document.getElementById('appr-body');
        if (body && isPurchaseActive()) {
            body.innerHTML = '<tr><td colspan="7" class="pa-empty-cell">'
                + esc(message || 'Unable to load purchase approvals.') + '</td></tr>';
        }
        updatePurchaseBadge();
    }

    function renderPurchaseTable() {
        if (!isPurchaseActive()) {
            toggleToolbar(false);
            return false;
        }

        toggleToolbar(true);
        toggleFilterFields();
        readFiltersFromUi();

        var tab = typeof window.apprTabSt !== 'undefined' ? window.apprTabSt : 'pending';
        var head = document.getElementById('appr-head');
        var body = document.getElementById('appr-body');
        var statusFilter = document.getElementById('pa-filter-status');
        if (statusFilter) {
            statusFilter.style.display = tab === 'history' ? '' : 'none';
        }

        if (!head || !body) return true;

        var state = window.ED_PURCHASE || defaultState();

        if (!state.loaded && !state.error) {
            showLoadingRow(tab === 'history' ? 7 : 6);
            return true;
        }

        if (tab === 'pending') {
            head.innerHTML = '<tr>'
                + '<th class="pa-sno">S.NO</th>'
                + '<th>PROJECT ID</th>'
                + '<th>DESCRIPTION</th>'
                + '<th>LOCATION</th>'
                + '<th>DOA STATUS</th>'
                + '<th class="pa-actions">VIEW</th></tr>';

            var pendingRows = (state.pending || []).filter(function (row) {
                return rowMatchesFilters(row, 'pending');
            });

            if (!pendingRows.length) {
                body.innerHTML = '<tr><td colspan="6" class="pa-empty-cell">No pending requests found</td></tr>';
                return true;
            }

            body.innerHTML = pendingRows.map(function (row, index) {
                var amcBadge = row.is_amc
                    ? '<div style="margin-top:4px"><span style="padding:2px 8px;border-radius:99px;font-size:10px;font-weight:700;background:#2563eb;color:#fff">AMC</span></div>'
                    : '';
                var desc = row.description || row.det || '';

                return '<tr>'
                    + '<td class="pa-sno">' + (index + 1) + '</td>'
                    + '<td class="pa-pid">' + esc(row.project_id) + amcBadge + '</td>'
                    + '<td class="pa-wrap-cell">' + esc(desc) + '</td>'
                    + '<td class="pa-loc">' + esc(row.location_display || row.location_name || '—') + '</td>'
                    + '<td class="pa-cell">' + doaBadge(row.doa_status, row.doa_status_label) + '</td>'
                    + '<td class="pa-actions">' + viewButton(row, 'pending') + '</td>'
                    + '</tr>';
            }).join('');

            return true;
        }

        head.innerHTML = '<tr>'
            + '<th class="pa-sno">S.NO</th>'
            + '<th>PROJECT ID</th>'
            + '<th>DESCRIPTION</th>'
            + '<th>LOCATION</th>'
            + '<th>DOA STATUS</th>'
            + '<th>STATUS</th>'
            + '<th class="pa-actions">VIEW</th></tr>';

        if (!state.historyLoaded) {
            showLoadingRow(7);
            loadHistory(false);
            return true;
        }

        var historyRows = (state.history || []).filter(function (row) {
            return rowMatchesFilters(row, 'history');
        });

        if (!historyRows.length) {
            body.innerHTML = '<tr><td colspan="7" class="pa-empty-cell">No history found</td></tr>';
            return true;
        }

        body.innerHTML = historyRows.map(function (row, index) {
            var desc = row.description || row.det || '';
            return '<tr>'
                + '<td class="pa-sno">' + (index + 1) + '</td>'
                + '<td class="pa-pid">' + esc(row.project_id) + '</td>'
                + '<td class="pa-wrap-cell">' + esc(desc) + '</td>'
                + '<td class="pa-loc">' + esc(row.location_display || row.location_name || '—') + '</td>'
                + '<td class="pa-cell">' + doaBadge(row.doa_status, row.doa_status_label) + '</td>'
                + '<td class="pa-cell">' + actionBadge(row.status) + '</td>'
                + '<td class="pa-actions">' + viewButton(row, 'history') + '</td>'
                + '</tr>';
        }).join('');

        return true;
    }

    function findStepByPredicate(steps, predicate) {
        for (var i = 0; i < (steps || []).length; i++) {
            if (predicate(steps[i], i)) {
                return steps[i];
            }
        }
        return null;
    }

    function buildFallbackRequest(row) {
        if (!row) return null;
        return {
            request_id: row.request_id || row.id,
            project_id: row.project_id || '',
            description: row.description || row.det || '',
            location_code: row.location_code || '',
            location_name: row.location_name || '',
            location_display: row.location_display || row.location_name || '',
            employee_name: row.employee_name || row.req || '',
            bio_id: row.bio_id || '',
            approx_value_display: row.approx_value_display || row.amt || '',
            doa_status: row.doa_status || 'pending',
            doa_status_label: row.doa_status_label || 'Pending',
            type_name: row.type_name || '',
            status: row.status || row.stage_status || 'Pending',
            stage_status: row.stage_status || row.status || 'Pending',
            is_amc: !!row.is_amc,
            document_url: row.document_url || '',
            document_type: row.document_type || 'none',
        };
    }

    function setDetailError(message) {
        var errorEl = document.getElementById('pa-detail-error');
        if (!errorEl) return;
        if (message) {
            errorEl.textContent = message;
            errorEl.classList.add('is-visible');
        } else {
            errorEl.textContent = '';
            errorEl.classList.remove('is-visible');
        }
    }

    function showDetailLoading() {
        var loadingEl = document.getElementById('pa-detail-loading');
        var contentEl = document.getElementById('pa-detail-content');
        if (loadingEl) {
            loadingEl.classList.remove('is-hidden');
            loadingEl.innerHTML = 'Loading project details...';
        }
        if (contentEl) contentEl.classList.remove('is-open');
        setDetailError('');
    }

    function showDetailContent() {
        var loadingEl = document.getElementById('pa-detail-loading');
        var contentEl = document.getElementById('pa-detail-content');
        if (loadingEl) loadingEl.classList.add('is-hidden');
        if (contentEl) contentEl.classList.add('is-open');
    }

    function renderDetailData(block, row) {
        var request = (block && block.request) || buildFallbackRequest(row);
        var workflow = (block && block.workflow) || [];
        var boqItems = (block && block.boq_items) || [];

        try {
            renderOverviewPanel(request);
            renderWorkflowPanel(workflow, request);
            renderBoqPanel(boqItems);
        } catch (err) {
            console.error('[EDPurchaseApproval] renderDetailData', err);
            setDetailError('Some details could not be rendered. Please refresh and try again.');
        }

        var approveBtn = document.getElementById('pa-detail-approve-btn');
        if (approveBtn) {
            approveBtn.style.display = block && block.can_approve ? '' : 'none';
        }
    }

    function formatShortDate(value) {
        if (!value) return '—';
        var d = new Date(value);
        if (isNaN(d.getTime())) return '—';
        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    }

    function findStepByStage(steps, stageNumber) {
        for (var i = 0; i < (steps || []).length; i++) {
            if (parseInt(steps[i].stage, 10) === stageNumber) {
                return steps[i];
            }
        }
        return null;
    }

    function findCurrentPendingStep(steps) {
        for (var i = 0; i < (steps || []).length; i++) {
            var step = steps[i];
            if (normalizeStatus(step.status) !== 'Pending') {
                continue;
            }
            if (parseInt(step.stage, 10) === 1) {
                return step;
            }
            var prev = findStepByStage(steps, parseInt(step.stage, 10) - 1);
            if (prev && normalizeStatus(prev.status) === 'Approved') {
                return step;
            }
        }
        return null;
    }

    function resolveCurrentPendingStage(steps) {
        var step = findCurrentPendingStep(steps);
        return step ? parseInt(step.stage, 10) : null;
    }

    function resolveStepState(step, steps) {
        var status = normalizeStatus(step.status);
        if (status === 'Approved') return 'done';
        if (status === 'Rejected') return 'rejected';
        if (status === 'Pending') {
            return parseInt(step.stage, 10) === resolveCurrentPendingStage(steps) ? 'pending' : 'up';
        }
        return 'up';
    }

    function renderOverviewPanel(req) {
        var panel = document.getElementById('pa-detail-overview');
        if (!panel || !req) return;

        panel.innerHTML = '<div class="pa-info-grid">'
            + infoCard('Project ID', '<strong>' + esc(req.project_id || '—') + '</strong>' + (req.is_amc ? ' <span class="pa-doa-badge pending" style="margin-left:6px">AMC</span>' : ''))
            + infoCard('Category', esc(req.type_name || '—'))
            + infoCard('Requester', esc((req.employee_name || '—') + (req.bio_id ? ' (' + req.bio_id + ')' : '')))
            + infoCard('Location', esc(req.location_display || '—'))
            + '</div>'
            + '<div class="pa-info-card pa-info-desc">'
            + '<div class="lbl">Description</div>'
            + descriptionBlock(req.description)
            + '</div>';
    }

    function infoCard(label, value) {
        return '<div class="pa-info-card"><div class="lbl">' + esc(label) + '</div><div class="val">' + value + '</div></div>';
    }

    function stageReportHtml(step) {
        if (!step.report_url) return '';
        var icon = step.report_type === 'pdf' ? 'fa-file-pdf' : 'fa-file';
        return '<a href="' + esc(step.report_url) + '" target="_blank" rel="noopener noreferrer"'
            + ' style="display:inline-flex;align-items:center;gap:4px;font-size:10px;color:#2563eb;margin-top:4px;text-decoration:none">'
            + '<i class="fa ' + icon + '"></i> View Report</a>';
    }

    function renderWorkflowPanel(steps, req) {
        var panel = document.getElementById('pa-detail-workflow');
        if (!panel) return;

        var wfSub = document.getElementById('pa-wf-sub');
        var wfReq = document.getElementById('pa-wf-req');
        var wfDept = document.getElementById('pa-wf-dept');
        var wfAmt = document.getElementById('pa-wf-amt');
        var wfProg = document.getElementById('pa-wf-prog');
        var wfCnt = document.getElementById('pa-wf-cnt');
        var wfPend = document.getElementById('pa-wf-pend');

        if (req) {
            if (wfSub) wfSub.textContent = workflowSubtitle(req);
            if (wfReq) wfReq.textContent = req.employee_name || '—';
            if (wfDept) wfDept.textContent = truncateText(req.location_name || req.type_name || '—', 42);
            if (wfAmt) wfAmt.textContent = req.approx_value_display || '—';
        }

        if (!steps || !steps.length) {
            panel.innerHTML = '<div style="padding:24px;color:#9ca3af;text-align:center;font-size:12px">No workflow data available</div>';
            if (wfProg) wfProg.style.width = '0%';
            if (wfCnt) wfCnt.textContent = '0/0';
            if (wfPend) wfPend.textContent = '—';
            return;
        }

        var done = steps.filter(function (s) { return normalizeStatus(s.status) === 'Approved'; }).length;
        var rejected = steps.some(function (s) { return normalizeStatus(s.status) === 'Rejected'; });
        var progress = Math.round((done / steps.length) * 100);
        if (wfProg) wfProg.style.width = progress + '%';
        if (wfCnt) wfCnt.textContent = done + '/' + steps.length;

        var currentPending = findCurrentPendingStep(steps);
        if (wfPend) {
            if (currentPending) {
                var approver = currentPending.head_name && currentPending.head_name !== 'N/A'
                    ? currentPending.head_name
                    : 'Approver';
                var approverId = currentPending.head_id ? ' (' + currentPending.head_id + ')' : '';
                wfPend.textContent = approver + approverId + ' — Stage ' + currentPending.stage;
            } else if (rejected) {
                wfPend.textContent = 'Rejected';
            } else if (done === steps.length) {
                wfPend.textContent = 'All stages completed';
            } else {
                wfPend.textContent = 'None';
            }
        }

        var dotCfg = {
            done: { bg: 'linear-gradient(180deg,#4ade80,#22c55e)', border: '#16a34a', icon: 'fa-check' },
            pending: { bg: 'linear-gradient(180deg,#fbbf24,#f59e0b)', border: '#d97706', icon: 'fa-clock' },
            rejected: { bg: 'linear-gradient(180deg,#f87171,#ef4444)', border: '#dc2626', icon: 'fa-times' },
            up: { bg: '#e5e7eb', border: '#d1d5db', icon: 'fa-circle' },
        };

        panel.innerHTML = steps.map(function (step, index) {
            var st = resolveStepState(step, steps);
            var c = dotCfg[st] || dotCfg.up;
            var dateLabel = formatShortDate(step.action_date);
            var title = 'Stage ' + step.stage + ' Approval';
            var roleLine = esc(step.head_name || 'N/A') + (step.head_id ? ' — ' + esc(step.head_id) : '');
            var rem = '';
            if (normalizeStatus(step.status) === 'Approved') {
                rem = 'Approved at this stage.';
            } else if (normalizeStatus(step.status) === 'Rejected' && step.reject_reason) {
                rem = esc(step.reject_reason);
            } else if (st === 'pending') {
                rem = 'Awaiting approval at this stage.';
            }

            return '<div class="wf-step d-flex ' + (st === 'up' ? 'opacity-50' : '') + (st === 'rejected' ? ' rejected' : '') + '">'
                + '<div class="wf-date">' + esc(dateLabel) + '</div>'
                + '<div class="wf-mid">'
                + '<div class="wf-dot' + (st === 'rejected' ? ' rejected-dot' : '') + '" style="background:' + c.bg + ';border:1.5px solid ' + c.border + '">'
                + '<i class="fa ' + c.icon + '" style="font-size:8px"></i></div>'
                + (index < steps.length - 1 ? '<div class="wf-vline ' + (st === 'done' ? 'done' : '') + '"></div>' : '')
                + '</div>'
                + '<div class="wf-body">'
                + '<div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">'
                + '<span style="font-size:12px;font-weight:700;color:#1a202c">' + esc(title) + '</span>'
                + (st === 'pending' ? '<span style="padding:1px 6px;background:#f59e0b;color:#fff;font-size:8px;font-weight:700;border-radius:99px;text-transform:uppercase">Current</span>' : '')
                + (st === 'rejected' ? '<span style="padding:1px 6px;background:#ef4444;color:#fff;font-size:8px;font-weight:700;border-radius:99px;text-transform:uppercase">Rejected</span>' : '')
                + '</div>'
                + '<div style="font-size:10px;color:#9ca3af;margin-top:1px">' + roleLine + '</div>'
                + (rem ? '<div style="font-size:10px;color:#9ca3af;margin-top:3px;line-height:1.4">' + rem + '</div>' : '')
                + stageReportHtml(step)
                + '</div></div>';
        }).join('');
    }

    function filteredBoqItems(items) {
        var q = (detailState.boqFilter.search || '').trim().toLowerCase();
        var status = detailState.boqFilter.status || '';

        return (items || []).filter(function (item) {
            if (status && item.status !== status) return false;
            if (!q) return true;
            var hay = [item.item_code, item.description, item.unit_measure, item.approved_by_name, item.status].join(' ').toLowerCase();
            return hay.indexOf(q) !== -1;
        });
    }

    function renderBoqPanel(items) {
        var panel = document.getElementById('pa-detail-boq');
        if (!panel) return;

        var filtered = filteredBoqItems(items);

        panel.innerHTML = '<div class="pa-boq-filter">'
            + '<input type="text" class="boq-inp" id="pa-boq-search" placeholder="Search item code, description..." value="' + esc(detailState.boqFilter.search) + '" oninput="EDPurchaseApproval.onBoqFilterChange()">'
            + '<select class="boq-inp" id="pa-boq-status" style="width:auto;min-width:140px" onchange="EDPurchaseApproval.onBoqFilterChange()">'
            + '<option value="">All Item Status</option>'
            + '<option value="Approved"' + (detailState.boqFilter.status === 'Approved' ? ' selected' : '') + '>Approved</option>'
            + '<option value="Rejected"' + (detailState.boqFilter.status === 'Rejected' ? ' selected' : '') + '>Rejected</option>'
            + '<option value="Pending"' + (detailState.boqFilter.status === 'Pending' ? ' selected' : '') + '>Pending</option>'
            + '</select></div>'
            + '<div class="pa-boq-scroll" style="overflow-x:auto;border:1px solid rgba(0,0,0,.08);border-radius:10px">'
            + '<table class="pa-boq-tbl"><thead><tr>'
            + '<th>#</th><th>Code</th><th>Description</th><th>UOM</th><th>Qty</th><th>Unit</th><th>Total</th><th>Status</th></tr></thead>'
            + '<tbody>'
            + (filtered.length ? filtered.map(function (item, idx) {
                return '<tr><td data-label="#" style="white-space:nowrap">' + (idx + 1) + '</td>'
                    + '<td data-label="Code" style="white-space:nowrap"><strong>' + esc(item.item_code) + '</strong></td>'
                    + '<td data-label="Description" class="pa-wrap-cell">' + boqDescriptionCell(item.description, item.item_code || 'Item Description') + '</td>'
                    + '<td data-label="UOM" style="white-space:nowrap">' + esc(item.unit_measure || 'EA') + '</td>'
                    + '<td data-label="Qty" style="white-space:nowrap">' + esc(item.quantity) + '</td>'
                    + '<td data-label="Unit" style="white-space:nowrap">' + esc(item.item_price_display) + '</td>'
                    + '<td data-label="Total" style="white-space:nowrap"><strong>' + esc(item.total_display) + '</strong></td>'
                    + '<td data-label="Status" style="white-space:nowrap">' + actionBadge(item.status) + '</td></tr>';
            }).join('') : '<tr class="pa-empty-row"><td colspan="8" style="text-align:center;padding:28px;color:#9ca3af">No BOQ items found</td></tr>')
            + '</tbody></table></div>';
    }

    function openDetail(row, tab) {
        if (!row) return;

        var requestId = parseInt(row.request_id || row.id, 10);
        if (!requestId) return;

        detailState.row = row;
        detailState.data = null;
        detailState.boqFilter = { search: '', status: '' };

        var modalEl = document.getElementById('purchase-detail-modal');
        if (!modalEl) return;

        document.getElementById('pa-detail-title').textContent = 'Project ' + (row.project_id || requestId);
        document.getElementById('pa-detail-subtitle').textContent = modalSubtitle(row);

        setDetailError('');
        document.getElementById('pa-detail-overview').innerHTML = '';
        document.getElementById('pa-detail-workflow').innerHTML = '';
        document.getElementById('pa-detail-boq').innerHTML = '';

        var approveBtn = document.getElementById('pa-detail-approve-btn');
        if (approveBtn) approveBtn.style.display = 'none';

        if (!detailModal) {
            detailModal = new bootstrap.Modal(modalEl);
        }
        detailModal.show();

        showDetailContent();
        renderDetailData(null, row);

        var loadingEl = document.getElementById('pa-detail-loading');
        if (loadingEl) {
            loadingEl.classList.add('is-hidden');
        }

        fetchJson(apiUrl({ action: 'full_detail', request_id: requestId }))
            .then(function (data) {
                var block = (data && data.purchase_approval) || {};
                detailState.data = block;
                setDetailError('');
                renderDetailData(block, row);
            })
            .catch(function (err) {
                console.error('[EDPurchaseApproval] full_detail', err.message);
                setDetailError(err.message || 'Could not load full details. Showing available data.');
                renderDetailData(null, row);

                fetchJson(apiUrl({ action: 'workflow', request_id: requestId }))
                    .then(function (wfData) {
                        var steps = (wfData && wfData.purchase_approval && wfData.purchase_approval.steps) || [];
                        if (!detailState.data) detailState.data = {};
                        detailState.data.workflow = steps;
