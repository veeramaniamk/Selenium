        if (!isOwn) {
            greeting = {
                headline: (emp.first_name || emp.employee_name) + '\'s Birthday',
                message: 'Send a warm wish or view replies from your colleague.',
                university_message: 'Send a warm wish or view replies from your colleague.',
                institution: institution,
            };
        }

        var wishes = [];
