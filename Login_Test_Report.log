@media (max-width: 767px) {
    #conferenceDuplicateAuditModal .era-dialog,
    #conferenceDuplicateAuditModal .modal-dialog.era-dialog,
    #conferenceDuplicateAuditModal .modal-dialog.modal-xl {
        width: 100vw !important;
