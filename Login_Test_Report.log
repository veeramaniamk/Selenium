        /**
 * Employee Dashboard — global Bootstrap modal fixes.
 * Teleports modals to document.body (hidden .page parents break display)
 * and cleans up orphaned backdrops after close.
 */
(function () {
    'use strict';

    function portalModal(modal) {
        if (modal && modal.classList.contains('modal') && modal.parentElement !== document.body) {
            document.body.appendChild(modal);
        }
    }

    function portalAllModals() {
        document.querySelectorAll('.modal').forEach(portalModal);
    }

    function cleanupModalBody() {
        if (document.querySelector('.modal.show')) {
            return;
        }
        document.querySelectorAll('.modal-backdrop').forEach(function (el) {
            el.remove();
        });
        document.body.classList.remove('modal-open');
        document.body.style.removeProperty('overflow');
        document.body.style.removeProperty('padding-right');
    }

    document.addEventListener('show.bs.modal', function (e) {
        portalModal(e.target);
    });

    document.addEventListener('hidden.bs.modal', cleanupModalBody);

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', portalAllModals);
    } else {
        portalAllModals();
    }

    window.EDModalFix = {
        portal: portalModal,
        show: function (modalEl) {
            if (!modalEl || !window.bootstrap || !window.bootstrap.Modal) {
                return null;
            }
            portalModal(modalEl);
            var inst = window.bootstrap.Modal.getOrCreateInstance(modalEl);
            inst.show();
            return inst;
        }
    };
})();


