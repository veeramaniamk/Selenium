        }

        body.modern-mode p {
            color: var(--text-secondary) !important;
        }

        body.modern-mode select.finp option {
            background: #fff;
            color: var(--text-primary);
        }

        body.appearance-dark.modern-mode select.finp option {
            background: #2a2c3a;
            color: var(--text-primary);
        }

        body.modern-mode .pname,
        body.modern-mode .brand-name,
        body.modern-mode .hstat-vl {
