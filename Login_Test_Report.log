        pctEl = el.querySelector('[data-sp-pct]');
        fillEl = el.querySelector('[data-sp-fill]');
    }

    function setPercent(n) {
        percent = Math.max(1, Math.min(100, Math.round(n)));
        if (pctEl) {
            pctEl.innerHTML = String(percent) + '<span>%</span>';
        }
        if (fillEl) {
            fillEl.style.width = percent + '%';
        }
    }

    function pickMessage() {
