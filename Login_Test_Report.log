        /**
 * Employee Dashboard — shared runtime config and API URLs.
 * Uses direct .php paths (no nginx rewrite rules required).
 */
(function () {
    'use strict';

    window.ED_CONFIG = window.ED_CONFIG || {
        apiBase: '/api/employee',
    };

    window.edApprovalDenied = function edApprovalDenied(err) {
        var msg = String((err && err.message) || err || '');
        return msg.indexOf('Forbidden for your scope') !== -1;
    };

    window.edLogApprovalFailure = function edLogApprovalFailure(label, err, quiet) {
        if (quiet || window.edApprovalDenied(err)) return;
        console.error(label, (err && err.message) ? err.message : err);
    };

    window.edApiUrl = function edApiUrl(action, query) {
        var base = (window.ED_CONFIG && window.ED_CONFIG.apiBase) || '/api/employee';
        var name = String(action || '').replace(/^employee\./, '').replace(/\.php$/i, '');
        var url = base.replace(/\/$/, '') + '/' + encodeURIComponent(name) + '.php';

        if (query && typeof query === 'object') {
            var qs = new URLSearchParams(query).toString();
            if (qs) {
                url += (url.indexOf('?') >= 0 ? '&' : '?') + qs;
            }
        }

        return url;
    };

    /** Bind a handler once per element (safe after lazy page injection). */
    window.edWire = function edWire(el, event, handler, key) {
        if (!el || typeof handler !== 'function') return false;
        var token = String(key || event || 'default');
        var attr = 'data-ed-wire-' + token;
        if (el.hasAttribute(attr)) return false;
        el.setAttribute(attr, '1');
        el.addEventListener(event, handler);
        return true;
    };

    /** Re-bind lazy page controls; call from module onPage() after fragment mount. */
    window.edRewire = function edRewire(fn) {
        if (typeof fn === 'function') fn();
    };
})();


