        salaryTab: 'history',
    };

    function apiUrl(route, qs) {
        var base = (window.ED_CONFIG && window.ED_CONFIG.apiBase) || '/api/employee';
        var url = base.replace(/\/$/, '') + '/' + route + '.php';
        if (qs) {
            url += (url.indexOf('?') >= 0 ? '&' : '?') + qs;
        }
        return url;
    }

    function esc(s) {
        var el = document.createElement('span');
        el.textContent = s == null ? '' : String(s);
        return el.innerHTML;
    }

    function inr(n) {
        return new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(Number(n) || 0);
    }

    function fmtNum(n) {
        return new Intl.NumberFormat('en-IN').format(Number(n) || 0);
    }

    function labelFromKey(key) {
        return String(key).replace(/^earnings_/, '').replace(/_/g, ' ').toUpperCase();
    }

    function toast(msg, type) {
        if (window.EDToast) {
            if (type === 'error') window.EDToast.error(msg);
            else if (type === 'success') window.EDToast.success(msg);
            else window.EDToast.info(msg);
        }
    }

    async function fetchJson(url, opts) {
        var res = await fetch(url, Object.assign({ credentials: 'same-origin', headers: { Accept: 'application/json' } }, opts || {}));
        var json = await res.json().catch(function () { return { success: false }; });
        if (!res.ok || !json.success) {
            throw new Error((json && json.error) || 'Request failed');
        }
        return json.data;
    }

    function switchSalaryTab(tab) {
        state.salaryTab = tab || 'history';
        document.querySelectorAll('#page-salary .rep-salary-tab').forEach(function (btn) {
            btn.classList.toggle('active', btn.dataset.salaryTab === state.salaryTab);
        });
        document.querySelectorAll('#page-salary .rep-salary-pane').forEach(function (pane) {
            pane.classList.toggle('active', pane.id === 'rep-salary-pane-' + state.salaryTab);
        });
        if (state.salaryTab === 'history') loadSalary();
        if (state.salaryTab === 'allowance') loadAllowance();
    }

    function renderHistory(items) {
        var body = document.getElementById('rep-salary-history-body');
        if (!body) return;
        if (!items || !items.length) {
            body.innerHTML = '<tr><td colspan="4" class="rep-empty">No released payslips found.</td></tr>';
            return;
        }
        body.innerHTML = items.map(function (row) {
            return '<tr>' +
                '<td>' + esc(row.sno) + '</td>' +
                '<td>' + esc(row.period) + '</td>' +
                '<td>' + esc(row.total_ctc_formatted) + '</td>' +
                '<td><button type="button" class="rep-payable-link" data-period="' + esc(row.period) + '">' + esc(row.payable_salary_formatted) + '</button></td>' +
                '</tr>';
        }).join('');
        body.querySelectorAll('.rep-payable-link').forEach(function (btn) {
            btn.addEventListener('click', function () {
                openPayslip(btn.getAttribute('data-period'));
            });
        });
    }

    async function loadSalary() {
        var histBody = document.getElementById('rep-salary-history-body');
        if (histBody) histBody.innerHTML = '<tr><td colspan="4" class="rep-empty">Loading…</td></tr>';
        try {
            var histData = await fetchJson(apiUrl('salary', 'action=history'));
            renderHistory(histData.history.items);
        } catch (e) {
            if (histBody) histBody.innerHTML = '<tr><td colspan="4" class="rep-empty">' + esc(e.message) + '</td></tr>';
        }
    }

    async function loadAllowance() {
        var body = document.getElementById('rep-allowance-body');
        var notice = document.getElementById('rep-allowance-notice');
        if (body) body.innerHTML = '<tr><td colspan="5" class="rep-empty">Loading…</td></tr>';
        try {
            var data = await fetchJson(apiUrl('allowance'));
            if (notice) notice.textContent = data.notice || '';
            if (!data.allowances || !data.allowances.length) {
                body.innerHTML = '<tr><td colspan="5" class="rep-empty">No approved allowances found.</td></tr>';
                return;
            }
            body.innerHTML = data.allowances.map(function (r) {
                return '<tr><td>' + esc(r.sno) + '</td><td>' + esc(r.allowance_name) + '</td><td>' + esc(r.allowance_type) + '</td>' +
                    '<td>' + esc(r.allowance_amount_formatted) + '</td><td>' + esc(r.valid_upto) + '</td></tr>';
            }).join('');
        } catch (e) {
            if (body) body.innerHTML = '<tr><td colspan="5" class="rep-empty">' + esc(e.message) + '</td></tr>';
        }
    }

    function totalEarnings(data) {
        return Number(data.medical_exp_allowance || 0) + Number(data.internal_allowance || 0) +
            Number(data.external_allowance || 0) + Number(data.total_allowance_amount || 0) +
            Number(data.professional_consultancy || 0) + Number(data.clinical_research_incentive || 0) +
            Number(data.reimbursement || 0) + Number(data.over_time_credit || 0);
    }

    function totalDeductions(data) {
        return Number(data.total_lop_amount || 0) + Number(data.total_special_deduction || 0) +
            Number(data.other_deduction || 0) + Number(data.tds_form_16 || 0) + Number(data.pf_deduction || 0) +
            Number(data.esi_deduction || 0) + Number(data.tds_form_16a || 0) + Number(data.total_credit_lop || 0) +
            Number(data.eb_charges || 0);
    }

    function payslipTableRows(data) {
        var grossRows = '';
        var totalGross = 0;
        if (data.earnings) {
            Object.keys(data.earnings).forEach(function (k) {
                grossRows += '<tr><th>' + esc(labelFromKey(k)) + '</th><td class="amt">' + esc(inr(data.earnings[k])) + '</td></tr>';
                totalGross += Number(data.earnings[k]) || 0;
            });
        }
        grossRows += '<tr class="ps-total-row"><th>Total Gross Salary</th><td class="amt">' + esc(inr(totalGross)) + '</td></tr>';
        var earningsRows =
            '<tr><th>Internal Experience</th><td class="amt">' + esc(inr(data.internal_allowance)) + '</td></tr>' +
            '<tr><th>External Experience</th><td class="amt">' + esc(inr(data.external_allowance)) + '</td></tr>' +
            '<tr><th>Medical Exp. Allowance</th><td class="amt">' + esc(inr(data.medical_exp_allowance)) + '</td></tr>' +
            '<tr><th>Allowance</th><td>' + esc(data.allowance_names || 'N/A') + '</td></tr>' +
            '<tr><th>Total Allowance Amount</th><td class="amt">' + esc(inr(data.total_allowance_amount)) + '</td></tr>' +
            '<tr><th>Professional Consultancy</th><td class="amt">' + esc(inr(data.professional_consultancy)) + '</td></tr>' +
            '<tr><th>Incentive Types</th><td>' + esc(data.incentive_description || 'N/A') + '</td></tr>' +
            '<tr><th>Clinical Research Incentive</th><td class="amt">' + esc(inr(data.clinical_research_incentive)) + '</td></tr>' +
            '<tr><th>Encashment</th><td class="amt">' + esc(inr(data.reimbursement)) + '</td></tr>' +
            '<tr><th>Overtime Credit</th><td class="amt">' + esc(inr(data.over_time_credit)) + '</td></tr>' +
            '<tr class="ps-total-row ps-earn"><th>Total Earnings</th><td class="amt">' + esc(inr(totalEarnings(data))) + '</td></tr>';
        var deductionRows =
            '<tr><th>Total LOP Amount</th><td class="amt">' + esc(inr(Number(data.total_lop_amount || 0) + Number(data.total_credit_lop || 0))) + '</td></tr>' +
            '<tr><th>Deduction</th><td>' + esc(data.deduction_names || 'N/A') + '</td></tr>' +
            '<tr><th>Total Special Deduction</th><td class="amt">' + esc(inr(data.total_special_deduction)) + '</td></tr>' +
            '<tr><th>EB Charge</th><td class="amt">' + esc(inr(data.eb_charges)) + '</td></tr>' +
            '<tr><th>Other Deduction</th><td class="amt">' + esc(inr(data.other_deduction)) + '</td></tr>' +
            '<tr><th>PF</th><td class="amt">' + esc(inr(data.pf_deduction)) + '</td></tr>' +
            '<tr><th>ESI</th><td class="amt">' + esc(inr(data.esi_deduction)) + '</td></tr>' +
            '<tr><th>TDS (Form 16)</th><td class="amt">' + esc(inr(data.tds_form_16)) + '</td></tr>' +
            '<tr><th>TDS (Form 16A)</th><td class="amt">' + esc(inr(data.tds_form_16a)) + '</td></tr>' +
            '<tr class="ps-total-row ps-deduct"><th>Total Deductions</th><td class="amt">' + esc(inr(totalDeductions(data))) + '</td></tr>';
        return { grossRows: grossRows, earningsRows: earningsRows, deductionRows: deductionRows };
    }

    function buildPayslipBody(data) {
        var t = payslipTableRows(data);
        var contactLine = (data.email || data.contact) ? esc(data.email) + (data.contact ? ' | ' + esc(data.contact) : '') : '';
        return '<div id="rep-payslip-print" class="ps-doc">' +
            '<header class="ps-header"><img src="/assets/img/saveetha.png" alt="Logo" class="ps-logo" onerror="this.style.display=\'none\'">' +
            '<h1 class="ps-org">SAVEETHA INSTITUTE OF MEDICAL AND TECHNICAL SCIENCES</h1>' +
            '<p class="ps-sub">Chennai, Tamil Nadu, India</p>' +
            (contactLine ? '<p class="ps-contact">' + contactLine + '</p>' : '') +
            '<p class="ps-period">Pay Period: <strong>' + esc(data.period) + '</strong></p></header>' +
            '<table class="ps-info-grid"><tr><td class="ps-info-cell"><h2>Employee Information</h2><table class="ps-tbl">' +
            '<tr><th>Name</th><td>' + esc(data.employee_name) + '</td></tr><tr><th>Bio ID</th><td>' + esc(data.employee_id) + '</td></tr>' +
            '<tr><th>Campus</th><td>' + esc(data.campus) + '</td></tr></table></td>' +
            '<td class="ps-info-cell"><h2>Salary Details</h2><table class="ps-tbl">' +
            '<tr><th>Pay Period</th><td>' + esc(data.period) + '</td></tr><tr><th>Total Pay Days</th><td>' + esc(fmtNum(data.total_pay_days)) + '</td></tr>' +
            '<tr><th>LOP in Days</th><td>' + esc(fmtNum(data.lop_in_days)) + '</td></tr></table></td></tr></table>' +
            '<section class="ps-block"><h3 class="ps-block-hdr ps-warn">Gross Salary Break Up</h3><table class="ps-tbl ps-full">' + t.grossRows + '</table></section>' +
            '<table class="ps-split"><tr><td class="ps-split-cell"><h3 class="ps-block-hdr ps-ok">Earnings</h3><table class="ps-tbl ps-full">' + t.earningsRows + '</table></td>' +
            '<td class="ps-split-cell"><h3 class="ps-block-hdr ps-bad">Deductions</h3><table class="ps-tbl ps-full">' + t.deductionRows + '</table></td></tr></table>' +
            '<section class="ps-net"><span class="ps-net-lbl">Total Amount After Tax</span><span class="ps-net-amt">' + esc(inr(data.payable_salary)) + '</span></section>' +
            '<footer class="ps-footer"><div class="ps-sign"><img src="/assets/img/cfo.png" alt="Signature" onerror="this.style.display=\'none\'">' +
            '<p class="ps-sign-name">' + esc(data.cfo_name || 'Mr.V.Balasubramanian') + '</p>' +
            '<p class="ps-sign-title">' + esc(data.cfo_title || 'Chief Financial Officer') + '</p></div>' +
            '<p class="ps-foot-note">This is a system-generated payslip.</p></footer></div>';
    }

    function payslipPrintStyles() {
        return 'body{margin:0;padding:16px;font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#111}' +
            '.ps-doc{max-width:800px;margin:0 auto}.ps-header{text-align:center;border-bottom:2px solid #1e40af;padding-bottom:12px;margin-bottom:14px}' +
            '.ps-logo{height:52px}.ps-org{font-size:15px;font-weight:800;color:#1e3a8a;margin:0}' +
            '.ps-sub,.ps-contact{font-size:10px;color:#64748b}.ps-tbl{width:100%;border-collapse:collapse;font-size:10px}' +
            '.ps-tbl th,.ps-tbl td{border:1px solid #cbd5e1;padding:6px 8px}.ps-tbl th{background:#f8fafc;width:42%}' +
            '.ps-tbl .amt{text-align:right;font-weight:600}.ps-split{width:100%;border-collapse:collapse}' +
            '.ps-split-cell{width:50%;vertical-align:top;padding:0 4px}.ps-block-hdr{padding:7px 10px;font-size:11px;font-weight:800;margin:0}' +
            '.ps-warn{background:#fef3c7;color:#92400e}.ps-ok{background:#dcfce7;color:#166534}.ps-bad{background:#fee2e2;color:#991b1b}' +
            '.ps-net{text-align:center;padding:14px;border:2px solid #16a34a;border-radius:8px;background:#f0fdf4;margin:14px 0}' +
            '.ps-net-amt{font-size:22px;font-weight:800;color:#15803d;display:block}.ps-footer{margin-top:16px;border-top:1px solid #e2e8f0;padding-top:12px}' +
            '.ps-sign{text-align:right}.ps-sign-name{font-weight:800;margin:4px 0 0}.ps-sign-title{margin:0;font-size:10px;color:#64748b}' +
            '@page{size:A4 portrait;margin:12mm}';
    }

    function buildPayslipPrintDocument(data) {
        return '<!DOCTYPE html><html><head><meta charset="utf-8"><title>Payslip - ' + esc(data.period) + '</title><style>' +
            payslipPrintStyles() + '</style></head><body>' + buildPayslipBody(data) + '</body></html>';
    }

    async function openPayslip(period) {
        try {
            var data = await fetchJson(apiUrl('salary', 'action=detail&period=' + encodeURIComponent(period)));
            state.payslipData = data.payslip;
            var content = document.getElementById('rep-payslip-content');
            if (content) content.innerHTML = buildPayslipBody(data.payslip);
            var modal = document.getElementById('rep-payslip-modal');
            if (modal && window.bootstrap) window.bootstrap.Modal.getOrCreateInstance(modal).show();
        } catch (e) {
            toast(e.message, 'error');
        }
    }

    function downloadPayslip() {
        if (!state.payslipData) return;
        var win = window.open('', '_blank', 'noopener,noreferrer,width=900,height=700');
        if (!win) {
            toast('Please allow pop-ups to download the payslip.', 'error');
            return;
        }
        win.document.open();
        win.document.write(buildPayslipPrintDocument(state.payslipData));
        win.document.close();
        win.focus();
        setTimeout(function () { win.print(); }, 400);
    }

    var uiBound = false;
    function bindUi() {
        var tabs = document.querySelectorAll('#page-salary .rep-salary-tab');
        if (!tabs.length) return;
        if (uiBound) return;
        uiBound = true;
        tabs.forEach(function (btn) {
            btn.addEventListener('click', function () { switchSalaryTab(btn.dataset.salaryTab); });
        });
        var dl = document.getElementById('rep-download-payslip');
        if (dl) dl.addEventListener('click', downloadPayslip);
    }

    function onSalaryPage() {
        bindUi();
        switchSalaryTab(state.salaryTab || 'history');
    }

    window.EDReports = { onSalaryPage: onSalaryPage };
})();


