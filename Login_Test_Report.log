        window.edWire($('er-request-form'), 'submit', submitRequest, 'form');
        window.edWire($('er-request-form'), 'input', function (e) {
            if (e.target && e.target.classList.contains('er-budget-input')) updateTotalBudget();
        }, 'form-input');
        window.edWire($('er-expense-body'), 'click', function (e) {
            var toggleHdr = e.target.closest('.js-er-toggle-card');
            if (toggleHdr && !e.target.closest('.cr-view-btn') && !e.target.closest('.btn-pri')) {
                var card = toggleHdr.closest('.er-budget-card');
                if (card) {
                    card.classList.toggle('er-budget-collapsed');
                }
                return;
            }
            var add = e.target.closest('.js-er-add-expense');
            if (add) { openAddExpenseModal(add.getAttribute('data-component-id'), parseFloat(add.getAttribute('data-available')) || 0); return; }
            var fund = e.target.closest('.js-er-add-fund');
            if (fund) { openAddFundModal(fund.getAttribute('data-component-id')); return; }
        }, 'exp-body');
        window.edWire($('er-expense-body'), 'keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') {
                var toggleHdr = e.target.closest('.js-er-toggle-card');
                if (toggleHdr && !e.target.closest('.cr-view-btn') && !e.target.closest('.btn-pri')) {
                    e.preventDefault();
                    var card = toggleHdr.closest('.er-budget-card');
                    if (card) card.classList.toggle('er-budget-collapsed');
                }
            }
        }, 'exp-body-key');
        window.edWire($('er-add-expense-form'), 'submit', submitExpense, 'exp-form');
        window.edWire($('er-add-fund-form'), 'submit', submitFund, 'fund-form');
        window.edWire($('er-pending-search'), 'input', function () {
            var pendingSearchInp = $('er-pending-search');
            pendingSearch = pendingSearchInp ? (pendingSearchInp.value || '') : '';
            renderPendingList();
        }, 'pending-search');
        window.edWire($('er-pending-list'), 'click', function (e) {
            var li = e.target.closest('[data-idx]');
            if (!li) return;
            currentApprovalIndex = parseInt(li.getAttribute('data-idx'), 10);
            renderPendingList();
            renderCurrentApproval();
        }, 'pending-list');
        window.edWire($('er-approve-btn'), 'click', function () { updateApproval('approved', ''); }, 'approve');
        window.edWire($('er-reject-btn'), 'click', openRejectModal, 'reject');
        window.edWire($('er-reject-confirm'), 'click', confirmReject, 'reject-confirm');
        window.edWire($('er-prev-approval'), 'click', function () {
            if (currentApprovalIndex > 0) { currentApprovalIndex -= 1; renderPendingList(); renderCurrentApproval(); }
        }, 'prev-appr');
        window.edWire($('er-next-approval'), 'click', function () {
            if (currentApprovalIndex < pendingApprovals.length - 1) { currentApprovalIndex += 1; renderPendingList(); renderCurrentApproval(); }
        }, 'next-appr');
    }

    function wireEvents() {
        wirePageControls();
        if (wired) return;
        wired = true;
    }

    function onPage() {
        wireEvents();
        if (loaded) return;
        filterSearchSelects = { location: null, status: null };
        initFilterSearchSelects();
        loadRows();
        checkApprover();
    }

    function init() {
        wireEvents();
    }

    window.EDEventRequest = { init: init, onPage: onPage };
}());


