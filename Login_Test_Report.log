    function openDetail(approvalId) {
        ensureDetailModal();
        var modalEl = document.getElementById('priv-approval-modal');
        var body = document.getElementById('priv-detail-body');
        var footer = document.getElementById('priv-detail-footer');
        var title = document.getElementById('priv-detail-title');
        var subtitle = document.getElementById('priv-detail-subtitle');
        if (!modalEl || !body) return;

        body.innerHTML = '<div class="text-center text-muted py-4"><i class="fa fa-spinner fa-spin me-2"></i>Loading details...</div>';
        if (footer) footer.style.display = 'none';
        detailModal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
        detailModal.show();

        fetchJson(apiUrl({ action: 'detail', approval_id: String(approvalId) }))
            .then(function (data) {
                var row = (data && data.privilege_approval) || {};
                detailState.data = row;
                detailState.row = row;
                if (title) title.textContent = row.privilege_name || 'Privilege Approval';
                if (subtitle) {
                    subtitle.textContent = (row.action_btn_name || '') + (row.project_id ? (' · ' + row.project_id) : '');
