    function saveUpdate(id) {
        var status = ($('pt-update-status') || {}).value || '';
        var remark = (($('pt-update-remark') || {}).value || '').trim();
        if (!remark) {
            toast('Remark is required', false);
            return;
        }
        var btn = $('pt-update-btn');
        if (btn) btn.disabled = true;
        fetch(API + '?action=update_status', {
            method: 'POST',
            credentials: 'same-origin',
            headers: csrfHeaders(true),
            body: JSON.stringify({ id: Number(id), status: status, remark: remark })
        }).then(function (r) { return r.json(); }).then(function (json) {
            if (!json || !json.success) throw new Error((json && json.message) || 'Update failed');
