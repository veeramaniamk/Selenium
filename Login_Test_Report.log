            '<div class="ed-bday-letter">' +
            '<p class="ed-bday-subline">' + esc(message) + '</p>' +
            '<div class="ed-bday-signature">With warm wishes — ' + esc(institution) + '</div>' +
            '</div></div>';
    }

    function bindEnvelopeReveal(modal, emp, greeting, institution, skipEnvelope) {
        if (skipEnvelope || state.cardRevealed) {
            var envelope = document.getElementById('ed-bday-envelope');
            if (envelope) envelope.remove();
            var existing = document.getElementById('ed-bday-reveal');
            if (!existing) {
                modal.insertAdjacentHTML('afterbegin', buildRevealedHtml(emp, greeting, institution));
            } else {
                existing.classList.add('visible');
            }
            return;
        }

        var envelopeEl = document.getElementById('ed-bday-envelope');
        if (!envelopeEl) return;

        function revealCard() {
            if (state.cardRevealed) return;
            state.cardRevealed = true;
            envelopeEl.classList.add('is-opening');
            fireConfetti();

            setTimeout(function () {
                envelopeEl.style.display = 'none';
                modal.insertAdjacentHTML('afterbegin', buildRevealedHtml(emp, greeting, institution));
            }, 650);
