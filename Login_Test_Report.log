    <!-- ████ DIGILOCKER / AADHAAR VERIFICATION (mandatory, roles 8 and 13) ████ -->
    <div class="modal fade" id="edv-verification-modal" tabindex="-1" aria-labelledby="edvVerificationLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header" style="background:linear-gradient(135deg,#7c3aed,#5b21b6);color:#fff; display:flex; justify-content:space-between; align-items:flex-start;">
                    <div>
                        <div class="edv-step-label">Identity verification</div>
                        <h5 class="modal-title" id="edvVerificationLabel">Verify your Aadhaar</h5>
                        <div style="font-size:12px;opacity:.9;margin-top:2px">Required before you can access the dashboard</div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" id="edv-close-btn" style="display:none; margin-top:2px;" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="edv-form-info" class="alert alert-info" role="status"></div>
                    <div id="edv-form-error" class="alert alert-danger" role="alert"></div>

                    <div class="edv-step-panel is-active" data-step="aadhaar">
                        <p class="text-muted small mb-3">Your Aadhaar number from HR records is shown below. Click verify to continue with DigiLocker.</p>
                        <label class="form-label" for="edv-aadhaar-input">Aadhaar Number</label>
                        <input type="text" class="form-control edv-aadhaar-input" id="edv-aadhaar-input" inputmode="numeric" maxlength="12" placeholder="Enter 12-digit Aadhaar" autocomplete="off">
                    </div>

                    <div class="edv-step-panel" data-step="otp">
                        <div class="edv-phone-banner">
                            OTP will be sent to your registered mobile:
                            <strong id="edv-masked-phone">**********</strong>
                        </div>
                        <p class="text-muted small mb-3">Enter the 6-digit OTP sent to your WhatsApp number on file.</p>
                        <label class="form-label" for="edv-otp-input">OTP Code</label>
                        <input type="text" class="form-control edv-otp-input" id="edv-otp-input" inputmode="numeric" maxlength="6" placeholder="------" autocomplete="one-time-code">
                        <div class="edv-resend-wrap">
                            Didn't receive it?
                            <button type="button" class="btn btn-link btn-sm p-0 align-baseline" id="edv-resend-otp-btn">Resend OTP</button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" id="edv-skip-btn" style="display:none">
                        Skip (<span id="edv-skips-left">3</span> left)
                    </button>
                    <button type="button" class="btn btn-primary" id="edv-aadhaar-btn">
                        <i class="fa fa-fingerprint me-1"></i> Verify with DigiLocker
                    </button>
                    <button type="button" class="btn btn-primary" id="edv-verify-otp-btn" style="display:none">
                        <i class="fa fa-shield-halved me-1"></i> Verify OTP
                    </button>
                </div>
            </div>
        </div>
    </div>

