    function openRaiseModal() {
        var modalEl = $('grv-raise-modal');
        if (!modalEl || !window.bootstrap) return;
        raiseModal = window.bootstrap.Modal.getOrCreateInstance(modalEl);
        var form = $('grv-raise-form');
        if (form) { form.reset(); }
        setFormError('');
        var previewEl = $('grv-file-preview');
        if (previewEl) previewEl.style.display = 'none';
