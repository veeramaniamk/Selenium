    function renderLeaveTable() {
        if (!isLeaveActive()) {
            toggleToolbar(false);
            return false;
        }
        toggleToolbar(true);
        toggleFilterFields();
        readFilters();

        var head = document.getElementById('appr-head');
        var body = document.getElementById('appr-body');
        if (!head || !body) return true;
        var tab = typeof window.apprTabSt !== 'undefined' ? window.apprTabSt : 'pending';
        var state = window.ED_LEAVE_APPROVAL || defaultState();

        if (!state.loaded && !state.error) {
            showLoadingCards();
            return true;
        }

        head.innerHTML = '<tr><th style="display:none"></th></tr>';

        if (tab === 'history' && !state.historyLoaded) {
            showLoadingCards();
            loadHistory(false);
            return true;
        }

        var rows = tab === 'history' ? (state.history || []) : (state.pending || []);
        rows = rows.filter(function (r) {
            return rowMatchesFilters(r, tab);
        });

        if (!rows.length) {
            body.innerHTML = '<tr><td colspan="8" class="pa-empty-cell">No leave ' + (tab === 'history' ? 'history' : 'requests') + ' found</td></tr>';
            return true;
        }

        var totalCount = tab === 'history' ? (state.historyTotal || state.counts.history || 0) : (state.pendingTotal || state.counts.pending || 0);
        var currentOffset = tab === 'history' ? (state.historyOffset || 0) : (state.pendingOffset || 0);
        var currentLimit = tab === 'history' ? (state.historyLimit || PER_PAGE) : (state.pendingLimit || PER_PAGE);

        body.innerHTML = '<tr><td colspan="8" style="padding:8px;border:0">'
            + '<div class="pa-lv-grid">'
            + rows.map(function (row) { return cardHtml(row, tab === 'history'); }).join('')
            + '</div>'
            + renderPaginationControls(tab, totalCount, currentOffset, currentLimit, rows.length)
            + '</td></tr>';

        wireLeaveCardActions(body);
        wirePaginationActions(body);
        return true;
    }

    function onFilterChange() {
        if (!isLeaveActive()) return;
        var tab = typeof window.apprTabSt !== 'undefined' ? window.apprTabSt : 'pending';
        if (tab === 'history') {
            historyOffset = 0;
            loadHistory(false);
        } else {
            pendingOffset = 0;
            loadPending(false, false);
        }
    }

    function ensureLoaded() {
        if (loaded && !needsPendingReload()) return Promise.resolve();
        if (isLeaveActive()) showLoadingCards();
        return loadPending(true, false);
    }

    function onLeaveTab() {
        var tab = typeof window.apprTabSt !== 'undefined' ? window.apprTabSt : 'pending';
        if (tab === 'history') {
            return ensureLoaded().then(function () { return loadHistory(false); });
        }
        if (needsPendingReload() || !loaded) {
            return ensureLoaded().then(function () {
                if (isLeaveActive()) renderLeaveTable();
            });
        }
        if (isLeaveActive()) renderLeaveTable();
        return Promise.resolve();
    }

    function schedulePrefetch() {
        if (prefetchStarted || loaded || loading) return;
        prefetchStarted = true;
        var run = function () {
