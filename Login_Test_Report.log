                <form id="sg-raise-form" enctype="multipart/form-data" autocomplete="off">
                    <div class="cr-modal-body sg-raise-body">
                        <div id="sg-form-error" class="cr-form-error" style="display:none"></div>

                        <div class="pa-section sg-raise-section">
                            <div class="pa-section-hdr">
                                <span class="pa-section-title"><i class="fa fa-user me-1"></i>Who is this for?</span>
                            </div>
                            <div class="pa-section-body">
                                <div class="sg-subject-toggle" role="group" aria-label="Ticket subject">
                                    <input type="radio" class="btn-check" name="sg_subject_type" id="sg-self" value="self" checked>
                                    <label class="sg-tog-btn" for="sg-self"><i class="fa fa-user"></i><span>For me</span></label>
                                    <input type="radio" class="btn-check" name="sg_subject_type" id="sg-other" value="other">
                                    <label class="sg-tog-btn" for="sg-other"><i class="fa fa-users"></i><span>For others</span></label>
                                </div>

                                <div id="sg-subject-wrap" class="sg-emp-picker" hidden>
                                    <label class="cr-form-label" for="sg-emp-search">Select employee <span class="text-danger">*</span></label>
                                    <input type="text" class="finp cr-form-inp" id="sg-emp-search" placeholder="Type name or bio ID to search…" autocomplete="off">
                                    <input type="hidden" id="sg-subject-bio" value="">
                                    <div id="sg-emp-selected" class="sg-emp-selected" hidden></div>
                                    <ul id="sg-emp-results" class="sg-emp-results" hidden></ul>
                                </div>
                            </div>
                        </div>

                        <div class="pa-section sg-raise-section">
                            <div class="pa-section-hdr">
                                <span class="pa-section-title"><i class="fa fa-bug me-1"></i>Issue details</span>
                            </div>
                            <div class="pa-section-body">
                                <div class="sg-field">
                                    <label class="cr-form-label" for="sg-error-message">Error message <span class="text-danger">*</span></label>
                                    <input type="text" class="finp cr-form-inp" id="sg-error-message" maxlength="500" required placeholder="Short summary of the error">
