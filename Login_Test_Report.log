                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ birthday_bio_id: birthdayBioId }),
            });
        } catch (e) {
            console.warn('[EDBirthday] mark-seen', e.message);
            return null;
        }
    }

    function applySeenStateToStatus(birthdayBioId) {
        if (!state.status) return;
        [state.status.colleague_birthdays, state.status.pending_notifications].forEach(function (list) {
            if (!Array.isArray(list)) return;
            list.forEach(function (c) {
                if (c.bio_id === birthdayBioId) {
                    c.already_wished = true;
                    c.unread_reply_count = 0;
                    c.show_reminder = false;
                }
            });
        });
        renderColleagueBanner(state.status);
    }

