        /* Employee submit progress — macOS skeuomorphic sheet */

.ed-sp-overlay {
  position: fixed;
  inset: 0;
  z-index: 20000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(28, 28, 30, 0.42);
  -webkit-backdrop-filter: blur(14px) saturate(140%);
  backdrop-filter: blur(14px) saturate(140%);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.28s ease, visibility 0.28s ease;
}

.ed-sp-overlay.is-open {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.ed-sp-sheet {
  width: min(100%, 380px);
  padding: 28px 26px 24px;
  border-radius: 18px;
  background:
    linear-gradient(180deg, #fafafa 0%, #ececec 48%, #e2e2e4 100%);
  border: 1px solid rgba(255, 255, 255, 0.75);
  box-shadow:
    0 1px 0 rgba(255, 255, 255, 0.9) inset,
    0 -1px 0 rgba(0, 0, 0, 0.06) inset,
    0 18px 48px rgba(0, 0, 0, 0.28),
    0 4px 12px rgba(0, 0, 0, 0.12);
  text-align: center;
  transform: translateY(10px) scale(0.97);
  transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
}

.ed-sp-overlay.is-open .ed-sp-sheet {
  transform: translateY(0) scale(1);
}

.ed-sp-title {
  margin: 0 0 6px;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", sans-serif;
  font-size: 1.05rem;
  font-weight: 650;
  letter-spacing: -0.02em;
  color: #1d1d1f;
}

.ed-sp-msg {
  min-height: 1.35em;
  margin: 0 0 18px;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", sans-serif;
  font-size: 0.88rem;
  font-weight: 450;
  color: #6e6e73;
  transition: opacity 0.22s ease;
}

.ed-sp-msg.is-fading {
  opacity: 0;
}

.ed-sp-percent {
  margin: 0 0 14px;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", sans-serif;
  font-size: 2.35rem;
  font-weight: 700;
  letter-spacing: -0.04em;
  line-height: 1;
  color: #1d1d1f;
  font-variant-numeric: tabular-nums;
}

.ed-sp-percent span {
  font-size: 1.1rem;
  font-weight: 600;
  color: #86868b;
  margin-left: 1px;
}

.ed-sp-track {
  position: relative;
  height: 14px;
  border-radius: 999px;
  background: linear-gradient(180deg, #c8c8cc 0%, #e8e8ea 35%, #f4f4f5 100%);
  box-shadow:
    0 1px 2px rgba(0, 0, 0, 0.18) inset,
    0 1px 0 rgba(255, 255, 255, 0.7);
  overflow: hidden;
}

.ed-sp-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 1%;
  border-radius: 999px;
  background:
    linear-gradient(180deg,
      #7dd3fc 0%,
      #38bdf8 18%,
      #0ea5e9 52%,
      #0284c7 100%);
  box-shadow:
    0 1px 0 rgba(255, 255, 255, 0.55) inset,
    0 -1px 0 rgba(0, 60, 120, 0.25) inset,
    0 0 8px rgba(14, 165, 233, 0.35);
  transition: width 0.18s linear;
}

.ed-sp-fill::after {
  content: "";
  position: absolute;
  inset: 1px 0 auto 0;
  height: 42%;
  border-radius: 999px 999px 40% 40%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.65), rgba(255, 255, 255, 0));
  pointer-events: none;
}

.ed-sp-hint {
  margin: 14px 0 0;
  font-size: 0.75rem;
  color: #a1a1a6;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", sans-serif;
}

@media (max-width: 420px) {
  .ed-sp-sheet {
    padding: 24px 20px 20px;
    border-radius: 16px;
  }

  .ed-sp-percent {
    font-size: 2rem;
  }
}


