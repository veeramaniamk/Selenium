    function openDetail(id, canUpdatePreferred) {
        var el = $('sgDetailModal');
        var body = $('sg-detail-body');
        var title = $('sg-detail-title');
        if (!el || !body || !window.bootstrap) return;
        if (!detailModal) detailModal = new bootstrap.Modal(el);
        title.textContent = 'Ticket #' + id;
        body.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>';
        detailModal.show();

        // Prefer assignee API for update UI; fall back to raise API for owner read-only
        var url = canUpdatePreferred
            ? (TICKET_API + '?action=detail&id=' + encodeURIComponent(id))
            : raiseUrl('detail', '&id=' + encodeURIComponent(id));

        fetch(url, {
            credentials: 'same-origin',
            headers: { Accept: 'application/json' }
        }).then(readJsonResponse).then(function (json) {
            if ((!json || !json.success) && canUpdatePreferred) {
                return fetch(raiseUrl('detail', '&id=' + encodeURIComponent(id)), {
                    credentials: 'same-origin',
                    headers: { Accept: 'application/json' }
                }).then(readJsonResponse);
            }
            return json;
        }).then(function (json) {
            if (!json || !json.success) throw new Error((json && json.message) || 'Failed');
            var t = json.data || {};
            title.textContent = t.ticket_no || ('Ticket #' + id);
            var imgs = (t.attachments || []).map(function (a) {
                if (!a.url) return '';
                return '<a href="' + esc(a.url) + '" target="_blank" rel="noopener"><img src="' + esc(a.url) + '" style="height:90px;border-radius:8px;border:1px solid #e2e8f0;object-fit:cover;margin:0 8px 8px 0"></a>';
            }).join('');
            var history = (t.updates || []).map(function (u) {
                return '<div class="mb-2 ps-2 border-start">' +
                    statusBadge(u.new_status) + ' <small class="text-muted">' + esc(u.created_at || '') + '</small>' +
                    '<div class="small text-muted">By ' + esc(actorLabel(u, t)) + '</div>' +
                    '<div>' + esc(u.remark || '') + '</div></div>';
            }).join('') || '<div class="text-muted">No updates yet.</div>';

            var updateForm = '';
            if (t._can_update) {
                updateForm =
                    '<hr><h6 class="fw-semibold">Update status</h6>' +
                    '<div class="row g-2 align-items-end">' +
                    '<div class="col-md-4"><label class="form-label small">Status</label>' +
                    '<select class="form-select" id="sg-update-status">' +
                    ['pending', 'in_review', 'delay', 'updated'].map(function (s) {
                        return '<option value="' + s + '"' + (t.status === s ? ' selected' : '') + '>' + s.replace(/_/g, ' ') + '</option>';
                    }).join('') +
                    '</select></div>' +
                    '<div class="col-md-8"><label class="form-label small">Remark <span class="text-danger">*</span></label>' +
                    '<input type="text" class="form-control" id="sg-update-remark" placeholder="Add a remark…"></div>' +
                    '<div class="col-12"><button type="button" class="btn btn-primary btn-sm" id="sg-update-btn" data-id="' + esc(t.id) + '">Save update</button></div>' +
                    '</div>';
            }

            body.innerHTML =
                '<div class="row g-3 mb-3">' +
                '<div class="col-md-6"><small class="text-muted">Status</small><div>' + statusBadge(t.status) + '</div></div>' +
                '<div class="col-md-6"><small class="text-muted">Created</small><div>' + esc(t.created_at || '') + '</div></div>' +
                '<div class="col-md-6"><small class="text-muted">Raised by</small><div>' + esc(t.raised_by_name || t.raised_by_bio_id || '—') + '</div></div>' +
                '<div class="col-md-6"><small class="text-muted">Subject</small><div>' + esc(t.subject_name || t.subject_bio_id) + ' (' + esc(t.subject_type) + ')</div></div>' +
                '<div class="col-12"><small class="text-muted">Error message</small><div class="fw-semibold">' + esc(t.error_message || '') + '</div></div>' +
                '<div class="col-12"><small class="text-muted">Detailed remarks</small><div>' + esc(t.detailed_remarks || '') + '</div></div>' +
                '<div class="col-12"><small class="text-muted">Attachments</small><div class="mt-1">' + (imgs || '<span class="text-muted">None</span>') + '</div></div>' +
                '</div><h6 class="fw-semibold">History</h6>' + history + updateForm;
        }).catch(function (err) {
            body.innerHTML = '<div class="alert alert-danger">' + esc(err.message || 'Failed') + '</div>';
        });
    }

    function saveUpdate(id) {
        var status = ($('sg-update-status') || {}).value || '';
        var remark = (($('sg-update-remark') || {}).value || '').trim();
        if (!remark) {
            toast('Remark is required', false);
            return;
        }
        var btn = $('sg-update-btn');
        if (btn) btn.disabled = true;
        fetch(TICKET_API + '?action=update_status', {
            method: 'POST',
            credentials: 'same-origin',
            headers: csrfHeaders(true),
            body: JSON.stringify({ id: Number(id), status: status, remark: remark })
        }).then(readJsonResponse).then(function (json) {
            if (!json || !json.success) throw new Error((json && json.message) || 'Update failed');
            toast(json.message || 'Updated', true);
            openDetail(id, true);
            inboxLoaded = false;
            loadInboxRows();
            mineLoaded = false;
            loadMineRows();
            if (window.EDPendingTickets && window.EDPendingTickets.reload) {
                window.EDPendingTickets.reload();
            }
        }).catch(function (err) {
            toast(err.message || 'Update failed', false);
        }).finally(function () {
            if (btn) btn.disabled = false;
        });
    }

    function onPage() {
        wire();
        if (!mineLoaded) loadMineRows();
        else renderMineRows();
        refreshHandlerMeta().then(function () {
            if (isHandler && !inboxLoaded) {
                // preload counts only; list loads when tab opens
            }
        });
    }

    window.EDSoftwareGrievance = {
        onPage: onPage,
        reload: function () {
            mineLoaded = false;
            inboxLoaded = false;
            loadMineRows();
            refreshHandlerMeta();
        },
        openRaise: openRaiseModal
    };
})();

