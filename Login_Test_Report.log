        var body = $('cn-body');
        if (!body) return;

        var rows = state.rows || [];
        if (!rows.length) {
            body.innerHTML = '<tr><td colspan="14" class="cn-td-empty">No consumable requests found.</td></tr>';
            renderPager();
            updateShowing();
            return;
        }

        body.innerHTML = rows.map(function (r, idx) {
            var serial = (page - 1) * perPage + idx + 1;
            var reqQty = r.requested_qty != null ? r.requested_qty : (r.initial_quantity || 0);
            var issQty = r.issued_qty || 0;
            var recQty = r.received_qty || 0;
            var storeStatus = r.store_manager_status || 'Pending';
            var canReceive = r.can_receive
                || ((storeStatus === 'Issued' || storeStatus === 'Partial') && recQty < issQty);

            var actions = canReceive
                ? '<button type="button" class="cn-receive-btn js-cn-receive" data-index="' + idx + '" title="Receive items">'
                    + '<i class="fa fa-box-open fa-xs"></i> Receive</button>'
                : '<span class="cn-muted">—</span>';

            return '<tr>'
                + '<td data-label="#">' + esc(String(serial)) + '</td>'
