        for (var i = 0; i < (count || 5); i += 1) {
            out += '<tr class="cn-skel-row">';
            for (var c = 0; c < cols; c += 1) {
                var w = c === 0 ? 'w-sm' : (c === 2 ? 'w-md' : 'w-sm');
                out += '<td><span class="ed-skel ed-skel-cell ' + w + '"></span></td>';
            }
            out += '</tr>';
        }
        return out;
    }

