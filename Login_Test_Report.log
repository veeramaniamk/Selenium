        envelopeEl.addEventListener('click', revealCard);
        envelopeEl.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                revealCard();
            }
        });
    }

    async function renderModal(status, birthdayBioId, mode, skipEnvelope) {
        var modal = document.getElementById('ed-bday-modal');
