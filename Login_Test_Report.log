        }

        .pa-detail-footer {
            padding: 13px 16px;
            background: linear-gradient(180deg, #fff, #f5f7fb);
            border-top: 1px solid #e2e8f0;
            display: flex;
            gap: 10px;
            align-items: center;
            flex-shrink: 0;
