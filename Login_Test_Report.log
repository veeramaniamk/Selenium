    }

    function wireEvents() {
        wirePageControls();
        if (wired) return;
        wired = true;

        document.addEventListener('click', function (e) {
            var tlBtn = e.target.closest('.js-cr-timeline');
            if (tlBtn) {
                var id = tlBtn.getAttribute('data-id');
                if (id) openTimeline(id);
                return;
            }

            var reportBtn = e.target.closest('.js-view-dup-report');
            if (reportBtn) {
                var cid = reportBtn.getAttribute('data-claim-id');
                if (cid) openClaimAuditReport(cid);
                return;
            }

            var dupBadgeBtn = e.target.closest('.js-check-dup-badge');
            if (dupBadgeBtn) {
                var cid = dupBadgeBtn.getAttribute('data-claim-id');
                if (cid) {
                    delete pendingCheckQueue[cid];
                    dupBadgeBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Checking';
                    processPendingDuplicateBadges();
                }
                return;
            }

            var pendingItem = e.target.closest('.cr-pending-item');
            if (pendingItem && pendingItem.closest('#cr-pending-list')) {
                var idx = parseInt(pendingItem.getAttribute('data-index'), 10);
                if (!isNaN(idx)) selectApproval(idx);
            }
        });
    }

