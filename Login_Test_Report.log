                + '<td data-label="Location">' + esc(r.location_code || '—') + '</td>'
                + '<td data-label="UOM">' + esc(r.uom || '—') + '</td>'
                + '<td data-label="Issue Type">' + esc(r.issue_type || '—') + '</td>'
                + '<td data-label="Req Qty">' + esc(String(reqQty)) + '</td>'
                + '<td data-label="Issued">' + esc(String(issQty)) + '</td>'
                + '<td data-label="Received">' + esc(String(recQty)) + '</td>'
                + '<td data-label="Progress">' + progressBar(reqQty, issQty, recQty) + '</td>'
                + '<td data-label="Store Status">' + storeStatusBadge(storeStatus) + '</td>'
                + '<td data-label="Approver Status">' + statusBadge(r.final_status) + '</td>'
