    function submitDecision(status) {
        var row = detailState.data;
        if (!row || !row.approval_id) return;
        var remarkEl = document.getElementById('priv-detail-remark');
        var remark = remarkEl ? String(remarkEl.value || '').trim() : '';
        if (status === 'rejected' && !remark) {
            if (window.EDToast) window.EDToast.warning('Remark is required when rejecting.');
            return;
        }

        var approveBtn = document.getElementById('priv-detail-approve');
        var rejectBtn = document.getElementById('priv-detail-reject');
        if (approveBtn) approveBtn.disabled = true;
        if (rejectBtn) rejectBtn.disabled = true;

        fetchJson(apiUrl({ action: 'action' }), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
                approval_id: row.approval_id,
                status: status,
                remark: remark,
            }),
        })
            .then(function () {
                if (detailModal) detailModal.hide();
                if (window.EDToast) {
                    window.EDToast.success(status === 'approved' ? 'Request approved.' : 'Request rejected.');
                }
                return Promise.all([loadPending(true, false), loadHistory(true)]);
            })
            .then(function () {
                if (typeof window.drawAppr === 'function' && isPrivilegeActive()) {
                    window.drawAppr();
                }
            })
            .catch(function (err) {
                if (window.EDToast) window.EDToast.error(err.message || 'Action failed.');
            })
            .finally(function () {
                if (approveBtn) approveBtn.disabled = false;
                if (rejectBtn) rejectBtn.disabled = false;
            });
    }

