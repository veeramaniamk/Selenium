        var cycleKey = btn.getAttribute('data-cycle') || 'last';
        var cycle = getCycleByKey(cycleKey);

        if (!claimable) {
            var reason = (cycle && cycle.eligibility && cycle.eligibility.reason)
                || 'This claim is not available right now.';
            toast(reason, 'info');
            return;
        }

        if (claiming) return;
        if (!window.confirm('Claim ' + (cycle.eligibility.credit_label || 'buffer credit') + ' for the previous cycle?')) {
            return;
        }

        claiming = true;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Claiming…';

        fetch(apiUrl(), {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
