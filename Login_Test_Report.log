        updateCombinedSidebarBadge();
    }

    function updateDutyPendingBadge(count) {
        var n = Number(count) || 0;
        dutyPendingTotal = n;

        ['duty-pending-badge', 'duty-subtab-badge'].forEach(function (id) {
            var badge = $(id);
            if (!badge) return;
            if (n > 0) {
                badge.textContent = String(n);
                badge.style.display = 'inline-flex';
            } else {
                badge.style.display = 'none';
            }
        });
        updateCombinedSidebarBadge();
    }

    function fetchWeekendPendingCount() {
        return fetch(weekendApiUrl({ action: 'pending_count' }), {
            credentials: 'same-origin',
            headers: { Accept: 'application/json' },
        })
            .then(function (r) { return r.json(); })
            .then(function (json) {
                if (json && json.success && json.data) {
                    updateWeekendPendingBadge(json.data.pending_count);
                }
                return json;
            })
            .catch(function () { return null; });
    }

    function weekendStatusPill(status) {
        if (status === 'claimable') return '<span class="clm-wh-pill clm-wh-pill--ready"><i class="fa fa-circle-check"></i> Ready</span>';
        if (status === 'claimed') return '<span class="clm-wh-pill clm-wh-pill--done"><i class="fa fa-check"></i> Claimed</span>';
        return '<span class="clm-wh-pill clm-wh-pill--muted"><i class="fa fa-ban"></i> Ineligible</span>';
    }

    function weekendActionHtml(row) {
        if (row.status !== 'claimable') {
            return '<span class="clm-wh-reason">' + esc(row.reason || '—') + '</span>';
        }

        var encDisabled = !row.encashment_allowed;
        var encLabel = row.encashment_amount_preview != null
            ? 'Encashment (₹' + esc(String(row.encashment_amount_preview)) + ')'
            : 'Encashment';

        return '<div class="clm-wh-action">'
            + '<select class="clm-wh-claim-type" data-duty-date="' + esc(row.duty_date) + '" aria-label="Claim type">'
            + '<option value="" selected disabled>Select type</option>'
            + '<option value="CL">' + esc(row.credit_label || 'CL') + '</option>'
            + '<option value="Encashment"' + (encDisabled ? ' disabled' : '') + '>' + encLabel + '</option>'
            + '</select>'
            + '<button type="button" class="btn-pri clm-wh-claim-btn" data-duty-date="' + esc(row.duty_date) + '">'
            + '<i class="fa fa-gift"></i> Claim</button>'
            + (encDisabled ? '<small class="clm-wh-enc-note">Encashment grace period ended for previous cycle</small>' : '')
            + '</div>';
    }

    function weekendRowHtml(row, index) {
        return '<tr data-duty-date="' + esc(row.duty_date) + '">'
            + '<td>' + (index + 1) + '</td>'
            + '<td><span class="clm-period">' + esc(row.duty_date_label || row.duty_date) + '</span></td>'
            + '<td>' + esc(row.day_type || '—') + '</td>'
            + '<td><span class="clm-wh-shift">' + esc(row.shift_name || '—') + '</span>'
            + '<small>' + esc(row.shift_start || '') + ' – ' + esc(row.shift_end || '') + '</small></td>'
            + '<td>' + esc(row.in_time || '—') + '</td>'
            + '<td>' + esc(row.out_time || '—') + '</td>'
            + '<td>' + esc(row.worked_hours != null ? String(row.worked_hours) + 'h' : '—') + '</td>'
            + '<td><span class="clm-credit-pill">' + esc(row.credit_label || '—') + '</span></td>'
            + '<td>' + weekendStatusPill(row.status) + '</td>'
            + '<td class="clm-wh-action-cell">' + weekendActionHtml(row) + '</td>'
            + '</tr>';
    }

    function renderWeekendNotice(cycleKey, cycle) {
        var notice = $('clm-weekend-notice');
        if (!notice) return;
        if (cycleKey === 'last') {
            notice.hidden = false;
            if (cycle && cycle.encashment_grace_active) {
                var graceEnd = cycle.encashment_grace_ends || '';
                notice.innerHTML = '<div class="clm-notice-icon"><i class="fa fa-info-circle"></i></div>'
                    + '<div><strong>Previous cycle — encashment grace active</strong>'
                    + '<p>Both CL and encashment are available until '
                    + esc(graceEnd || 'the grace deadline')
                    + ' (5 days after the cycle ends).</p></div>';
                return;
            }
            notice.innerHTML = '<div class="clm-notice-icon"><i class="fa fa-info-circle"></i></div>'
                + '<div><strong>Previous cycle</strong>'
                + '<p>CL claims are available. Encashment is disabled after the 5-day grace period.</p></div>';
            return;
        }
        notice.hidden = true;
        notice.innerHTML = '';
    }

    function renderWeekendHistory(history) {
        var body = $('clm-weekend-history-body');
        if (!body) return;
        if (!history || !history.length) {
            body.innerHTML = '<tr><td colspan="5" class="clm-empty"><i class="fa fa-inbox"></i><span>No weekend/holiday claim history yet.</span></td></tr>';
            return;
        }
        body.innerHTML = history.map(function (row, i) {
            var credit = row.claim_type === 'Encashment'
                ? ('₹' + esc(String(row.amount != null ? row.amount : '—')))
                : esc(row.credit_label || row.credit_value || '—');
            return '<tr>'
                + '<td>' + (i + 1) + '</td>'
                + '<td>' + esc(row.duty_date_label || row.duty_date || '—') + '</td>'
                + '<td>' + esc(row.claim_type || '—') + '</td>'
                + '<td><span class="clm-credit-pill">' + credit + '</span></td>'
                + '<td><span class="clm-status-pill"><i class="fa fa-check"></i> ' + esc(row.status || 'Claimed') + '</span></td>'
                + '</tr>';
        }).join('');
    }

    function renderWeekend(data) {
        weekendState = data;
        var cycle = data.cycle || {};
        var labelEl = $('wh-cycle-label');
        if (labelEl) labelEl.textContent = cycle.label || '';

        document.querySelectorAll('[data-wh-cycle]').forEach(function (btn) {
            btn.classList.toggle('active', btn.getAttribute('data-wh-cycle') === weekendCycle);
        });

        renderWeekendNotice(weekendCycle, cycle);

        var body = $('clm-weekend-body');
        var rows = data.rows || [];
        if (body) {
            if (!rows.length) {
                body.innerHTML = '<tr><td colspan="11" class="clm-empty"><i class="fa fa-calendar-xmark"></i>'
                    + '<span>No eligible weekend or holiday duty found for this cycle.</span></td></tr>';
            } else {
                body.innerHTML = rows.map(weekendRowHtml).join('');
            }
        }

        renderWeekendHistory(data.history || []);
        fetchWeekendPendingCount();
    }

    function showWeekendSkeleton() {
        var body = $('clm-weekend-body');
        var hist = $('clm-weekend-history-body');
        if (body) {
            body.innerHTML = '';
            for (var i = 0; i < 4; i++) {
                body.innerHTML += '<tr><td colspan="10"><span class="ed-skel ed-skel-cell w-full"></span></td></tr>';
            }
        }
        if (hist) {
            hist.innerHTML = '';
            for (var j = 0; j < 3; j++) {
                hist.innerHTML += '<tr><td colspan="5"><span class="ed-skel ed-skel-cell w-full"></span></td></tr>';
            }
        }
    }

    function fetchWeekendOverview(force) {
        if (weekendLoading) return Promise.resolve(weekendState);
        if (weekendLoaded && !force) return Promise.resolve(weekendState);

        weekendLoading = true;
        showWeekendSkeleton();

        return fetch(weekendApiUrl({ cycle: weekendCycle }), {
            credentials: 'same-origin',
            headers: { Accept: 'application/json' },
        })
            .then(function (r) {
                return r.json().then(function (json) { return { ok: r.ok, json: json }; });
            })
            .then(function (res) {
                if (!res.ok || !res.json || !res.json.success) {
                    throw new Error((res.json && res.json.error) || 'Failed to load weekend/holiday claims');
                }
                weekendLoaded = true;
                renderWeekend(res.json.data);
                return res.json.data;
            })
            .catch(function (err) {
                var body = $('clm-weekend-body');
                if (body) {
                    body.innerHTML = '<tr><td colspan="10" class="clm-error"><i class="fa fa-triangle-exclamation"></i> '
                        + esc(err.message || 'Unable to load weekend/holiday claims.') + '</td></tr>';
                }
                throw err;
            })
            .finally(function () {
                weekendLoading = false;
            });
    }

    function ensureWeekendLoaded(force) {
        if (subTab !== 'weekend') return;
        fetchWeekendOverview(!!force);
    }

    function setWeekendCycle(cycleKey) {
        if (cycleKey !== 'current' && cycleKey !== 'last') cycleKey = 'current';
        if (weekendCycle === cycleKey && weekendLoaded) return;
        weekendCycle = cycleKey;
        weekendLoaded = false;
        fetchWeekendOverview(true);
    }

    function handleWeekendClaim(btn) {
        var dutyDate = btn.getAttribute('data-duty-date');
        if (!dutyDate || weekendClaiming) return;

        var rowEl = btn.closest('tr');
        var select = rowEl ? rowEl.querySelector('.clm-wh-claim-type') : null;
        var claimType = select ? select.value : '';
        if (!claimType) {
            toast('Please select a claim type (CL or Encashment).', 'info');
            return;
        }

        var rowData = null;
        if (weekendState && weekendState.rows) {
            for (var i = 0; i < weekendState.rows.length; i++) {
                if (weekendState.rows[i].duty_date === dutyDate) {
                    rowData = weekendState.rows[i];
                    break;
                }
            }
        }

        var confirmMsg = 'Claim ' + (rowData && rowData.credit_label ? rowData.credit_label : 'credit')
            + ' (' + claimType + ') for ' + (rowData && rowData.duty_date_label ? rowData.duty_date_label : dutyDate) + '?';
        if (!window.confirm(confirmMsg)) return;

        weekendClaiming = true;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i>';

        fetch(weekendApiUrl(), {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                Accept: 'application/json',
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ duty_date: dutyDate, claim_type: claimType }),
        })
            .then(function (r) {
                return r.json().then(function (j) { return { ok: r.ok, json: j }; });
            })
            .then(function (res) {
                if (!res.ok || !res.json || !res.json.success) {
                    throw new Error((res.json && res.json.error) || 'Claim failed');
                }
                showSuccessOverlay(res.json.data || {});
                weekendLoaded = false;
                if (res.json.data && res.json.data.pending_count != null) {
                    updateWeekendPendingBadge(res.json.data.pending_count);
                }
                return fetchWeekendOverview(true);
            })
            .catch(function (err) {
                toast(err.message || 'Unable to submit claim.', 'error');
            })
            .finally(function () {
                weekendClaiming = false;
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa fa-gift"></i> Claim';
                }
            });
    }

    function swipeIndicatorHtml(swipe) {
        var ok = !!swipe.matched;
        return ok
            ? '<span class="clm-duty-dot clm-duty-dot--ok" title="Matched ' + esc(swipe.matched_punch || '') + '"></span>'
            : '<span class="clm-duty-dot clm-duty-dot--fail" title="Unmatched ' + esc(swipe.day || '') + ' ' + esc(swipe.swipe_time || '') + '"></span>';
    }

    function swipeChipHtml(swipe) {
        var ok = !!swipe.matched;
        var cls = ok ? 'clm-duty-chip--ok' : 'clm-duty-chip--fail';
        var icon = ok ? 'fa-check' : 'fa-xmark';
        var punch = ok && swipe.matched_punch ? esc(swipe.matched_punch) : 'No punch';
        return '<span class="clm-duty-chip ' + cls + '" title="' + esc(swipe.day || '') + ' · ' + esc(swipe.swipe_time || '') + '">'
            + '<i class="fa ' + icon + ' clm-duty-chip-icon"></i>'
            + '<span class="clm-duty-chip-info"><b>' + esc(swipe.day || '') + '</b> ' + esc(swipe.swipe_time || '') + '<em>' + punch + '</em></span>'
            + '</span>';
    }

    function dutyCreditRowHtml(credit, dutyDate) {
        var labelMap = { rest_day: 'Rest-Day Start', all_swipes: 'Full Duty', next_day: 'Next Rest-Day' };
        var label = labelMap[credit.type] || credit.label || credit.type;

        if (credit.status === 'claimable') {
            var encAllowed = credit.encashment_allowed !== false;
            var encLabel = encAllowed
                ? (credit.encashment_preview != null
                    ? 'Encashment (₹' + esc(String(credit.encashment_preview)) + ')'
                    : 'Encashment')
                : null;
            return '<div class="clm-duty-cr clm-duty-cr--ready">'
                + '<span class="clm-duty-cr-name"><i class="fa fa-circle-check"></i>' + esc(label) + '</span>'
                + '<div class="clm-duty-cr-act">'
                + '<select class="clm-duty-claim-type" data-duty-date="' + esc(dutyDate) + '" data-credit-type="' + esc(credit.type) + '">'
                + '<option value="" selected disabled>Select type</option>'
                + '<option value="CL">1 CL</option>'
                + (encAllowed && encLabel ? '<option value="Encashment">' + encLabel + '</option>' : '')
                + '</select>'
                + (!encAllowed ? '<span class="clm-duty-enc-note">Previous cycle — CL only</span>' : '')
                + '<button type="button" class="btn-pri clm-duty-claim-btn" data-duty-date="' + esc(dutyDate) + '" data-credit-type="' + esc(credit.type) + '">'
                + '<i class="fa fa-gift"></i> Claim</button>'
                + '</div>'
                + '</div>';
        }
        if (credit.status === 'claimed') {
            return '<div class="clm-duty-cr clm-duty-cr--done">'
                + '<span class="clm-duty-cr-name"><i class="fa fa-check"></i>' + esc(label) + '</span>'
                + '<span class="clm-duty-cr-tag clm-duty-cr-tag--done"><i class="fa fa-check-circle"></i> Claimed · ' + esc(credit.claim_type_claimed || 'CL') + '</span>'
                + '</div>';
        }
        return '<div class="clm-duty-cr clm-duty-cr--off">'
            + '<span class="clm-duty-cr-name"><i class="fa fa-ban"></i>' + esc(label) + '</span>'
            + '<span class="clm-duty-cr-tag clm-duty-cr-tag--off">' + esc(credit.reason || 'Ineligible') + '</span>'
            + '</div>';
    }

    function dutyCreditStatusHtml(credit) {
        if (credit.status === 'claimable') {
            return '<span class="clm-wh-pill clm-wh-pill--ready"><i class="fa fa-circle-check"></i> Ready</span>';
        }
        if (credit.status === 'claimed') {
            var claimed = credit.claim_type_claimed || 'CL';
            return '<span class="clm-wh-pill clm-wh-pill--done"><i class="fa fa-check"></i> Claimed (' + esc(claimed) + ')</span>';
        }
        return '<span class="clm-wh-pill clm-wh-pill--muted"><i class="fa fa-ban"></i> Ineligible</span>';
    }

    function dutyCreditActionHtml(credit, dutyDate) {
        if (credit.status !== 'claimable') {
            return '<span class="clm-duty-reason">' + esc(credit.reason || '—') + '</span>';
        }
        var encAllowed = credit.encashment_allowed !== false;
        var encLabel = encAllowed
            ? (credit.encashment_preview != null
                ? ('Encashment (₹' + esc(String(credit.encashment_preview)) + ')')
                : 'Encashment')
            : null;
        return '<div class="clm-duty-credit-action">'
            + '<select class="clm-duty-claim-type" data-duty-date="' + esc(dutyDate) + '" data-credit-type="' + esc(credit.type) + '">'
            + '<option value="" selected disabled>Select</option>'
            + '<option value="CL">1 CL</option>'
            + (encAllowed && encLabel ? '<option value="Encashment">' + encLabel + '</option>' : '')
            + '</select>'
            + (!encAllowed ? '<span class="clm-duty-enc-note">Previous cycle — CL only</span>' : '')
            + '<button type="button" class="btn-pri clm-duty-claim-btn" data-duty-date="' + esc(dutyDate) + '" data-credit-type="' + esc(credit.type) + '">'
            + '<i class="fa fa-gift"></i> Claim</button>'
            + '</div>';
    }

    function dutyCardHtml(row, index) {
        var swipes = row.swipes || [];
        var credits = row.credits || [];
        var matchedCount = row.swipes_matched != null ? row.swipes_matched : 0;
        var totalCount = row.swipes_total != null ? row.swipes_total : 0;
        var claimableCount = credits.filter(function (c) { return c.status === 'claimable'; }).length;
        var claimedCount = credits.filter(function (c) { return c.status === 'claimed'; }).length;
        var statusCls = row.duty_status === 'Completed' ? 'clm-wh-pill--done' : 'clm-wh-pill--muted';
        var swipeDots = swipes.length
            ? swipes.map(swipeIndicatorHtml).join('')
            : '<span class="clm-duty-no-swipes">—</span>';

        var creditsBadge = claimableCount > 0
            ? '<span class="clm-duty-credits-count clm-duty-credits-count--pending">' + claimableCount + ' pending</span>'
            : (claimedCount === credits.length && credits.length > 0
                ? '<span class="clm-duty-credits-count clm-duty-credits-count--done">All claimed</span>'
                : '<span class="clm-duty-credits-count clm-duty-credits-count--off">Ineligible</span>');

        var mainRow = '<tr class="clm-duty-main-tr" data-duty-date="' + esc(row.duty_date) + '" style="cursor:pointer">'
            + '<td>' + (index + 1) + '</td>'
            + '<td><strong class="clm-duty-date-lbl">' + esc(row.duty_date_label || row.duty_date) + '</strong></td>'
            + '<td><span class="clm-wh-shift">' + esc(row.shift_name || '—') + '</span>'
            + '<small>' + esc(String(row.total_hours || '')) + 'h</small></td>'
            + '<td><div class="clm-duty-dots">' + swipeDots + '</div></td>'
            + '<td><span class="clm-duty-match">' + matchedCount + '<span class="clm-duty-match-total">/' + totalCount + '</span></span></td>'
            + '<td><span class="clm-wh-pill ' + statusCls + '">' + esc(row.duty_status || 'Pending') + '</span></td>'
            + '<td>' + creditsBadge + '</td>'
            + '<td><i class="fa fa-chevron-right clm-duty-chevron"></i></td>'
            + '</tr>';

        var creditsHtml = credits.map(function (c) { return dutyCreditRowHtml(c, row.duty_date); }).join('');
        var chipsHtml = swipes.length
            ? swipes.map(swipeChipHtml).join('')
            : '<span class="clm-duty-cr-tag clm-duty-cr-tag--off">No swipe schedule configured.</span>';

        var detailRow = '<tr class="clm-duty-detail-tr" data-duty-date="' + esc(row.duty_date) + '" hidden>'
            + '<td colspan="8" class="clm-duty-detail-td">'
            + '<div class="clm-duty-detail-inner">'
            + '<div class="clm-duty-detail-col">'
            + '<p class="clm-duty-detail-heading"><i class="fa fa-fingerprint"></i> Swipe Schedule</p>'
            + '<div class="clm-duty-chips">' + chipsHtml + '</div>'
            + '</div>'
            + '<div class="clm-duty-detail-col clm-duty-detail-col--credits">'
            + '<p class="clm-duty-detail-heading"><i class="fa fa-gift"></i> Available Credits</p>'
            + '<div class="clm-duty-credits-list">' + creditsHtml + '</div>'
            + '</div>'
            + '</div>'
            + '</td>'
            + '</tr>';

        return mainRow + detailRow;
    }

    function renderDutyHistory(history) {
        var body = $('clm-duty-history-body');
        if (!body) return;
        if (!history || !history.length) {
            body.innerHTML = '<tr><td colspan="6" class="clm-empty"><i class="fa fa-inbox"></i><span>No duty claim history yet.</span></td></tr>';
            return;
        }
        body.innerHTML = history.map(function (row, i) {
            var amount = row.claim_type === 'Encashment' && row.amount != null
                ? ('₹' + esc(String(row.amount)))
                : '—';
            return '<tr>'
                + '<td>' + (i + 1) + '</td>'
                + '<td>' + esc(row.duty_date_label || row.duty_date || '—') + '</td>'
                + '<td>' + esc(row.credit_type_label || row.credit_type || '—') + '</td>'
                + '<td>' + esc(row.claim_type || '—') + '</td>'
                + '<td>' + amount + '</td>'
                + '<td><span class="clm-status-pill"><i class="fa fa-check"></i> ' + esc(row.status || 'Claimed') + '</span></td>'
                + '</tr>';
        }).join('');
    }

    function renderDutyNotice(cycleKey, cycle) {
        var notice = $('clm-duty-notice');
        if (!notice) return;
        if (cycleKey === 'last') {
            notice.hidden = false;
            if (cycle && cycle.encashment_grace_active) {
                var graceEnd = cycle.encashment_grace_ends || '';
                notice.innerHTML = '<div class="clm-notice-icon"><i class="fa fa-info-circle"></i></div>'
                    + '<div><strong>Previous cycle — encashment grace active</strong>'
                    + '<p>Both CL and encashment are available until '
                    + esc(graceEnd || 'the grace deadline')
                    + ' (5 days after the cycle ends).</p></div>';
                return;
            }
            notice.innerHTML = '<div class="clm-notice-icon"><i class="fa fa-info-circle"></i></div>'
                + '<div><strong>Previous cycle</strong>'
                + '<p>CL claims are available. Encashment is disabled after the 5-day grace period.</p></div>';
            return;
        }
        notice.hidden = true;
        notice.innerHTML = '';
    }

    function renderDuty(data) {
        dutyState = data;

        // Update cycle label
        var cycleLabel = $('duty-cycle-label');
        if (cycleLabel && data.cycle) {
            cycleLabel.textContent = data.cycle.label || '';
        }

        renderDutyNotice(dutyCycle, data.cycle || null);

        var body = $('clm-duty-body');
        var rows = data.rows || [];
        if (body) {
            if (!rows.length) {
                body.innerHTML = '<tr><td colspan="8" class="clm-empty"><i class="fa fa-user-clock"></i>'
                    + '<span>No long-duty assignments found for this cycle.</span></td></tr>';
            } else {
                body.innerHTML = rows.map(dutyCardHtml).join('');
                body.querySelectorAll('.clm-duty-main-tr').forEach(function (tr) {
                    var date = tr.getAttribute('data-duty-date');
                    var detailTr = body.querySelector('.clm-duty-detail-tr[data-duty-date="' + date + '"]');
                    if (!detailTr) return;
                    var hasClaimable = detailTr.querySelector('.clm-duty-cr--ready');
                    if (hasClaimable) {
                        detailTr.hidden = false;
                        var chev = tr.querySelector('.clm-duty-chevron');
                        if (chev) chev.style.transform = 'rotate(90deg)';
                    }
                });
            }
        }
        renderDutyHistory(data.history || []);
        updateDutyPendingBadge(data.pending_count || 0);
    }

    function setDutyCycle(cycleKey) {
        if (dutyCycle === cycleKey && dutyLoaded) return;
        dutyCycle = cycleKey;
        dutyLoaded = false;

        // Update button active states
        document.querySelectorAll('[data-duty-cycle]').forEach(function (btn) {
            btn.classList.toggle('active', btn.getAttribute('data-duty-cycle') === cycleKey);
        });

        fetchDutyOverview(true);
    }

    function showDutySkeleton() {
        var body = $('clm-duty-body');
        var hist = $('clm-duty-history-body');
        if (body) {
            body.innerHTML = '';
            for (var i = 0; i < 4; i++) {
                body.innerHTML += '<tr><td colspan="8"><span class="ed-skel ed-skel-cell w-full"></span></td></tr>';
            }
        }
        if (hist) {
            hist.innerHTML = '';
            for (var j = 0; j < 3; j++) {
                hist.innerHTML += '<tr><td colspan="6"><span class="ed-skel ed-skel-cell w-full"></span></td></tr>';
            }
        }
    }

    function fetchDutyPendingCount() {
        return fetch(dutyApiUrl({ action: 'pending_count' }), {
            credentials: 'same-origin',
            headers: { Accept: 'application/json' },
        })
            .then(function (r) { return r.json(); })
            .then(function (json) {
                if (json && json.success && json.data) {
                    updateDutyPendingBadge(json.data.pending_count);
                }
                return json;
            })
            .catch(function () { return null; });
    }

    function fetchDutyOverview(force) {
        if (dutyLoading) return Promise.resolve(dutyState);
        if (dutyLoaded && !force) return Promise.resolve(dutyState);

