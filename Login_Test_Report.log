        try {
            return await fetchJson(apiUrl('open'), {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ trigger: trigger }),
            });
        } catch (e) {
            console.warn('[EDBirthday] markOpened', e.message);
            return null;
        }
    }

