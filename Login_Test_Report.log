            (function wireFragmentWarm() {
                if (!window.EDPageLoader) return;

                function warmFromNav(el) {
                    if (!el || !window.EDPageLoader) return;
                    const page = el.getAttribute('data-page');
                    if (!page || page === 'home') return;
                    if (typeof window.EDPageLoader.warmPage === 'function') {
                        window.EDPageLoader.warmPage(page);
                    }
                }

                function warmFromSeg(btn) {
                    if (!btn || !window.EDPageLoader || typeof window.EDPageLoader.warmTab !== 'function') return;
                    const id = btn.id || '';
                    if (id === 'sb1') window.EDPageLoader.warmTab('home-tab-duty');
                    if (id === 'sb2') window.EDPageLoader.warmTab('home-tab-leave');
                }

                function onPointerOrFocus(e) {
                    const nav = e.target && e.target.closest ?
                        e.target.closest('.sitem[data-page], .subitem[data-page]') :
                        null;
                    if (nav) warmFromNav(nav);
                    const seg = e.target && e.target.closest ?
                        e.target.closest('.seg-btn') :
                        null;
                    if (seg) warmFromSeg(seg);
                }

                document.addEventListener('pointerenter', onPointerOrFocus, true);
                document.addEventListener('focusin', onPointerOrFocus, true);
            })();

            function setSidebarCountBadge(id, count) {
                var badge = document.getElementById(id);
                if (!badge) return;
                var n = Number(count) || 0;
                badge.textContent = String(n);
                badge.style.display = n > 0 ? '' : 'none';
            }

            function applyDashboardCounts(payload) {
                payload = payload || {};
                var acc = getApprovalAccess();
                if (payload.pendingCounts && typeof payload.pendingCounts === 'object') {
