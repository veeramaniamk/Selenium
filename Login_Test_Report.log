        var payload = [];
        document.querySelectorAll('#hysGroups .hys-group').forEach(function (groupEl) {
            var group = dueGroups[Number(groupEl.dataset.groupIndex)];
            if (!group) return;
            var scores = [];
            groupEl.querySelectorAll('.hys-person').forEach(function (person) {
                var input = person.querySelector('input');
                var numeric = readScore(input);
                scores.push({ employee_bio_id: person.dataset.bioId, score: numeric });
            });
            payload.push({
                group_name: group.group_name,
                scores: scores,
            });
        });
        if (!payload.length) {
            showError('No hierarchy groups to submit.');
            return;
        }
        showError('');
        button.disabled = true;
        button.textContent = 'Saving…';
        fetch(endpoint('submit'), {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ groups: payload })
        }).then(function (response) {
            return response.json().then(function (json) {
                if (!response.ok || !json.success) throw new Error(json.error || 'Unable to save scores');
                return json;
            });
        }).then(function () {
            dueGroups = [];
            hideModal();
            if (window.EDToast) window.EDToast.success('Hierarchy score round completed.');
            // Quiet follow-up later — do not refresh/reopen immediately after submit.
            clearNextTimer();
            nextTimer = window.setTimeout(function () {
                check(true);
            }, 60 * 1000);
        }).catch(function (error) {
            showError(error.message);
        }).finally(function () {
            button.textContent = 'Submit score round';
            updateSubmitState();
        });
    }

    function bootCheck() {
        bootAttempts += 1;
        check(true);
        if (bootAttempts < 3) {
            window.setTimeout(bootCheck, 1800);
        }
    }

    function start() {
        ensureModal();
        window.setTimeout(bootCheck, 500);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start);
    } else {
        start();
    }
    document.addEventListener('ed-page-ready', function () {
        window.setTimeout(function () { check(false); }, 300);
    });
    document.addEventListener('click', function (event) {
        if (requiredOpen && event.target.closest('[data-page], #sidebar, #layout .nav, .sidebar')) {
            event.preventDefault();
            event.stopPropagation();
            showModal({ preserveInputs: true });
            return;
        }
        if (event.target.closest('[data-page]')) {
            window.setTimeout(function () { check(false); }, 400);
        }
    }, true);

    document.addEventListener('visibilitychange', function () {
        if (!document.hidden) check(false);
    });

    window.EDHierarchyScores = { check: check, show: showModal };
}());


