    function renderWorkflowTimeline(stages) {
        if (!stages || !stages.length) {
            return '<div style="padding:24px;color:#9ca3af;text-align:center;font-size:12px">No workflow data available</div>';
        }

        var dotCfg = {
            done: { bg: 'linear-gradient(180deg,#4ade80,#22c55e)', border: '#16a34a', icon: 'fa-check' },
            pending: { bg: 'linear-gradient(180deg,#fbbf24,#f59e0b)', border: '#d97706', icon: 'fa-clock' },
            rejected: { bg: 'linear-gradient(180deg,#f87171,#ef4444)', border: '#dc2626', icon: 'fa-times' },
            up: { bg: '#e5e7eb', border: '#d1d5db', icon: 'fa-circle' },
        };

        var currentPendingStage = null;
        for (var i = 0; i < stages.length; i++) {
            if (stages[i].status === 'Pending') {
                currentPendingStage = stages[i].stage_number;
                break;
            }
        }

        return stages.map(function (step, index) {
            var st = 'up';
            if (step.status === 'Approved') st = 'done';
            else if (step.status === 'Rejected') st = 'rejected';
            else if (step.status === 'Pending') {
                st = step.stage_number === currentPendingStage ? 'pending' : 'up';
            }

            var c = dotCfg[st] || dotCfg.up;
            var dateLabel = '';
            if (step.action_date) {
                var d = new Date(step.action_date);
                if (!isNaN(d.getTime())) {
                    dateLabel = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                }
            }

            var title = 'Stage ' + step.stage_number + ' Approval';
            var roleLine = esc(step.head_name || 'N/A') + (step.head_id ? ' — ' + esc(step.head_id) : '');
            var rem = '';
            if (step.status === 'Approved') {
                // Show actual approver notes if available, else generic text
                rem = step.approval_notes
                    ? esc(step.approval_notes)
                    : 'Approved at this stage.';
            } else if (step.status === 'Rejected' && step.reject_reason) {
                rem = esc(step.reject_reason);
            } else if (st === 'pending') {
                rem = 'Awaiting approval at this stage.';
            }

            var reportHtml = '';
            if (step.signed_pdf_url) {
                reportHtml = '<a href="' + esc(step.signed_pdf_url) + '" target="_blank" rel="noopener noreferrer"'
                    + ' style="display:inline-flex;align-items:center;gap:4px;font-size:10px;color:#2563eb;margin-top:4px;text-decoration:none">'
                    + '<i class="fa fa-file-pdf"></i> View Signed PDF</a>';
            }

            return '<div class="wf-step d-flex ' + (st === 'up' ? 'opacity-50' : '') + (st === 'rejected' ? ' rejected' : '') + '">'
                + '<div class="wf-date" style="width: 50px; font-size:10px; color:#9ca3af; text-align:right; margin-right:12px; margin-top:2px;">' + esc(dateLabel) + '</div>'
                + '<div class="wf-mid" style="display:flex; flex-direction:column; align-items:center; position:relative; margin-right:12px;">'
                + '<div class="wf-dot' + (st === 'rejected' ? ' rejected-dot' : '') + '" style="width:20px; height:20px; border-radius:50%; display:flex; align-items:center; justify-content:center; background:' + c.bg + '; border:1.5px solid ' + c.border + '; color:#fff; z-index:2">'
                + '<i class="fa ' + c.icon + '" style="font-size:8px"></i></div>'
                + (index < stages.length - 1 ? '<div class="wf-vline ' + (st === 'done' ? 'done' : '') + '" style="width:2px; flex-grow:1; background:#e5e7eb; position:absolute; top:20px; bottom: -20px; z-index:1;"></div>' : '')
                + '</div>'
                + '<div class="wf-body" style="padding-bottom:20px; flex:1;">'
                + '<div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">'
                + '<span style="font-size:12px;font-weight:700;color:#1a202c">' + esc(title) + '</span>'
                + (st === 'pending' ? '<span style="padding:1px 6px;background:#f59e0b;color:#fff;font-size:8px;font-weight:700;border-radius:99px;text-transform:uppercase">Current</span>' : '')
                + (st === 'rejected' ? '<span style="padding:1px 6px;background:#ef4444;color:#fff;font-size:8px;font-weight:700;border-radius:99px;text-transform:uppercase">Rejected</span>' : '')
                + '</div>'
                + '<div style="font-size:10px;color:#9ca3af;margin-top:1px">' + roleLine + '</div>'
                + (rem ? '<div style="font-size:10px;color:#64748b;margin-top:3px;line-height:1.4">' + rem + '</div>' : '')
                + reportHtml
                + '</div></div>';
        }).join('');
    }

    function renderWorkflowCardHtml(stages, req) {
        var done = stages.filter(function (s) { return s.status === 'Approved'; }).length;
        var progress = stages.length ? Math.round((done / stages.length) * 100) : 0;
        var pendingStep = null;
        for (var i = 0; i < stages.length; i++) {
            if (stages[i].status === 'Pending') {
                pendingStep = stages[i];
                break;
            }
        }
        var pendingText = 'None';
        if (pendingStep) {
            pendingText = esc(pendingStep.head_name || 'Approver') + ' (Stage ' + pendingStep.stage_number + ')';
        } else if (stages.some(function(s) { return s.status === 'Rejected'; })) {
            pendingText = 'Rejected';
        } else if (done === stages.length) {
            pendingText = 'All stages completed';
        }

        return '<div class="pa-wf-card">' +
            '<div class="m-hdr" style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;background:linear-gradient(180deg,#3b82f6,#2563eb);">' +
