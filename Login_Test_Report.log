        ensureTypeDropdownParent();

        var q = (filterText || '').toLowerCase().trim();
        var types = formOptions.category_types || [];
        var matching = types.filter(function (t) {
            return !q || (t.type_name || '').toLowerCase().indexOf(q) !== -1;
        });

        if (!matching.length) {
            dd.innerHTML = '<div style="padding:12px 14px;font-size:12.5px;color:#94a3b8;text-align:center;">No matching categories</div>';
        } else {
            var html = matching.map(function (t) {
                var name = t.type_name || '';
                var isSel = selectedTypes.indexOf(name) !== -1;
                return '<div class="pr-type-opt' + (isSel ? ' is-selected' : '') + '" data-type="' + esc(name) + '">'
                    + '<span class="pr-type-opt-check"></span>'
                    + '<span class="pr-type-opt-name">' + esc(name) + '</span>'
                    + '</div>';
            }).join('');
            dd.innerHTML = html;
        }

        dd.hidden = false;
        positionTypeDropdown();
    }

    function setupTypeMultiSelect() {
        if (typeMultiSelectWired) return;

        var searchInp = document.getElementById('pr-type-search-inp');
        var dd = document.getElementById('pr-type-dropdown');
        var chipsArea = document.getElementById('pr-type-chips');
        var wrap = document.getElementById('pr-type-multiselect');
        if (!searchInp || !dd || !chipsArea || !wrap) return;

        typeMultiSelectWired = true;

        // Open dropdown on focus
        searchInp.addEventListener('focus', function () {
            renderTypeDropdown(searchInp.value);
        });

        // Filter on typing
        searchInp.addEventListener('input', function () {
            renderTypeDropdown(searchInp.value);
        });

        // Keyboard navigation
        searchInp.addEventListener('keydown', function (e) {
            if (e.key === 'Backspace' && !searchInp.value && selectedTypes.length > 0) {
                selectedTypes.pop();
                renderTypeChips();
                updateCategoryVisibility();
                syncTypeDropdownOptions();
                positionTypeDropdown();
            } else if (e.key === 'Escape') {
                dd.hidden = true;
            }
        });

        // Prevent focus theft on option clicks; DO NOT prevent default on scrollbar clicks/drags!
        dd.addEventListener('mousedown', function (ev) {
            ev.stopPropagation();
            if (ev.target.closest('.pr-type-opt')) {
                ev.preventDefault();
            }
        });

        // Smooth instant toggle without recreating DOM or closing dropdown
        dd.addEventListener('click', function (ev) {
            var opt = ev.target.closest('.pr-type-opt');
            if (!opt) return;
            var tName = opt.getAttribute('data-type');
            if (!tName) return;

            var idx = selectedTypes.indexOf(tName);
            if (idx === -1) {
                selectedTypes.push(tName);
                opt.classList.add('is-selected');
            } else {
                selectedTypes.splice(idx, 1);
                opt.classList.remove('is-selected');
            }

            renderTypeChips();
            updateCategoryVisibility();
            positionTypeDropdown();
            searchInp.focus();
        });

        // Chips area click
        chipsArea.addEventListener('click', function (ev) {
            var delBtn = ev.target.closest('.pr-type-chip-del');
            if (delBtn) {
                var tName = delBtn.getAttribute('data-type');
                var idx = selectedTypes.indexOf(tName);
                if (idx !== -1) {
                    selectedTypes.splice(idx, 1);
                    renderTypeChips();
                    updateCategoryVisibility();
                    syncTypeDropdownOptions();
                    positionTypeDropdown();
                }
                searchInp.focus();
                return;
            }
            searchInp.focus();
            renderTypeDropdown(searchInp.value);
        });

        // Keep dropdown glued to search input on scroll and resize
        window.addEventListener('scroll', function () {
            var d = document.getElementById('pr-type-dropdown');
            if (d && !d.hidden) positionTypeDropdown();
        }, true);

        window.addEventListener('resize', function () {
            var d = document.getElementById('pr-type-dropdown');
            if (d && !d.hidden) positionTypeDropdown();
        });

        // Close dropdown when modal is hidden
        var modalEl = document.getElementById('pr-request-modal');
        if (modalEl) {
            modalEl.addEventListener('hidden.bs.modal', function () {
                var d = document.getElementById('pr-type-dropdown');
                if (d) d.hidden = true;
            });
        }

        // Outside-click detection that never misfires on selected item clicks
        document.addEventListener('click', function (ev) {
            var d = document.getElementById('pr-type-dropdown');
            var w = document.getElementById('pr-type-multiselect');
            if (!d || d.hidden) return;
            var path = typeof ev.composedPath === 'function' ? ev.composedPath() : [];
            if ((w && w.contains(ev.target)) || d.contains(ev.target) || (w && path.indexOf(w) !== -1) || path.indexOf(d) !== -1) {
                return;
            }
            d.hidden = true;
        });
    }

    function populateFormSelects() {
        var locSel = document.getElementById('pr-form-location');
        var catSel = document.getElementById('pr-form-category');
        if (!locSel || !catSel) return;

        var locHtml = '<option value="" disabled selected>Select location</option>';
        var locItems = [];
        (formOptions.locations || []).forEach(function (loc) {
            var val = String(loc.location_name || '');
            var label = String((loc.location_code || '') + ' - ' + (loc.location_name || ''));
            locHtml += '<option value="' + esc(val) + '">' + esc(label) + '</option>';
            locItems.push({ value: val, label: label });
        });
        locSel.innerHTML = locHtml;

        var catHtml = '<option value="" disabled selected>Select vendor category</option>';
        var catItems = [];
        (formOptions.vendor_categories || []).forEach(function (c) {
            var val = String(c.id || '') + '|' + String(c.category_name || '');
            var label = String(c.id) + ' - ' + String(c.category_name || '');
            catHtml += '<option value="' + esc(val) + '">' + esc(label) + '</option>';
            catItems.push({ value: val, label: label });
        });
        catSel.innerHTML = catHtml;

        if (!formSearchSelects.location && window.EDSearchSelect) {
            formSearchSelects.location = new EDSearchSelect(locSel, { placeholder: 'Select location' });
            formSearchSelects.category = new EDSearchSelect(catSel, { placeholder: 'Select vendor category' });
        }

        if (formSearchSelects.location) formSearchSelects.location.setOptions(locItems);
        if (formSearchSelects.category) formSearchSelects.category.setOptions(catItems);

        setupTypeMultiSelect();
    }

    function ensureFormOptions() {
        if (formOptionsLoaded) {
            populateFormSelects();
            return Promise.resolve();
        }
        return fetchJson(apiUrl('form-options')).then(function (data) {
            var block = (data && data.project_request) || data || {};
            formOptions = {
                locations: block.locations || [],
                category_types: block.category_types || [],
                vendor_categories: block.vendor_categories || [],
            };
            formOptionsLoaded = true;
            populateFormSelects();
        });
    }

    function openRequestModal() {
        ensureFormOptions().then(function () {
            var form = document.getElementById('pr-request-form');
            if (form) form.reset();
            resetFormSearchSelects();
            var err = document.getElementById('pr-form-error');
            if (err) { err.style.display = 'none'; err.textContent = ''; }
            var modalEl = document.getElementById('pr-request-modal');
            if (modalEl && window.bootstrap && window.bootstrap.Modal) {
                window.bootstrap.Modal.getOrCreateInstance(modalEl).show();
            }
        }).catch(function (e) {
            if (window.EDToast) window.EDToast.error(e.message || 'Unable to load form options');
        });
    }

    function submitRequest(ev) {
        if (ev) ev.preventDefault();
        var form = document.getElementById('pr-request-form');
        var btn = document.getElementById('pr-form-submit');
        var err = document.getElementById('pr-form-error');
        if (!form) return;

        if (err) { err.style.display = 'none'; err.textContent = ''; }

        // Validation
        if (!selectedTypes.length) {
            if (err) {
                err.textContent = 'Please select at least one Category Type.';
                err.style.display = 'block';
            }
            return;
        }

        if (btn) btn.disabled = true;

        var fd = new FormData(form);
        if (!fd.has('type_names[]')) {
            selectedTypes.forEach(function (t) {
                fd.append('type_names[]', t);
            });
        }
        fetch(apiUrl('submit'), {
            method: 'POST',
            credentials: 'same-origin',
            headers: { Accept: 'application/json' },
            body: fd,
        }).then(function (res) {
            return res.text().then(function (text) {
                var json = null;
                try { json = text ? JSON.parse(text) : null; } catch (e) { json = null; }
                if (!json || !json.success) {
                    throw new Error((json && (json.error || json.message)) || 'Submission failed');
                }
                return json;
            });
        }).then(function (json) {
            var modalEl = document.getElementById('pr-request-modal');
            if (modalEl && window.bootstrap && window.bootstrap.Modal) {
                window.bootstrap.Modal.getOrCreateInstance(modalEl).hide();
            }
            form.reset();
            resetFormSearchSelects();

            var pr = (json.data && json.data.project_request) || {};
            if (pr.is_multi) {
                if (window.EDToast) {
                    window.EDToast.success(json.message || 'Multi-category request submitted! Awaiting Project Consolidater approval.');
                }
                switchTab('multi');
            } else {
                if (window.EDToast) {
                    window.EDToast.success(json.message || 'Request submitted successfully.');
                }
                loadFilterOptions();
                return loadRows({ reset: true });
            }
        }).catch(function (e) {
            if (err) {
                err.textContent = e.message || 'Submission failed';
                err.style.display = 'block';
            }
        }).finally(function () {
            if (btn) btn.disabled = false;
        });
    }

    function openWithdrawModal(requestId) {
        withdrawTargetId = requestId;
        var modalEl = document.getElementById('pr-withdraw-modal');
        if (modalEl && window.bootstrap && window.bootstrap.Modal) {
            window.bootstrap.Modal.getOrCreateInstance(modalEl).show();
        }
    }

    function confirmWithdraw() {
        if (!withdrawTargetId) return;
        var btn = document.getElementById('pr-withdraw-confirm');
        if (btn) btn.disabled = true;

        fetch(apiUrl('withdraw'), {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ request_id: withdrawTargetId }),
        }).then(function (res) {
            return res.text().then(function (text) {
                var json = null;
                try { json = text ? JSON.parse(text) : null; } catch (e) { json = null; }
                if (!json || !json.success) {
                    throw new Error((json && (json.error || json.message)) || 'Withdraw failed');
                }
                return json;
            });
        }).then(function () {
            var modalEl = document.getElementById('pr-withdraw-modal');
            if (modalEl && window.bootstrap && window.bootstrap.Modal) {
                window.bootstrap.Modal.getOrCreateInstance(modalEl).hide();
            }
            withdrawTargetId = null;
            return loadRows({ reset: true });
        }).catch(function (e) {
            if (window.EDToast) window.EDToast.error(e.message || 'Withdraw failed');
        }).finally(function () {
            if (btn) btn.disabled = false;
        });
    }

    // =========================================================================
    // Multi Project Tab Logic
    // =========================================================================

    function statusPill(status) {
        var s = String(status || 'pending').toLowerCase();
        var cls = 'pr-status-' + s;
        var label = s.charAt(0).toUpperCase() + s.slice(1);
        if (s === 'pending') label = 'Pending Consolidater';
        if (s === 'partial') label = 'Partially Approved';
        return '<span class="' + cls + '">' + esc(label) + '</span>';
    }

    function renderMultiRow(r, index) {
        var items = Array.isArray(r.items) ? r.items : [];
        var categoriesHtml = items.map(function (it) {
            var st = String(it.status || 'pending').toLowerCase();
            var badgeCls = 'pr-status-' + st;
            var pidTxt = (st === 'approved' && it.project_id) ? (' (' + it.project_id + ')') : '';
            return '<span class="' + badgeCls + '" style="display:inline-block;margin:2px 2px;">'
                + esc(it.type_name) + esc(pidTxt)
                + '</span>';
        }).join('');
        if (!categoriesHtml) {
            categoriesHtml = '<span class="pr-muted">' + (r.item_count || 0) + ' items</span>';
        }

        var batchRefShort = (r.batch_ref || '').slice(0, 8) + '…';
        var batchRefHtml = '<span class="pr-batch-ref-code" title="' + esc(r.batch_ref) + '">' + esc(batchRefShort) + '</span>';

        var loc = esc(r.location_name || '—');
        if (r.location_code) loc += ' <span class="pr-loc-code">(' + esc(r.location_code) + ')</span>';

        var docBtn = r.document_url
            ? '<a class="pr-doc-link pa-view-btn" href="' + esc(r.document_url) + '" target="_blank" rel="noopener" style="margin-right:6px;display:inline-flex;align-items:center;gap:3px;"><i class="fa fa-file-pdf fa-xs"></i> Doc</a>'
            : '';

        var action = docBtn + '<button type="button" class="cr-view-btn js-pr-multi-timeline" data-batch-ref="' + esc(String(r.batch_ref)) + '">'
            + '<i class="fa fa-clock-rotate-left fa-xs"></i> Timeline</button>';

        return '<tr>'
            + '<td class="pr-td-sno">' + esc(String(index)) + '</td>'
            + '<td>' + batchRefHtml + '</td>'
            + '<td class="pr-td-desc">' + esc(r.description || '—') + '</td>'
            + '<td class="pr-td-loc">' + loc + '</td>'
            + '<td>' + categoriesHtml + '</td>'
            + '<td>' + statusPill(r.status) + '</td>'
            + '<td>' + fmtDate(r.created_at) + '</td>'
            + '<td class="pr-td-act pr-td-actions">' + action + '</td>'
            + '</tr>';
    }

    function renderMultiTable() {
        var body = document.getElementById('pr-multi-body');
        if (!body) return;

        if (!multiLoaded && multiLoading) {
            body.innerHTML = skeletonRows(5);
            return;
        }

        var rows = multiState.rows || [];
        if (!rows.length) {
            body.innerHTML = '<tr><td colspan="8" class="pr-td-empty">No multi-category requests found</td></tr>';
            return;
        }

        body.innerHTML = rows.map(function (r, idx) { return renderMultiRow(r, idx + 1); }).join('');
    }

    function loadMultiRows(opts) {
        var options = opts || {};
        var reset = options.reset !== false;
        if (multiLoading) return Promise.resolve();

        if (reset) {
            multiState.page = 1;
            multiState.rows = [];
            var body = document.getElementById('pr-multi-body');
            if (body) body.innerHTML = skeletonRows(5);
        }

        multiLoading = true;
        var search = ((document.getElementById('pr-multi-search-input') || {}).value || '').trim();
        var status = ((document.getElementById('pr-multi-filter-status') || {}).value || '').trim();

        return fetchJson(apiUrl('list-multi', {
            page: String(multiState.page || 1),
            search: search,
            status: status,
        })).then(function (data) {
            var block = data.multi_requests || {};
            multiState.rows = Array.isArray(block.rows) ? block.rows : [];
            multiState.total = Number(block.total || multiState.rows.length || 0);
            multiLoaded = true;
        }).catch(function (e) {
            var body = document.getElementById('pr-multi-body');
            if (body && reset) {
                body.innerHTML = '<tr><td colspan="8" class="pr-td-empty pr-td-error">' + esc(e.message || 'Unable to load multi requests') + '</td></tr>';
            }
        }).finally(function () {
            multiLoading = false;
            renderMultiTable();
        });
    }

    function openMultiTimeline(batchRef) {
        if (!batchRef || !window.EDWorkflowModal) return;
        fetchJson(apiUrl('multi-detail', { batch_ref: batchRef })).then(function (data) {
            var d = data.multi_detail || {};
            var batch = d.batch || {};
            var items = d.items || [];

            var wfSteps = [];
            // Step 1: Submission
            wfSteps.push({
                title: 'Multi-Request Submission',
                approver: batch.employee_name || 'Requester',
                role: 'Requester',
                date: batch.created_at,
                status: 'done',
                remark: 'Submitted with ' + items.length + ' category types.',
            });

            // Step 2: Consolidater Review
            var batchStatus = String(batch.status || 'pending').toLowerCase();
            var consStatus = 'pending';
            if (batchStatus === 'approved') consStatus = 'done';
            else if (batchStatus === 'rejected') consStatus = 'rejected';
            else if (batchStatus === 'partial') consStatus = 'done';

            wfSteps.push({
                title: 'Project Consolidater Review',
                approver: batch.consolidater_bio_id ? ('Consolidater (' + batch.consolidater_bio_id + ')') : 'Pending Consolidater',
                role: 'Consolidater',
                date: batch.reviewed_at || null,
                status: consStatus,
                remark: batch.review_note || (consStatus === 'pending' ? 'Awaiting Consolidater review.' : 'Review completed.'),
            });

            // Individual category item steps
            items.forEach(function (it, idx) {
                var itStatus = String(it.status || 'pending').toLowerCase();
                var stKey = 'up';
                var remark = 'Awaiting review';
                if (itStatus === 'approved') {
                    stKey = 'done';
                    remark = 'Approved! Project ID created: ' + (it.project_id || 'Assigned');
                } else if (itStatus === 'rejected') {
                    stKey = 'rejected';
                    remark = 'Rejected: ' + (it.reject_reason || 'No reason specified');
                } else if (consStatus === 'pending') {
                    stKey = 'pending';
                }

                wfSteps.push({
                    title: 'Category ' + (idx + 1) + ': ' + (it.type_name || 'Item'),
                    approver: it.project_id ? it.project_id : 'Staging',
                    role: it.type_name,
                    date: it.approved_at || null,
                    status: stKey,
                    remark: remark,
                });
            });

            var subtitle = 'Multi-Request Batch (' + (batch.batch_ref ? batch.batch_ref.slice(0, 8) + '…' : '') + ')';
            var metaHtml = '';
            var docUrl = batch.document_url || '';
            if (docUrl) {
                metaHtml = '<div style="margin-top:6px;"><a href="' + esc(docUrl) + '" target="_blank" rel="noopener" class="pr-doc-link pa-view-btn" style="display:inline-flex;align-items:center;gap:4px;font-size:11px;padding:3px 10px;text-decoration:none;"><i class="fa fa-file-pdf"></i> View Document <i class="fa fa-arrow-up-right-from-square fa-xs"></i></a></div>';
            }

            EDWorkflowModal.show({
                subtitle: subtitle,
                requester: batch.employee_name || '—',
                department: batch.location_name || batch.location_code || '—',
                amount: items.length + ' Categories',
                metaHtml: metaHtml,
                steps: wfSteps,
            });
        }).catch(function (e) {
            if (window.EDToast) window.EDToast.error(e.message || 'Unable to load timeline');
        });
    }

    function switchTab(tab) {
        currentTab = tab;
        var btnList = document.getElementById('pr-tab-btn-list');
        var btnMulti = document.getElementById('pr-tab-btn-multi');
        var panelList = document.getElementById('pr-panel-list');
        var panelMulti = document.getElementById('pr-panel-multi');

        if (tab === 'multi') {
            if (btnList) btnList.classList.remove('is-active');
            if (btnMulti) btnMulti.classList.add('is-active');
            if (panelList) panelList.style.display = 'none';
            if (panelMulti) panelMulti.style.display = 'block';
            loadMultiRows({ reset: true });
        } else {
            if (btnList) btnList.classList.add('is-active');
            if (btnMulti) btnMulti.classList.remove('is-active');
            if (panelList) panelList.style.display = 'block';
            if (panelMulti) panelMulti.style.display = 'none';
            if (state.rows.length === 0) loadRows({ reset: true });
        }
    }

    function wirePageControls() {
        var searchInput = document.getElementById('pr-search-input');
        if (searchInput) {
            window.edWire(searchInput, 'input', function () {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(function () { loadRows({ reset: true }); }, 180);
            }, 'search');
        }

        var locFilter = document.getElementById('pr-filter-location');
        var doaFilter = document.getElementById('pr-filter-doa');
        if (locFilter || doaFilter) initFilterSearchSelects();
        window.edWire(locFilter, 'change', function () { loadRows({ reset: true }); }, 'loc');
        window.edWire(doaFilter, 'change', function () { loadRows({ reset: true }); }, 'doa');

        // Multi filters
        var multiSearch = document.getElementById('pr-multi-search-input');
        if (multiSearch) {
            window.edWire(multiSearch, 'input', function () {
                clearTimeout(multiSearchTimer);
                multiSearchTimer = setTimeout(function () { loadMultiRows({ reset: true }); }, 200);
            }, 'multi-search');
        }
        var multiStatusSel = document.getElementById('pr-multi-filter-status');
        if (multiStatusSel) {
            window.edWire(multiStatusSel, 'change', function () { loadMultiRows({ reset: true }); }, 'multi-status');
        }

        // Tab buttons
        var btnList = document.getElementById('pr-tab-btn-list');
        var btnMulti = document.getElementById('pr-tab-btn-multi');
        if (btnList) window.edWire(btnList, 'click', function () { switchTab('list'); }, 'tab-list');
        if (btnMulti) window.edWire(btnMulti, 'click', function () { switchTab('multi'); }, 'tab-multi');

        window.edWire(document.getElementById('pr-request-btn'), 'click', openRequestModal, 'req');
        window.edWire(document.getElementById('pr-request-form'), 'submit', submitRequest, 'form');
        window.edWire(document.getElementById('pr-withdraw-confirm'), 'click', confirmWithdraw, 'withdraw');
    }

    function wireEvents() {
        wirePageControls();
        if (wired) return;
        wired = true;

        document.addEventListener('click', function (ev) {
            if (!isActive()) return;

            // Single request timeline
            var tlBtn = ev.target.closest('.js-pr-timeline');
            if (tlBtn) {
                var id = parseInt(tlBtn.getAttribute('data-id') || '0', 10);
                var row = (state.rows || []).find(function (r) { return Number(r.id) === id; });
                if (row) openProjectTimeline(row);
                return;
            }

            // Single request withdraw
            var btn = ev.target.closest('.js-pr-withdraw');
            if (btn) {
                openWithdrawModal(parseInt(btn.getAttribute('data-id') || '0', 10));
                return;
            }

            // Multi request timeline
            var mtlBtn = ev.target.closest('.js-pr-multi-timeline');
            if (mtlBtn) {
                var ref = mtlBtn.getAttribute('data-batch-ref');
                if (ref) openMultiTimeline(ref);
                return;
            }
        });
    }

    function onPage() {
        wireEvents();
        if (currentTab === 'multi') {
            loadMultiRows({ reset: true });
        } else {
            if (loaded) {
                renderTable();
                return;
            }
            showLoading();
            filterSearchSelects = { location: null, doa: null };
            loadFilterOptions();
            return loadRows({ reset: true });
        }
    }

    function schedulePrefetch() {
        if (prefetchStarted) return;
        prefetchStarted = true;
        var run = function () { loadRows({ reset: true }); };
        if (typeof window.requestIdleCallback === 'function') {
            window.requestIdleCallback(run, { timeout: 3000 });
        } else {
            setTimeout(run, 800);
        }
    }

    function init() {
        wireEvents();
    }

    window.EDProjectRequest = {
        init: init,
        onPage: onPage,
        loadRows: loadRows,
        loadMultiRows: loadMultiRows,
        switchTab: switchTab,
        openRequestModal: openRequestModal,
        prefetch: schedulePrefetch,
    };
})();

