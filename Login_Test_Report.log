    function showConfirmModal(action) {
        var itemsData = [];
        var isValid = true;
        
        // Collect item quantities if approving
        if (action === 'approve') {
            document.querySelectorAll('.sd-qty-input').forEach(function(input) {
                var val = parseFloat(input.value) || 0;
                var max = parseFloat(input.getAttribute('max')) || 0;
                if (val < 0 || val > max) isValid = false;
                itemsData.push({
                    id: input.getAttribute('data-id'),
                    qty: val
                });
            });
            
            if (!isValid) {
                if (window.toast) window.toast('Invalid quantities entered.', 'error');
                return;
            }
        }

        var title = action === 'approve' ? 'Approve Dispatch' : 'Reject Dispatch';
        var promptText = action === 'approve' ? 'Are you sure you want to approve this dispatch request?' : 'Please provide a reason for rejecting this dispatch request.';
        var btnClass = action === 'approve' ? 'btn-success' : 'btn-danger';
        var iconClass = action === 'approve' ? 'fa-check-circle' : 'fa-times-circle';
        var hdrBg = action === 'approve' ? 'linear-gradient(135deg,#22c55e,#16a34a)' : 'linear-gradient(135deg,#ef4444,#dc2626)';

        var rejectRemarksHtml = '';
        if (action === 'reject') {
            rejectRemarksHtml = '<div style="margin-top:12px;">' +
                '<label style="font-weight:600;font-size:12px;color:#374151;margin-bottom:6px;display:block;"><i class="fa fa-pencil me-1"></i>Rejection Remarks <span style="color:#ef4444;">*</span></label>' +
                '<textarea id="sd-reject-remarks" class="form-control" rows="3" placeholder="Enter reason for rejection..." style="border-radius:8px;font-size:13px;border:1px solid #d1d5db;resize:vertical;"></textarea>' +
                '<div id="sd-reject-remarks-error" style="display:none;color:#ef4444;font-size:11px;margin-top:4px;"><i class="fa fa-exclamation-circle me-1"></i>Please enter rejection remarks.</div>' +
                '</div>';
        }

        var html = '<div class="modal fade" id="sd-confirm-modal" tabindex="-1" aria-hidden="true">' +
            '<div class="modal-dialog modal-dialog-centered">' +
            '<div class="modal-content" style="border:none;border-radius:12px;overflow:hidden;">' +
            '<div style="background:' + hdrBg + ';padding:16px 20px;display:flex;align-items:center;gap:12px;">' +
            '<div style="width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;"><i class="fa ' + iconClass + '" style="color:#fff;font-size:16px;"></i></div>' +
            '<h5 class="modal-title" style="margin:0;color:#fff;font-weight:700;font-size:16px;">' + esc(title) + '</h5>' +
            '</div>' +
            '<div class="modal-body" style="padding:20px;">' +
            '<p style="font-weight:500;font-size:14px;color:#374151;margin-bottom:0;">' + promptText + '</p>' +
            rejectRemarksHtml +
            '</div>' +
            '<div class="modal-footer" style="padding:12px 20px;border-top:1px solid #f3f4f6;">' +
            '<button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="border-radius:8px;">Cancel</button>' +
            '<button type="button" class="btn ' + btnClass + '" id="sd-confirm-submit" style="border-radius:8px;font-weight:600;"><i class="fa ' + iconClass + ' me-1"></i>Confirm</button>' +
            '</div>' +
            '</div>' +
            '</div>' +
            '</div>';
            
        var old = document.getElementById('sd-confirm-modal');
        if (old) old.remove();
        
        document.body.insertAdjacentHTML('beforeend', html);
        var modalEl = document.getElementById('sd-confirm-modal');
        var bsModal = new bootstrap.Modal(modalEl);
        bsModal.show();

        document.getElementById('sd-confirm-submit').addEventListener('click', function() {
            var btn = this;

            // For reject: validate the rejection remarks
            if (action === 'reject') {
                var rejectRemarksEl = document.getElementById('sd-reject-remarks');
                var rejectErrEl = document.getElementById('sd-reject-remarks-error');
                if (rejectRemarksEl && !rejectRemarksEl.value.trim()) {
                    if (rejectErrEl) rejectErrEl.style.display = 'block';
                    rejectRemarksEl.style.borderColor = '#ef4444';
                    rejectRemarksEl.focus();
                    return;
                }
                if (rejectErrEl) rejectErrEl.style.display = 'none';
                if (rejectRemarksEl) rejectRemarksEl.style.borderColor = '#d1d5db';
            }

            btn.disabled = true;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i>Processing...';

            var remarksVal = '';
            if (action === 'reject') {
                var rejectInput = document.getElementById('sd-reject-remarks');
                if (rejectInput) remarksVal = rejectInput.value.trim();
            } else {
                var remarksInput = document.getElementById('sd-detail-remarks');
                if (remarksInput) remarksVal = remarksInput.value.trim();
            }

            var formData = new FormData();
            formData.append('request_id', detailState.row.request_id || detailState.row.dispatch_id);
            formData.append('action', action);
            formData.append('remarks', remarksVal);
            
            if (action === 'approve') {
                formData.append('selected_items_json', JSON.stringify(itemsData));
                
                // Append PDF document
                var pdfInput = document.getElementById('sd-upload-pdf');
                if (pdfInput && pdfInput.files.length > 0) {
                    formData.append('pdf_document', pdfInput.files[0]);
                }
                
                // Append Multiple Images for each item row
                document.querySelectorAll('.sd-item-image-input').forEach(function(input) {
                    var code = input.getAttribute('data-code');
                    if (code && input.files.length > 0) {
                        var cleanCode = code.replace(/[^a-zA-Z0-9]/g, '_');
                        var fieldName = 'images_' + cleanCode + '[]';
                        for (var i = 0; i < input.files.length; i++) {
                            formData.append(fieldName, input.files[i]);
                        }
                    }
                });
            }

            fetch('/api_employee/scrap_dispatch/approve_dispatch.php', {
                method: 'POST',
                body: formData
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
                bsModal.hide();
                if (data.success) {
                    if (window.toast) window.toast('Dispatch ' + (action === 'approve' ? 'approved' : 'rejected') + ' successfully', 'success');
                    if (detailModal) detailModal.hide();
                    if (window.EDScrapDispatchApproval) {
                        window.EDScrapDispatchApproval.forceRefresh();
                        if (window.updatePendingCounts) window.updatePendingCounts();
                    }
                } else {
                    if (window.toast) window.toast(data.error || 'Failed to process request', 'error');
                }
            })
            .catch(function(err) {
                bsModal.hide();
                if (window.toast) window.toast(err.message, 'error');
            });
        });
    }

    function renderTable(data, tableBodyId, isPending) {
        var tbody = document.getElementById(tableBodyId);
        if (!tbody) return;
        
        if (!data || !data.length) {
            tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted">No records found.</td></tr>';
            return;
        }

        var html = data.map(function(row) {
            var reqId = row.request_id || row.dispatch_id || '';
            var requester = row.requester_name || 'N/A';
            var loc = row.location_display || '';
            var desc = row.description || '';
            var trackScrapId = row.track_scrap_id || '';
            var stat = row.status || 'Pending';
            
            var statClass = stat === 'Approved' ? 'success' : (stat === 'Rejected' ? 'danger' : 'warning');
            var statBadge = '<span class="badge bg-' + statClass + '">' + esc(stat) + '</span>';

            var actBtns = '<button type="button" class="btn btn-sm btn-outline-primary" onclick="EDScrapDispatchApproval.openDetail(' + esc(reqId) + ', this)">View</button>';

            return '<tr data-row=\'' + JSON.stringify(row).replace(/'/g, "&apos;") + '\'>' +
                '<td>' + esc(requester) + '</td>' +
                '<td>' + esc(loc) + '</td>' +
                '<td>' + esc(desc) + '</td>' +
                '<td>' + esc(trackScrapId) + '</td>' +
                '<td>' + statBadge + '</td>' +
                '<td>' + actBtns + '</td>' +
                '</tr>';
        }).join('');
        
        tbody.innerHTML = html;
    }

    window.EDScrapDispatchApproval = {
        renderScrapDispatchTable: function() {
            var tab = getTab();
            var head = document.getElementById('appr-head');
            if (head) {
                head.innerHTML = '<tr><th>Requester Name</th><th>Location</th><th>Description</th><th>Scrap Track ID</th><th>Status</th><th>Actions</th></tr>';
            }
            this.loadData(tab);
            return true;
        },
        init: function () {
            loaded = true;
            this.renderScrapDispatchTable();
        },
        destroy: function () {
            loaded = false;
            historyLoaded = false;
        },
        loadData: function (tab) {
            if (!tab) tab = getTab();
            var tbody = document.getElementById('appr-body');
            if (tbody) tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4"><i class="fa fa-spinner fa-spin me-2"></i>Loading...</td></tr>';
            
            fetchJson(apiUrl(tab))
                .then(function (res) {
                    var items = res && res.scrap_dispatch_approval ? res.scrap_dispatch_approval.rows : [];
                    renderTable(items, 'appr-body', tab === 'pending');
                    if (tab === 'pending') {
                        var c = res && res.scrap_dispatch_approval ? res.scrap_dispatch_approval.count : 0;
                        pendingCount = c;
                        var b = document.getElementById('appr-pb');
                        if (b) {
                            var bHTML = b.innerHTML.replace(/\s*<span.*<\/span>/, '');
                            if (c > 0) b.innerHTML = bHTML + ' <span class="badge bg-danger rounded-pill ms-1" style="font-size:10px">' + c + '</span>';
                            else b.innerHTML = bHTML;
                        }
                        // Refresh category card badge
                        if (window.refreshApprovalCategoryBadges) window.refreshApprovalCategoryBadges();
                    }
                })
                .catch(function (err) {
                    if (tbody) tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-danger">' + esc(err.message) + '</td></tr>';
                });
        },
        forceRefresh: function () {
            if (loaded) this.loadData();
        },
        getPendingCount: function () {
            return pendingCount;
        },
        openDetail: function (reqId, btn) {
            var tr = btn.closest('tr');
            if (!tr) return;
            var rowStr = tr.getAttribute('data-row');
            if (!rowStr) return;
            try {
                var row = JSON.parse(rowStr);
                ensureDetailModal();
                if (detailModal) detailModal.show();
                loadDetailData(row);
            } catch (e) {
                console.error("Error parsing row data", e);
            }
        },
        openApproveFromDetail: function () {
            showConfirmModal('approve');
        },
        openRejectFromDetail: function () {
            showConfirmModal('reject');
        }
    };
})();

