        display: none;
    }

    #conferenceDuplicateAuditModal .era-tabs .amodal-tab-btn {
        white-space: nowrap;
        flex-shrink: 0;
        padding: 9px 12px;
        font-size: 12px;
    }

    #conferenceDuplicateAuditModal .era-foot-hint {
        font-size: 11px;
        width: 100%;
    }

    .era-hero {
        flex-direction: column;
        gap: 12px;
        padding: 14px;
    }

    #conferenceDuplicateAuditModal .claim-compare-cards {
        grid-template-columns: 1fr;
    }

    #conferenceDuplicateAuditModal .claim-doc-compare {
        min-height: auto;
    }

    #conferenceDuplicateAuditModal .claim-doc-iframe {
        min-height: 320px;
    }
}

