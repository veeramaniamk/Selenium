#er-expense-modal .er-summary-val-spent,
#er-expense-modal .er-stat-spent {
    color: #c2410c;
}

#er-expense-modal .er-summary-val-avail,
#er-expense-modal .er-stat-avail {
    color: #15803d;
}

#er-expense-modal .er-expense-cards {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

#er-expense-modal .er-budget-card {
    margin-bottom: 0;
    border-radius: 14px;
    overflow: hidden;
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    border: 1px solid #c7d2df;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05), inset 0 1px 0 #ffffff;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

#er-expense-modal .er-budget-card-hdr {
    display: flex;
    flex-direction: column;
    gap: 8px;
    cursor: pointer;
    user-select: none;
    padding: 12px 14px;
    background: linear-gradient(180deg, #ffffff 0%, #f5f8fc 60%, #e9eff7 100%);
    border-bottom: 1px solid transparent;
    transition: all 0.15s ease;
    box-shadow: inset 0 1px 0 #ffffff;
}

#er-expense-modal .er-budget-card-hdr:hover {
    background: linear-gradient(180deg, #ffffff 0%, #eef4fc 60%, #dde7f5 100%);
}

#er-expense-modal .er-budget-hdr-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    width: 100%;
}

#er-expense-modal .er-budget-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    min-width: 0;
}

#er-expense-modal .er-budget-title {
    font-weight: 800;
    font-size: 13.5px;
    color: #0f172a;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.9);
}

#er-expense-modal .er-budget-quick-stat {
    font-size: 11.5px;
    font-weight: 800;
    color: #1e293b;
    background: linear-gradient(180deg, #ffffff 0%, #edf2f7 100%);
    border: 1px solid #cbd5e1;
    box-shadow: inset 0 1px 0 #ffffff, 0 1px 2px rgba(0, 0, 0, 0.05);
    padding: 2px 9px;
    border-radius: 8px;
    white-space: nowrap;
}

#er-expense-modal .er-budget-hdr-right {
    display: flex;
    align-items: center;
    gap: 7px;
    flex-shrink: 0;
}

#er-expense-modal .er-util-badge {
    font-size: 10.5px;
    padding: 3px 10px;
    font-weight: 800;
    border-radius: 999px;
    white-space: nowrap;
}

#er-expense-modal .er-util-badge.cr-doa-approved {
    background: linear-gradient(180deg, #6ee7b7 0%, #22c55e 48%, #16a34a 52%, #15803d 100%);
    color: #ffffff;
    text-shadow: 0 -1px 0 rgba(0, 0, 0, 0.35);
    border: 1px solid #14532d;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.65), 0 2px 4px rgba(21, 128, 61, 0.3);
}

#er-expense-modal .er-util-badge.cr-doa-pending {
