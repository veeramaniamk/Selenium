    padding: 10px 4px 0;
}

.er-step-bar {
    display: flex;
    gap: 6px;
    margin-bottom: 16px;
    padding: 4px;
    background: linear-gradient(180deg, #f1f5f9, #e8edf3);
    border-radius: 12px;
    border: 1px solid rgba(0, 0, 0, 0.06);
}

@media (max-width: 991.98px) {
    #er-expense-modal .modal-dialog.er-expense-dialog {
        width: 100vw !important;
        max-width: 100vw !important;
        min-width: 0 !important;
        height: 100dvh;
        max-height: 100dvh;
        margin: 0 !important;
    }

    #er-expense-modal .modal-content {
        width: 100vw;
        height: 100dvh;
        max-height: 100dvh !important;
        border-radius: 0 !important;
    }

    #er-expense-modal .er-expense-m-hdr {
        flex-shrink: 0;
        padding: 10px 12px !important;
        min-height: 56px;
    }

    #er-expense-modal .cr-modal-icon {
        width: 32px !important;
        height: 32px !important;
        flex: 0 0 32px;
        font-size: 14px;
    }

    #er-expense-modal .er-expense-title {
        font-size: 14px;
        line-height: 1.25;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    #er-expense-modal .er-expense-id {
        font-size: 10px;
        line-height: 1.25;
    }

    #er-expense-modal .er-expense-body-wrap {
        max-height: none;
        padding: 10px 12px 12px;
    }

    #er-expense-modal .pa-detail-footer {
        padding: 10px 12px !important;
        padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px)) !important;
    }
}

