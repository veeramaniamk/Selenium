            font-family: 'DM Sans', sans-serif;
            font-size: 1.05rem;
            font-weight: 600;
            color: #fff;
            cursor: pointer;
            transition: box-shadow 0.2s, transform 0.15s;
            box-shadow: 0 2px 8px rgba(26, 86, 219, 0.25);
