        .viana-logo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        /* ── bottom footer animation ── */
        .bottom-footer {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            padding: 0.85rem 0 0;
            flex-wrap: wrap;
            justify-content: center;
            opacity: 0;
