            color: var(--ink-ghost);
            font-size: 1.1rem;
            line-height: 1;
            padding: 0;
            transition: color 0.2s ease, transform 0.2s ease;
        }

        .t-close:hover {
            color: var(--ink);
            transform: scale(1.1);
