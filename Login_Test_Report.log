}

/* ═══════════════════════════════════════════════════════════════
   HIERARCHY DATA — direct reports under logged-in head
   ═══════════════════════════════════════════════════════════════ */

#page-hierarchy .hy-win-icon {
    background: linear-gradient(145deg, #0ea5e9 0%, #0284c7 100%) !important;
}

#page-hierarchy .hy-total-badge {
    margin-left: 10px;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    color: #0369a1;
    background: #e0f2fe;
    border: 1px solid #bae6fd;
}

#page-hierarchy .hy-groups {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: linear-gradient(180deg, #fafbfd 0%, #f4f6fb 100%);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
}

#page-hierarchy .hy-groups-lbl {
