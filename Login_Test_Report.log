    line-height: 1.15;
    word-break: break-word;
}

#conferenceDuplicateAuditModal .era-metric-card.is-missing .era-metric-value {
    font-size: clamp(15px, 2.8vw, 18px);
    color: #b45309;
}

#conferenceDuplicateAuditModal .era-metric-hint {
    font-size: 11.5px;
    font-weight: 600;
    color: #94a3b8;
    margin-top: 8px;
    line-height: 1.35;
}

/* ---- Expense table ---- */
.era-table-wrap {
    border: 1px solid #e2e8f0;
