        }

        body.modern-mode .day-popup {
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.85), rgba(244, 244, 248, 0.75)) !important;
            border-color: rgba(0, 0, 0, 0.15) !important;
            color: var(--text-primary) !important;
        }

        body.modern-mode h1,
        body.modern-mode h2,
        body.modern-mode h3,
        body.modern-mode h4,
        body.modern-mode h5,
        body.modern-mode h6 {
